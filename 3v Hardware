    local function performGhostStrike(enemyCharacter, shouldStomp)
        if isAttacking or alreadyAttempted or not scriptRunning or commandCancelled then return end
        local enemyPlayer = Players:GetPlayerFromCharacter(enemyCharacter)
        if enemyPlayer and commandBlacklist[enemyPlayer.UserId] then return end
        -- Wait out forcefield (spawn protection)
        if hasForceField(enemyCharacter) then
            local ffWait = tick()
            while hasForceField(enemyCharacter) and tick() - ffWait < 5 do
                if not scriptRunning or commandCancelled then return end
                task.wait(0.3)
            end
            if not enemyCharacter or not enemyCharacter.Parent then return end
        end
        
        isAttacking = true
        local char = worker.Character
        if not char then isAttacking = false return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local enemyHum = enemyCharacter and enemyCharacter:FindFirstChild("Humanoid")
        local enemyPart = enemyCharacter and (enemyCharacter:FindFirstChild("UpperTorso") or enemyCharacter:FindFirstChild("Torso") or enemyCharacter:FindFirstChild("HumanoidRootPart"))
        
        if not root or not enemyPart or not enemyHum or enemyHum.Health <= KNOCK_THRESHOLD or isRagdolled(enemyCharacter) then 
            isAttacking = false 
            return 
        end
        
        local tool = getCombatTool(char)
        if not tool then isAttacking = false return end
        
        local securePos = root.CFrame
        local windupStart = tick()
        while tick() - windupStart < FAKE_WINDUP_DELAY do
            if not scriptRunning or commandCancelled or alreadyAttempted or not enemyHum or enemyHum.Health <= KNOCK_THRESHOLD or isRagdolled(enemyCharacter) then break end
            root.CFrame = securePos
            root.AssemblyLinearVelocity = Vector3.zero
            tool:Activate()
            RunService.RenderStepped:Wait()
        end

        clearPhysics(root)
        local lockStart = tick()
        lastEnemyVelocity = enemyPart.AssemblyLinearVelocity
        local lastEnemyPosition = enemyPart.Position
        
        while tick() - lockStart < STICK_DURATION do
            if not scriptRunning or commandCancelled or alreadyAttempted or not enemyPart.Parent or enemyHum.Health <= KNOCK_THRESHOLD or isRagdolled(enemyCharacter) then break end
            
            local currentPos = enemyPart.Position
            local posDelta = (currentPos - lastEnemyPosition).Magnitude
            lastEnemyPosition = currentPos
            
            -- Detect teleport: if position jumped more than 50 studs in one frame, snap directly
            if posDelta > 50 then
                root.CFrame = CFrame.lookAt(currentPos + Vector3.new(0, 0, TP_DISTANCE), currentPos)
                root.AssemblyLinearVelocity = Vector3.zero
                lastEnemyVelocity = Vector3.zero
                tool:Activate()
                task.wait(HITBOX_DELAY)
                -- Reset lock timer so we keep tracking after their TP
                lockStart = tick()
            else
                local currentVelocity = enemyPart.AssemblyLinearVelocity
                local velocityDelta = (currentVelocity - lastEnemyVelocity)
                lastEnemyVelocity = currentVelocity
                
                local speed = currentVelocity.Magnitude
                
                -- Detect sharp direction changes (macro A-D spam)
                local directionChange = velocityDelta.Magnitude
                local isMacroing = directionChange > (speed * 0.6 + 5)
                
                -- When macroing, reduce prediction to near-zero so we snap to actual position
                local dynamicPScale
                if isMacroing then
                    dynamicPScale = 0.05
                else
                    dynamicPScale = (speed > 1) and math.clamp(BASE_PREDICTION + (speed * 0.007) / (1 + speed * 0.018), BASE_PREDICTION, BASE_PREDICTION + 0.38) or BASE_PREDICTION
                end
                
                -- Higher delta weight to react faster to direction reversals
                local deltaWeight = isMacroing and 0.25 or 0.15
                local prediction = (currentVelocity * dynamicPScale) + (velocityDelta * deltaWeight)
                local strikePoint = currentPos + prediction
                
                local lookDir = enemyPart.CFrame.LookVector
                root.CFrame = CFrame.lookAt(strikePoint + (lookDir * TP_DISTANCE), strikePoint)
                root.AssemblyLinearVelocity = Vector3.zero
                
                tool:Activate()
                task.wait(HITBOX_DELAY)
            end
        end

        -- Fire 10 extra hits to MAKE SURE they get knocked
        if enemyPart and enemyPart.Parent and enemyHum and enemyHum.Parent then
            for i = 1, 10 do
                if not enemyPart.Parent then break end
                root.CFrame = CFrame.lookAt(enemyPart.Position + (enemyPart.CFrame.LookVector * TP_DISTANCE), enemyPart.Position)
                root.AssemblyLinearVelocity = Vector3.zero
                tool:Activate()
                task.wait(HITBOX_DELAY)
            end
        end

        if shouldStomp and enemyHum and enemyPart and enemyPart.Parent and enemyHum.Health > 0 then
            clearPhysics(root)
            applySmartNoclip(false)
            
            -- Listen for kill sound to stop stomp early
            local stompDone = false
            local soundConn = enemyCharacter.DescendantAdded:Connect(function(desc)
                if desc:IsA("Sound") and desc.SoundId:find("124468602748905") then
                    stompDone = true
                end
            end)
            
            -- Stomp: position above torso and spam E
            local stompStart = tick()
            while tick() - stompStart < 3.5 do 
                if stompDone or commandCancelled or not enemyCharacter or not enemyCharacter.Parent or enemyHum.Health <= 0 then break end
                local stompTarget = enemyCharacter:FindFirstChild("UpperTorso") or enemyCharacter:FindFirstChild("Torso") or enemyCharacter:FindFirstChild("HumanoidRootPart")
                if not stompTarget then break end
                root.CFrame = CFrame.new(stompTarget.Position + Vector3.new(0, 2.5, 0))
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                for _, v in ipairs(enemyCharacter:GetDescendants()) do
                    if v:IsA("ProximityPrompt") then
                        fireproximityprompt(v)
                    end
                end
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(0.1)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                task.wait(0.1)
            end
            soundConn:Disconnect()
            applySmartNoclip(true)
            task.wait(0.1) 
        end

        isAttacking = false
        CombatExitTeleport()
        task.wait(ATTACK_REPEAT_DELAY)
    end

    -- Gun-based knock: equips AUG, expands target hitbox, shoots until knocked, then unequips
    local function performGunKnock(enemyCharacter, shouldStomp)
        if isAttacking or alreadyAttempted or not scriptRunning or commandCancelled then return end
        local enemyPlayer = Players:GetPlayerFromCharacter(enemyCharacter)
        if enemyPlayer and commandBlacklist[enemyPlayer.UserId] then return end
        -- Wait out forcefield (spawn protection)
        if hasForceField(enemyCharacter) then
            local ffWait = tick()
            while hasForceField(enemyCharacter) and tick() - ffWait < 5 do
                if not scriptRunning or commandCancelled then return end
                task.wait(0.3)
            end
            if not enemyCharacter or not enemyCharacter.Parent then return end
        end

        local enemyHum = enemyCharacter and enemyCharacter:FindFirstChild("Humanoid")
        local enemyRoot = enemyCharacter and enemyCharacter:FindFirstChild("HumanoidRootPart")
        if not enemyHum or not enemyRoot or enemyHum.Health <= KNOCK_THRESHOLD or isRagdolled(enemyCharacter) then return end

        isAttacking = true
        local char = worker.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not root then isAttacking = false return end

        -- Unequip ALL tools first to prevent dual-wield
        local toUnequip = {}
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Tool") then
                table.insert(toUnequip, obj)
            end
        end
        for _, tool in ipairs(toUnequip) do
            tool.Parent = worker.Backpack
        end
        task.wait(0.1)

        -- Find guns: AUG and Rifle for dual-wield
        local aug = nil
        local rifle = nil
        for _, item in ipairs(worker.Backpack:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name:lower()
                if not aug and (name == "aug" or name:find("aug")) then
                    aug = item
                elseif not rifle and (name == "rifle" or name:find("rifle")) then
                    rifle = item
                end
            end
        end
        if not aug and not rifle then isAttacking = false return end

        -- Skip pre-reload, go straight to shooting (reload happens after/during idle)
        clearPhysics(root)
        root.CFrame = CFrame.new(root.Position.X, FLY_HEIGHT, root.Position.Z)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        
        -- Equip first gun to start shooting
        if aug then
            aug.Parent = char
            if rifle and rifle.Parent == char then rifle.Parent = worker.Backpack end
        elseif rifle then
            rifle.Parent = char
        end
        task.wait(0.15)
        
        -- Wait briefly for line of sight — if target is indoors, the orbit loop handles it
        local ignoreChars = {char}
        if enemyCharacter then table.insert(ignoreChars, enemyCharacter) end
        local losWaitStart = tick()
        while tick() - losWaitStart < 3 do
            if not scriptRunning or commandCancelled then break end
            if not enemyRoot or not enemyRoot.Parent or not enemyHum or enemyHum.Health <= KNOCK_THRESHOLD or isRagdolled(enemyCharacter) then break end
            local checkFrom = enemyRoot.Position + Vector3.new(0, 30, 14)
            local checkTo = enemyRoot.Position
            if hasLineOfSight(checkFrom, checkTo, ignoreChars) then
                break
            end
            -- Also check from same height (indoor angle)
            local sideCheck = enemyRoot.Position + Vector3.new(8, 2, 0)
            if hasLineOfSight(sideCheck, checkTo, ignoreChars) then
                break
            end
            root.CFrame = CFrame.new(root.Position.X, FLY_HEIGHT, root.Position.Z)
            root.AssemblyLinearVelocity = Vector3.zero
            task.wait(0.3)
        end
        
        if not scriptRunning or commandCancelled or not enemyRoot or not enemyRoot.Parent or not enemyHum or enemyHum.Health <= KNOCK_THRESHOLD or isRagdolled(enemyCharacter) then
            if aug and aug.Parent == char then aug.Parent = worker.Backpack end
            if rifle and rifle.Parent == char then rifle.Parent = worker.Backpack end
            isAttacking = false
            CombatExitTeleport()
            return
        end

        -- Expand target hitbox
        if enemyRoot then
            enemyRoot.Size = Vector3.new(20, 20, 20)
            enemyRoot.CanCollide = false
            enemyRoot.Transparency = 0.7
            enemyRoot.Color = Color3.fromRGB(0, 0, 0)
            enemyRoot.Material = Enum.Material.Neon
        end

        local gunCamera = workspace.CurrentCamera
        local shotCount = 0
        local maxShots = 9999

        -- Orbit and shoot until knocked
        local gunOrbitAngle = 0
        local GUN_ORBIT_RADIUS = 14
        local GUN_ORBIT_HEIGHT = 30
        -- Indoor fallback: orbit slightly above target's hitbox height, closer range
        local INDOOR_ORBIT_RADIUS = 8
        local INDOOR_ORBIT_HEIGHT = 15
        applySmartNoclip(true)
        clearPhysics(root)
        while scriptRunning and not commandCancelled do
            -- Check if target left or character is gone
            if not enemyCharacter or not enemyCharacter.Parent then break end
            if not enemyHum or not enemyHum.Parent then break end
            if not enemyRoot or not enemyRoot.Parent then break end
            if enemyHum.Health <= KNOCK_THRESHOLD then break end
            if isRagdolled(enemyCharacter) then break end

            -- Unequip any stray tools (phone, etc) that snuck in
            for _, obj in ipairs(char:GetChildren()) do
                if obj:IsA("Tool") and obj ~= aug and obj ~= rifle then
                    obj.Parent = worker.Backpack
                end
            end

            gunOrbitAngle = gunOrbitAngle + 30 * (1/60)
            local tPos = enemyRoot.Position
            
            -- Try outdoor orbit first (high above)
            local ox = math.cos(gunOrbitAngle) * GUN_ORBIT_RADIUS
            local oz = math.sin(gunOrbitAngle) * GUN_ORBIT_RADIUS
            local outdoorPos = Vector3.new(tPos.X + ox, tPos.Y + GUN_ORBIT_HEIGHT, tPos.Z + oz)
            
            local orbitPos
            local hasLOS = hasLineOfSight(outdoorPos, tPos, ignoreChars)
            
            if hasLOS then
                -- Outdoor: orbit high above
                orbitPos = outdoorPos
            else
                -- Indoor: orbit at same height, close range (shoot through doors/windows)
                local ix = math.cos(gunOrbitAngle) * INDOOR_ORBIT_RADIUS
                local iz = math.sin(gunOrbitAngle) * INDOOR_ORBIT_RADIUS
                local indoorPos = Vector3.new(tPos.X + ix, tPos.Y + INDOOR_ORBIT_HEIGHT, tPos.Z + iz)
                
                -- Check if we can see them from this angle
                if hasLineOfSight(indoorPos, tPos, ignoreChars) then
                    orbitPos = indoorPos
                    hasLOS = true
                else
                    -- Try multiple angles at same height to find a gap (door/window)
                    local foundAngle = false
                    for probe = 1, 8 do
                        local probeAngle = gunOrbitAngle + (probe * math.pi / 4)
                        local px = math.cos(probeAngle) * INDOOR_ORBIT_RADIUS
                        local pz = math.sin(probeAngle) * INDOOR_ORBIT_RADIUS
                        local probePos = Vector3.new(tPos.X + px, tPos.Y + INDOOR_ORBIT_HEIGHT, tPos.Z + pz)
                        if hasLineOfSight(probePos, tPos, ignoreChars) then
                            orbitPos = probePos
                            hasLOS = true
                            foundAngle = true
                            break
                        end
                    end
                    if not foundAngle then
                        -- No angle works, just stay at indoor orbit and wait
                        orbitPos = indoorPos
                        hasLOS = false
                    end
                end
            end

            -- Face the target directly so shots connect
            root.CFrame = CFrame.lookAt(orbitPos, tPos)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero

            -- Only shoot if we have line of sight
            if hasLOS then
                -- Shoot with current gun, re-aiming each shot
                for burst = 1, 5 do
                    if not enemyRoot or not enemyRoot.Parent then break end
                    local freshPos = enemyRoot.Position
                    local screenPos, onScreen = gunCamera:WorldToScreenPoint(freshPos)
                    if onScreen and screenPos.Z > 0 then
                        VirtualInputManager:SendMouseMoveEvent(screenPos.X, screenPos.Y, game)
                        VirtualInputManager:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, true, game, 1)
                        VirtualInputManager:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, false, game, 1)
                    end
                    shotCount = shotCount + 1
                end

                -- Swap guns every 0.4 seconds (~120 shots at 60fps with 5 shots/frame)
                if aug and rifle and shotCount > 0 and shotCount % 120 == 0 then
                    local currentGun = (aug.Parent == char) and aug or rifle
                    local otherGun = (currentGun == aug) and rifle or aug
                    if otherGun then
                        currentGun.Parent = worker.Backpack
                        task.wait(0.1)
                        otherGun.Parent = char
                        task.wait(0.1)
                    end
                end
            end

            RunService.RenderStepped:Wait()
        end

        -- Fire 30 extra shots to MAKE SURE they get knocked
        if enemyRoot and enemyRoot.Parent and enemyHum and enemyHum.Parent and enemyCharacter and enemyCharacter.Parent then
            for i = 1, 30 do
                if not enemyRoot or not enemyRoot.Parent or not enemyCharacter or not enemyCharacter.Parent then break end
                local tPos = enemyRoot.Position
                local screenPos, onScreen = gunCamera:WorldToScreenPoint(tPos)
                if onScreen and screenPos.Z > 0 then
                    VirtualInputManager:SendMouseMoveEvent(screenPos.X, screenPos.Y, game)
                    VirtualInputManager:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, true, game, 1)
                    VirtualInputManager:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, false, game, 1)
                end
            end
        end

        -- Reset hitbox
        if enemyRoot and enemyRoot.Parent then
            enemyRoot.Size = Vector3.new(2, 2, 1)
            enemyRoot.CanCollide = false
            enemyRoot.Transparency = 1
            enemyRoot.Material = Enum.Material.SmoothPlastic
        end

        -- Unequip guns after shooting
        if aug and aug.Parent == char then
            aug.Parent = worker.Backpack
        end
        if rifle and rifle.Parent == char then
            rifle.Parent = worker.Backpack
        end
        task.wait(0.1)

        -- Stomp if needed (same as fist mode)
        if shouldStomp and enemyHum and enemyRoot and enemyRoot.Parent and enemyHum.Health > 0 then
            clearPhysics(root)
            applySmartNoclip(false)
            
            -- Listen for kill sound to stop stomp early
            local stompDone = false
            local soundConn = enemyCharacter.DescendantAdded:Connect(function(desc)
                if desc:IsA("Sound") and desc.SoundId:find("124468602748905") then
                    stompDone = true
                end
            end)
            
            -- Stomp: position above torso and spam E
            local stompStart = tick()
            while tick() - stompStart < 3.5 do
                if stompDone or commandCancelled or not enemyCharacter or not enemyCharacter.Parent or enemyHum.Health <= 0 then break end
                local stompTarget = enemyCharacter:FindFirstChild("UpperTorso") or enemyCharacter:FindFirstChild("Torso") or enemyCharacter:FindFirstChild("HumanoidRootPart")
                if not stompTarget then break end
                root.CFrame = CFrame.new(stompTarget.Position + Vector3.new(0, 2.5, 0))
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                for _, v in ipairs(enemyCharacter:GetDescendants()) do
                    if v:IsA("ProximityPrompt") then
                        fireproximityprompt(v)
                    end
                end
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(0.1)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                task.wait(0.1)
            end
            soundConn:Disconnect()
            applySmartNoclip(true)
            task.wait(0.1)
        end

        isAttacking = false
        CombatExitTeleport()
        task.wait(ATTACK_REPEAT_DELAY)
    end

