                    local tag = masterHum:FindFirstChild("creator")
                    if tag and tag:IsA("ObjectValue") and tag.Value and tag.Value:IsA("Player") then
                        attacker = tag.Value
                    end
                    
                    -- Find attacker by checking who is facing the master with a weapon
                    if not attacker and masterRoot then
                        local closestDist = math.huge
                        local bestCandidate = nil
                        
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p ~= masterObj and p ~= worker and p.Character then
                                local pChar = p.Character
                                local pRoot = pChar:FindFirstChild("HumanoidRootPart")
                                local tool = pChar:FindFirstChildOfClass("Tool")
                                
                                if pRoot and tool then
                                    local distance = (masterRoot.Position - pRoot.Position).Magnitude
                                    local isFist = (tool.Name == "Combat")
                                    local isGun = not isFist and tool.Name ~= "Combat"
                                    
                                    -- Check if they're facing the master (dot product of look vector toward master)
                                    local dirToMaster = (masterRoot.Position - pRoot.Position).Unit
                                    local lookDir = pRoot.CFrame.LookVector
                                    local facingScore = lookDir:Dot(dirToMaster)
                                    
                                    if isGun and distance < 200 and facingScore > 0.3 then
                                        -- Gun user facing master within range
                                        if distance < closestDist then
                                            closestDist = distance
                                            bestCandidate = p
                                        end
                                    elseif isFist and distance < 15 and facingScore > 0.4 then
                                        -- Fist user very close and facing master
                                        local pAnimator = pChar:FindFirstChildOfClass("Humanoid") and pChar.Humanoid:FindFirstChildOfClass("Animator")
                                        if pAnimator and #pAnimator:GetPlayingAnimationTracks() > 0 then
                                            if distance < closestDist then
                                                closestDist = distance
                                                bestCandidate = p
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        attacker = bestCandidate
                    end
                    
                    if attacker and attacker.Character and not commandBlacklist[attacker.UserId] then
                        local exists = false
                        for _, queued in ipairs(targetQueue) do
                            if queued == attacker then exists = true break end
                        end
                        if not exists then
                            combatMode = protectCombatMode
                            table.insert(targetQueue, attacker)
                            task.spawn(function() executeQueue("Knock") end)
                        end
                    end
                end
                lastHealth = masterHum.Health
            else
                lastHealth = 100
            end
            task.wait(0.01)
        end
    end)

