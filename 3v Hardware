    -- Line-of-sight check: returns true if there's a clear path between two positions (no walls)
    local function hasLineOfSight(fromPos, toPos, ignoreList)
        local direction = toPos - fromPos
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = ignoreList or {}
        rayParams.IgnoreWater = true
        local result = workspace:Raycast(fromPos, direction, rayParams)
        if result then
            -- Hit something — check if it's close to the target (within 5 studs means we can see them)
            local hitDist = (result.Position - toPos).Magnitude
            return hitDist < 5
        end
        -- No hit means clear line of sight
        return true
    end

