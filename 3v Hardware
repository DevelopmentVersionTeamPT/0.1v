    -- Check if a character is ragdolled/knocked (Da Hood compatible)
    local function isRagdolled(targetChar)
        if not targetChar then return false end
        if not targetChar.Parent then return false end
        local hum = targetChar:FindFirstChildOfClass("Humanoid")
        if not hum then return true end
        -- If they're sitting in a seat (car/chair), they're NOT ragdolled
        if hum.Sit or hum.SeatPart then return false end
        -- If being carried, NOT ragdolled (they have a weld to another player)
        local root = targetChar:FindFirstChild("HumanoidRootPart")
        if root then
            for _, child in ipairs(root:GetChildren()) do
                if child:IsA("Weld") or child:IsA("WeldConstraint") then
                    if child.Part1 and child.Part1.Parent ~= targetChar then
                        return false
                    end
                end
            end
        end
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.Dead then return true end
        if state == Enum.HumanoidStateType.Physics then return true end
        if state == Enum.HumanoidStateType.PlatformStanding then return true end
        if targetChar:FindFirstChild("Ragdoll") then return true end
        if targetChar:FindFirstChild("RagdollConstraint") then return true end
        if hum.PlatformStand then return true end
        -- Da Hood sets WalkSpeed to 0 when knocked — but only if not sitting and not carried
        if hum.WalkSpeed == 0 and hum.Health > 0 and state == Enum.HumanoidStateType.GettingUp then return true end
        return false
    end

