    local function handleSpam(target, isInfinite)
        if not scriptRunning or commandBlacklist[target.UserId] then
            return
        end

        local char = worker.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then
            return
        end

        local targetChar = target.Character
        local targetHum = targetChar and targetChar:FindFirstChild("Humanoid")

        local targetPart = targetChar and (
            targetChar:FindFirstChild("UpperTorso")
            or targetChar:FindFirstChild("Torso")
            or targetChar:FindFirstChild("HumanoidRootPart")
        )

        isSpamBusy = true
        applySmartNoclip(true)
        local lastSpamVelocity = Vector3.zero
        local lastSpamMoveDir = Vector3.new(0, 0, -1)
        local lastSpamUnderY = nil
        local SPAM_UNDER_DEPTH = 6
        local SPAM_DIR_OFFSET = 1.5

        local function isTargetJumping(trackPart, velocity)
            if not targetHum then return false end
            if velocity.Y > 2.5 then
                return true
            end
            local state = targetHum:GetState()
            if state == Enum.HumanoidStateType.Jumping then
                return true
            end
            if state == Enum.HumanoidStateType.Freefall and velocity.Y > 1 then
                return true
            end
            return false
        end

        local function getSpamUnderCFrame()
            local trackPart = (targetChar and targetChar:FindFirstChild("HumanoidRootPart")) or targetPart
            if not trackPart then return root.CFrame end
            local velocity = trackPart.AssemblyLinearVelocity
            local horizontalVel = Vector3.new(velocity.X, 0, velocity.Z)
            local speed = horizontalVel.Magnitude
            local rawDir = Vector3.zero

            if targetHum and targetHum.MoveDirection.Magnitude > 0.08 then
                rawDir = Vector3.new(targetHum.MoveDirection.X, 0, targetHum.MoveDirection.Z)
            elseif speed > 1.2 then
                rawDir = horizontalVel.Unit
            else
                rawDir = Vector3.new(trackPart.CFrame.LookVector.X, 0, trackPart.CFrame.LookVector.Z)
            end

            if rawDir.Magnitude < 0.05 then
                rawDir = lastSpamMoveDir
            else
                rawDir = rawDir.Unit
            end

            lastSpamMoveDir = lastSpamMoveDir:Lerp(rawDir, 0.75)
            if lastSpamMoveDir.Magnitude > 0.05 then
                lastSpamMoveDir = lastSpamMoveDir.Unit
            end

            local velocityDelta = velocity - lastSpamVelocity
            lastSpamVelocity = velocity
            local horizontalDelta = Vector3.new(velocityDelta.X, 0, velocityDelta.Z)
            local predScale = (speed > 1) and math.clamp(BASE_PREDICTION + (speed * 0.009) / (1 + speed * 0.018), BASE_PREDICTION, BASE_PREDICTION + 0.42) or BASE_PREDICTION
            local predictedPos = trackPart.Position + (horizontalVel * predScale) + (horizontalDelta * 0.15)
            local jumping = isTargetJumping(trackPart, velocity)
            local groundUnderY = trackPart.Position.Y - SPAM_UNDER_DEPTH

            if jumping then
                if not lastSpamUnderY then
                    lastSpamUnderY = groundUnderY
                end
            else
                lastSpamUnderY = groundUnderY
            end

            local underPos = Vector3.new(
                predictedPos.X + (lastSpamMoveDir.X * SPAM_DIR_OFFSET),
                lastSpamUnderY,
                predictedPos.Z + (lastSpamMoveDir.Z * SPAM_DIR_OFFSET)
            )
            local aimPoint = Vector3.new(predictedPos.X, lastSpamUnderY + SPAM_UNDER_DEPTH + 2, predictedPos.Z)
            local flatAim = Vector3.new(aimPoint.X - underPos.X, 0, aimPoint.Z - underPos.Z)

            if flatAim.Magnitude < 0.15 then
                return CFrame.new(underPos)
            end
            return CFrame.lookAt(underPos, aimPoint, Vector3.yAxis)
        end

        local function snapUnderTarget()
            root.CFrame = getSpamUnderCFrame()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end

        while scriptRunning and not commandCancelled do
            targetChar = target.Character
            targetHum = targetChar and targetChar:FindFirstChild("Humanoid")
            targetPart = targetChar and (targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("HumanoidRootPart"))

            if not targetPart or not targetHum or not targetHum.Parent or targetHum.Health < 1 then
                if isInfinite then
                    clearPhysics(root)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    task.wait(0.006)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                    task.wait(0.08)
                    continue
                else
                    break
                end
            end

            clearPhysics(root)

            local trackStart = tick()
            while tick() - trackStart < 0.06 do
                if commandCancelled or not targetPart.Parent or targetHum.Health < 1 then break end
                snapUnderTarget()
                RunService.Heartbeat:Wait()
            end

            if commandCancelled then
                break
            end

            if targetHum.Health >= 1 and targetPart.Parent then
                snapUnderTarget()

                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.006)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end

            local hitStart = tick()
            while tick() - hitStart < 0.08 do
                if commandCancelled or (not isInfinite and (not targetPart.Parent or targetHum.Health < 1)) then break end
                snapUnderTarget()
                RunService.Heartbeat:Wait()
            end
        end

        applySmartNoclip(true)
        isSpamBusy = false
        mode = "Idle"
        CombatExitTeleport()
    end

