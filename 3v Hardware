                while tick() - grabStart < 0.8 do
                    if not scriptRunning or mode ~= "Waiting" then break end
                    local targetPartLoop = target.Character:FindFirstChild("UpperTorso") or target.Character:FindFirstChild("Torso") or target.Character:FindFirstChild("HumanoidRootPart")
                    if targetPartLoop then
                        root.CFrame = CFrame.new(targetPartLoop.Position + Vector3.new(0, 0.8, 0))
                        root.AssemblyLinearVelocity = Vector3.zero
                    end
                    RunService.RenderStepped:Wait()
                end
                
                if mode == "Waiting" then
                    for i = 1, 3 do
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.G, false, game)
                        task.wait(0.05)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.G, false, game)
                        task.wait(0.05)
                    end
                    task.wait(0.2)
                    root.CFrame = CFrame.new(root.Position.X, FLY_HEIGHT, root.Position.Z)
                    task.wait(0.3)
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.G, false, game)
                    task.wait(0.1)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.G, false, game)
                end
            end
        end
        isDescending = false
        applySmartNoclip(true)
        mode = "Idle"
        CombatExitTeleport()
    end

    -- Snipe: hitbox expand one target, orbit + shoot with rifle, stop on death/ragdoll

    local Camera = workspace.CurrentCamera
    local snipePrevCameraSubject = nil
    local snipePrevCameraType = nil

    local function stopSnipe()
        if snipeConnection then
            snipeConnection:Disconnect()
            snipeConnection = nil
        end
        if snipeHitboxConnection then
            snipeHitboxConnection:Disconnect()
            snipeHitboxConnection = nil
        end
        -- Restore camera to the worker's humanoid
        if snipePrevCameraSubject then
            Camera.CameraSubject = snipePrevCameraSubject
            snipePrevCameraSubject = nil
        end
        if snipePrevCameraType then
            Camera.CameraType = snipePrevCameraType
            snipePrevCameraType = nil
        end
        -- Unequip: move tool back to backpack
        local char = worker.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                tool.Parent = worker.Backpack
            end
        end
        mode = "Idle"
        print("[Snipe] Ended – returning to Idle")
    end

    local function getRifleTool()
        -- Check backpack first
        for _, item in ipairs(worker.Backpack:GetChildren()) do
            if item:IsA("Tool") and item.Name:lower():find("aug") then
                return item
            end
        end
        -- Check if already equipped
        local char = worker.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and tool.Name:lower():find("aug") then
                return tool
            end
        end
        return nil
    end

    local function equipTool(tool)
        -- Parent directly into character to equip
        local char = worker.Character
        if not char then return false end
        if tool.Parent == char then return true end -- already equipped
        tool.Parent = char
        task.wait(0.1)
        return true
    end

    local function expandHitboxForTarget(targetChar)
        local hrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        hrp.Size = Vector3.new(20, 20, 20)
        hrp.CanCollide = false
        hrp.Transparency = 0.7
        hrp.Color = Color3.fromRGB(0, 0, 0)
        hrp.Material = Enum.Material.Neon
    end

    local function resetHitboxForTarget(targetChar)
        local hrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        hrp.Size = Vector3.new(2, 2, 1)
        hrp.CanCollide = true
        hrp.Transparency = 1
        hrp.Material = Enum.Material.SmoothPlastic
    end

    -- Project a world position to screen coords; returns (screenPos, onScreen)
    local function worldToScreen(worldPos)
        local screenPos, inBounds = Camera:WorldToScreenPoint(worldPos)
        return Vector2.new(screenPos.X, screenPos.Y), inBounds and screenPos.Z > 0
    end

    local function handleSnipe(target)
        if not scriptRunning or commandBlacklist[target.UserId] then return end
        if commandCancelled then return end

        -- Find and equip the rifle
        local rifle = getRifleTool()
        if not rifle then
            print("[Snipe] No AUG found in inventory")
            return
        end

        if not equipTool(rifle) then
            print("[Snipe] Failed to equip rifle")
            return
        end
        task.wait(0.25) -- let equip settle

        mode = "Snipe"

        local char = worker.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then stopSnipe() return end

        -- Point camera at the stand so the player can see what's happening
        snipePrevCameraSubject = Camera.CameraSubject
        snipePrevCameraType = Camera.CameraType
        Camera.CameraSubject = root
        Camera.CameraType = Enum.CameraType.Follow

        local orbitAngle = 0
        local ORBIT_HEIGHT = 15         -- studs above the target's head
        local ORBIT_RADIUS = 10         -- radius of the circle above them
        local ORBIT_SPEED = 50          -- radians per second (extremely fast orbit)
        local SHOOT_INTERVAL = 0.1      -- fire every 0.1 seconds (spam clicks)
        local RELOAD_TIME = 2.5         -- AUG reload animation time
        local MAG_SIZE = 30             -- AUG magazine capacity
        local shotsFired = 0
        local lastShot = tick() - SHOOT_INTERVAL -- fire immediately on first cycle
        local isReloading = false

        -- Continuous hitbox expansion on target only
        snipeHitboxConnection = RunService.RenderStepped:Connect(function()
            local tChar = target.Character
            if tChar then
                expandHitboxForTarget(tChar)
            end
        end)

        -- Orbit + shoot loop (blocks until snipe ends so executeQueue waits correctly)
        while scriptRunning and not commandCancelled and mode == "Snipe" do
            local tChar = target.Character
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")

            -- Stop condition: dead or ragdolled
            if not tChar or not tHum or tHum.Health < 1 or isRagdolled(tChar) then
                resetHitboxForTarget(tChar)
                stopSnipe()
                return
            end

            -- Keep camera on the stand
            Camera.CameraSubject = root

            -- Advance orbit angle each frame
            orbitAngle = orbitAngle + ORBIT_SPEED * (1/60)

            local targetPos = tRoot.Position
            local offsetX = math.cos(orbitAngle) * ORBIT_RADIUS
            local offsetZ = math.sin(orbitAngle) * ORBIT_RADIUS
            -- Orbit above the target's head
            local orbitPos = Vector3.new(targetPos.X + offsetX, targetPos.Y + ORBIT_HEIGHT, targetPos.Z + offsetZ)

            -- Calculate forward direction (tangent to the circle = direction of movement)
            local forwardX = -math.sin(orbitAngle)
            local forwardZ = math.cos(orbitAngle)
            local forwardPoint = orbitPos + Vector3.new(forwardX, 0, forwardZ)

            -- Position stand at orbit point, facing forward (movement direction)
            clearPhysics(root)
            root.CFrame = CFrame.lookAt(orbitPos, forwardPoint)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero

            -- Shoot every 1.25 seconds (skip if still reloading)
            if not isReloading and tick() - lastShot >= SHOOT_INTERVAL then
                lastShot = tick()

                -- Aim mouse directly at the target's HumanoidRootPart (center of character)
                local screenPos, onScreen = worldToScreen(targetPos)

                if onScreen then
                    VirtualInputManager:SendMouseMoveEvent(screenPos.X, screenPos.Y, game)
                    task.wait(0.03)
                    VirtualInputManager:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, true, game, 1)
                    task.wait(0.07)
                    VirtualInputManager:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, false, game, 1)
                else
                    local vp = Camera.ViewportSize
                    local cx, cy = vp.X / 2, vp.Y / 2
                    VirtualInputManager:SendMouseMoveEvent(cx, cy, game)
                    task.wait(0.03)
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                    task.wait(0.07)
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                end

                -- Track shots and reload after full mag
                shotsFired = shotsFired + 1
                if shotsFired >= MAG_SIZE then
                    isReloading = true
                    -- Go to idle height during reload so we can't get shot
                    clearPhysics(root)
                    root.CFrame = CFrame.new(root.Position.X, FLY_HEIGHT, root.Position.Z)
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    task.spawn(function()
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                        task.wait(0.02)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                        task.wait(RELOAD_TIME)
                        shotsFired = 0
                        isReloading = false
                    end)
                end
            end

            RunService.RenderStepped:Wait()
        end

        -- Exited loop cleanly (cancel or mode change)
        if mode == "Snipe" then
            stopSnipe()
        end
    end

    local function executeQueue(cmdType, extraData)
        while #targetQueue > 0 and scriptRunning and not commandCancelled do
            local currentTarget = targetQueue[1]
            table.remove(targetQueue, 1)
            targetPlayer = currentTarget
            isAttacking = false
            alreadyAttempted = false
            if cmdType == "Kill" or cmdType == "K" then performKnock(currentTarget.Character, true)
            elseif cmdType == "Knock" or cmdType == "Kn" then performKnock(currentTarget.Character, false)
            elseif cmdType == "Bring" or cmdType == "B" then handleBring(currentTarget)
            elseif cmdType == "Void" or cmdType == "V" then handleVoid(currentTarget)
            elseif cmdType == "Safe" or cmdType == "S" then handleSafe(currentTarget)
            elseif cmdType == "Autosafe" then handleSafe(currentTarget)
            elseif cmdType == "Hold" or cmdType == "H" then handleHold(currentTarget)
            elseif cmdType == "Loopknock" or cmdType == "Autoknock" then
                while scriptRunning and not commandCancelled do
                    local tChar = currentTarget.Character
                    local tHum = tChar and tChar:FindFirstChild("Humanoid")
                    if tChar and tHum and tHum.Health > KNOCK_THRESHOLD and not isRagdolled(tChar) and not hasForceField(tChar) then
                        isAttacking = false
                        alreadyAttempted = false
                        performKnock(tChar, false)
                    end
                    task.wait(0.5)
                end
            elseif cmdType == "Loopkill" or cmdType == "Autokill" then
                while scriptRunning and not commandCancelled do
                    local tChar = currentTarget.Character
                    local tHum = tChar and tChar:FindFirstChild("Humanoid")
                    if tChar and tHum and tHum.Health > KNOCK_THRESHOLD and not isRagdolled(tChar) and not hasForceField(tChar) then
                        isAttacking = false
                        alreadyAttempted = false
                        performKnock(tChar, true)
                    end
                    task.wait(0.5)
                end
            elseif cmdType == "Sky" then handleSky(currentTarget)
            elseif cmdType == "Snipe" then handleSnipe(currentTarget)
            elseif cmdType == "LocationBring" then handleLocationBring(currentTarget, extraData) end
            isAttacking = false
            isDescending = false
            alreadyAttempted = false
            task.wait(0.1)
        end
        if mode ~= "Summoned" and mode ~= "Waiting" and mode ~= "Snipe" then mode = "Idle" end
        targetPlayer = nil
    end

    -- Real-Time Damage Signature Interceptor (100% Attacker Verification Loop)
    task.spawn(function()
