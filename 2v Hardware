    -- Check if a character is ragdolled/knocked (Da Hood compatible)
    local function isRagdolled(targetChar)
        if not targetChar then return false end
        if not targetChar.Parent then return false end
        local hum = targetChar:FindFirstChildOfClass("Humanoid")
        if not hum then return true end
        -- If they're sitting in a seat, they're NOT ragdolled
        if hum.Sit or hum.SeatPart then return false end
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.Dead then return true end
        if state == Enum.HumanoidStateType.Physics then return true end
        if state == Enum.HumanoidStateType.PlatformStanding then return true end
        if targetChar:FindFirstChild("Ragdoll") then return true end
        if targetChar:FindFirstChild("RagdollConstraint") then return true end
        if hum.PlatformStand then return true end
        -- Da Hood sets WalkSpeed to 0 when knocked
        if hum.WalkSpeed == 0 and hum.Health > 0 then return true end
        return false
    end

    local function performGhostStrike(enemyCharacter, shouldStomp)
        if isAttacking or alreadyAttempted or not scriptRunning or commandCancelled then return end
        local enemyPlayer = Players:GetPlayerFromCharacter(enemyCharacter)
        if enemyPlayer and commandBlacklist[enemyPlayer.UserId] then return end 
        
        isAttacking = true
        local char = worker.Character
        if not char then isAttacking = false return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local enemyHum = enemyCharacter and enemyCharacter:FindFirstChild("Humanoid")
        local enemyPart = enemyCharacter and (enemyCharacter:FindFirstChild("UpperTorso") or enemyCharacter:FindFirstChild("Torso") or enemyCharacter:FindFirstChild("HumanoidRootPart"))
        
        if not root or not enemyPart or not enemyHum or enemyHum.Health <= KNOCK_THRESHOLD or isRagdolled(enemyCharacter) then 
            isAttacking = false 
            return 
        end
        
        local tool = getCombatTool(char)
        if not tool then isAttacking = false return end
        
        local securePos = root.CFrame
        local windupStart = tick()
        while tick() - windupStart < FAKE_WINDUP_DELAY do
            if not scriptRunning or commandCancelled or alreadyAttempted or not enemyHum or enemyHum.Health <= KNOCK_THRESHOLD or isRagdolled(enemyCharacter) then break end
            root.CFrame = securePos
            root.AssemblyLinearVelocity = Vector3.zero
            tool:Activate()
            RunService.RenderStepped:Wait()
        end

        clearPhysics(root)
        local lockStart = tick()
        lastEnemyVelocity = enemyPart.AssemblyLinearVelocity
        local lastEnemyPosition = enemyPart.Position
        
        while tick() - lockStart < STICK_DURATION do
            if not scriptRunning or commandCancelled or alreadyAttempted or not enemyPart.Parent or enemyHum.Health <= KNOCK_THRESHOLD or isRagdolled(enemyCharacter) then break end
            
            local currentPos = enemyPart.Position
            local posDelta = (currentPos - lastEnemyPosition).Magnitude
            lastEnemyPosition = currentPos
            
            -- Detect teleport: if position jumped more than 50 studs in one frame, snap directly
            if posDelta > 50 then
                root.CFrame = CFrame.lookAt(currentPos + Vector3.new(0, 0, TP_DISTANCE), currentPos)
                root.AssemblyLinearVelocity = Vector3.zero
                lastEnemyVelocity = Vector3.zero
                tool:Activate()
                task.wait(HITBOX_DELAY)
                -- Reset lock timer so we keep tracking after their TP
                lockStart = tick()
            else
                local currentVelocity = enemyPart.AssemblyLinearVelocity
                local velocityDelta = (currentVelocity - lastEnemyVelocity)
                lastEnemyVelocity = currentVelocity
                
                local speed = currentVelocity.Magnitude
                
                -- Detect sharp direction changes (macro A-D spam)
                local directionChange = velocityDelta.Magnitude
                local isMacroing = directionChange > (speed * 0.6 + 5)
                
                -- When macroing, reduce prediction to near-zero so we snap to actual position
                local dynamicPScale
                if isMacroing then
                    dynamicPScale = 0.05
                else
                    dynamicPScale = (speed > 1) and math.clamp(BASE_PREDICTION + (speed * 0.007) / (1 + speed * 0.018), BASE_PREDICTION, BASE_PREDICTION + 0.38) or BASE_PREDICTION
                end
                
                -- Higher delta weight to react faster to direction reversals
                local deltaWeight = isMacroing and 0.25 or 0.15
                local prediction = (currentVelocity * dynamicPScale) + (velocityDelta * deltaWeight)
                local strikePoint = currentPos + prediction
                
                local lookDir = enemyPart.CFrame.LookVector
                root.CFrame = CFrame.lookAt(strikePoint + (lookDir * TP_DISTANCE), strikePoint)
                root.AssemblyLinearVelocity = Vector3.zero
                
                tool:Activate()
                task.wait(HITBOX_DELAY)
            end
        end

        -- Fire 10 extra hits to MAKE SURE they get knocked
        if enemyPart and enemyPart.Parent and enemyHum and enemyHum.Parent then
            for i = 1, 10 do
                if not enemyPart.Parent then break end
                root.CFrame = CFrame.lookAt(enemyPart.Position + (enemyPart.CFrame.LookVector * TP_DISTANCE), enemyPart.Position)
                root.AssemblyLinearVelocity = Vector3.zero
                tool:Activate()
                task.wait(HITBOX_DELAY)
            end
        end

        if shouldStomp and enemyHum and enemyPart and enemyPart.Parent and enemyHum.Health > 0 then
            clearPhysics(root)
            applySmartNoclip(false)
            
            -- Brief hover to register above them
            local hoverStart = tick()
            while tick() - hoverStart < 0.3 do
                if commandCancelled or not enemyPart.Parent or enemyHum.Health <= 0 then break end
                root.CFrame = CFrame.new(enemyPart.Position + Vector3.new(0, 3, 0))
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                RunService.RenderStepped:Wait()
            end

            -- Stomp: stay on top and spam E
            local stompStart = tick()
            while tick() - stompStart < 2.5 do 
                if commandCancelled or not enemyPart.Parent or enemyHum.Health <= 0 then break end
                root.CFrame = CFrame.new(enemyPart.Position + Vector3.new(0, 1.3, 0))
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(0.06)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                RunService.RenderStepped:Wait()
            end
            task.wait(0.1) 
            applySmartNoclip(true)
        end

        isAttacking = false
        CombatExitTeleport()
        task.wait(ATTACK_REPEAT_DELAY)
    end

    -- Gun-based knock: equips AUG, expands target hitbox, shoots until knocked, then unequips
    local function performGunKnock(enemyCharacter, shouldStomp)
        if isAttacking or alreadyAttempted or not scriptRunning or commandCancelled then return end
        local enemyPlayer = Players:GetPlayerFromCharacter(enemyCharacter)
        if enemyPlayer and commandBlacklist[enemyPlayer.UserId] then return end

        local enemyHum = enemyCharacter and enemyCharacter:FindFirstChild("Humanoid")
        local enemyRoot = enemyCharacter and enemyCharacter:FindFirstChild("HumanoidRootPart")
        if not enemyHum or not enemyRoot or enemyHum.Health <= KNOCK_THRESHOLD or isRagdolled(enemyCharacter) then return end

        isAttacking = true
        local char = worker.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not root then isAttacking = false return end

        -- Unequip ALL tools first to prevent dual-wield
        local toUnequip = {}
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Tool") then
                table.insert(toUnequip, obj)
            end
        end
        for _, tool in ipairs(toUnequip) do
            tool.Parent = worker.Backpack
        end
        task.wait(0.1)

        -- Find AUG specifically by checking for gun-type tool
        local aug = nil
        for _, item in ipairs(worker.Backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name:lower() == "aug" or item.Name:lower():find("aug")) then
                aug = item
                break
            end
        end
        if not aug then isAttacking = false return end

        -- Equip ONLY the AUG
        aug.Parent = char
        task.wait(0.15)
        
        -- Double-check: unequip anything else that snuck in
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Tool") and obj ~= aug then
                obj.Parent = worker.Backpack
            end
        end

        -- Auto-reload before shooting to ensure full mag
        clearPhysics(root)
        root.CFrame = CFrame.new(root.Position.X, FLY_HEIGHT, root.Position.Z)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
        task.wait(0.02)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
        task.wait(2.5)

        -- Expand target hitbox
        if enemyRoot then
            enemyRoot.Size = Vector3.new(20, 20, 20)
            enemyRoot.CanCollide = false
            enemyRoot.Transparency = 0.7
            enemyRoot.Color = Color3.fromRGB(0, 0, 0)
            enemyRoot.Material = Enum.Material.Neon
        end

        local gunCamera = workspace.CurrentCamera
        local shotCount = 0
        local maxShots = 90

        -- Orbit and shoot until knocked (tight orbit for indoor compatibility)
        local gunOrbitAngle = 0
        local GUN_ORBIT_RADIUS = 14
        local GUN_ORBIT_HEIGHT = 30
        applySmartNoclip(true)
        clearPhysics(root)
        while scriptRunning and not commandCancelled do
            -- Check if target left or character is gone
            if not enemyCharacter or not enemyCharacter.Parent then break end
            if not enemyHum or not enemyHum.Parent then break end
            if not enemyRoot or not enemyRoot.Parent then break end
            if enemyHum.Health <= KNOCK_THRESHOLD then break end
            if isRagdolled(enemyCharacter) then break end

            gunOrbitAngle = gunOrbitAngle + 50 * (1/60)
            local tPos = enemyRoot.Position
            local ox = math.cos(gunOrbitAngle) * GUN_ORBIT_RADIUS
            local oz = math.sin(gunOrbitAngle) * GUN_ORBIT_RADIUS
            local orbitPos = Vector3.new(tPos.X + ox, tPos.Y + GUN_ORBIT_HEIGHT, tPos.Z + oz)

            -- Face the target directly so shots connect
            root.CFrame = CFrame.lookAt(orbitPos, tPos)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero

            -- Aim and shoot
            local screenPos, onScreen = gunCamera:WorldToScreenPoint(tPos)
            if onScreen and screenPos.Z > 0 then
                VirtualInputManager:SendMouseMoveEvent(screenPos.X, screenPos.Y, game)
                task.wait(0.02)
                VirtualInputManager:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, true, game, 1)
                task.wait(0.03)
                VirtualInputManager:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, false, game, 1)
            end

            shotCount = shotCount + 1
            if shotCount >= maxShots then
                -- Reload: go to idle height so we can't get shot
                root.CFrame = CFrame.new(root.Position.X, FLY_HEIGHT, root.Position.Z)
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                task.wait(0.02)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                task.wait(2.5)
                shotCount = 0
            end

            RunService.RenderStepped:Wait()
        end

        -- Fire 10 extra shots to MAKE SURE they get knocked
        if enemyRoot and enemyRoot.Parent and enemyHum and enemyHum.Parent and enemyCharacter and enemyCharacter.Parent then
            for i = 1, 10 do
                if not enemyRoot or not enemyRoot.Parent or not enemyCharacter or not enemyCharacter.Parent then break end
                local tPos = enemyRoot.Position
                local screenPos, onScreen = gunCamera:WorldToScreenPoint(tPos)
                if onScreen and screenPos.Z > 0 then
                    VirtualInputManager:SendMouseMoveEvent(screenPos.X, screenPos.Y, game)
                    task.wait(0.02)
                    VirtualInputManager:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, true, game, 1)
                    task.wait(0.03)
                    VirtualInputManager:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, false, game, 1)
                end
            end
        end

        -- Reset hitbox
        if enemyRoot and enemyRoot.Parent then
            enemyRoot.Size = Vector3.new(2, 2, 1)
            enemyRoot.CanCollide = false
            enemyRoot.Transparency = 1
            enemyRoot.Material = Enum.Material.SmoothPlastic
        end

        -- Unequip AUG and re-equip Combat for grab compatibility
        if aug and aug.Parent == char then
            aug.Parent = worker.Backpack
        end
        task.wait(0.1)
        local combatTool = worker.Backpack:FindFirstChild("Combat")
        if combatTool then
            combatTool.Parent = char
        end

        -- Stomp if needed (same as fist mode)
        if shouldStomp and enemyHum and enemyRoot and enemyRoot.Parent and enemyHum.Health > 0 then
            clearPhysics(root)
            applySmartNoclip(false)
            
            -- Brief hover to register above them
            local hoverStart = tick()
            while tick() - hoverStart < 0.3 do
                if commandCancelled or not enemyRoot.Parent or enemyHum.Health <= 0 then break end
                root.CFrame = CFrame.new(enemyRoot.Position + Vector3.new(0, 3, 0))
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                RunService.RenderStepped:Wait()
            end

            -- Stomp: stay on top and spam E
            local stompStart = tick()
            while tick() - stompStart < 2.5 do
                if commandCancelled or not enemyRoot.Parent or enemyHum.Health <= 0 then break end
                root.CFrame = CFrame.new(enemyRoot.Position + Vector3.new(0, 1.3, 0))
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(0.06)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                RunService.RenderStepped:Wait()
            end
            task.wait(0.1)
            applySmartNoclip(true)
        end

        isAttacking = false
        CombatExitTeleport()
        task.wait(ATTACK_REPEAT_DELAY)
    end

    -- Unified knock function that picks fist or gun based on combatMode
    local function performKnock(enemyCharacter, shouldStomp)
        if combatMode == "gun" then
            performGunKnock(enemyCharacter, shouldStomp)
        else
            performGhostStrike(enemyCharacter, shouldStomp)
        end
    end

    local function handleSpam(target, isInfinite)
        if not scriptRunning or commandBlacklist[target.UserId] then
            return
        end

        local char = worker.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then
            return
        end

        local targetChar = target.Character
        local targetHum = targetChar and targetChar:FindFirstChild("Humanoid")

        local targetPart = targetChar and (
            targetChar:FindFirstChild("UpperTorso")
            or targetChar:FindFirstChild("Torso")
            or targetChar:FindFirstChild("HumanoidRootPart")
        )

        isSpamBusy = true
        applySmartNoclip(true)
        local lastSpamVelocity = Vector3.zero
        local lastSpamMoveDir = Vector3.new(0, 0, -1)
        local lastSpamUnderY = nil
        local SPAM_UNDER_DEPTH = 6
        local SPAM_DIR_OFFSET = 1.5

        local function isTargetJumping(trackPart, velocity)
            if not targetHum then return false end
            if velocity.Y > 2.5 then
                return true
            end
            local state = targetHum:GetState()
            if state == Enum.HumanoidStateType.Jumping then
                return true
            end
            if state == Enum.HumanoidStateType.Freefall and velocity.Y > 1 then
                return true
            end
            return false
        end

        local function getSpamUnderCFrame()
            local trackPart = (targetChar and targetChar:FindFirstChild("HumanoidRootPart")) or targetPart
            if not trackPart then return root.CFrame end
            local velocity = trackPart.AssemblyLinearVelocity
            local horizontalVel = Vector3.new(velocity.X, 0, velocity.Z)
            local speed = horizontalVel.Magnitude
            local rawDir = Vector3.zero

            if targetHum and targetHum.MoveDirection.Magnitude > 0.08 then
                rawDir = Vector3.new(targetHum.MoveDirection.X, 0, targetHum.MoveDirection.Z)
            elseif speed > 1.2 then
                rawDir = horizontalVel.Unit
            else
                rawDir = Vector3.new(trackPart.CFrame.LookVector.X, 0, trackPart.CFrame.LookVector.Z)
            end

            if rawDir.Magnitude < 0.05 then
                rawDir = lastSpamMoveDir
            else
                rawDir = rawDir.Unit
            end

            lastSpamMoveDir = lastSpamMoveDir:Lerp(rawDir, 0.75)
            if lastSpamMoveDir.Magnitude > 0.05 then
                lastSpamMoveDir = lastSpamMoveDir.Unit
            end

            local velocityDelta = velocity - lastSpamVelocity
            lastSpamVelocity = velocity
            local horizontalDelta = Vector3.new(velocityDelta.X, 0, velocityDelta.Z)
            local predScale = (speed > 1) and math.clamp(BASE_PREDICTION + (speed * 0.009) / (1 + speed * 0.018), BASE_PREDICTION, BASE_PREDICTION + 0.42) or BASE_PREDICTION
            local predictedPos = trackPart.Position + (horizontalVel * predScale) + (horizontalDelta * 0.15)
            local jumping = isTargetJumping(trackPart, velocity)
            local groundUnderY = trackPart.Position.Y - SPAM_UNDER_DEPTH

            if jumping then
                if not lastSpamUnderY then
                    lastSpamUnderY = groundUnderY
                end
            else
                lastSpamUnderY = groundUnderY
            end

            local underPos = Vector3.new(
                predictedPos.X + (lastSpamMoveDir.X * SPAM_DIR_OFFSET),
                lastSpamUnderY,
                predictedPos.Z + (lastSpamMoveDir.Z * SPAM_DIR_OFFSET)
            )
            local aimPoint = Vector3.new(predictedPos.X, lastSpamUnderY + SPAM_UNDER_DEPTH + 2, predictedPos.Z)
            local flatAim = Vector3.new(aimPoint.X - underPos.X, 0, aimPoint.Z - underPos.Z)

            if flatAim.Magnitude < 0.15 then
                return CFrame.new(underPos)
            end
            return CFrame.lookAt(underPos, aimPoint, Vector3.yAxis)
        end

        local function snapUnderTarget()
            root.CFrame = getSpamUnderCFrame()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end

        while scriptRunning and not commandCancelled do
            targetChar = target.Character
            targetHum = targetChar and targetChar:FindFirstChild("Humanoid")
            targetPart = targetChar and (targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("HumanoidRootPart"))

            if not targetPart or not targetHum or not targetHum.Parent or targetHum.Health < 1 then
                if isInfinite then
                    clearPhysics(root)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    task.wait(0.006)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                    task.wait(0.08)
                    continue
                else
                    break
                end
            end

            clearPhysics(root)

            local trackStart = tick()
            while tick() - trackStart < 0.06 do
                if commandCancelled or not targetPart.Parent or targetHum.Health < 1 then break end
                snapUnderTarget()
                RunService.Heartbeat:Wait()
            end

            if commandCancelled then
                break
            end

            if targetHum.Health >= 1 and targetPart.Parent then
                snapUnderTarget()

                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.006)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end

            local hitStart = tick()
            while tick() - hitStart < 0.08 do
                if commandCancelled or (not isInfinite and (not targetPart.Parent or targetHum.Health < 1)) then break end
                snapUnderTarget()
                RunService.Heartbeat:Wait()
            end
        end

        applySmartNoclip(true)
        isSpamBusy = false
        mode = "Idle"
        CombatExitTeleport()
    end

