local function getClosestPlayerToCursor()
    local closest = nil
    local closestDist = math.huge
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local screenPos, onScreen = Camera:WorldToScreenPoint(root.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

local function getTargetPart(char)
    if targetMode == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    else
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    end
end

table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if waitingForKeybind then
        LOCK_KEYBIND = input.KeyCode
        kbButton.Text = input.KeyCode.Name
        waitingForKeybind = false
        return
    end

    if waitingForGuiKeybind then
        GUI_TOGGLE_KEY = input.KeyCode
        guiKbButton.Text = input.KeyCode.Name
        waitingForGuiKeybind = false
        return
    end

    if input.KeyCode == GUI_TOGGLE_KEY then
        MainFrame.Visible = not MainFrame.Visible
        return
    end

    if input.KeyCode == LOCK_KEYBIND then
        if lockedTarget then
            if hitboxEnabled and lockedTarget.Character then
                local root = lockedTarget.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    root.Size = Vector3.new(2, 2, 1)
                    root.Transparency = 1
                    root.CanCollide = false
                    root.Material = Enum.Material.SmoothPlastic
                end
            end
            lockedTarget = nil
        else
            local target = getClosestPlayerToCursor()
            if target then
                lockedTarget = target
            end
        end
    end
end))

table.insert(connections, RunService.RenderStepped:Connect(function()
    if not scriptActive then return end

    if lockedTarget and lockedTarget.Character and hitboxEnabled then
        local root = lockedTarget.Character:FindFirstChild("HumanoidRootPart")
        if root then
            root.Size = HITBOX_SIZE
            root.CanCollide = false
            if hitboxShape == "Sphere" then
                root.Shape = Enum.PartType.Ball
            elseif hitboxShape == "Cylinder" then
                root.Shape = Enum.PartType.Cylinder
            else
                root.Shape = Enum.PartType.Block
            end
            if hitboxVisible and hitboxOpacity > 0 then
                root.Transparency = 1 - (hitboxOpacity / 10)
                root.Color = hitboxColor
                root.Material = Enum.Material.SmoothPlastic
            else
                root.Transparency = 1
            end
        end
    end

    if not lockedTarget then return end
    local char = lockedTarget.Character
    if not char then
        lockedTarget = nil
        return
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local part = getTargetPart(char)
    if not part or not hum or hum.Health <= 0 then
        if hitboxEnabled then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                root.Size = Vector3.new(2, 2, 1)
                root.Transparency = 1
                root.CanCollide = false
                root.Material = Enum.Material.SmoothPlastic
            end
        end
        lockedTarget = nil
        return
    end

    if camLockEnabled then
        local camPos = Camera.CFrame.Position
        Camera.CFrame = CFrame.lookAt(camPos, part.Position)
    end
end))

