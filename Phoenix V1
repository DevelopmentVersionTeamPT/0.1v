local function getClosestPlayerToCursor()
    local closest = nil
    local closestDist = math.huge
    local mousePos
    if isMobile then
        local viewportSize = Camera.ViewportSize
        mousePos = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    else
        mousePos = UserInputService:GetMouseLocation()
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local screenPos, onScreen = Camera:WorldToScreenPoint(root.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < fovRadius and dist < closestDist then
                        closestDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

local function getTargetPart(char)
    if targetMode == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    else
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    end
end

table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if waitingForKeybind then
        LOCK_KEYBIND = input.KeyCode
        kbButton.Text = input.KeyCode.Name
        waitingForKeybind = false
        return
    end

    if waitingForGuiKeybind then
        GUI_TOGGLE_KEY = input.KeyCode
        guiKbButton.Text = input.KeyCode.Name
        waitingForGuiKeybind = false
        return
    end

    if input.KeyCode == GUI_TOGGLE_KEY then
        MainFrame.Visible = not MainFrame.Visible
        return
    end

    if input.KeyCode == LOCK_KEYBIND then
        if lockedTarget then
            if lockFeedbackEnabled then
                local name = (espNameMode == "Display") and lockedTarget.DisplayName or lockedTarget.Name
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "Unlocked",
                    Text = "You Unlocked From " .. name,
                    Duration = 2
                })
            end
            if hitboxEnabled and lockedTarget.Character then
                local root = lockedTarget.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    root.Size = Vector3.new(2, 2, 1)
                    root.Transparency = 1
                    root.CanCollide = false
                    root.Material = Enum.Material.SmoothPlastic
                end
            end
            lockedTarget = nil
        else
            local target = getClosestPlayerToCursor()
            if target then
                lockedTarget = target
                if lockFeedbackEnabled then
                    local name = (espNameMode == "Display") and target.DisplayName or target.Name
                    game:GetService("StarterGui"):SetCore("SendNotification", {
                        Title = "Locked",
                        Text = "You Locked Onto " .. name,
                        Duration = 2
                    })
                end
            end
        end
    end
end))

