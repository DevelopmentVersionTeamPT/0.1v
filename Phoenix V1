                        end
                    else
                        obj.tracer.Visible = false
                    end
                else
                    if obj.tracer then obj.tracer:Remove() obj.tracer = nil end
                end

                -- Box ESP
                if boxEspEnabled and hasDrawing then
                    if not obj.boxOutline then
                        local outline = Drawing.new("Quad")
                        outline.Visible = false
                        outline.Color = boxEspColor
                        outline.Thickness = 1
                        outline.Filled = false
                        obj.boxOutline = outline
                    end
                    obj.boxOutline.Color = boxEspColor
                    local rootPos = root.Position
                    local rootSize = char:GetExtentsSize()
                    local half = rootSize / 2

                    local corners = {
                        Camera:WorldToViewportPoint(rootPos + Vector3.new(-half.X, half.Y, 0)),
                        Camera:WorldToViewportPoint(rootPos + Vector3.new(half.X, half.Y, 0)),
                        Camera:WorldToViewportPoint(rootPos + Vector3.new(half.X, -half.Y, 0)),
                        Camera:WorldToViewportPoint(rootPos + Vector3.new(-half.X, -half.Y, 0)),
                    }
                    local allOnScreen = true
                    for _, c in ipairs(corners) do
                        if not select(2, Camera:WorldToViewportPoint(rootPos + Vector3.new(0, 0, 0))) then
                            allOnScreen = false
                            break
                        end
                    end

                    if allOnScreen then
                        local topLeft = Camera:WorldToViewportPoint(rootPos + Vector3.new(0, half.Y, 0))
                        local bottomRight = Camera:WorldToViewportPoint(rootPos + Vector3.new(0, -half.Y, 0))
                        local height = math.abs(topLeft.Y - bottomRight.Y)
                        local width = height * 0.6

                        local centerX = topLeft.X
                        local topY = topLeft.Y
                        local botY = bottomRight.Y

                        obj.boxOutline.PointA = Vector2.new(centerX - width / 2, topY)
                        obj.boxOutline.PointB = Vector2.new(centerX + width / 2, topY)
                        obj.boxOutline.PointC = Vector2.new(centerX + width / 2, botY)
                        obj.boxOutline.PointD = Vector2.new(centerX - width / 2, botY)
                        obj.boxOutline.Visible = true
                    else
                        obj.boxOutline.Visible = false
                    end
                else
                    if obj.boxOutline then obj.boxOutline:Remove() obj.boxOutline = nil end
                end

                -- Skeleton ESP
                if skeletonEnabled and hasDrawing then
                    local joints = {
                        {"Head", "UpperTorso"},
                        {"UpperTorso", "LowerTorso"},
                        {"UpperTorso", "LeftUpperArm"},
                        {"LeftUpperArm", "LeftLowerArm"},
                        {"LeftLowerArm", "LeftHand"},
                        {"UpperTorso", "RightUpperArm"},
                        {"RightUpperArm", "RightLowerArm"},
                        {"RightLowerArm", "RightHand"},
                        {"LowerTorso", "LeftUpperLeg"},
                        {"LeftUpperLeg", "LeftLowerLeg"},
                        {"LeftLowerLeg", "LeftFoot"},
                        {"LowerTorso", "RightUpperLeg"},
                        {"RightUpperLeg", "RightLowerLeg"},
                        {"RightLowerLeg", "RightFoot"},
                    }
                    -- R6 fallback
                    local isR15 = char:FindFirstChild("UpperTorso") ~= nil
                    if not isR15 then
                        joints = {
                            {"Head", "Torso"},
                            {"Torso", "Left Arm"},
                            {"Torso", "Right Arm"},
                            {"Torso", "Left Leg"},
                            {"Torso", "Right Leg"},
                        }
                    end

                    if not obj.skeleton then
                        obj.skeleton = {}
                    end

                    for i, joint in ipairs(joints) do
                        if not obj.skeleton[i] then
                            local line = Drawing.new("Line")
                            line.Visible = false
                            line.Color = skeletonColor
                            line.Thickness = 1
                            line.Transparency = 0.9
                            obj.skeleton[i] = line
                        end

                        local part1 = char:FindFirstChild(joint[1])
                        local part2 = char:FindFirstChild(joint[2])
                        if part1 and part2 then
                            local p1, onScreen1 = Camera:WorldToViewportPoint(part1.Position)
                            local p2, onScreen2 = Camera:WorldToViewportPoint(part2.Position)
                            if onScreen1 and onScreen2 then
                                obj.skeleton[i].From = Vector2.new(p1.X, p1.Y)
                                obj.skeleton[i].To = Vector2.new(p2.X, p2.Y)
                                obj.skeleton[i].Color = skeletonColor
                                obj.skeleton[i].Visible = true
                            else
                                obj.skeleton[i].Visible = false
                            end
                        else
                            obj.skeleton[i].Visible = false
                        end
                    end

                    -- Remove extra lines if joint count changed
                    for i = #joints + 1, #obj.skeleton do
                        if obj.skeleton[i] then
                            obj.skeleton[i]:Remove()
                            obj.skeleton[i] = nil
                        end
                    end
                else
                    if obj.skeleton then
                        for _, line in pairs(obj.skeleton) do
                            line:Remove()
                        end
                        obj.skeleton = nil
                    end
                end

            else
