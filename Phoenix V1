    scroll.BorderSizePixel = 0
    return scroll
end

local function switchTab(name)
    for tabName, frame in pairs(tabs) do
        frame.Visible = (tabName == name)
    end
    local t = themes[currentTheme]
    for tabName, btn in pairs(tabButtons) do
        if tabName == name then
            btn.BackgroundColor3 = t.tabActive
            btn.TextColor3 = t.text
        else
            btn.BackgroundColor3 = t.tabInactive
            btn.TextColor3 = Color3.fromRGB(140, 140, 140)
        end
    end
    activeTab = name
end

local function CreateToggle(parent, yPos, label, default, callback)
    local container = Instance.new("Frame", parent)
    container.BackgroundColor3 = Color3.fromRGB(22, 22, 24)
    container.BorderColor3 = Color3.fromRGB(38, 38, 40)
    container.BorderSizePixel = 1
    container.Position = UDim2.new(0.5, -130, 0, yPos)
    container.Size = UDim2.new(0, 260, 0, 32)
    local c = Instance.new("UICorner", container)
    c.CornerRadius = UDim.new(0, 5)
    table.insert(themedElements, {type = "container", obj = container})

    local lbl = Instance.new("TextLabel", container)
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.Size = UDim2.new(0.65, 0, 1, 0)
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    table.insert(themedElements, {type = "label", obj = lbl})

    local btn = Instance.new("TextButton", container)
    btn.BackgroundColor3 = default and Color3.fromRGB(35, 90, 35) or Color3.fromRGB(50, 50, 53)
    btn.BorderSizePixel = 0
    btn.Position = UDim2.new(1, -52, 0.5, -10)
    btn.Size = UDim2.new(0, 42, 0, 20)
    btn.Font = Enum.Font.GothamBold
    btn.Text = default and "ON" or "OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 9
    local bc = Instance.new("UICorner", btn)
    bc.CornerRadius = UDim.new(0, 4)
    table.insert(themedElements, {type = "button", obj = btn, isToggle = true})

    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = state and "ON" or "OFF"
        local t = themes[currentTheme]
        btn.BackgroundColor3 = state and Color3.fromRGB(35, 90, 35) or (t and t.button or Color3.fromRGB(50, 50, 53))
        if callback then callback(state) end
    end)
    return btn
end

local function CreateCycle(parent, yPos, label, options, default, callback)
    local container = Instance.new("Frame", parent)
    container.BackgroundColor3 = Color3.fromRGB(22, 22, 24)
    container.BorderColor3 = Color3.fromRGB(38, 38, 40)
    container.BorderSizePixel = 1
    container.Position = UDim2.new(0.5, -130, 0, yPos)
    container.Size = UDim2.new(0, 260, 0, 32)
    local c = Instance.new("UICorner", container)
    c.CornerRadius = UDim.new(0, 5)
    table.insert(themedElements, {type = "container", obj = container})

    local lbl = Instance.new("TextLabel", container)
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.Size = UDim2.new(0.55, 0, 1, 0)
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    table.insert(themedElements, {type = "label", obj = lbl})

    local idx = 1
    for i, v in ipairs(options) do
        if v == default then idx = i break end
    end

    local btn = Instance.new("TextButton", container)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 53)
    btn.BorderSizePixel = 0
    btn.Position = UDim2.new(1, -65, 0.5, -10)
    btn.Size = UDim2.new(0, 55, 0, 20)
    btn.Font = Enum.Font.GothamBold
    btn.Text = default
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 9
    local bc = Instance.new("UICorner", btn)
    bc.CornerRadius = UDim.new(0, 4)
    table.insert(themedElements, {type = "button", obj = btn, isToggle = false})

    btn.MouseButton1Click:Connect(function()
        idx = idx % #options + 1
        btn.Text = options[idx]
        if callback then callback(options[idx]) end
    end)
    return btn
end

