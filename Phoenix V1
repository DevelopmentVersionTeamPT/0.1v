                        local hl = Instance.new("Highlight")
                        hl.Name = "VoidChams"
                        hl.FillTransparency = 0
                        hl.OutlineTransparency = 1
                        hl.Adornee = char
                        hl.Parent = char
                        obj.chams = hl
                    end
