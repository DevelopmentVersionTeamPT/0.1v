        fovCircle.Visible = true
    elseif fovCircle then
        fovCircle.Visible = false
    end

    if lockedTarget and lockedTarget.Character and hitboxEnabled then
        local root = lockedTarget.Character:FindFirstChild("HumanoidRootPart")
        if root then
            root.Size = HITBOX_SIZE
            root.CanCollide = false
            if hitboxShape == "Sphere" then
                root.Shape = Enum.PartType.Ball
            elseif hitboxShape == "Cylinder" then
                root.Shape = Enum.PartType.Cylinder
            else
                root.Shape = Enum.PartType.Block
            end
            if hitboxVisible and hitboxOpacity > 0 then
                root.Transparency = 1 - (hitboxOpacity / 10)
                root.Color = hitboxColor
                root.Material = Enum.Material.SmoothPlastic
            else
                root.Transparency = 1
            end
        end
    end

    if not lockedTarget then return end
    local char = lockedTarget.Character
    if not char then
        lockedTarget = nil
        return
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local part = getTargetPart(char)
    if not part or not hum or hum.Health <= 0 then
        if hitboxEnabled then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                root.Size = Vector3.new(2, 2, 1)
                root.Transparency = 1
                root.CanCollide = false
                root.Material = Enum.Material.SmoothPlastic
            end
        end
        if autoRelockEnabled then
            local newTarget = getClosestPlayerToCursor()
            if newTarget and newTarget ~= lockedTarget then
                lockedTarget = newTarget
                if lockFeedbackEnabled then
                    local name = (espNameMode == "Display") and newTarget.DisplayName or newTarget.Name
                    game:GetService("StarterGui"):SetCore("SendNotification", {
                        Title = "Relocked",
                        Text = "You Relocked Onto " .. name,
                        Duration = 2
                    })
                end
            else
                lockedTarget = nil
            end
        else
            lockedTarget = nil
        end
        return
    end

    if camLockEnabled then
        local camPos = Camera.CFrame.Position
        Camera.CFrame = CFrame.lookAt(camPos, part.Position)
    end
end))

