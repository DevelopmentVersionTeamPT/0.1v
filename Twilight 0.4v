        local minV, maxV = 16, 200
        local function setFromAlpha(a)
            a = math.clamp(a, 0, 1)
            sprintSpeed = math.floor(minV + (maxV - minV) * a + 0.5)
            local t = (sprintSpeed - minV) / (maxV - minV)
