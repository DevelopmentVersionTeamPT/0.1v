        container.Size = UDim2.new(0, 260, 0, 32)

        local lbl = Instance.new("TextLabel", container)
        lbl.BackgroundTransparency = 1
        lbl.Position = UDim2.new(0, 12, 0, 0)
        lbl.Size = UDim2.new(0.65, 0, 1, 0)
        lbl.Font = Enum.Font.GothamBold
        lbl.Text = label
        lbl.TextColor3 = Color3.fromRGB(228, 228, 232)
        lbl.TextSize = 11
        lbl.TextXAlignment = Enum.TextXAlignment.Left

        local btn = Instance.new("TextButton", container)
        btn.BackgroundColor3 = Color3.fromRGB(42, 42, 46)
        btn.BorderSizePixel = 0
        btn.Position = UDim2.new(1, -55, 0.5, -10)
        btn.Size = UDim2.new(0, 42, 0, 20)
        btn.Font = Enum.Font.GothamBold
        btn.Text = "GO"
        btn.TextColor3 = Color3.fromRGB(236, 236, 240)
        btn.TextSize = 9
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
        btn.MouseButton1Click:Connect(function()
            btn.BackgroundColor3 = Color3.fromRGB(40, 88, 48)
            btn.Text = "OK"
            pcall(fn)
            task.delay(0.35, function()
                if btn and btn.Parent then
                    btn.BackgroundColor3 = Color3.fromRGB(42, 42, 46)
                    btn.Text = "GO"
                end
            end)
        end)
    end

    makeUtilBtn(530, "Respawn", function()
        if Act.respawn then Act.respawn() end
    end)
    makeUtilBtn(570, "Rejoin", function()
        game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
    end)
    makeUtilBtn(610, "Server Hop", function()
        if Act.serverHop then Act.serverHop() end
    end)
    makeUtilBtn(650, "Commands List", function()
        if Act.cmds then Act.cmds() end
    end)
    makeUtilBtn(690, "Chat Logs", function()
        if Act.chatLogs then Act.chatLogs() end
    end)
    makeUtilBtn(730, "Copy Position", function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and setclipboard then
            local p = hrp.Position
            setclipboard(math.floor(p.X) .. ", " .. math.floor(p.Y) .. ", " .. math.floor(p.Z))
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {Title = "Copied", Text = "Position", Duration = 2})
            end)
        end
    end)
    makeUtilBtn(770, "Copy Job ID", function()
        if setclipboard then
            setclipboard(game.JobId)
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {Title = "Copied", Text = "Job ID", Duration = 2})
            end)
        end
    end)
    makeUtilBtn(810, "Copy Place ID", function()
        if setclipboard then
            setclipboard(tostring(game.PlaceId))
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {Title = "Copied", Text = "Place ID", Duration = 2})
            end)
        end
    end)
    makeUtilBtn(850, "Copy Username", function()
        if setclipboard then
            setclipboard(LocalPlayer.Name)
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {Title = "Copied", Text = "Username", Duration = 2})
            end)
        end
    end)
    makeUtilBtn(890, "Quit", function()
        if Act.destroy then Act.destroy() end
    end)
end

local function applyMobileMode(on)
    mobileControlsEnabled = on and true or false
    if toggleRegistry["Mobile Controls"] then
        toggleRegistry["Mobile Controls"].set(mobileControlsEnabled)
    end
    if MobileControls and MobileControls.setVisible then
        MobileControls.setVisible(mobileControlsEnabled)
    end
    if mobileControlsEnabled or isMobile then
        MainFrame.Size = UDim2.new(0, 320, 0, 360)
    else
        MainFrame.Size = UDim2.new(0, 380, 0, 400)
    end
end



pcall(function()
createTabButton("Server")
tabs["Server"] = createTabContent()

local serverSearchFilter = ""

local serverListFrame = Instance.new("Frame", tabs["Server"])
serverListFrame.BackgroundTransparency = 1
serverListFrame.Size = UDim2.new(1, 0, 0, 2000)
serverListFrame.Position = UDim2.new(0, 0, 0, 0)

local serverListLayout = Instance.new("UIListLayout", serverListFrame)
serverListLayout.Padding = UDim.new(0, 4)
serverListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
serverListLayout.SortOrder = Enum.SortOrder.LayoutOrder

local serverListPadding = Instance.new("UIPadding", serverListFrame)
serverListPadding.PaddingTop = UDim.new(0, 5)
serverListPadding.PaddingBottom = UDim.new(0, 5)


local searchContainer = Instance.new("Frame", serverListFrame)
searchContainer.BackgroundColor3 = Color3.fromRGB(22, 22, 24)
searchContainer.BorderColor3 = Color3.fromRGB(38, 38, 40)
searchContainer.BorderSizePixel = 1
searchContainer.Size = UDim2.new(0, 280, 0, 30)
searchContainer.LayoutOrder = -1
Instance.new("UICorner", searchContainer).CornerRadius = UDim.new(0, 5)
table.insert(themedElements, {type = "container", obj = searchContainer})

local searchBox = Instance.new("TextBox", searchContainer)
searchBox.BackgroundTransparency = 1
searchBox.Position = UDim2.new(0, 10, 0, 0)
searchBox.Size = UDim2.new(1, -20, 1, 0)
searchBox.Font = Enum.Font.GothamBold
searchBox.PlaceholderText = "Search player..."
searchBox.PlaceholderColor3 = Color3.fromRGB(120, 120, 120)
searchBox.Text = ""
searchBox.TextColor3 = Color3.fromRGB(236, 236, 240)
searchBox.TextSize = 11
searchBox.TextXAlignment = Enum.TextXAlignment.Left
searchBox.ClearTextOnFocus = false
table.insert(themedElements, {type = "label", obj = searchBox})

local function isTargeted(player)
    return targetEspPlayers[player] == true
end

local function refreshServerList()
    
    for _, child in ipairs(serverListFrame:GetChildren()) do
        if child:IsA("Frame") and child ~= searchContainer then child:Destroy() end
    end

    local filter = serverSearchFilter:lower()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            
            local matchesFilter = (filter == "") or
                player.Name:lower():find(filter, 1, true) or
                player.DisplayName:lower():find(filter, 1, true)

            if matchesFilter then
                local row = Instance.new("Frame", serverListFrame)
                row.BackgroundColor3 = Color3.fromRGB(22, 22, 24)
                row.BorderColor3 = Color3.fromRGB(38, 38, 40)
                row.BorderSizePixel = 1
                row.Size = UDim2.new(0, 280, 0, 58)
                row.LayoutOrder = 1
                local rowCorner = Instance.new("UICorner", row)
                rowCorner.CornerRadius = UDim.new(0, 5)
                table.insert(themedElements, {type = "container", obj = row})

                
                local avatar = Instance.new("ImageLabel", row)
                avatar.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                avatar.BorderSizePixel = 0
                avatar.Position = UDim2.new(0, 5, 0, 5)
                avatar.Size = UDim2.new(0, 28, 0, 28)
                avatar.Image = ""
                Instance.new("UICorner", avatar).CornerRadius = UDim.new(0, 14)

                
                task.spawn(function()
                    local success, result = pcall(function()
                        return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
                    end)
                    if success and result and avatar and avatar.Parent then
                        avatar.Image = result
                    end
                end)

                
                local displayLbl = Instance.new("TextLabel", row)
                displayLbl.BackgroundTransparency = 1
                displayLbl.Position = UDim2.new(0, 38, 0, 3)
                displayLbl.Size = UDim2.new(0, 160, 0, 16)
                displayLbl.Font = Enum.Font.GothamBold
                displayLbl.Text = player.DisplayName
                displayLbl.TextColor3 = Color3.fromRGB(236, 236, 240)
                displayLbl.TextSize = 11
                displayLbl.TextXAlignment = Enum.TextXAlignment.Left
                displayLbl.TextTruncate = Enum.TextTruncate.AtEnd

                
                local userLbl = Instance.new("TextLabel", row)
                userLbl.BackgroundTransparency = 1
                userLbl.Position = UDim2.new(0, 38, 0, 18)
                userLbl.Size = UDim2.new(0, 160, 0, 14)
                userLbl.Font = Enum.Font.GothamBold
                userLbl.Text = "@" .. player.Name
                userLbl.TextColor3 = Color3.fromRGB(168, 170, 180)
                userLbl.TextSize = 9
                userLbl.TextXAlignment = Enum.TextXAlignment.Left
                userLbl.TextTruncate = Enum.TextTruncate.AtEnd

                
                local btnY = 36
                local btnH = 16
                local btnSpacing = 4
                local btnStartX = 6
                local xOffset = btnStartX

                
                local viewBtn = Instance.new("TextButton", row)
                viewBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 38)
                viewBtn.BorderSizePixel = 0
                viewBtn.Position = UDim2.new(0, xOffset, 0, btnY)
                viewBtn.Size = UDim2.new(0, 46, 0, btnH)
                viewBtn.Font = Enum.Font.GothamBold
                viewBtn.Text = (viewingPlayer == player) and "Unview" or "View"
                viewBtn.TextColor3 = Color3.fromRGB(200, 202, 210)
                viewBtn.TextSize = 9
                Instance.new("UICorner", viewBtn).CornerRadius = UDim.new(0, 3)
                if viewingPlayer == player then
                    viewBtn.BackgroundColor3 = Color3.fromRGB(50, 35, 35)
                end
                viewBtn.MouseButton1Click:Connect(function()
                    if viewingPlayer == player then
                        
                        viewingPlayer = nil
                        local myHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                        local cam = workspace.CurrentCamera
                        if cam then
                            cam.CameraType = Enum.CameraType.Custom
                            if myHum then cam.CameraSubject = myHum end
                        end
                        viewBtn.Text = "View"
                        viewBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 38)
                    else
                        
                        if player.Character then
                            viewingPlayer = player
                            viewBtn.Text = "Unview"
                            viewBtn.BackgroundColor3 = Color3.fromRGB(50, 35, 35)
                        end
                    end
                end)
                xOffset = xOffset + 46 + btnSpacing

                
                local actions = {
                    {text = "TP", width = 30, fn = function()
                        if player.Character then
                            local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
                            local myChar = LocalPlayer.Character
                            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                            if targetRoot and myRoot then
                                myRoot.CFrame = targetRoot.CFrame + Vector3.new(0, 3, 0)
                            end
                        end
                    end},
                }

                for _, action in ipairs(actions) do
                    local btn = Instance.new("TextButton", row)
                    btn.BackgroundColor3 = action.color or Color3.fromRGB(35, 35, 38)
                    btn.BorderSizePixel = 0
                    btn.Position = UDim2.new(0, xOffset, 0, btnY)
                    btn.Size = UDim2.new(0, action.width, 0, btnH)
                    btn.Font = Enum.Font.GothamBold
                    btn.Text = action.text
                    btn.TextColor3 = Color3.fromRGB(200, 202, 210)
                    btn.TextSize = 9
                    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 3)
                    btn.MouseButton1Click:Connect(action.fn)
                    xOffset = xOffset + action.width + btnSpacing
                end

                
                local lockBtn = Instance.new("TextButton", row)
                lockBtn.BackgroundColor3 = (lockedTarget == player) and Color3.fromRGB(35, 60, 35) or Color3.fromRGB(35, 35, 38)
                lockBtn.BorderSizePixel = 0
                lockBtn.Position = UDim2.new(0, xOffset, 0, btnY)
                lockBtn.Size = UDim2.new(0, 46, 0, btnH)
                lockBtn.Font = Enum.Font.GothamBold
                lockBtn.Text = (lockedTarget == player) and "Unlock" or "Lock"
                lockBtn.TextColor3 = Color3.fromRGB(200, 202, 210)
                lockBtn.TextSize = 9
                Instance.new("UICorner", lockBtn).CornerRadius = UDim.new(0, 3)
                lockBtn.MouseButton1Click:Connect(function()
                    if lockedTarget == player then
                        
                        lockedTarget = nil
                        lockBtn.Text = "Lock"
                        lockBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 38)
                    else
                        if player.Character and camLockEnabled then
                            if teamCheckEnabled and H.isTeammate(player) then
                                return
                            end
                            lockedTarget = player
                            lockBtn.Text = "Unlock"
                            lockBtn.BackgroundColor3 = Color3.fromRGB(35, 60, 35)
                        end
                    end
                end)
                xOffset = xOffset + 46 + btnSpacing

                
                local targetBtn = Instance.new("TextButton", row)
                targetBtn.BackgroundColor3 = targetEspPlayers[player] and Color3.fromRGB(35, 60, 35) or Color3.fromRGB(35, 35, 38)
                targetBtn.BorderSizePixel = 0
                targetBtn.Position = UDim2.new(0, xOffset, 0, btnY)
                targetBtn.Size = UDim2.new(0, 46, 0, btnH)
                targetBtn.Font = Enum.Font.GothamBold
                targetBtn.Text = targetEspPlayers[player] and "Untgt" or "Target"
                targetBtn.TextColor3 = Color3.fromRGB(200, 202, 210)
                targetBtn.TextSize = 9
                Instance.new("UICorner", targetBtn).CornerRadius = UDim.new(0, 3)
                targetBtn.MouseButton1Click:Connect(function()
                    if targetEspPlayers[player] then
                        targetEspPlayers[player] = nil
                        if targetEspObjects[player] and targetEspObjects[player].Parent then
                            targetEspObjects[player]:Destroy()
                        end
                        targetEspObjects[player] = nil
                        targetBtn.Text = "Target"
                        targetBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 38)
                    else
                        targetEspPlayers[player] = true
                        targetEspEnabled = true
                        targetBtn.Text = "Untgt"
                        targetBtn.BackgroundColor3 = Color3.fromRGB(35, 60, 35)
                    end
                end)
                xOffset = xOffset + 46 + btnSpacing
            end
        end
    end
end


searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    serverSearchFilter = searchBox.Text
    refreshServerList()
end)


Players.PlayerAdded:Connect(function()
    task.wait(0.5)
    pcall(refreshServerList)
end)
Players.PlayerRemoving:Connect(function(player)
    
    if targetEspPlayers[player] then
        targetEspPlayers[player] = nil
        if targetEspObjects[player] and targetEspObjects[player].Parent then
            targetEspObjects[player]:Destroy()
        end
        targetEspObjects[player] = nil
    end
    task.wait(0.2)
    pcall(refreshServerList)
end)


pcall(refreshServerList)

end) 




pcall(function()
    local placeId = game.PlaceId
    local gameRoleESP = {} 

    
    if placeId == 142823291 then
        createTabButton("Game")
        tabs["Game"] = createTabContent()

        CreateSectionHeader(tabs["Game"], 5, "Murder Mystery 2")

        local mm2RoleEspEnabled = false
        local mm2ShowMurderer = true
        local mm2ShowSheriff = true
        local mm2ShowInnocent = true
        local mm2ShowHero = true
        local mm2OriginalSheriff = nil 

        local function getMM2Role(player)
            if not player or not player.Character then return "Innocent" end
            local backpack = player:FindFirstChild("Backpack")
            local char = player.Character

            local function searchForKnife(container)
                if not container then return false end
                for _, item in ipairs(container:GetChildren()) do
                    if item:IsA("Tool") then
                        if item.Name:lower():find("knife") then return true end
                        if item:FindFirstChild("KnifeServer") or item:FindFirstChild("Kill") then return true end
                    end
                end
                return false
            end

            local function searchForGun(container)
                if not container then return false end
                for _, item in ipairs(container:GetChildren()) do
                    if item:IsA("Tool") then
                        if item.Name == "Gun" or item.Name == "Revolver" or item.Name:lower() == "gun" then return true end
                        if item:FindFirstChild("Fire") or item:FindFirstChild("Shoot") or item:FindFirstChild("GunServer") then return true end
                    end
                end
                return false
            end

            local hasKnife = searchForKnife(backpack) or searchForKnife(char)
            local hasGun = searchForGun(backpack) or searchForGun(char)

            if hasKnife then
                return "Murderer"
            elseif hasGun then
                
                if mm2OriginalSheriff == nil then
                    mm2OriginalSheriff = player
                    return "Sheriff"
                elseif mm2OriginalSheriff == player then
                    return "Sheriff"
                else
                    
                    return "Hero"
                end
            end
            return "Innocent"
        end

        local mm2Btn, mm2Info = CreateToggle(tabs["Game"], 25, "Role ESP", false, function(state)
            mm2RoleEspEnabled = state
            if not state then
                for p, data in pairs(gameRoleESP) do
                    if data.highlight and data.highlight.Parent then data.highlight:Destroy() end
                    if data.billboard and data.billboard.Parent then data.billboard:Destroy() end
                end
                gameRoleESP = {}
                mm2OriginalSheriff = nil
            end
        end)

        
        mm2Info.setBuilder(function(panel)
            local roles = {
                {name = "Murderer", var = function() return mm2ShowMurderer end, set = function(v) mm2ShowMurderer = v end},
                {name = "Sheriff", var = function() return mm2ShowSheriff end, set = function(v) mm2ShowSheriff = v end},
                {name = "Innocent", var = function() return mm2ShowInnocent end, set = function(v) mm2ShowInnocent = v end},
                {name = "Hero", var = function() return mm2ShowHero end, set = function(v) mm2ShowHero = v end},
            }
            for i, role in ipairs(roles) do
                local rBtn = Instance.new("TextButton", panel)
                rBtn.BackgroundColor3 = role.var() and Color3.fromRGB(35, 90, 35) or Color3.fromRGB(50, 50, 53)
                rBtn.BorderSizePixel = 0
                rBtn.Position = UDim2.new(0, 8 + (i-1) * 62, 0.5, -10)
                rBtn.Size = UDim2.new(0, 56, 0, 20)
                rBtn.Font = Enum.Font.GothamBold
                rBtn.Text = role.name
                rBtn.TextColor3 = Color3.fromRGB(236, 236, 240)
                rBtn.TextSize = 8
                rBtn.ZIndex = 6
                Instance.new("UICorner", rBtn).CornerRadius = UDim.new(0, 4)
                rBtn.MouseButton1Click:Connect(function()
                    local newVal = not role.var()
                    role.set(newVal)
                    rBtn.BackgroundColor3 = newVal and Color3.fromRGB(35, 90, 35) or Color3.fromRGB(50, 50, 53)
                end)
            end
        end, 40)

        
        task.spawn(function()
            while scriptActive do
                if mm2RoleEspEnabled then
                    
                    local anyoneHasKnife = false
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character then
                            local bp = p:FindFirstChild("Backpack")
                            local ch = p.Character
                            local function checkKnife(c)
                                if not c then return false end
                                for _, item in ipairs(c:GetChildren()) do
                                    if item:IsA("Tool") and (item.Name:lower():find("knife") or item:FindFirstChild("KnifeServer") or item:FindFirstChild("Kill")) then return true end
                                end
                                return false
                            end
                            if checkKnife(bp) or checkKnife(ch) then anyoneHasKnife = true break end
                        end
                    end
                    if not anyoneHasKnife then
                        mm2OriginalSheriff = nil
                        
                        for p, data in pairs(gameRoleESP) do
                            if data.highlight then pcall(function() data.highlight:Destroy() end) end
                            if data.billboard then pcall(function() data.billboard:Destroy() end) end
                        end
                        gameRoleESP = {}
                    end

                    for _, player in ipairs(Players:GetPlayers()) do
                        if player ~= LocalPlayer and player.Character then
                            local char = player.Character
                            local hum = char:FindFirstChildOfClass("Humanoid")
                            local head = char:FindFirstChild("Head")

                            
                            if gameRoleESP[player] then
                                local data = gameRoleESP[player]
                                if data.highlight and data.highlight.Parent ~= char then
                                    pcall(function() data.highlight:Destroy() end)
                                    data.highlight = nil
                                end
                                if data.billboard and data.billboard.Parent ~= char then
                                    pcall(function() data.billboard:Destroy() end)
                                    data.billboard = nil
                                end
                            end

                            if hum and hum.Health > 0 and head then
                                local role = getMM2Role(player)

                                
                                local showRole = (role == "Murderer" and mm2ShowMurderer)
                                    or (role == "Sheriff" and mm2ShowSheriff)
                                    or (role == "Innocent" and mm2ShowInnocent)
                                    or (role == "Hero" and mm2ShowHero)

                                if showRole then
                                    local roleColor
                                    if role == "Murderer" then
                                        roleColor = Color3.fromRGB(255, 50, 50)
                                    elseif role == "Sheriff" then
                                        roleColor = Color3.fromRGB(50, 130, 255)
                                    elseif role == "Hero" then
                                        roleColor = Color3.fromRGB(255, 220, 50)
                                    else
                                        roleColor = Color3.fromRGB(80, 200, 80)
                                    end

                                    if not gameRoleESP[player] then gameRoleESP[player] = {} end
                                    local data = gameRoleESP[player]

                                    if not data.highlight or not data.highlight.Parent then
                                        local hl = Instance.new("Highlight")
                                        hl.Name = "MM2RoleHL"
                                        hl.FillTransparency = 0.7
                                        hl.OutlineTransparency = 0
                                        hl.Adornee = char
                                        hl.Parent = char
                                        data.highlight = hl
                                    end
                                    data.highlight.FillColor = roleColor
                                    data.highlight.OutlineColor = roleColor

                                    if not data.billboard or not data.billboard.Parent then
                                        local bb = Instance.new("BillboardGui")
                                        bb.Name = "MM2RoleESP"
                                        bb.Size = UDim2.new(0, 100, 0, 20)
                                        bb.StudsOffset = Vector3.new(0, 3.5, 0)
                                        bb.AlwaysOnTop = true
                                        bb.Adornee = head
                                        bb.Parent = char
                                        local lbl = Instance.new("TextLabel", bb)
                                        lbl.Name = "RoleLbl"
                                        lbl.BackgroundTransparency = 1
                                        lbl.Size = UDim2.new(1, 0, 1, 0)
                                        lbl.Font = Enum.Font.GothamBold
                                        lbl.TextSize = 13
                                        lbl.TextStrokeTransparency = 0.4
                                        data.billboard = bb
                                    end
                                    local roleLbl = data.billboard:FindFirstChild("RoleLbl")
                                    if roleLbl then
                                        roleLbl.Text = role
                                        roleLbl.TextColor3 = roleColor
                                    end
                                else
                                    
                                    if gameRoleESP[player] then
                                        if gameRoleESP[player].highlight then pcall(function() gameRoleESP[player].highlight:Destroy() end) end
                                        if gameRoleESP[player].billboard then pcall(function() gameRoleESP[player].billboard:Destroy() end) end
                                        gameRoleESP[player] = nil
                                    end
                                end
                            else
                                
                                if gameRoleESP[player] then
                                    if gameRoleESP[player].highlight then pcall(function() gameRoleESP[player].highlight:Destroy() end) end
                                    if gameRoleESP[player].billboard then pcall(function() gameRoleESP[player].billboard:Destroy() end) end
                                    gameRoleESP[player] = nil
                                end
                            end
                        end
                    end

                    
                    for player, data in pairs(gameRoleESP) do
                        if not player.Parent then
                            if data.highlight then pcall(function() data.highlight:Destroy() end) end
                            if data.billboard then pcall(function() data.billboard:Destroy() end) end
                            gameRoleESP[player] = nil
                        end
                    end
                end
                task.wait(0.3)
            end

            
            for _, data in pairs(gameRoleESP) do
                if data.highlight then pcall(function() data.highlight:Destroy() end) end
                if data.billboard then pcall(function() data.billboard:Destroy() end) end
            end
            gameRoleESP = {}
        end)

    end 

    
    
    
    if placeId == 286090429 or placeId == 2377868063 then
        if not tabs["Game"] then
            createTabButton("Game")
            tabs["Game"] = createTabContent()
        end

        CreateSectionHeader(tabs["Game"], 5, "Arsenal")

        local backstabEnabled = false
        local backstabKeybind = Enum.KeyCode.X
        local waitingForBackstabKeybind = false

        
        local function isOnGoldenKnife()
            local char = LocalPlayer.Character
            if not char then return false end
            
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                local name = tool.Name:lower()
                
                if name:find("golden") or name:find("knife") or name:find("golden knife") then
                    return true
                end
                
                if tool:FindFirstChild("Blade") or tool:FindFirstChild("KnifeModel") or tool:FindFirstChild("Handle") then
                    
                    if not tool:FindFirstChild("Ammo") and not tool:FindFirstChild("FireSound") and not tool:FindFirstChild("Barrel") then
                        
                        if name:find("knife") or name:find("blade") or name:find("sword") or name:find("golden") then
                            return true
                        end
                    end
                end
            end
            
            return false
        end

        
        local function getAimedEnemy()
            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myRoot then return nil end

            local viewportSize = Camera.ViewportSize
            local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

            local closest = nil
            local closestDist = math.huge

            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local char = player.Character
                    local root = char:FindFirstChild("HumanoidRootPart")
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if root and hum and hum.Health > 0 then
                        
                        if not H.isTeammate(player) then
                            local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                            if onScreen then
                                local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                                if dist < closestDist then
                                    closestDist = dist
                                    closest = player
                                end
                            end
                        end
                    end
                end
            end
            return closest
        end

        
        local function executeBackstab()
            local target = getAimedEnemy()
            if not target or not target.Character then return end

            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myRoot then return end

            local targetChar = target.Character
            local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
            if not targetRoot then return end

            
            local behindPos = (targetRoot.CFrame * CFrame.new(0, 0, 1.5)).Position
            local lookCF = CFrame.lookAt(behindPos, targetRoot.Position)
            myRoot.CFrame = lookCF

            
            Camera.CFrame = CFrame.lookAt(behindPos + Vector3.new(0, 1.2, 0), targetRoot.Position)

            
            local tool = myChar:FindFirstChildOfClass("Tool")
            if tool then pcall(function() tool:Activate() end) end
            if not (isMobile or mobileControlsEnabled) then
                pcall(function() mouse1click() end)
                pcall(function()
                    local vim = game:GetService("VirtualInputManager")
                    vim:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                    vim:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                end)
            end
            if tool then pcall(function() tool:Activate() end) end
            if not (isMobile or mobileControlsEnabled) then
                pcall(function() mouse1click() end)
            end
        end

        local _, backstabInfo = CreateToggle(tabs["Game"], 25, "Backstab", false, function(state)
            backstabEnabled = state
        end)
        ActiveExtras.backstab = {
            name = "Backstab",
            on = function() return backstabEnabled end,
            key = function() return backstabKeybind end,
        }
        backstabInfo.setBuilder(function(panel)
            
            local lbl = Instance.new("TextLabel", panel)
            lbl.BackgroundTransparency = 1; lbl.Position = UDim2.new(0, 10, 0, 0)
            lbl.Size = UDim2.new(0, 55, 1, 0); lbl.Font = Enum.Font.GothamBold
            lbl.Text = "Hotkey"; lbl.TextColor3 = Color3.fromRGB(160,160,160); lbl.TextSize = 10
            lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.ZIndex = 6

            local kbBtn = Instance.new("TextButton", panel)
            kbBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 53)
            kbBtn.BorderSizePixel = 0; kbBtn.Position = UDim2.new(0, 65, 0.5, -9)
            kbBtn.Size = UDim2.new(0, 50, 0, 18); kbBtn.Font = Enum.Font.GothamBold
            kbBtn.Text = backstabKeybind.Name; kbBtn.TextColor3 = Color3.fromRGB(255,255,255)
            kbBtn.TextSize = 9; kbBtn.ZIndex = 6
            Instance.new("UICorner", kbBtn).CornerRadius = UDim.new(0, 4)

            kbBtn.MouseButton1Click:Connect(function()
                kbBtn.Text = "..."
                kbBtn.BackgroundColor3 = Color3.fromRGB(90, 50, 50)
                waitingForBackstabKeybind = true
                local conn
                conn = UserInputService.InputBegan:Connect(function(input, processed)
                    if processed then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        backstabKeybind = input.KeyCode
                        kbBtn.Text = input.KeyCode.Name
                        kbBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 53)
                        waitingForBackstabKeybind = false
                        conn:Disconnect()
                    end
                end)
            end)
        end, 38)

        
        table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
            if processed then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if waitingForBackstabKeybind then return end
            if input.KeyCode == backstabKeybind and backstabEnabled then
                executeBackstab()
            end
        end))

    end

end) 

