CreateToggle(tabs["Settings"], 265, "NPC Visuals", false, function(state)
    npcEspEnabled = state
    if not state then
        for _, obj in pairs(npcEspObjects) do
            if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
            if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
            if obj.trail then pcall(function() obj.trail:Destroy() end) end
            if obj.trailAttach0 then pcall(function() obj.trailAttach0:Destroy() end) end
            if obj.trailAttach1 then pcall(function() obj.trailAttach1:Destroy() end) end
            if obj.chams then pcall(function() obj.chams:Destroy() end) end
            if obj.tracer then pcall(function() obj.tracer:Remove() end) end
            if obj.boxOutline then pcall(function() obj.boxOutline:Remove() end) end
            if obj.skeleton then for _, l in pairs(obj.skeleton) do pcall(function() l:Remove() end) end end
            if obj.headDot then pcall(function() obj.headDot:Remove() end) end
        end
        npcEspObjects = {}
    end
end)

