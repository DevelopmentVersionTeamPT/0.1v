local _bTeam, teamInfo = CreateToggle(tabs["Visuals"], 585, "3D Team Outline", false, function(state)
    teamEspEnabled = state
    if not state then
        for _, hl in pairs(teamEspObjects) do
            if hl and hl.Parent then hl:Destroy() end
        end
        teamEspObjects = {}
    end
end)
teamInfo.setBuilder(function(panel)
    
    local Teams = game:GetService("Teams")
    local teams = Teams:GetTeams()
    if #teams == 0 then
        local lbl = Instance.new("TextLabel", panel)
        lbl.BackgroundTransparency = 1; lbl.Size = UDim2.new(1,0,1,0)
        lbl.Font = Enum.Font.GothamBold; lbl.Text = "No teams found"
        lbl.TextColor3 = Color3.fromRGB(120,120,120); lbl.TextSize = 9; lbl.ZIndex = 6
        return
    end
    local panelWidth = 260
    local btnW = math.floor((panelWidth - 16) / math.min(#teams, 4))
    for i, team in ipairs(teams) do
        if i > 4 then break end
        local isOn = (teamEspWhitelist[team.Name] ~= false)
        local b = Instance.new("TextButton", panel)
        b.BackgroundColor3 = isOn and Color3.fromRGB(35, 90, 35) or Color3.fromRGB(50, 50, 53)
        b.BorderSizePixel = 0
        b.Position = UDim2.new(0, 8 + (i-1)*(btnW+2), 0.5, -9)
        b.Size = UDim2.new(0, btnW - 4, 0, 18)
        b.Font = Enum.Font.GothamBold
        b.Text = team.Name
        b.TextColor3 = Color3.fromRGB(236, 236, 240)
        b.TextSize = 8
        b.TextTruncate = Enum.TextTruncate.AtEnd
        b.ZIndex = 6
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
        b.MouseButton1Click:Connect(function()
            local newState = not (teamEspWhitelist[team.Name] ~= false)
            teamEspWhitelist[team.Name] = newState
            b.BackgroundColor3 = newState and Color3.fromRGB(35, 90, 35) or Color3.fromRGB(50, 50, 53)
        end)
    end
end, 38)

local _bFriend, friendInfo = CreateToggle(tabs["Visuals"], 625, "3D Friend Outline", false, function(state)
    friendEspEnabled = state
    if not state then
        for _, hl in pairs(friendEspObjects) do
            if hl and hl.Parent then hl:Destroy() end
        end
        friendEspObjects = {}
    end
end)
friendInfo.setBuilder(function(panel)
    
    local friends = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local ok, isFriend = pcall(function() return LocalPlayer:IsFriendsWith(p.UserId) end)
            if ok and isFriend then
                table.insert(friends, p)
            end
        end
    end
    if #friends == 0 then
        local lbl = Instance.new("TextLabel", panel)
        lbl.BackgroundTransparency = 1; lbl.Size = UDim2.new(1,0,1,0)
        lbl.Font = Enum.Font.GothamBold; lbl.Text = "No friends in server"
        lbl.TextColor3 = Color3.fromRGB(120,120,120); lbl.TextSize = 9; lbl.ZIndex = 6
        return
    end
    local btnW = math.floor(240 / math.min(#friends, 4))
    for i, p in ipairs(friends) do
        if i > 4 then break end
        local isOn = (friendEspWhitelist[p] ~= false)
        local b = Instance.new("TextButton", panel)
        b.BackgroundColor3 = isOn and Color3.fromRGB(35, 90, 35) or Color3.fromRGB(50, 50, 53)
        b.BorderSizePixel = 0
        b.Position = UDim2.new(0, 8 + (i-1)*(btnW+2), 0.5, -9)
        b.Size = UDim2.new(0, btnW - 4, 0, 18)
        b.Font = Enum.Font.GothamBold
        b.Text = p.DisplayName
        b.TextColor3 = Color3.fromRGB(236, 236, 240)
        b.TextSize = 8
        b.TextTruncate = Enum.TextTruncate.AtEnd
        b.ZIndex = 6
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
        b.MouseButton1Click:Connect(function()
            local newState = not (friendEspWhitelist[p] ~= false)
            friendEspWhitelist[p] = newState
            b.BackgroundColor3 = newState and Color3.fromRGB(35, 90, 35) or Color3.fromRGB(50, 50, 53)
        end)
    end
end, 38)

local _b1, cornerInfo = CreateToggle(tabs["Visuals"], 665, "2D Corner Box", false, function(state)
    cornerBoxEnabled = state
    if not state then
        for _, obj in pairs(espObjects) do
            if obj.cornerBox then
                for _, line in pairs(obj.cornerBox) do pcall(function() line:Remove() end) end
                obj.cornerBox = nil
            end
        end
    end
end)
cornerInfo.setBuilder(function(panel)
    local lbl=Instance.new("TextLabel",panel)
    lbl.BackgroundTransparency=1; lbl.Position=UDim2.new(0,10,0,0); lbl.Size=UDim2.new(0,60,1,0)
    lbl.Font=Enum.Font.GothamBold; lbl.Text="Thickness"; lbl.TextColor3=Color3.fromRGB(160,160,160)
    lbl.TextSize=10; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.ZIndex=6
    local opts={{"Thin",1},{"Normal",2},{"Thick",3}}
    for i,opt in ipairs(opts) do
        local b=Instance.new("TextButton",panel)
        b.BackgroundColor3=(cornerBoxThickness==opt[2]) and Color3.fromRGB(50,90,50) or Color3.fromRGB(40,40,43)
        b.BorderSizePixel=0; b.Position=UDim2.new(0,75+(i-1)*55,0.5,-9); b.Size=UDim2.new(0,48,0,18)
        b.Font=Enum.Font.GothamBold; b.Text=opt[1]; b.TextColor3=Color3.fromRGB(200,200,200); b.TextSize=9; b.ZIndex=6
        Instance.new("UICorner",b).CornerRadius=UDim.new(0,4)
        b.MouseButton1Click:Connect(function()
            cornerBoxThickness=opt[2]
            for _,c in ipairs(panel:GetChildren()) do if c:IsA("TextButton") then c.BackgroundColor3=Color3.fromRGB(40,40,43) end end
            b.BackgroundColor3=Color3.fromRGB(50,90,50)
        end)
    end
end, 38)

CreateToggle(tabs["Visuals"], 705, "3D Beam", false, function(state)
    beamEspEnabled = state
    if not state then
        for _, obj in pairs(espObjects) do
            if obj.beam then pcall(function() obj.beam:Destroy() end) obj.beam = nil end
            if obj.beamAttach0 then pcall(function() obj.beamAttach0:Destroy() end) obj.beamAttach0 = nil end
            if obj.beamAttach1 then pcall(function() obj.beamAttach1:Destroy() end) obj.beamAttach1 = nil end
        end
    end
end)

