local spinActive = false
local spinConnection = nil
local spinSpeed = 10
cmdCommands["spin"] = "NEEDS_ARG"
cmdCommands["unspin"] = function()
    spinActive = false
    syncToggle("Spin", false)
    if spinConnection then
        spinConnection:Disconnect()
        spinConnection = nil
    end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local bav = hrp:FindFirstChild("XthosSpinVel")
        if bav then bav:Destroy() end
    end
end

Act.spinOn = function(spd)
    spinSpeed = tonumber(spd) or spinSpeed or 20
    if spinActive then return end
    spinActive = true
    syncToggle("Spin", true)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then spinActive = false syncToggle("Spin", false) return end
    local old = hrp:FindFirstChild("XthosSpinVel")
    if old then old:Destroy() end
    local bav = Instance.new("BodyAngularVelocity")
    bav.Name = "XthosSpinVel"
    bav.MaxTorque = Vector3.new(0, math.huge, 0)
    bav.AngularVelocity = Vector3.new(0, spinSpeed, 0)
    bav.Parent = hrp
    spinConnection = RunService.Heartbeat:Connect(function()
        if not spinActive then return end
        local c = LocalPlayer.Character
        local root = c and c:FindFirstChild("HumanoidRootPart")
        if root then
            local v = root:FindFirstChild("XthosSpinVel")
            if v then
                v.AngularVelocity = Vector3.new(0, spinSpeed, 0)
            end
        end
    end)
end
Act.spinOff = cmdCommands["unspin"]


local tpToolActive = false
local tpToolConnection = nil
cmdCommands["tptool"] = function()
    if tpToolActive then
        tpToolActive = false
        syncToggle("TP Tool", false)
        if tpToolConnection then
            tpToolConnection:Disconnect()
            tpToolConnection = nil
        end
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChild("TpTool") or LocalPlayer.Backpack:FindFirstChild("TpTool")
            if tool then tool:Destroy() end
        end
    else
        tpToolActive = true
        syncToggle("TP Tool", true)
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local tool = Instance.new("Tool")
        tool.Name = "TpTool"
        tool.RequiresHandle = false
        tool.Parent = LocalPlayer.Backpack

        tool.Activated:Connect(function()
            local mouse = LocalPlayer:GetMouse()
            if mouse.Hit then
                local pos = mouse.Hit.Position + Vector3.new(0, 3, 0)
                local character = LocalPlayer.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                if root then
                    root.CFrame = CFrame.new(pos)
                end
            end
        end)

        task.wait(0.1)
        local backpackTool = LocalPlayer.Backpack:FindFirstChild("TpTool")
        if backpackTool then
            backpackTool.Parent = char
        end
    end
end
Act.tpToolOn = function()
    if not tpToolActive then cmdCommands["tptool"]() end
end
Act.tpToolOff = function()
    if tpToolActive then cmdCommands["tptool"]() end
end


local flyActive = false
local flyConnection = nil
local flyBodyVel = nil
local flyBodyGyro = nil
local FLY_SPEED = 50

cmdCommands["fly"] = "NEEDS_ARG"

local function clearFlyParts(char)
    char = char or LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp then
        local bv = hrp:FindFirstChild("XthosFlyVel")
        if bv then pcall(function() bv:Destroy() end) end
        local bg = hrp:FindFirstChild("XthosFlyGyro")
        if bg then pcall(function() bg:Destroy() end) end
    end
    if hum then
        pcall(function()
            hum.PlatformStand = false
            hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
    flyBodyVel = nil
    flyBodyGyro = nil
end

local function attachFlyParts(char)
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp then
        hrp = char:WaitForChild("HumanoidRootPart", 5)
    end
    if not hum then
        hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
    end
    if not hrp or not hum or not char.Parent then return false end

    
    local oldBv = hrp:FindFirstChild("XthosFlyVel")
    if oldBv then oldBv:Destroy() end
    local oldBg = hrp:FindFirstChild("XthosFlyGyro")
    if oldBg then oldBg:Destroy() end

    pcall(function()
        hum.PlatformStand = true
        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    end)

    flyBodyVel = Instance.new("BodyVelocity")
    flyBodyVel.Name = "XthosFlyVel"
    flyBodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBodyVel.Velocity = Vector3.new(0, 0, 0)
    flyBodyVel.Parent = hrp

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.Name = "XthosFlyGyro"
    flyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBodyGyro.P = 1000
    flyBodyGyro.D = 200
    flyBodyGyro.CFrame = hrp.CFrame
    flyBodyGyro.Parent = hrp

    
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = hrp.CFrame + Vector3.new(0, 4, 0)
    end)
    return true
end

local function ensureFlyLoop()
    if flyConnection then return end
    flyConnection = RunService.RenderStepped:Connect(function()
        if not flyActive then return end
        local c = LocalPlayer.Character
        if not c or not c.Parent then return end
        local root = c:FindFirstChild("HumanoidRootPart")
        local h = c:FindFirstChildOfClass("Humanoid")
        if not root or not h or h.Health <= 0 then return end

        local bvel = root:FindFirstChild("XthosFlyVel")
        local bgyro = root:FindFirstChild("XthosFlyGyro")
        if not bvel or not bgyro then
            attachFlyParts(c)
            bvel = root:FindFirstChild("XthosFlyVel")
            bgyro = root:FindFirstChild("XthosFlyGyro")
            if not bvel then return end
        end

        h.PlatformStand = true

        local cam = workspace.CurrentCamera
        local velocity = Vector3.zero
        if not UserInputService:GetFocusedTextBox() then
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                velocity = velocity + cam.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                velocity = velocity - cam.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                velocity = velocity - cam.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                velocity = velocity + cam.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                velocity = velocity + Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                velocity = velocity - Vector3.new(0, 1, 0)
            end
        end

        if velocity.Magnitude > 0 then
            velocity = velocity.Unit * FLY_SPEED
        end

        bvel.Velocity = velocity
        if bgyro then
            bgyro.CFrame = cam.CFrame
        end
    end)
end

local function startFly(speed)
    if speed then FLY_SPEED = speed end
    flyActive = true
    syncToggle("Fly", true)
    ensureFlyLoop()
    local char = LocalPlayer.Character
    if char then
        attachFlyParts(char)
    end
end

cmdCommands["unfly"] = function()
    if not flyActive and not flyConnection then return end
    flyActive = false
    syncToggle("Fly", false)
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    clearFlyParts(LocalPlayer.Character)
end
Act.flyOn = startFly
Act.flyOff = cmdCommands["unfly"]

table.insert(connections, LocalPlayer.CharacterAdded:Connect(function(char)
    if not flyActive then return end
    task.spawn(function()
        task.wait(0.15)
        if not flyActive or not char or not char.Parent then return end
        attachFlyParts(char)
        ensureFlyLoop()
    end)
end))

local freecamActive = false
local freecamConn = nil
local freecamSpeed = 60
local freecamYaw, freecamPitch = 0, 0
local freecamPos = nil
local freecamSaved = nil

local function stopFreecam()
    if not freecamActive then return end
    freecamActive = false
    syncToggle("Freecam", false)
    if freecamConn then
        freecamConn:Disconnect()
        freecamConn = nil
    end
    pcall(function()
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end)
    local cam = workspace.CurrentCamera
    if cam and freecamSaved then
        cam.CameraType = freecamSaved.type or Enum.CameraType.Custom
        if freecamSaved.subject then
            cam.CameraSubject = freecamSaved.subject
        else
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then cam.CameraSubject = hum end
        end
    end
    freecamSaved = nil
    freecamPos = nil
end

local function startFreecam(speed)
    if freecamActive then
        freecamSpeed = speed or freecamSpeed
        return
    end
    if viewingPlayer then
        viewingPlayer = nil
    end
    freecamSpeed = speed or 60
    syncToggle("Freecam", true)
    local cam = workspace.CurrentCamera
    if not cam then return end
    freecamSaved = {
        type = cam.CameraType,
        subject = cam.CameraSubject,
    }
    freecamPos = cam.CFrame.Position
    local look = cam.CFrame.LookVector
    freecamYaw = math.atan2(-look.X, -look.Z)
    freecamPitch = math.asin(math.clamp(look.Y, -1, 1))
    cam.CameraType = Enum.CameraType.Scriptable
    freecamActive = true

    freecamConn = RunService.RenderStepped:Connect(function(dt)
        if not freecamActive then return end
        local c = workspace.CurrentCamera
        if not c then return end

        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
            local delta = UserInputService:GetMouseDelta()
            freecamYaw = freecamYaw - delta.X * 0.004
            freecamPitch = math.clamp(freecamPitch - delta.Y * 0.004, -1.45, 1.45)
        else
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end

        local rot = CFrame.Angles(0, freecamYaw, 0) * CFrame.Angles(freecamPitch, 0, 0)
        local move = Vector3.zero
        if not UserInputService:GetFocusedTextBox() then
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + rot.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - rot.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - rot.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + rot.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                move = move + Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                move = move - Vector3.new(0, 1, 0)
            end
        end

        local spd = freecamSpeed
        if not UserInputService:GetFocusedTextBox() and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            spd = spd * 2.4
        end
        if move.Magnitude > 0 then
            freecamPos = freecamPos + move.Unit * spd * dt
        end
        c.CFrame = CFrame.new(freecamPos) * rot
    end)
end

cmdCommands["freecam"] = "NEEDS_ARG"
cmdCommands["unfreecam"] = function()
    stopFreecam()
end
Act.freecamOn = startFreecam
Act.freecamOff = stopFreecam
Act.destroy = cmdCommands["destroy"]


