;(function()
    local ActiveHud = Instance.new("Frame", ScreenGui)
    ActiveHud.Name = "ActiveFeatures"
    ActiveHud.BackgroundTransparency = 1
    ActiveHud.BorderSizePixel = 0
    ActiveHud.AnchorPoint = Vector2.new(1, 1)
    ActiveHud.Position = UDim2.new(1, -12, 1, -12)
    ActiveHud.Size = UDim2.new(0, 168, 0, 0)
    ActiveHud.AutomaticSize = Enum.AutomaticSize.Y
    ActiveHud.Visible = false
    ActiveHud.ZIndex = 12

    local layout = Instance.new("UIListLayout", ActiveHud)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 1)

    local rows = {}

    local function keyName(k)
        if typeof(k) ~= "EnumItem" then return nil end
        local n = k.Name
        if n == "LeftShift" then return "LShift"
        elseif n == "RightShift" then return "RShift"
        elseif n == "LeftControl" then return "LCtrl"
        elseif n == "RightControl" then return "RCtrl"
        elseif n == "LeftAlt" then return "LAlt"
        elseif n == "RightAlt" then return "RAlt"
        end
        return n
    end

    local function getFeatures()
        local list = {
            {name = "Camera Lock", on = camLockEnabled, key = CombatBinds.lock},
            {name = "Aim Radius", on = fovCircleEnabled, key = CombatBinds.aim},
            {name = "Lock Fire", on = autoLockKillEnabled, key = CombatBinds.alk},
            {name = "360 Assist", on = rageBotEnabled, key = CombatBinds.rage},
            {name = "Triggerbot", on = triggerbotEnabled, key = CombatBinds.trigger},
            {name = "Hotkey Lock", on = keybindLockEnabled, key = nil},
            {name = "Auto Relock", on = autoRelockEnabled and camLockEnabled, key = nil},
            {name = "Team Check", on = teamCheckEnabled, key = nil},
            {name = "Target Info", on = targetInfoEnabled, key = nil},
            {name = "Hitbox Expander", on = hitboxEnabled, key = nil},
            {name = "Speed", on = speedEnabled, key = nil},
            {name = "Sprint", on = sprintEnabled, key = sprintKeybind},
            {name = "Jump Power", on = jumpPowerEnabled, key = nil},
            {name = "Infinite Jump", on = infiniteJumpEnabled, key = nil},
            {name = "Noclip", on = noclipEnabled, key = nil},
            {name = "Click TP", on = clickTPEnabled, key = clickTPKeybind},
            {name = "Panic", on = Safety.panicOn, key = Safety.panicKey},
            {name = "Return on Death", on = Safety.respawnLoc, key = nil},
            {name = "Anti Void", on = Safety.antiVoid, key = nil},
            {name = "Nametags", on = espEnabled, key = nil},
            {name = "Highlight", on = highlightEnabled, key = nil},
            {name = "Chams", on = chamsEnabled, key = nil},
            {name = "Tracers", on = tracersEnabled, key = nil},
            {name = "Box ESP", on = boxEspEnabled, key = nil},
            {name = "Skeleton", on = skeletonEnabled, key = nil},
            {name = "Full Illumination", on = fullbrightEnabled, key = nil},
            {name = "NPC Visuals", on = npcEspEnabled, key = nil},
            {name = "NPC Combat", on = npcCombatEnabled, key = nil},
        }
        for _, entry in pairs(ActiveExtras) do
            if entry and entry.name then
                local on = entry.on
                if type(on) == "function" then on = on() end
                local key = entry.key
                if type(key) == "function" then key = key() end
                table.insert(list, {name = entry.name, on = on and true or false, key = key})
            end
        end
        return list
    end

    local function stroke(lbl)
        local s = Instance.new("UIStroke", lbl)
        s.Color = Color3.fromRGB(0, 0, 0)
        s.Thickness = 1.2
        s.Transparency = 0.35
    end

    local function ensureRow(i)
        if rows[i] then return rows[i] end
        local row = Instance.new("Frame", ActiveHud)
        row.BackgroundTransparency = 1
        row.Size = UDim2.new(1, 0, 0, 14)
        row.LayoutOrder = i
        row.ZIndex = 21

        local nameLbl = Instance.new("TextLabel", row)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Position = UDim2.new(0, 0, 0, 0)
        nameLbl.Size = UDim2.new(1, -36, 1, 0)
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.TextColor3 = Color3.fromRGB(236, 236, 240)
        nameLbl.TextSize = 11
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
        nameLbl.ZIndex = 22
        stroke(nameLbl)

        local keyLbl = Instance.new("TextLabel", row)
        keyLbl.BackgroundTransparency = 1
        keyLbl.AnchorPoint = Vector2.new(1, 0)
        keyLbl.Position = UDim2.new(1, 0, 0, 0)
        keyLbl.Size = UDim2.new(0, 34, 1, 0)
        keyLbl.Font = Enum.Font.GothamBold
        keyLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        keyLbl.TextSize = 10
        keyLbl.TextXAlignment = Enum.TextXAlignment.Right
        keyLbl.Visible = false
        keyLbl.ZIndex = 22
        stroke(keyLbl)

        rows[i] = {row = row, nameLbl = nameLbl, keyLbl = keyLbl}
        return rows[i]
    end

    local _lastSig = ""
    local function refreshActiveHud()
        if not scriptActive or cmdBarOpen then
            ActiveHud.Visible = false
            return
        end
        local active = {}
        for _, f in ipairs(getFeatures()) do
            if f.on then
                table.insert(active, f)
            end
        end
        local sig = tostring(#active)
        for _, f in ipairs(active) do
            sig = sig .. "|" .. f.name .. ":" .. (keyName(f.key) or "")
        end
        if sig == _lastSig then
            ActiveHud.Visible = #active > 0
            return
        end
        _lastSig = sig

        for i = 1, #rows do
            if rows[i] then rows[i].row.Visible = false end
        end
        for i, f in ipairs(active) do
            local r = ensureRow(i)
            r.row.Visible = true
            r.nameLbl.Text = f.name
            local kn = keyName(f.key)
            if kn then
                r.keyLbl.Visible = true
                r.keyLbl.Text = kn
                r.nameLbl.Size = UDim2.new(1, -36, 1, 0)
            else
                r.keyLbl.Visible = false
                r.nameLbl.Size = UDim2.new(1, 0, 1, 0)
            end
        end
        ActiveHud.Visible = #active > 0
    end

    table.insert(connections, RunService.Heartbeat:Connect(function()
        refreshActiveHud()
    end))
end)()

