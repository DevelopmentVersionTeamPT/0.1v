local GameDetect = (function()
    local env = (getgenv and getgenv()) or _G
    env.TwilightUniverseCache = env.TwilightUniverseCache or {}
    local cache = env.TwilightUniverseCache
    local REDLINER_PLACE = 94987506187454

    if game.PlaceId == REDLINER_PLACE then
        cache[REDLINER_PLACE] = game.GameId
    end

    task.spawn(function()
        if cache[REDLINER_PLACE] then return end
        pcall(function()
            local HttpService = game:GetService("HttpService")
            local raw = game:HttpGet("https://apis.roblox.com/universes/v1/places/" .. tostring(REDLINER_PLACE) .. "/universe")
            local data = HttpService:JSONDecode(raw)
            local uid = tonumber(data.universeId)
            if uid then cache[REDLINER_PLACE] = uid end
        end)
    end)

    local function isRedliner()
        if game.PlaceId == REDLINER_PLACE then return true end
        local uid = cache[REDLINER_PLACE]
        return uid ~= nil and game.GameId == uid
    end

    return {
        isArsenal = function()
            return game.PlaceId == 286090429 or game.PlaceId == 2377868063
        end,
        isRedliner = isRedliner,
        isOneTap = function()
            return game.PlaceId == 90568084448279
        end,
        isLostFront = function()
            return game.PlaceId == 102871156420149
        end,
        name = function()
            if game.PlaceId == 286090429 or game.PlaceId == 2377868063 then return "Arsenal" end
            if game.PlaceId == 142823291 then return "Murder Mystery 2" end
            if game.PlaceId == 90568084448279 then return "One Tap" end
            if game.PlaceId == 102871156420149 then return "The Lost Front" end
            if isRedliner() then return "Redliner" end
            return nil
        end,
    }
end)()
