runPanic = function()
    MainFrame.Visible = false
    lockedTarget = nil
    local off = {
        "Camera Lock", "Aim Radius", "Lock Fire", "360 Assist", "Triggerbot", "Expander",
        "2D Nametags", "2D Health Info", "2D Health Bar", "2D Distance", "2D Weapon",
        "2D Tracers", "2D Box", "2D Corner Box", "2D Skeleton", "2D Head Dot",
        "3D Highlight", "3D Chams", "3D Box", "3D Damage Numbers", "3D Team Outline", "3D Friend Outline",
        "3D Trail", "3D Beam", "Full Illumination", "Clear Atmosphere", "Unlimited Zoom", "NPC Visuals", "NPC Combat", "Target Info",
        "Walk Speed", "Jump Power", "Infinite Jump", "Noclip", "Click Teleport", "Sprint",
        "Fly", "Freecam", "Swim", "Sit", "Spin", "Freeze", "TP Tool",
        "Return on Death", "Anti Void", "Anti AFK",
    }
    for i = 1, #off do
        local reg = toggleRegistry[off[i]]
        if reg then reg.set(false) end
    end

    clearAllVisualEsp()
    pcall(function()
        if fovCircle then fovCircle.Visible = false end
    end)
    pcall(function()
        if TI and TI.frame then TI.frame.Visible = false end
    end)
    pcall(function()
        if Act.flyOff then Act.flyOff() end
        if Act.freecamOff then Act.freecamOff() end
        if Act.swimOff then Act.swimOff() end
        if Act.spinOff then Act.spinOff() end
        if Act.freezeOff then Act.freezeOff() end
        if Act.tpToolOff then Act.tpToolOff() end
        if Act.infZoomOff then Act.infZoomOff() end
        if Act.antiAfkOff then Act.antiAfkOff() end
    end)
end

