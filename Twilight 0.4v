local function twilightNotify(title, text, dur)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = dur or 4,
        })
    end)
end

local function twilightHttpRequest(opts)
    
    local req = nil
    pcall(function() req = request end)
    if not req then pcall(function() req = http_request end) end
    if not req then pcall(function() req = http and http.request end) end
    if not req then pcall(function() req = syn and syn.request end) end
    if not req then pcall(function() req = fluxus and fluxus.request end) end
    if not req then pcall(function() req = potassium and (potassium.request or potassium.http_request) end) end

    if not req then
        if (opts.Method == "GET" or not opts.Method) then
            local ok, body = pcall(function()
                return game:HttpGet(opts.Url)
            end)
            if ok and body then
                return { Body = body, StatusCode = 200, Success = true }
            end
        end
        return nil
    end

    local ok, res = pcall(req, opts)
    if not ok or type(res) ~= "table" then
        return nil
    end
    
    if res.Body == nil and res.body ~= nil then res.Body = res.body end
    if res.StatusCode == nil and res.status_code ~= nil then res.StatusCode = res.status_code end
    if res.Success == nil and typeof(res.StatusCode) == "number" then
        res.Success = res.StatusCode >= 200 and res.StatusCode < 300
    end
    return res
end

local function isJobIdString(s)
    if typeof(s) ~= "string" then return false end
    return s:match("^[%x]+%-[%x]+%-[%x]+%-[%x]+%-[%x]+$") ~= nil
end

local function joinSpecificServer(placeId, jobId)
    placeId = tonumber(placeId) or game.PlaceId
    jobId = tostring(jobId or ""):gsub("%s+", "")
    if jobId == "" then
        twilightNotify("Join Server", "Missing server id", 4)
        return
    end
    if jobId == game.JobId and placeId == game.PlaceId then
        twilightNotify("Join Server", "Already in that server", 3)
        return
    end
    twilightNotify("Join Server", "Teleporting...", 3)
    local TeleportService = game:GetService("TeleportService")
    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
    end)
    if not ok then
        twilightNotify("Join Server", "Failed: " .. tostring(err), 5)
    end
end

local function resolveJoinUserId(query)
    query = tostring(query or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if query == "" then return nil end

    local asNum = tonumber(query)
    if asNum then return asNum end

    local online = findPlayer(query)
    if online then return online.UserId end

    local HttpService = game:GetService("HttpService")
    local ok, result = pcall(function()
        local res = twilightHttpRequest({
            Url = "https://users.roblox.com/v1/usernames/users",
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({
                usernames = { query },
                excludeBannedUsers = true,
            }),
        })
        if not res or not res.Body then return nil end
        local data = HttpService:JSONDecode(res.Body)
        if data and data.data and data.data[1] and data.data[1].id then
            return data.data[1].id
        end
        return nil
    end)
    if ok and result then return result end
    return nil
end

local function joinPlayerServer(query)
    task.spawn(function()
        query = tostring(query or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if query == "" then
            twilightNotify("Join", "Usage: ;join username", 4)
            return
        end

        
        local parts = query:split(" ")
        if #parts >= 2 and tonumber(parts[1]) and isJobIdString(parts[2]) then
            joinSpecificServer(parts[1], parts[2])
            return
        end
        if #parts == 1 and isJobIdString(parts[1]) then
            joinSpecificServer(game.PlaceId, parts[1])
            return
        end

        twilightNotify("Join", "Looking up " .. query .. "...", 3)

        local userId = resolveJoinUserId(query)
        if not userId then
            twilightNotify("Join", "Player not found", 4)
            return
        end

        if userId == LocalPlayer.UserId then
            twilightNotify("Join", "That's you", 3)
            return
        end

        local sameServer = Players:GetPlayerByUserId(userId)
        if sameServer then
            twilightNotify("Join", "Already in this server — use ;to", 4)
            return
        end

        local HttpService = game:GetService("HttpService")
        local TeleportService = game:GetService("TeleportService")

        local ok, presence = pcall(function()
            local res = twilightHttpRequest({
                Url = "https://presence.roblox.com/v1/presence/users",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({ userIds = { userId } }),
            })
            if not res or not res.Body then return nil end
            return HttpService:JSONDecode(res.Body)
        end)

        if not ok or not presence or not presence.userPresences or not presence.userPresences[1] then
            twilightNotify("Join", "Couldn't read presence (check Potassium HTTP)", 5)
            return
        end

        local info = presence.userPresences[1]
        
        if (info.userPresenceType or 0) ~= 2 then
            twilightNotify("Join", "Player is not in a game", 4)
            return
        end

        local placeId = tonumber(info.placeId) or tonumber(info.rootPlaceId)
        local jobId = info.gameId
        if not placeId or not jobId or jobId == "" then
            twilightNotify("Join", "No server id (privacy / join disabled)", 5)
            return
        end

        if jobId == game.JobId then
            twilightNotify("Join", "Already in their server", 3)
            return
        end

        
        if placeId ~= game.PlaceId and tonumber(info.rootPlaceId) ~= game.PlaceId then
            local sameUniverse = false
            pcall(function()
                if game.GameId ~= 0 and info.universeId and tonumber(info.universeId) == game.GameId then
                    sameUniverse = true
                end
            end)
            if not sameUniverse then
                twilightNotify("Join", "Player is in a different game", 4)
                return
            end
        end

        twilightNotify("Join", "Teleporting to their server...", 3)
        local tpOk, tpErr = pcall(function()
            TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
        end)
        if not tpOk then
            twilightNotify("Join", "Teleport failed: " .. tostring(tpErr), 5)
        end
    end)
end

