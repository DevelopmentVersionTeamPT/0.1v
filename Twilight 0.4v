SearchResults.AutomaticCanvasSize = Enum.AutomaticSize.Y
SearchResults.ZIndex = 9

do
    local searchLayout = Instance.new("UIListLayout", SearchResults)
    searchLayout.Padding = UDim.new(0, 4)
    searchLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    searchLayout.SortOrder = Enum.SortOrder.LayoutOrder
end
local function refreshSearchResults(query)
    for _, child in ipairs(SearchResults:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    if query == "" then return end
    local lower = query:lower()
    local i = 0
    for label, reg in pairs(toggleRegistry) do
        if label:lower():find(lower, 1, true) then
            i = i + 1
            local row = Instance.new("Frame", SearchResults)
            row.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
            row.BorderSizePixel = 0
            row.Size = UDim2.new(0, 260, 0, 32)
            row.LayoutOrder = i
            row.ZIndex = 10
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

            local lbl = Instance.new("TextLabel", row)
            lbl.BackgroundTransparency = 1
            lbl.Position = UDim2.new(0, 10, 0, 0)
            lbl.Size = UDim2.new(0.65, 0, 1, 0)
            lbl.Font = Enum.Font.GothamBold
            lbl.Text = label
            lbl.TextColor3 = Color3.fromRGB(236, 236, 240)
            lbl.TextSize = 11
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.ZIndex = 10

            local state = reg.get()
            local btn = Instance.new("TextButton", row)
            btn.BackgroundColor3 = state and Color3.fromRGB(40, 88, 48) or Color3.fromRGB(42, 42, 46)
            btn.BorderSizePixel = 0
            btn.Position = UDim2.new(1, -55, 0.5, -10)
            btn.Size = UDim2.new(0, 42, 0, 20)
            btn.Font = Enum.Font.GothamBold
            btn.Text = state and "ON" or "OFF"
            btn.TextColor3 = Color3.fromRGB(236, 236, 240)
            btn.TextSize = 9
            btn.ZIndex = 10
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

            btn.MouseButton1Click:Connect(function()
                local newState = not reg.get()
                reg.set(newState)
                btn.Text = newState and "ON" or "OFF"
                btn.BackgroundColor3 = newState and Color3.fromRGB(40, 88, 48) or Color3.fromRGB(42, 42, 46)
            end)
        end
    end
end

SearchButton.MouseButton1Click:Connect(function()
    _searchOpen = not _searchOpen
    SearchPanel.Visible = _searchOpen
    SearchButton.TextColor3 = _searchOpen and Color3.fromRGB(230, 230, 234) or Color3.fromRGB(140, 142, 150)
    if _searchOpen then
        SearchInput.Text = ""
        SearchInput:CaptureFocus()
        refreshSearchResults("")
    end
end)

SearchInput:GetPropertyChangedSignal("Text"):Connect(function()
    refreshSearchResults(SearchInput.Text)
end)

SearchInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        
    end
end)


