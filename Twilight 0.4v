local function findInfoLabel(name)
    for _, child in ipairs(homeScroll:GetChildren()) do
        if child:IsA("Frame") then
            local foundName = false
            local valLabel = nil
            for _, lbl in ipairs(child:GetChildren()) do
                if lbl:IsA("TextLabel") and lbl.Text == name then
                    foundName = true
                end
                if lbl:IsA("TextLabel") and lbl.Font == Enum.Font.GothamBold then
                    valLabel = lbl
                end
            end
            if foundName and valLabel then return valLabel end
        end
    end
    return nil
end

local pingLabel = findInfoLabel("Ping")
local healthLabel = findInfoLabel("Health")
local posLabel = findInfoLabel("Position")
local regionLabel = findInfoLabel("Region")
local uptimeLabel = findInfoLabel("Uptime")

local scriptStartTime = tick()


local function getRegion()
    local stats = game:GetService("Stats")
    local ping = stats:FindFirstChild("PerformanceStats") and stats.PerformanceStats:FindFirstChild("Ping")
    if not ping then return "Unknown" end
    local ms = ping:GetValue()
    if ms < 60 then return "Local"
    elseif ms < 120 then return "NA"
    elseif ms < 200 then return "EU"
    elseif ms < 300 then return "Asia"
    else return "Far" end
end


task.spawn(function()
    while true do
        if not homeScroll or not homeScroll.Parent then break end

        
        if pingLabel and pingLabel.Parent then
            local stats = game:GetService("Stats")
            local ping = stats:FindFirstChild("PerformanceStats") and stats.PerformanceStats:FindFirstChild("Ping")
            if ping then
                pingLabel.Text = tostring(math.floor(ping:GetValue())) .. " ms"
            end
        end

        
        if healthLabel and healthLabel.Parent then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                healthLabel.Text = tostring(math.floor(hum.Health)) .. " / " .. tostring(math.floor(hum.MaxHealth))
            else
                healthLabel.Text = "Dead"
            end
        end

        
        if posLabel and posLabel.Parent then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local p = hrp.Position
                posLabel.Text = math.floor(p.X) .. ", " .. math.floor(p.Y) .. ", " .. math.floor(p.Z)
            else
                posLabel.Text = "N/A"
            end
        end

        
        if regionLabel and regionLabel.Parent then
            regionLabel.Text = getRegion()
        end

        
        if uptimeLabel and uptimeLabel.Parent then
            local elapsed = math.floor(tick() - scriptStartTime)
            local mins = math.floor(elapsed / 60)
            local secs = elapsed % 60
            if mins > 0 then
                uptimeLabel.Text = mins .. "m " .. secs .. "s"
            else
                uptimeLabel.Text = secs .. "s"
            end
        end

        task.wait(1)
    end
end)


task.spawn(function()
    
    local ok, img = pcall(function()
        return Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
    end)
    if ok and img and avatarImg and avatarImg.Parent then
        avatarImg.Image = img
    end

    
    local ok2, friendPages = pcall(function()
        return Players:GetFriendsAsync(LocalPlayer.UserId)
    end)
    if ok2 and friendPages and friendsVal and friendsVal.Parent then
        local total = 0
        pcall(function()
            while true do
                local items = friendPages:GetCurrentPage()
                total = total + #items
                if friendPages.IsFinished then break end
                friendPages:AdvanceToNextPageAsync()
            end
        end)
        friendsVal.Text = tostring(total)
    end

    
    pcall(function()
        local HttpService = game:GetService("HttpService")
        local userId = tostring(LocalPlayer.UserId)
        local data = HttpService:GetAsync("https://friends.roblox.com/v1/users/" .. userId .. "/followers/count")
        local parsed = HttpService:JSONDecode(data)
        if parsed and parsed.count and followersVal and followersVal.Parent then
            followersVal.Text = tostring(parsed.count)
        end
    end)

    pcall(function()
        local HttpService = game:GetService("HttpService")
        local userId = tostring(LocalPlayer.UserId)
        local data = HttpService:GetAsync("https://friends.roblox.com/v1/users/" .. userId .. "/followings/count")
        local parsed = HttpService:JSONDecode(data)
        if parsed and parsed.count and followingVal and followingVal.Parent then
            followingVal.Text = tostring(parsed.count)
        end
    end)
end)
end) 


local function CreateSectionHeader(parent, yPos, text)
    local header = Instance.new("TextLabel", parent)
    header.BackgroundTransparency = 1
    header.Position = UDim2.new(0.5, -130, 0, yPos)
    header.Size = UDim2.new(0, 260, 0, 18)
    header.Font = Enum.Font.GothamBold
    header.Text = string.upper(text)
    header.TextColor3 = Color3.fromRGB(110, 112, 120)
    header.TextSize = 10
    header.TextXAlignment = Enum.TextXAlignment.Left
    table.insert(themedElements, {type = "label", obj = header})
    return header
end

