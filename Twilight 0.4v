local infZoomEnabled = false
local _infZoomFov = nil
local _infZoomDefaultFov = 70
local _infZoomSavedMin = 0.5
local _infZoomSavedMax = 400

local function restoreInfZoom()
    infZoomEnabled = false
    LocalPlayer.CameraMinZoomDistance = _infZoomSavedMin or 0.5
    LocalPlayer.CameraMaxZoomDistance = _infZoomSavedMax or 400
    local cam = workspace.CurrentCamera
    if cam then
        cam.FieldOfView = _infZoomDefaultFov or 70
    end
    _infZoomFov = nil
end

cmdCommands["infzoom"] = function()
    if infZoomEnabled then
        restoreInfZoom()
        syncToggle("Unlimited Zoom", false)
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Unlimited Zoom",
                Text = "Off",
                Duration = 2,
            })
        end)
        return
    end

    local cam = workspace.CurrentCamera
    _infZoomSavedMin = LocalPlayer.CameraMinZoomDistance
    _infZoomSavedMax = LocalPlayer.CameraMaxZoomDistance
    _infZoomDefaultFov = (cam and cam.FieldOfView) or 70
    _infZoomFov = _infZoomDefaultFov

    LocalPlayer.CameraMinZoomDistance = 0.5
    LocalPlayer.CameraMaxZoomDistance = 1e5
    infZoomEnabled = true
    syncToggle("Unlimited Zoom", true)

    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Unlimited Zoom",
            Text = "Scroll in/out (distance + FOV)",
            Duration = 3,
        })
    end)
end
cmdCommands["uninfzoom"] = function()
    restoreInfZoom()
    syncToggle("Unlimited Zoom", false)
end

Act.infZoomOn = function()
    if not infZoomEnabled then cmdCommands["infzoom"]() end
end
Act.infZoomOff = function()
    restoreInfZoom()
    syncToggle("Unlimited Zoom", false)
end

table.insert(connections, UserInputService.InputChanged:Connect(function(input, processed)
    if not infZoomEnabled or not scriptActive then return end
    if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
    if UserInputService:GetFocusedTextBox() then return end

    local cam = workspace.CurrentCamera
    if not cam then return end

    local cur = _infZoomFov or cam.FieldOfView or 70
    local dir = input.Position.Z
    if dir == 0 then return end

    
    if dir > 0 then
        cur = cur - 5
    else
        cur = cur + 5
    end

    _infZoomFov = math.clamp(cur, 1, 120)
    cam.FieldOfView = _infZoomFov
end))

table.insert(connections, RunService.RenderStepped:Connect(function()
    if not scriptActive or not infZoomEnabled then return end
    LocalPlayer.CameraMinZoomDistance = 0.5
    LocalPlayer.CameraMaxZoomDistance = 1e5
    local cam = workspace.CurrentCamera
    if cam and _infZoomFov then
        cam.FieldOfView = _infZoomFov
    end
end))


cmdCommands["respawn"] = function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if hrp then
        hrp.CFrame = CFrame.new(0, -500, 0)
    end
    
    task.delay(0.5, function()
        if hum and hum.Health > 0 then
            hum.Health = 0
        end
    end)
end
Act.respawn = cmdCommands["respawn"]


local swimActive = false
local swimConnection = nil
cmdCommands["swim"] = function()
    if swimActive then return end
    swimActive = true
    syncToggle("Swim", true)
    local char = LocalPlayer.Character
    if not char then swimActive = false syncToggle("Swim", false) return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then swimActive = false syncToggle("Swim", false) return end
    
    hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
    hum:SetStateEnabled(Enum.HumanoidStateType.Running, false)
    hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
    hum:ChangeState(Enum.HumanoidStateType.Swimming)
    swimConnection = RunService.Heartbeat:Connect(function()
        if not swimActive then return end
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then
            h:ChangeState(Enum.HumanoidStateType.Swimming)
        end
    end)
end
cmdCommands["unswim"] = function()
    swimActive = false
    syncToggle("Swim", false)
    if swimConnection then
        swimConnection:Disconnect()
        swimConnection = nil
    end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end
Act.swimOn = cmdCommands["swim"]
Act.swimOff = cmdCommands["unswim"]




