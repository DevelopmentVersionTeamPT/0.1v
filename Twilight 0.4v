cmdSuggestFrame = Instance.new("Frame", ScreenGui)
cmdSuggestFrame.Name = "CmdSuggestions"
cmdSuggestFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
cmdSuggestFrame.BorderSizePixel = 0

cmdSuggestFrame.AnchorPoint = Vector2.new(0, 1)
cmdSuggestFrame.Position = UDim2.new(0, 8, 1, -42)
cmdSuggestFrame.Size = UDim2.new(0, 260, 0, 0)
cmdSuggestFrame.Visible = false
cmdSuggestFrame.ClipsDescendants = true
cmdSuggestFrame.ZIndex = 25
Instance.new("UICorner", cmdSuggestFrame).CornerRadius = UDim.new(0, 4)
do local s = Instance.new("UIStroke", cmdSuggestFrame); s.Color = Color3.fromRGB(45, 45, 45); s.Thickness = 1 end

local function collectCmdMatches(text)
    local baseCmd = (text:lower():split(" ")[1]) or ""
    local matches = {}
    if baseCmd == "" then return matches, baseCmd end
    local prefix = {}
    local contains = {}
    for name, _ in pairs(cmdCommands) do
        if name:sub(1, #baseCmd) == baseCmd then
            table.insert(prefix, name)
        elseif name:find(baseCmd, 1, true) then
            table.insert(contains, name)
        end
    end
    table.sort(prefix)
    table.sort(contains)
    for _, n in ipairs(prefix) do table.insert(matches, n) end
    for _, n in ipairs(contains) do
        local dup = false
        for _, m in ipairs(matches) do if m == n then dup = true break end end
        if not dup then table.insert(matches, n) end
    end
    return matches, baseCmd
end

local function updateCmdGhost(text, matches, baseCmd)
    if not matches or #matches == 0 or not baseCmd or baseCmd == "" then
        cmdGhost.Text = ""
        return
    end
    local pick = matches[math.clamp(cmdMatchIndex, 1, #matches)]
    if not pick or text:find(" ") then
        cmdGhost.Text = ""
        return
    end
    -- Only show the untyped suffix; hide the matching prefix so it doesn't stack on the TextBox.
    if pick:sub(1, #baseCmd) == baseCmd and pick ~= baseCmd then
        local suffix = pick:sub(#baseCmd + 1)
        cmdGhost.Text = '<font transparency="1">' .. text .. '</font>' .. suffix
    else
        cmdGhost.Text = ""
    end
end

local function clearSuggestionButtons()
    for _, child in ipairs(cmdSuggestFrame:GetChildren()) do
        if child:IsA("GuiObject") and child:GetAttribute("CmdSug") then
            child:Destroy()
        end
    end
end

local function rebuildSuggestionButtons()
    clearSuggestionButtons()
    local count = math.min(#cmdMatches, 6)
    if count == 0 then
        cmdSuggestFrame.Visible = false
        cmdSuggestFrame.Size = UDim2.new(0, 260, 0, 0)
        return
    end

    local pad = 5
    local rowH = 22
    for i = 1, count do
        local name = cmdMatches[i]
        local sugBtn = Instance.new("TextButton", cmdSuggestFrame)
        sugBtn:SetAttribute("CmdSug", true)
        sugBtn.BorderSizePixel = 0
        sugBtn.Position = UDim2.new(0, 6, 0, pad + (i - 1) * rowH)
        sugBtn.Size = UDim2.new(1, -12, 0, 20)
        sugBtn.Font = Enum.Font.GothamBold
        sugBtn.Text = name:sub(1, 1):upper() .. name:sub(2)
        sugBtn.TextSize = 11
        sugBtn.TextXAlignment = Enum.TextXAlignment.Left
        sugBtn.ZIndex = 26
        sugBtn.AutoButtonColor = false
        local selected = (i == cmdMatchIndex)
        sugBtn.BackgroundColor3 = selected and Color3.fromRGB(42, 42, 48) or Color3.fromRGB(18, 18, 18)
        sugBtn.BackgroundTransparency = selected and 0 or 1
        sugBtn.TextColor3 = selected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
        Instance.new("UICorner", sugBtn).CornerRadius = UDim.new(0, 3)
        do
            local padL = Instance.new("UIPadding", sugBtn)
            padL.PaddingLeft = UDim.new(0, 8)
        end
        sugBtn.MouseButton1Click:Connect(function()
            cmdMatchIndex = i
            cmdInput.Text = name .. " "
            cmdGhost.Text = ""
            cmdInput:CaptureFocus()
            cmdInput.CursorPosition = #cmdInput.Text + 1
            updateSuggestions(cmdInput.Text)
        end)
    end
    cmdSuggestFrame.Size = UDim2.new(0, 260, 0, pad * 2 + count * rowH)
    cmdSuggestFrame.Position = UDim2.new(0, 8, 1, -42)
    cmdSuggestFrame.Visible = true
end

local function updateSuggestions(text)
    local matches, baseCmd = collectCmdMatches(text)
    cmdMatches = matches
    if #cmdMatches == 0 then
        cmdMatchIndex = 1
        clearSuggestionButtons()
        cmdSuggestFrame.Visible = false
        cmdSuggestFrame.Size = UDim2.new(0, 260, 0, 0)
        cmdGhost.Text = ""
        return
    end
    if cmdMatchIndex > #cmdMatches then
        cmdMatchIndex = 1
    end
    updateCmdGhost(text, matches, baseCmd)
    rebuildSuggestionButtons()
end

local function autofillCmd(cycle)
    if #cmdMatches == 0 then
        local matches = collectCmdMatches(cmdInput.Text)
        cmdMatches = matches
        cmdMatchIndex = 1
    end
    if #cmdMatches == 0 then return end
    if cycle then
        cmdMatchIndex = cmdMatchIndex % #cmdMatches + 1
    end
    local pick = cmdMatches[math.clamp(cmdMatchIndex, 1, #cmdMatches)]
    if not pick then return end
    local rest = ""
    local sp = cmdInput.Text:find(" ")
    if sp then
        rest = cmdInput.Text:sub(sp)
    else
        rest = " "
    end
    cmdInput.Text = pick .. (rest == "" and " " or rest)
    cmdGhost.Text = ""
    cmdInput:CaptureFocus()
    cmdInput.CursorPosition = #pick + 2
    rebuildSuggestionButtons()
end

cmdInput:GetPropertyChangedSignal("Text"):Connect(function()
    if cmdInput.Text:sub(1, 1) == ";" then
        cmdInput.Text = cmdInput.Text:sub(2)
        return
    end
    cmdMatchIndex = 1
    updateSuggestions(cmdInput.Text)
end)

cmdInput.FocusLost:Connect(function(enterPressed)
    task.delay(0.15, function()
        if cmdSuggestFrame then
            cmdSuggestFrame.Visible = false
        end
        if cmdGhost then
            cmdGhost.Text = ""
        end
    end)
    if enterPressed then
        local raw = cmdInput.Text:gsub("^%s*(.-)%s*$", "%1")
        local parts = raw:split(" ")
        local cmd = parts[1] and parts[1]:lower() or ""
        local arg = parts[2] or ""

        if cmd == "view" and arg ~= "" then
            local target = findPlayer(arg)
            if target then
                viewingPlayer = target
            end
        elseif cmd == "to" and arg ~= "" then
            local target = findPlayer(arg)
            if target and target.Character then
                local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if targetRoot and myRoot then
                    myRoot.CFrame = targetRoot.CFrame + Vector3.new(0, 3, 0)
                end
            end
        elseif cmd == "target" and arg ~= "" then
            local target = findPlayer(arg)
            if target and target ~= LocalPlayer then
                targetEspPlayers[target] = true
                targetEspEnabled = true
            end
        elseif cmd == "untarget" and arg ~= "" then
            local target = findPlayer(arg)
            if target then
                targetEspPlayers[target] = nil
                if targetEspObjects[target] and targetEspObjects[target].Parent then
                    targetEspObjects[target]:Destroy()
                end
                targetEspObjects[target] = nil
            end
        elseif cmd == "esp" then
            if arg ~= "" then
                local target = findPlayer(arg)
                if target and target ~= LocalPlayer then
                    if not playerVisuals[target] then playerVisuals[target] = {} end
                    playerVisuals[target].esp = true
                end
            else
                if toggleRegistry["2D Nametags"] then toggleRegistry["2D Nametags"].set(not espEnabled) end
            end
        elseif cmd == "unesp" then
            if arg ~= "" then
                local target = findPlayer(arg)
                if target and playerVisuals[target] then
                    playerVisuals[target].esp = false
                end
            else
                if toggleRegistry["2D Nametags"] then toggleRegistry["2D Nametags"].set(false) end
            end
        elseif cmd == "highlight" then
            if arg ~= "" then
                local target = findPlayer(arg)
                if target and target ~= LocalPlayer then
                    if not playerVisuals[target] then playerVisuals[target] = {} end
                    playerVisuals[target].highlight = true
                end
            else
                if toggleRegistry["3D Highlight"] then toggleRegistry["3D Highlight"].set(not highlightEnabled) end
            end
        elseif cmd == "unhighlight" then
            if arg ~= "" then
                local target = findPlayer(arg)
                if target and playerVisuals[target] then
                    playerVisuals[target].highlight = false
                end
            else
                if toggleRegistry["3D Highlight"] then toggleRegistry["3D Highlight"].set(false) end
            end
        elseif cmd == "chams" then
            if arg ~= "" then
                local target = findPlayer(arg)
                if target and target ~= LocalPlayer then
                    if not playerVisuals[target] then playerVisuals[target] = {} end
                    playerVisuals[target].chams = true
                end
            else
                if toggleRegistry["3D Chams"] then toggleRegistry["3D Chams"].set(not chamsEnabled) end
            end
        elseif cmd == "unchams" then
            if arg ~= "" then
                local target = findPlayer(arg)
                if target and playerVisuals[target] then
                    playerVisuals[target].chams = false
                end
            else
                if toggleRegistry["3D Chams"] then toggleRegistry["3D Chams"].set(false) end
            end
        elseif cmd == "tracers" then
            if arg ~= "" then
                local target = findPlayer(arg)
                if target and target ~= LocalPlayer then
                    if not playerVisuals[target] then playerVisuals[target] = {} end
                    playerVisuals[target].tracers = true
                end
            else
                if toggleRegistry["2D Tracers"] then toggleRegistry["2D Tracers"].set(not tracersEnabled) end
            end
        elseif cmd == "untracers" then
            if arg ~= "" then
                local target = findPlayer(arg)
                if target and playerVisuals[target] then
                    playerVisuals[target].tracers = false
                end
            else
                if toggleRegistry["2D Tracers"] then toggleRegistry["2D Tracers"].set(false) end
            end
        elseif cmd == "skeleton" then
            if arg ~= "" then
                local target = findPlayer(arg)
                if target and target ~= LocalPlayer then
                    if not playerVisuals[target] then playerVisuals[target] = {} end
                    playerVisuals[target].skeleton = true
                end
            else
                if toggleRegistry["2D Skeleton"] then toggleRegistry["2D Skeleton"].set(not skeletonEnabled) end
            end
        elseif cmd == "unskeleton" then
            if arg ~= "" then
                local target = findPlayer(arg)
                if target and playerVisuals[target] then
                    playerVisuals[target].skeleton = false
                end
            else
                if toggleRegistry["2D Skeleton"] then toggleRegistry["2D Skeleton"].set(false) end
            end
        elseif cmd == "box" then
            if arg ~= "" then
                local target = findPlayer(arg)
                if target and target ~= LocalPlayer then
                    if not playerVisuals[target] then playerVisuals[target] = {} end
                    playerVisuals[target].box = true
                end
            else
                if toggleRegistry["2D Box"] then toggleRegistry["2D Box"].set(not boxEspEnabled) end
            end
        elseif cmd == "unbox" then
            if arg ~= "" then
                local target = findPlayer(arg)
                if target and playerVisuals[target] then
                    playerVisuals[target].box = false
                end
            else
                if toggleRegistry["2D Box"] then toggleRegistry["2D Box"].set(false) end
            end
        elseif cmd == "headdot" then
            if arg ~= "" then
                local target = findPlayer(arg)
                if target and target ~= LocalPlayer then
                    if not playerVisuals[target] then playerVisuals[target] = {} end
                    playerVisuals[target].headdot = true
                end
            else
                if toggleRegistry["2D Head Dot"] then toggleRegistry["2D Head Dot"].set(not headDotEnabled) end
            end
        elseif cmd == "unheaddot" then
            if arg ~= "" then
                local target = findPlayer(arg)
                if target and playerVisuals[target] then
                    playerVisuals[target].headdot = false
                end
            else
                if toggleRegistry["2D Head Dot"] then toggleRegistry["2D Head Dot"].set(false) end
            end
        elseif cmd == "trail" then
            if arg ~= "" then
                local target = findPlayer(arg)
                if target and target ~= LocalPlayer then
                    if not playerVisuals[target] then playerVisuals[target] = {} end
                    playerVisuals[target].trail = true
                end
            else
                if toggleRegistry["3D Trail"] then toggleRegistry["3D Trail"].set(not trailEnabled) end
            end
        elseif cmd == "untrail" then
            if arg ~= "" then
                local target = findPlayer(arg)
                if target and playerVisuals[target] then
                    playerVisuals[target].trail = false
                end
            else
                if toggleRegistry["3D Trail"] then toggleRegistry["3D Trail"].set(false) end
            end
        elseif cmd == "age" and arg ~= "" then
            local target = findPlayer(arg)
            if target then
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "Account Age",
                    Text = tostring(target.AccountAge) .. " days",
                    Duration = 5
                })
            end
        elseif cmd == "time" and arg ~= "" then
            local t = tonumber(arg)
            if t and t >= 0 and t <= 24 then
                game:GetService("Lighting").ClockTime = t
            end
        elseif cmd == "spin" then
            local spd = tonumber(arg) or 10
            Act.spinOn(spd)
        elseif cmd == "fly" then
            local spd = tonumber(arg)
            startFly(spd)
        elseif cmd == "freecam" then
            local spd = tonumber(arg)
            startFreecam(spd)
        elseif (cmd == "join" or cmd == "joinplr") and arg ~= "" then
            local query = raw:sub(#cmd + 2):gsub("^%s+", ""):gsub("%s+$", "")
            joinPlayerServer(query)
        elseif (cmd == "joinserver" or cmd == "joinserverid") and arg ~= "" then
            local rest = raw:sub(#cmd + 2):gsub("^%s+", ""):gsub("%s+$", "")
            local bits = rest:split(" ")
            if #bits >= 2 and tonumber(bits[1]) then
                joinSpecificServer(bits[1], bits[2])
            else
                joinSpecificServer(game.PlaceId, bits[1])
            end
        elseif cmd == "goto" and arg ~= "" then
            
            local coords = raw:sub(#cmd + 2)
            coords = coords:gsub(",", " ")
            local parts2 = coords:split(" ")
            local nums = {}
            for _, p in ipairs(parts2) do
                local n = tonumber(p:gsub("%s", ""))
                if n then table.insert(nums, n) end
            end
            if #nums >= 3 then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = CFrame.new(nums[1], nums[2], nums[3])
                end
            end
        elseif cmd == "chat" and arg ~= "" then
            local message = raw:sub(#cmd + 2)
            pcall(function()
                local channels = game:GetService("TextChatService"):FindFirstChild("TextChannels")
                if channels then
                    local gen = channels:FindFirstChild("RBXGeneral")
                    if gen then gen:SendAsync(message) end
                end
            end)
        elseif cmdCommands[cmd] and type(cmdCommands[cmd]) == "function" then
            cmdCommands[cmd]()
        end
    end
    
    deactivateCmdBar()

end)



table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    
    if cmdBarActive then
        if input.KeyCode == Enum.KeyCode.Tab then
            local base = (cmdInput.Text:lower():split(" ")[1]) or ""
            local cur = cmdMatches[cmdMatchIndex]
            autofillCmd(cur ~= nil and base == cur)
            return
        end
        if input.KeyCode == Enum.KeyCode.Down then
            if #cmdMatches > 0 then
                cmdMatchIndex = cmdMatchIndex % #cmdMatches + 1
                updateCmdGhost(cmdInput.Text, cmdMatches, (cmdInput.Text:lower():split(" ")[1]) or "")
                rebuildSuggestionButtons()
            end
            return
        end
        if input.KeyCode == Enum.KeyCode.Up then
            if #cmdMatches > 0 then
                cmdMatchIndex = cmdMatchIndex - 1
                if cmdMatchIndex < 1 then cmdMatchIndex = #cmdMatches end
                updateCmdGhost(cmdInput.Text, cmdMatches, (cmdInput.Text:lower():split(" ")[1]) or "")
                rebuildSuggestionButtons()
            end
            return
        end
        if input.KeyCode == Enum.KeyCode.Escape then
            deactivateCmdBar()
            return
        end
    end

    if processed then return end

    
    if input.KeyCode == Enum.KeyCode.Semicolon then
        if isMobile then return end
        if UserInputService:GetFocusedTextBox() and not cmdBarActive then return end
        if not cmdBarActive then
            activateCmdBar()
        end
        return
    end

    if input.KeyCode == Enum.KeyCode.Escape and freecamActive then
        stopFreecam()
        return
    end

    
    if input.KeyCode == Enum.KeyCode.RightShift and not cmdBarActive then
        if UserInputService:GetFocusedTextBox() then return end
        MainFrame.Visible = not MainFrame.Visible
        return
    end
end))


table.insert(connections, RunService.RenderStepped:Connect(function()
    if not scriptActive then return end
    if not viewingPlayer then return end

    local cam = workspace.CurrentCamera
    if not cam then return end

    if not viewingPlayer.Parent then
        viewingPlayer = nil
        cam.CameraType = Enum.CameraType.Custom
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then cam.CameraSubject = hum end
        return
    end

    local tChar = viewingPlayer.Character
    if not tChar then return end

    local tHum = tChar:FindFirstChildOfClass("Humanoid")
    local hrp = tChar:FindFirstChild("HumanoidRootPart")
        or tChar:FindFirstChild("UpperTorso")
        or tChar:FindFirstChild("Torso")

    if tHum and tHum.Health > 0 then
        cam.CameraType = Enum.CameraType.Custom
        if cam.CameraSubject ~= tHum then
            cam.CameraSubject = tHum
        end
        return
    end

    if hrp and hrp:IsA("BasePart") then
        cam.CameraType = Enum.CameraType.Scriptable
        local lookAt = hrp.Position + Vector3.new(0, 1.5, 0)
        cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 3, 10), lookAt)
    end
end))

task.spawn(function()
    local ok, err = pcall(playTwilightLoader)
    if not ok then
        warn("[Twilight] loader error:", err)
    end
    if MainFrame and MainFrame.Parent and not MainFrame.Visible then
        MainFrame.Visible = true
    end
    if ScreenGui and not ScreenGui.Parent then
        pcall(function()
            ScreenGui.Parent = LocalPlayer:FindFirstChild("PlayerGui") or CoreGui
        end)
        if MainFrame then MainFrame.Visible = true end
    end
end)

end)() 
