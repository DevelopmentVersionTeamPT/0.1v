local function createTabButton(name)
    local btn = Instance.new("TextButton", TabBar)
    btn.BackgroundTransparency = 1
    btn.BorderSizePixel = 0
    btn.Size = UDim2.new(0, math.max(56, math.ceil(#name * 6.4) + 16), 0, 26)
    btn.Font = Enum.Font.GothamBold
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(120, 122, 130)
    btn.TextSize = 11
    btn.AutoButtonColor = false
    local indicator = Instance.new("Frame", btn)
    indicator.Name = "Indicator"
    indicator.BackgroundColor3 = Color3.fromRGB(235, 235, 238)
    indicator.BorderSizePixel = 0
    indicator.AnchorPoint = Vector2.new(0.5, 1)
    indicator.Position = UDim2.new(0.5, 0, 1, 0)
    indicator.Size = UDim2.new(1, -10, 0, 1)
    indicator.Visible = false
    tabButtons[name] = btn
    return btn
end

local function createTabContent()
    local scroll = Instance.new("ScrollingFrame", ContentArea)
    scroll.BackgroundTransparency = 1
    scroll.Size = UDim2.new(1, 0, 1, 0)
    scroll.Visible = false
    scroll.ScrollBarThickness = 2
    scroll.ScrollBarImageColor3 = Color3.fromRGB(55, 55, 58)
    scroll.CanvasSize = UDim2.new(0, 0, 0, 320)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.BorderSizePixel = 0
    scroll.ScrollingDirection = Enum.ScrollingDirection.Y
    return scroll
end

local function switchTab(name)
    
    if _searchOpen then
        _searchOpen = false
        SearchPanel.Visible = false
        SearchButton.TextColor3 = Color3.fromRGB(140, 142, 150)
    end
    for tabName, frame in pairs(tabs) do
        frame.Visible = (tabName == name)
    end
    for tabName, btn in pairs(tabButtons) do
        local on = (tabName == name)
        btn.TextColor3 = on and Color3.fromRGB(240, 240, 242) or Color3.fromRGB(120, 122, 130)
        local indicator = btn:FindFirstChild("Indicator")
        if indicator then
            indicator.Visible = on
        end
    end
    activeTab = name
end

local function styleRowContainer(container)
    container.BackgroundColor3 = Color3.fromRGB(18, 18, 20)
    container.BorderSizePixel = 0
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 6)
end

local function CreateToggle(parent, yPos, label, default, callback)
    local container = Instance.new("Frame", parent)
    styleRowContainer(container)
    container.Position = UDim2.new(0.5, -130, 0, yPos)
    container.Size = UDim2.new(0, 260, 0, 32)
    table.insert(themedElements, {type = "container", obj = container})

    local lbl = Instance.new("TextLabel", container)
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.Size = UDim2.new(0.65, 0, 1, 0)
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(228, 228, 232)
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    table.insert(themedElements, {type = "label", obj = lbl})

    local btn = Instance.new("TextButton", container)
    btn.BackgroundColor3 = default and Color3.fromRGB(40, 88, 48) or Color3.fromRGB(42, 42, 46)
    btn.BorderSizePixel = 0
    btn.Position = UDim2.new(1, -80, 0.5, -10)
    btn.Size = UDim2.new(0, 42, 0, 20)
    btn.Font = Enum.Font.GothamBold
    btn.Text = default and "ON" or "OFF"
    btn.TextColor3 = Color3.fromRGB(236, 236, 240)
    btn.TextSize = 9
    local bc = Instance.new("UICorner", btn)
    bc.CornerRadius = UDim.new(0, 4)
    table.insert(themedElements, {type = "button", obj = btn, isToggle = true})

    
    local plusBtn = Instance.new("TextButton", container)
    plusBtn.BackgroundColor3 = Color3.fromRGB(42, 42, 46)
    plusBtn.BorderSizePixel = 0
    plusBtn.Position = UDim2.new(1, -33, 0.5, -10)
    plusBtn.Size = UDim2.new(0, 24, 0, 20)
    plusBtn.Font = Enum.Font.GothamBold
    plusBtn.Text = "+"
    plusBtn.TextColor3 = Color3.fromRGB(200, 200, 206)
    plusBtn.TextSize = 13
    Instance.new("UICorner", plusBtn).CornerRadius = UDim.new(0, 4)

    local _plusPanel = nil
    local _plusShifted = {}
    local _plusOpen = false
    local _plusBuilder = nil
    local _plusPanelHeight = 44
    local _plusGap = 6

    plusBtn.MouseButton1Click:Connect(function()
        if _plusOpen then
            
            local panelH = _plusPanel and _plusPanel.Size.Y.Offset or _plusPanelHeight
            local shift = panelH + _plusGap
            if _plusPanel and _plusPanel.Parent then _plusPanel:Destroy() end
            _plusPanel = nil
            for _, child in ipairs(_plusShifted) do
                if child and child.Parent then
                    child.Position = child.Position - UDim2.new(0, 0, 0, shift)
                end
            end
            _plusShifted = {}
            _plusOpen = false
            plusBtn.Text = "+"
        else
            if not _plusBuilder then return end
            local containerY = container.Position.Y.Offset
            local shift = _plusPanelHeight + _plusGap

            
            _plusShifted = {}
            for _, child in ipairs(parent:GetChildren()) do
                if child:IsA("GuiObject") and child ~= container then
                    if child.Position.Y.Offset > containerY then
                        child.Position = child.Position + UDim2.new(0, 0, 0, shift)
                        table.insert(_plusShifted, child)
                    end
                end
            end

            
            local panel = Instance.new("Frame", parent)
            panel.BackgroundColor3 = Color3.fromRGB(18, 18, 20)
            panel.BorderSizePixel = 0
            panel.Position = UDim2.new(0.5, -130, 0, containerY + 32 + _plusGap)
            panel.Size = UDim2.new(0, 260, 0, _plusPanelHeight)
            panel.ZIndex = 5
            Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 6)
            _plusPanel = panel
            _plusOpen = true
            plusBtn.Text = "-"

            
            _plusBuilder(panel)
        end
    end)

    
    local toggleInfo = {}
    toggleInfo.setBuilder = function(builder, height)
        _plusBuilder = builder
        _plusPanelHeight = height or 44
    end

    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = state and "ON" or "OFF"
        btn.BackgroundColor3 = state and Color3.fromRGB(40, 88, 48) or Color3.fromRGB(42, 42, 46)
        if callback then callback(state) end
    end)

    
    toggleRegistry[label] = {
        set = function(newState)
            if newState == state then return end
            state = newState
            btn.Text = state and "ON" or "OFF"
            btn.BackgroundColor3 = state and Color3.fromRGB(40, 88, 48) or Color3.fromRGB(42, 42, 46)
            if callback then callback(state) end
        end,
        setSilent = function(newState)
            state = newState and true or false
            btn.Text = state and "ON" or "OFF"
            btn.BackgroundColor3 = state and Color3.fromRGB(40, 88, 48) or Color3.fromRGB(42, 42, 46)
        end,
        get = function()
            return state
        end
    }

    return btn, toggleInfo
end

local function CreateCycle(parent, yPos, label, options, default, callback)
    local container = Instance.new("Frame", parent)
    styleRowContainer(container)
    container.Position = UDim2.new(0.5, -130, 0, yPos)
    container.Size = UDim2.new(0, 260, 0, 32)
    table.insert(themedElements, {type = "container", obj = container})

    local lbl = Instance.new("TextLabel", container)
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.Size = UDim2.new(0.55, 0, 1, 0)
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(228, 228, 232)
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    table.insert(themedElements, {type = "label", obj = lbl})

    local idx = 1
    for i, v in ipairs(options) do
        if v == default then idx = i break end
    end

    local btn = Instance.new("TextButton", container)
    btn.BackgroundColor3 = Color3.fromRGB(42, 42, 46)
    btn.BorderSizePixel = 0
    btn.Position = UDim2.new(1, -65, 0.5, -10)
    btn.Size = UDim2.new(0, 55, 0, 20)
    btn.Font = Enum.Font.GothamBold
    btn.Text = default
    btn.TextColor3 = Color3.fromRGB(236, 236, 240)
    btn.TextSize = 9
    local bc = Instance.new("UICorner", btn)
    bc.CornerRadius = UDim.new(0, 4)
    table.insert(themedElements, {type = "button", obj = btn, isToggle = false})

    btn.MouseButton1Click:Connect(function()
        idx = idx % #options + 1
        btn.Text = options[idx]
        if callback then callback(options[idx]) end
    end)
    return btn
end




local activeColorPicker = nil

local function CreateColorCycle(parent, yPos, label, options, default, callback, getColor)
    local container = Instance.new("Frame", parent)
    styleRowContainer(container)
    container.Position = UDim2.new(0.5, -130, 0, yPos)
    container.Size = UDim2.new(0, 260, 0, 32)
    table.insert(themedElements, {type = "container", obj = container})

    local lbl = Instance.new("TextLabel", container)
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.Size = UDim2.new(0.4, 0, 1, 0)
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(228, 228, 232)
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    table.insert(themedElements, {type = "label", obj = lbl})

    local idx = 1
    for i, v in ipairs(options) do
        if v == default then idx = i break end
    end

    local dotsBtn = Instance.new("TextButton", container)
    dotsBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 53)
    dotsBtn.BorderSizePixel = 0
    dotsBtn.Position = UDim2.new(1, -33, 0.5, -10)
    dotsBtn.Size = UDim2.new(0, 24, 0, 20)
    dotsBtn.Font = Enum.Font.GothamBold
    dotsBtn.Text = "+"
    dotsBtn.TextColor3 = Color3.fromRGB(236, 236, 240)
    dotsBtn.TextSize = 13
    Instance.new("UICorner", dotsBtn).CornerRadius = UDim.new(0, 4)

    
    local btn = Instance.new("TextButton", container)
    btn.BorderSizePixel = 0
    btn.Position = UDim2.new(1, -80, 0.5, -10)
    btn.Size = UDim2.new(0, 42, 0, 20)
    btn.Font = Enum.Font.GothamBold
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.ZIndex = 2
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

    
    local colorMap = {
        White = Color3.fromRGB(255, 255, 255),
        Red = Color3.fromRGB(255, 50, 50),
        Green = Color3.fromRGB(50, 255, 50),
        Blue = Color3.fromRGB(50, 100, 255),
        Purple = Color3.fromRGB(180, 50, 255),
        Yellow = Color3.fromRGB(255, 255, 50),
        Pink = Color3.fromRGB(255, 100, 180),
        Rainbow = Color3.fromRGB(255, 255, 255),
    }
    btn.BackgroundColor3 = colorMap[default] or Color3.fromRGB(255, 255, 255)

    btn.MouseButton1Click:Connect(function()
        idx = idx % #options + 1
        local val = options[idx]
        btn.BackgroundColor3 = colorMap[val] or Color3.fromRGB(255, 255, 255)
        if val == "Rainbow" then
            btn.BackgroundColor3 = Color3.fromHSV((tick() * 0.5) % 1, 1, 1)
        end
        if callback then callback(val) end
    end)

    local _cpOpen = false
    local _cpPanel = nil
    local _cpShifted = {}
    local PICKER_HEIGHT = 44

    dotsBtn.MouseButton1Click:Connect(function()
        if _cpOpen then
            
            if _cpPanel and _cpPanel.Parent then _cpPanel:Destroy() end
            _cpPanel = nil
            for _, child in ipairs(_cpShifted) do
                if child and child.Parent then
                    child.Position = child.Position - UDim2.new(0, 0, 0, PICKER_HEIGHT)
                end
            end
            _cpShifted = {}
            _cpOpen = false
            dotsBtn.Text = "+"
            return
        end

        
        local containerY = container.Position.Y.Offset
        _cpShifted = {}
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("GuiObject") and child ~= container then
                if child.Position.Y.Offset > containerY then
                    child.Position = child.Position + UDim2.new(0, 0, 0, PICKER_HEIGHT)
                    table.insert(_cpShifted, child)
                end
            end
        end

        local panel = Instance.new("Frame", parent)
        panel.BackgroundColor3 = Color3.fromRGB(18, 18, 20)
        panel.BorderSizePixel = 0
        panel.Position = UDim2.new(0.5, -130, 0, containerY + 34)
        panel.Size = UDim2.new(0, 260, 0, 38)
        panel.ZIndex = 5
        Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 5)
        _cpPanel = panel
        _cpOpen = true
        dotsBtn.Text = "-"

        
        local swatchColors = {
            Color3.fromRGB(255,255,255), Color3.fromRGB(255,50,50), Color3.fromRGB(255,150,50),
            Color3.fromRGB(255,255,50), Color3.fromRGB(50,255,50), Color3.fromRGB(50,255,255),
            Color3.fromRGB(50,100,255), Color3.fromRGB(180,50,255), Color3.fromRGB(255,100,180),
        }
        for i, col in ipairs(swatchColors) do
            local sw = Instance.new("TextButton", panel)
            sw.BackgroundColor3 = col
            sw.BorderSizePixel = 0
            sw.Position = UDim2.new(0, 8 + (i-1) * 27, 0.5, -9)
            sw.Size = UDim2.new(0, 22, 0, 18)
            sw.Text = ""
            sw.ZIndex = 6
            Instance.new("UICorner", sw).CornerRadius = UDim.new(0, 4)
            sw.MouseButton1Click:Connect(function()
                btn.BackgroundColor3 = col
                if callback then callback("Custom", col) end
            end)
        end
    end)

    return btn
end



