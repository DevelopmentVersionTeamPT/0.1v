;(function()
local function bindFeatureKey(panel, x, y, currentKey, onSet)
    local kbBtn = Instance.new("TextButton", panel)
    kbBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 53)
    kbBtn.BorderSizePixel = 0
    kbBtn.Position = UDim2.new(0, x, 0, y)
    kbBtn.Size = UDim2.new(0, 50, 0, 18)
    kbBtn.Font = Enum.Font.GothamBold
    kbBtn.Text = currentKey and currentKey.Name or "None"
    kbBtn.TextColor3 = Color3.fromRGB(236, 236, 240)
    kbBtn.TextSize = 9
    kbBtn.ZIndex = 6
    Instance.new("UICorner", kbBtn).CornerRadius = UDim.new(0, 4)
    kbBtn.MouseButton1Click:Connect(function()
        kbBtn.Text = "..."
        kbBtn.BackgroundColor3 = Color3.fromRGB(90, 50, 50)
        local conn
        conn = UserInputService.InputBegan:Connect(function(input, processed)
            if processed then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if input.KeyCode == Enum.KeyCode.Backspace then
                onSet(nil)
                kbBtn.Text = "None"
            else
                onSet(input.KeyCode)
                kbBtn.Text = input.KeyCode.Name
            end
            kbBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 53)
            conn:Disconnect()
        end)
    end)
end

