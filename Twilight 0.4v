end)
boxInfo.setBuilder(function(panel)
    local function addOptionRow(y, labelText, options, getVal, setVal)
        local lbl = Instance.new("TextLabel", panel)
        lbl.BackgroundTransparency = 1
        lbl.Position = UDim2.new(0, 10, 0, y)
        lbl.Size = UDim2.new(0, 70, 0, 18)
        lbl.Font = Enum.Font.GothamBold
        lbl.Text = labelText
        lbl.TextColor3 = Color3.fromRGB(168, 170, 180)
        lbl.TextSize = 10
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.ZIndex = 6

        local rowName = labelText .. "Opt"
        for i, opt in ipairs(options) do
            local b = Instance.new("TextButton", panel)
            b.Name = rowName
            b.BackgroundColor3 = (getVal() == opt[2]) and Color3.fromRGB(50, 90, 50) or Color3.fromRGB(40, 40, 43)
            b.BorderSizePixel = 0
            b.Position = UDim2.new(0, 85 + (i - 1) * 55, 0, y)
            b.Size = UDim2.new(0, 48, 0, 18)
            b.Font = Enum.Font.GothamBold
            b.Text = opt[1]
            b.TextColor3 = Color3.fromRGB(200, 202, 210)
            b.TextSize = 9
            b.ZIndex = 6
            Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
            b.MouseButton1Click:Connect(function()
                setVal(opt[2])
                for _, c in ipairs(panel:GetChildren()) do
                    if c:IsA("TextButton") and c.Name == rowName then
                        c.BackgroundColor3 = Color3.fromRGB(40, 40, 43)
                    end
                end
                b.BackgroundColor3 = Color3.fromRGB(50, 90, 50)
            end)
        end
    end

    addOptionRow(2, "Thickness", {{"Thin", 1}, {"Normal", 2}, {"Thick", 3}}, function()
        return boxThickness
    end, function(v)
        boxThickness = v
    end)

    addOptionRow(26, "Teammates", {{"ON", true}, {"OFF", false}}, function()
        return boxTeamTitle.friendlies
    end, function(v)
        boxTeamTitle.friendlies = v
    end)

    addOptionRow(50, "Enemies", {{"ON", true}, {"OFF", false}}, function()
        return boxTeamTitle.enemies
    end, function(v)
        boxTeamTitle.enemies = v
    end)
end, 74)

boxTeamTitle.enabled = true

