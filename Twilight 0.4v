;(function() 

local function CreateSlider(panel, y, label, minV, maxV, default, callback)
    local value = default

    local lbl = Instance.new("TextLabel", panel)
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 10, 0, y)
    lbl.Size = UDim2.new(0, 48, 0, 18)
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(160, 160, 160)
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 6

    local valLbl = Instance.new("TextLabel", panel)
    valLbl.BackgroundTransparency = 1
    valLbl.Position = UDim2.new(1, -42, 0, y)
    valLbl.Size = UDim2.new(0, 34, 0, 18)
    valLbl.Font = Enum.Font.GothamBold
    valLbl.Text = tostring(math.floor(value + 0.5))
    valLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    valLbl.TextSize = 10
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.ZIndex = 6

    local track = Instance.new("Frame", panel)
    track.BackgroundColor3 = Color3.fromRGB(40, 40, 43)
    track.BorderSizePixel = 0
    track.Position = UDim2.new(0, 60, 0, y + 6)
    track.Size = UDim2.new(0, 150, 0, 6)
    track.ZIndex = 6
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", track)
    fill.BackgroundColor3 = Color3.fromRGB(90, 94, 104)
    fill.BorderSizePixel = 0
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.ZIndex = 6
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", track)
    knob.BackgroundColor3 = Color3.fromRGB(230, 230, 234)
    knob.BorderSizePixel = 0
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.ZIndex = 7
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local function setFromAlpha(a)
        a = math.clamp(a, 0, 1)
        value = math.floor(minV + (maxV - minV) * a + 0.5)
        local t = (value - minV) / (maxV - minV)
        fill.Size = UDim2.new(t, 0, 1, 0)
        knob.Position = UDim2.new(t, 0, 0.5, 0)
        valLbl.Text = tostring(value)
        if callback then callback(value) end
    end

    setFromAlpha((default - minV) / math.max(maxV - minV, 1))

    local dragging = false
    local function updateFromX(x)
        setFromAlpha((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1))
    end

    local hit = Instance.new("TextButton", track)
    hit.BackgroundTransparency = 1
    hit.Size = UDim2.new(1, 8, 1, 16)
    hit.Position = UDim2.new(0, -4, 0.5, -8)
    hit.Text = ""
    hit.ZIndex = 8

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    table.insert(connections, UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            updateFromX(input.Position.X)
        end
    end))
    table.insert(connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

