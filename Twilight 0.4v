    if not noclipEnabled or not char or not char.Parent then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end))

;(function()
    local lastVoidTp = 0
    local deathCF = nil

    local function getSpawnCFrame()
        local team = LocalPlayer.Team
        local fallback
        for _, sp in ipairs(workspace:GetDescendants()) do
            if sp:IsA("SpawnLocation") then
                local okTeam = true
                if team then
                    okTeam = sp.Neutral or (sp.TeamColor == team.TeamColor)
                end
                if okTeam then
                    return sp.CFrame * CFrame.new(0, 5, 0)
                end
                if not fallback then fallback = sp end
            end
        end
        if fallback then
            return fallback.CFrame * CFrame.new(0, 5, 0)
        end
        local pads = workspace:FindFirstChild("SpawnLocation")
        if pads and pads:IsA("SpawnLocation") then
            return pads.CFrame * CFrame.new(0, 5, 0)
        end
        return CFrame.new(0, 80, 0)
    end

    local function tpToSpawn(hrp)
        if not hrp then return end
        local cf = getSpawnCFrame()
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
        pcall(function()
            if hrp.Parent and hrp.Parent.PivotTo then
                hrp.Parent:PivotTo(cf)
            else
                hrp.CFrame = cf
            end
        end)
    end

    local function hookDeath(char)
        local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 8)
        if not hum then return end
        table.insert(connections, hum.Died:Connect(function()
            if not scriptActive or not Safety.respawnLoc then
                deathCF = nil
                return
            end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                deathCF = hrp.CFrame
            end
        end))
    end

    if LocalPlayer.Character then
        task.spawn(hookDeath, LocalPlayer.Character)
    end
    table.insert(connections, LocalPlayer.CharacterAdded:Connect(function(char)
        hookDeath(char)
        if not Safety.respawnLoc or not deathCF then return end
        local cf = deathCF
        deathCF = nil
        task.spawn(function()
            local hrp = char:WaitForChild("HumanoidRootPart", 8)
            if not hrp or not scriptActive or not Safety.respawnLoc then return end
            for _ = 1, 8 do
                task.wait(0.05)
                if not hrp.Parent then return end
                pcall(function()
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.CFrame = cf
                end)
            end
        end)
    end))

    table.insert(connections, RunService.Heartbeat:Connect(function()
        if not scriptActive or not Safety.antiVoid then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        local destroyY = workspace.FallenPartsDestroyHeight
        if typeof(destroyY) ~= "number" then destroyY = -500 end
        local y = hrp.Position.Y
        local vy = 0
        pcall(function() vy = hrp.AssemblyLinearVelocity.Y end)

        
        local nearVoid = y <= (destroyY + 250)
        local fallingHard = (y < 0 and vy < -90) or (y < -150)
        if not nearVoid and not fallingHard then return end

        local now = tick()
        if now - lastVoidTp < 0.4 then return end
        lastVoidTp = now
        tpToSpawn(hrp)
    end))
end)()

table.insert(connections, RunService.RenderStepped:Connect(function()
    if not scriptActive then return end

    
    if fovCircleEnabled and fovCircle then
        local mousePos
        if isMobile or mobileControlsEnabled then
            local vs = Camera.ViewportSize
            mousePos = Vector2.new(vs.X / 2, vs.Y / 2)
        else
            mousePos = UserInputService:GetMouseLocation()
        end
        fovCircle.Position = Vector2.new(mousePos.X, mousePos.Y)
        fovCircle.Radius = fovRadius
        if rainbow.fov then
            fovCircle.Color = Color3.fromHSV((tick() * 0.5) % 1, 1, 1)
        else
            fovCircle.Color = fovCircleColor
        end
        fovCircle.Visible = true
    elseif fovCircle then
        fovCircle.Visible = false
    end

    

    if lockedTarget and getLockedChar() and hitboxEnabled then
        local root = getLockedChar():FindFirstChild("HumanoidRootPart")
        if root then
            root.Size = HITBOX_SIZE
            root.CanCollide = false
            if hitboxShape == "Sphere" then
                root.Shape = Enum.PartType.Ball
            elseif hitboxShape == "Cylinder" then
                root.Shape = Enum.PartType.Cylinder
            else
                root.Shape = Enum.PartType.Block
            end
            if hitboxVisible and hitboxOpacity > 0 then
                root.Transparency = 1 - (hitboxOpacity / 10)
                root.Color = hitboxColor
                root.Material = Enum.Material.SmoothPlastic
            else
                root.Transparency = 1
            end
        end
    end

    if not lockedTarget then return end
    local char = getLockedChar()
    if not char or not char.Parent then
        lockedTarget = nil
        return
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local part = getTargetPart(char)
    
    local targetDead = (not part or not hum or hum.Health <= 0)
    if not targetDead and hum then
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.Dead then
            targetDead = true
        elseif state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.FallingDown then
            
            local root = char:FindFirstChild("HumanoidRootPart")
            if root and root.Position.Y < -50 then
                targetDead = true
            end
        end
    end
    
    if not targetDead and part then
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        
        if myRoot and part.Position.Y < myRoot.Position.Y - 50 and part.Position.Y < -50 then
            targetDead = true
        end
        if part.Position.Magnitude < 1 then
            targetDead = true
        end
    end
    if targetDead then
        if hitboxEnabled then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                root.Size = Vector3.new(2, 2, 1)
                root.Transparency = 1
                root.CanCollide = false
                root.Material = Enum.Material.SmoothPlastic
            end
        end
        if autoRelockEnabled then
            local newTarget = getClosestPlayerToCursor()
            if newTarget and newTarget ~= lockedTarget then
                lockedTarget = newTarget
                if lockFeedbackEnabled then
                    local name = (espNameMode == "Display") and newTarget.DisplayName or newTarget.Name
                    game:GetService("StarterGui"):SetCore("SendNotification", {
                        Title = "Twilight",
                        Text = "Locked: " .. name,
                        Duration = 1.5
                    })
                end
            else
                lockedTarget = nil
            end
        else
            lockedTarget = nil
        end
        return
    end
end))



Act._lastAutoLockCheck = 0
Act._lastAcquireCheck = 0
table.insert(connections, RunService.Heartbeat:Connect(function()
    if not scriptActive or not camLockEnabled or not fovCircleEnabled then return end
    if camLockMode == "Auto" and not lockKeyHeld and lockedTarget then
        local now = tick()
        
        local checkInterval = rageBotEnabled and 0.12 or 0.25
        if now - Act._lastAutoLockCheck < checkInterval then return end
        Act._lastAutoLockCheck = now

        
        local currentChar = nil
        if typeof(lockedTarget) == "Instance" then
            if lockedTarget:IsA("Player") then currentChar = lockedTarget.Character
            else currentChar = lockedTarget end
        end
        if currentChar then
            local hum = currentChar:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                
                local target = getClosestPlayerToCursor()
                if target and target ~= lockedTarget then
                    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if rageBotEnabled and myRoot then
                        local newChar = target:IsA("Player") and target.Character or target
                        local newRoot = newChar and newChar:FindFirstChild("HumanoidRootPart")
                        local oldRoot = currentChar:FindFirstChild("HumanoidRootPart")
                        if newRoot and oldRoot then
                            local newDist = (newRoot.Position - myRoot.Position).Magnitude
                            local oldDist = (oldRoot.Position - myRoot.Position).Magnitude
                            
                            if newDist < oldDist then
                                lockedTarget = target
                            end
                        end
                    else
                        lockedTarget = target
                    end
                end
                return
            end
        end
        
        local target = getClosestPlayerToCursor()
        if target then
            lockedTarget = target
        end
    end
end))


table.insert(connections, (function()
    local stepName = "TwilightCamLock"
    local function updateCamLock()
    if not scriptActive or not camLockEnabled or not lockedTarget then return end
    if lockedTarget:IsA("Player") and H.isTeammate(lockedTarget) then
        lockedTarget = nil
        return
    end
    
    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myChar or not myHum or myHum.Health <= 0 then return end
    
    local camSubject = Camera.CameraSubject
    if camSubject and camSubject ~= myHum and not camSubject:IsDescendantOf(myChar) then return end
    
    local myHead = myChar:FindFirstChild("Head")
    local myTorso = myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Torso")
    if (myHead and myHead.Transparency >= 1) and (myTorso and myTorso.Transparency >= 1) then return end
    local char = getLockedChar()
    if not char or not char.Parent then lockedTarget = nil return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then lockedTarget = nil return end
    
    local _head = char:FindFirstChild("Head")
    local _torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if (_head and _head.Transparency >= 1) and (_torso and _torso.Transparency >= 1) then
        lockedTarget = nil return
    end
    
    if char:FindFirstChildOfClass("ForceField") then
        lockedTarget = nil return
    end
    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Dead then
        lockedTarget = nil return
    end
    
    
    if (state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.FallingDown) then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root and root.Position.Y < -50 then
            lockedTarget = nil return
        end
    end
    local part = getTargetPart(char)
    if not part then lockedTarget = nil return end
    local targetPos
    if usesSmartAim() then
        targetPos = getBestAimPoint(char, myChar)
        _currentAimPoint = targetPos
    else
        targetPos = part.Position
        _currentAimPoint = nil
    end
    if not targetPos then lockedTarget = nil return end
    
    if targetPos.Magnitude < 1 then lockedTarget = nil return end
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if myRoot and targetPos.Y < myRoot.Position.Y - 50 then lockedTarget = nil return end
    
    if part:IsA("BasePart") and part.AssemblyLinearVelocity.Y < -120 and targetPos.Y < -50 then lockedTarget = nil return end
    
    if fovVisibleOnly and tick() > _respawnGrace then
        if not H.isCharVisibleFast(char, myChar) then
            
            lockedTarget = nil
            return
        end
    end
    local camPos = Camera.CFrame.Position
    local targetCF = CFrame.lookAt(camPos, targetPos)
    Camera.CFrame = targetCF
    end

    pcall(function() RunService:UnbindFromRenderStep(stepName) end)
    RunService:BindToRenderStep(stepName, Enum.RenderPriority.Camera.Value + 1, updateCamLock)
    return {
        Disconnect = function()
            pcall(function() RunService:UnbindFromRenderStep(stepName) end)
        end
    }
end)())


table.insert(connections, RunService.Heartbeat:Connect(function()
    if not scriptActive or not camLockEnabled then return end
    
    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myChar or not myHum or myHum.Health <= 0 then
        lockedTarget = nil
        return
    end
    
    local camSubject = Camera.CameraSubject
    if camSubject and camSubject ~= myHum and not camSubject:IsDescendantOf(myChar) then
        lockedTarget = nil
        return
    end
    
    local myHead = myChar:FindFirstChild("Head")
    local myTorso = myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Torso")
    if (myHead and myHead.Transparency >= 1) and (myTorso and myTorso.Transparency >= 1) then
        lockedTarget = nil
        return
    end
    
    if tick() < _respawnGrace then return end
    
    if not fovCircleEnabled then return end
    if camLockMode == "Auto" and not lockKeyHeld and not lockedTarget then
        local now = tick()
        if now - Act._lastAcquireCheck < 0.07 then return end
        Act._lastAcquireCheck = now
        local target = getClosestPlayerToCursor()
        
        if not target and rageBotEnabled then
            local myRoot = myChar:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local closestDist = math.huge
                
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character then
                        local char = player.Character
                        local root = char:FindFirstChild("HumanoidRootPart")
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if root and hum and hum.Health > 0 then
                            if not H.isTeammate(player) then
                                local dist = (root.Position - myRoot.Position).Magnitude
                                if dist < closestDist and dist > 1 then
                                    closestDist = dist
                                    target = player
                                end
                            end
                        end
                    end
                end
            end
        end
        if target then
            lockedTarget = target
        end
    end
end))


;(function()
local _lastAutoKillTarget = nil
local _lastAutoKillTime = 0
local _lockAcquireTime = 0
local _lastFireTarget = nil
local _lastSettleAimPoint = nil
local _autoClickHeld = false
local _autoClickReleaseAt = 0
local _isArsenalPlace = (game.PlaceId == 286090429 or game.PlaceId == 2377868063)
local _lastTriggerFire = 0
local _tbRayParams = RaycastParams.new()
_tbRayParams.FilterType = Enum.RaycastFilterType.Exclude
_tbRayParams.IgnoreWater = true

local function getAimSettleDelay()
    if isMobile or mobileControlsEnabled then return 0.01 end
    if _isArsenalPlace then return 0.01 end
    if rageBotEnabled then return 0.07 end
    if usesSmartAim() then return 0.05 end
    return 0.035
end

local function releaseAutoClick()
    if not _autoClickHeld then return end
    _autoClickHeld = false
    
    if isMobile or mobileControlsEnabled then return end
    pcall(function()
        if mouse1release then
            mouse1release()
        end
    end)
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        local vp = Camera.ViewportSize
        local cx, cy = math.floor(vp.X / 2), math.floor(vp.Y / 2)
        vim:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
    end)
end

local function fireAutoClick()
    
    if isMobile or mobileControlsEnabled then
        local myChar2 = LocalPlayer.Character
        local tool = myChar2 and myChar2:FindFirstChildOfClass("Tool")
        if tool then
            pcall(function() tool:Activate() end)
        end
        return
    end

    local vp = Camera.ViewportSize
    local cx = math.floor(vp.X / 2 + math.random(-2, 2))
    local cy = math.floor(vp.Y / 2 + math.random(-2, 2))

    releaseAutoClick()

    if _isArsenalPlace then
        pcall(function()
            if mouse1press then
                mouse1press()
            elseif mouse1click then
                mouse1click()
            end
        end)
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            vim:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
        end)
        _autoClickHeld = true
        _autoClickReleaseAt = tick() + 0.015
    else
        local myChar2 = LocalPlayer.Character
        local tool = myChar2 and myChar2:FindFirstChildOfClass("Tool")
        if tool then
            pcall(function() tool:Activate() end)
        end
        pcall(function()
            if mouse1click then mouse1click() end
        end)
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            vim:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
            vim:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
        end)
    end
end

table.insert(connections, RunService.Heartbeat:Connect(function()
    if not scriptActive then
        releaseAutoClick()
        return
    end

    if _autoClickHeld and tick() >= _autoClickReleaseAt then
        releaseAutoClick()
    end

    
    if triggerbotEnabled and not UserInputService:GetFocusedTextBox() then
        local nowTb = tick()
        local delayTb = (triggerbotDelay and triggerbotDelay > 0) and triggerbotDelay or 0.05
        if nowTb - _lastTriggerFire >= delayTb then
            local cam = workspace.CurrentCamera or Camera
            local myCharTb = LocalPlayer.Character
            if cam and myCharTb then
                local vp = cam.ViewportSize
                local ray = cam:ViewportPointToRay(vp.X * 0.5, vp.Y * 0.5)
                _tbRayParams.FilterDescendantsInstances = {myCharTb}
                local hit = workspace:Raycast(ray.Origin, ray.Direction * 800, _tbRayParams)
                if hit and hit.Instance then
                    local model = hit.Instance:FindFirstAncestorOfClass("Model")
                    if model then
                        local hum = model:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 and not model:FindFirstChildOfClass("ForceField") then
                            local plr = Players:GetPlayerFromCharacter(model)
                            local valid = false
                            if plr and plr ~= LocalPlayer then
                                valid = not H.isTeammate(plr)
                            elseif npcCombatEnabled and not plr then
                                valid = true
                            end
                            if valid then
                                _lastTriggerFire = nowTb
                                fireAutoClick()
                            end
                        end
                    end
                end
            end
        end
    end

    if not autoLockKillEnabled or not camLockEnabled then return end
    if not lockedTarget then
        _lastAutoKillTarget = nil
        _lastFireTarget = nil
        _lastSettleAimPoint = nil
        releaseAutoClick()
        return
    end

    
    local char = nil
    if typeof(lockedTarget) == "Instance" and lockedTarget:IsA("Player") then
        char = lockedTarget.Character
    elseif typeof(lockedTarget) == "Instance" then
        char = lockedTarget
    end
    if not char or not char.Parent then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        _lastAutoKillTarget = nil
        return
    end

    
    local head = char:FindFirstChild("Head")
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if (head and head.Transparency >= 1) and (torso and torso.Transparency >= 1) then
        _lastAutoKillTarget = nil
        return
    end
    
    if char:FindFirstChildOfClass("ForceField") then
        _lastAutoKillTarget = nil
        return
    end

    
    local now = tick()
    if lockedTarget ~= _lastFireTarget then
        _lockAcquireTime = now
        _lastFireTarget = lockedTarget
        _lastSettleAimPoint = nil
    end

    local aimPoint = _currentAimPoint
    if usesSmartAim() then
        if not aimPoint then
            aimPoint = getBestAimPoint(char, LocalPlayer.Character)
        end
    else
        local targetPart = getTargetPart(char)
        aimPoint = targetPart and targetPart.Position
    end

    if usesSmartAim() and aimPoint and not _isArsenalPlace then
        if _lastSettleAimPoint and (aimPoint - _lastSettleAimPoint).Magnitude > 1.5 then
            _lockAcquireTime = now
        end
        _lastSettleAimPoint = aimPoint
    end

    if now - _lockAcquireTime < getAimSettleDelay() then return end

    local baseInterval = (autoLockKillDelay and autoLockKillDelay > 0) and autoLockKillDelay or 0.03
    if _isArsenalPlace then
        baseInterval = 0.03
    end
    if _lastAutoKillTarget == lockedTarget and (now - _lastAutoKillTime < baseInterval) then return end

    if aimPoint and not _isArsenalPlace and not (isMobile or mobileControlsEnabled) then
        local camLook = Camera.CFrame.LookVector
        local toTarget = (aimPoint - Camera.CFrame.Position).Unit
        local dot = camLook:Dot(toTarget)
        if dot < (usesSmartAim() and 0.90 or 0.94) then return end
    end

    _lastAutoKillTarget = lockedTarget
    _lastAutoKillTime = now
    fireAutoClick()
end))
end)()


table.insert(connections, RunService.Heartbeat:Connect(function()
    if not scriptActive then return end
    if not targetInfoEnabled or not lockedTarget then
        TI.frame.Visible = false
        return
    end

    
    if not lockedTarget:IsA("Player") then
        TI.frame.Visible = false
        return
    end

    local player = lockedTarget
    local char = player.Character
    if not char then
        TI.frame.Visible = false
        return
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 then
        TI.frame.Visible = false
        return
    end

    TI.frame.Visible = true

    
    TI.displayName.Text = player.DisplayName
    TI.username.Text = "@" .. player.Name

    
    local healthPct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
    TI.healthFill.Size = UDim2.new(healthPct, 0, 1, 0)
    if healthPct > 0.55 then
        TI.healthFill.BackgroundColor3 = Color3.fromRGB(220, 220, 224)
    elseif healthPct > 0.25 then
        TI.healthFill.BackgroundColor3 = Color3.fromRGB(210, 170, 90)
    else
        TI.healthFill.BackgroundColor3 = Color3.fromRGB(200, 90, 90)
    end
    TI.healthText.Text = tostring(math.floor(hum.Health))

    
    if root then
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myRoot then
            local dist = math.floor((myRoot.Position - root.Position).Magnitude)
            TI.distance.Text = dist .. "m"
        end
    end

    
    if TI.lastTarget ~= player then
        TI.lastTarget = player
        if TI.avatarCache[player.UserId] then
            TI.avatar.Image = TI.avatarCache[player.UserId]
        else
            TI.avatar.Image = ""
            task.spawn(function()
                local ok, img = pcall(function()
                    return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
                end)
                if ok and img then
                    TI.avatarCache[player.UserId] = img
                    if TI.lastTarget == player and TI.avatar and TI.avatar.Parent then
                        TI.avatar.Image = img
                    end
                end
            end)
        end
    end
end))

table.insert(connections, RunService.RenderStepped:Connect(function()
    if not scriptActive then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChildOfClass("Humanoid")

            if not espObjects[player] then
                espObjects[player] = {}
            end
            local obj = espObjects[player]

            if root and hum and hum.Health > 0 then
                local showPlayerEsp = espEnabled and (espTargetMode == "Players" or espTargetMode == "Both")
                if showPlayerEsp then
                    if not obj.billboard or not obj.billboard.Parent then
                        local bb = Instance.new("BillboardGui")
                        bb.Name = "VoidESP"
                        bb.Size = UDim2.new(0, 150, 0, 58)
                        bb.StudsOffset = Vector3.new(0, 3.5, 0)
                        bb.AlwaysOnTop = true
                        bb.Adornee = head or root
                        bb.Parent = char

                        local weapLabel = Instance.new("TextLabel", bb)
                        weapLabel.Name = "WeapLabel"
                        weapLabel.BackgroundTransparency = 1
                        weapLabel.Position = UDim2.new(0, 0, 0, 0)
                        weapLabel.Size = UDim2.new(1, 0, 0, 14)
                        weapLabel.Font = Enum.Font.GothamBold
                        weapLabel.TextColor3 = Color3.fromRGB(236, 236, 240)
                        weapLabel.TextSize = 12
                        weapLabel.TextStrokeTransparency = 0.4

                        local nameLabel = Instance.new("TextLabel", bb)
                        nameLabel.Name = "NameLabel"
                        nameLabel.BackgroundTransparency = 1
                        nameLabel.Position = UDim2.new(0, 0, 0, 14)
                        nameLabel.Size = UDim2.new(1, 0, 0, 14)
                        nameLabel.Font = Enum.Font.GothamBold
                        nameLabel.TextColor3 = Color3.fromRGB(236, 236, 240)
                        nameLabel.TextSize = 12
                        nameLabel.TextStrokeTransparency = 0.5

                        local healthLabel = Instance.new("TextLabel", bb)
                        healthLabel.Name = "HealthLabel"
                        healthLabel.BackgroundTransparency = 1
                        healthLabel.Position = UDim2.new(0, 0, 0, 28)
                        healthLabel.Size = UDim2.new(1, 0, 0, 12)
                        healthLabel.Font = Enum.Font.GothamBold
                        healthLabel.TextColor3 = Color3.fromRGB(180, 255, 180)
                        healthLabel.TextSize = 10
                        healthLabel.TextStrokeTransparency = 0.5

                        local distLabel = Instance.new("TextLabel", bb)
                        distLabel.Name = "DistLabel"
                        distLabel.BackgroundTransparency = 1
                        distLabel.Position = UDim2.new(0, 0, 0, 42)
                        distLabel.Size = UDim2.new(1, 0, 0, 12)
                        distLabel.Font = Enum.Font.GothamBold
                        distLabel.TextColor3 = Color3.fromRGB(236, 236, 240)
                        distLabel.TextSize = 9
                        distLabel.TextStrokeTransparency = 0.5

                        obj.billboard = bb
                    end
                    local bb = obj.billboard
                    local nameLabel = bb:FindFirstChild("NameLabel")
                    local healthLabel = bb:FindFirstChild("HealthLabel")
                    if nameLabel then
                        nameLabel.Text = (espNameMode == "Display") and player.DisplayName or player.Name
                        if rainbow.espPlayer then
                            nameLabel.TextColor3 = Color3.fromHSV((tick() * 0.5) % 1, 1, 1)
                        else
                            nameLabel.TextColor3 = espPlayerColor
                        end
                    end
                    if healthLabel then
                        if espHealthEnabled then
                            healthLabel.Visible = true
                            healthLabel.Text = tostring(math.floor(hum.Health))
                            if rainbowHealth then
                                healthLabel.TextColor3 = Color3.fromHSV((tick() * 0.5) % 1, 1, 1)
                            else
                                healthLabel.TextColor3 = espHealthColor
                            end
                        else
                            healthLabel.Visible = false
                        end
                    end
                    
                    local distLabel = bb:FindFirstChild("DistLabel")
                    if distLabel then
                        if distanceEspEnabled and root then
                            local myChar = LocalPlayer.Character
                            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                            if myRoot then
                                local dist = math.floor((myRoot.Position - root.Position).Magnitude)
                                distLabel.Text = "(" .. dist .. ") Studs"
                                distLabel.TextColor3 = distanceEspColor
                                distLabel.Visible = true
                            else
                                distLabel.Visible = false
                            end
                        else
                            distLabel.Visible = false
                        end
                    end
                    
                    local weapLabel = bb:FindFirstChild("WeapLabel")
                    if weapLabel then
                        if weaponEspEnabled then
                            local tool = char:FindFirstChildOfClass("Tool")
                            if tool then
                                weapLabel.Text = tool.Name
                                weapLabel.TextColor3 = weaponEspColor
                                weapLabel.Visible = true
                            else
                                weapLabel.Visible = false
                            end
                        else
                            weapLabel.Visible = false
                        end
                    end
                else
                    if obj.billboard then obj.billboard:Destroy() obj.billboard = nil end
                end

                if highlightEnabled then
                    if not obj.highlight or not obj.highlight.Parent then
                        local hl = Instance.new("Highlight")
                        hl.Name = "VoidHighlight"
                        hl.FillTransparency = espHighlightFill
                        hl.OutlineTransparency = 0
                        hl.Adornee = char
                        hl.Parent = char
                        obj.highlight = hl
                    end
                    obj.highlight.FillColor = highlightColor
                    obj.highlight.OutlineColor = highlightColor
                    obj.highlight.FillTransparency = espHighlightFill
                else
                    if obj.highlight then obj.highlight:Destroy() obj.highlight = nil end
                end

                if trailEnabled or rainbowTrailEnabled then
                    if not obj.trail or not obj.trail.Parent then
                        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or root
                        local a0 = Instance.new("Attachment")
                        a0.Name = "VoidTrailA0"
                        a0.Position = Vector3.new(0, 1, 0)
                        a0.Parent = torso
                        local a1 = Instance.new("Attachment")
                        a1.Name = "VoidTrailA1"
                        a1.Position = Vector3.new(0, -1, 0)
                        a1.Parent = torso
                        local trail = Instance.new("Trail")
                        trail.Name = "VoidTrail"
                        trail.Attachment0 = a0
                        trail.Attachment1 = a1
                        trail.Lifetime = trailLifetime
                        trail.Color = ColorSequence.new(trailColor)
                        trail.Transparency = NumberSequence.new(0, 1)
                        trail.WidthScale = NumberSequence.new(1, 0)
                        trail.Parent = torso
                        obj.trail = trail
                        obj.trailAttach0 = a0
                        obj.trailAttach1 = a1
                    end
                    if rainbowTrailEnabled then
                        local hue = (tick() * 0.5) % 1
                        obj.trail.Color = ColorSequence.new(Color3.fromHSV(hue, 1, 1))
                    else
                        obj.trail.Color = ColorSequence.new(trailColor)
                    end
                else
                    if obj.trail then obj.trail:Destroy() obj.trail = nil end
                    if obj.trailAttach0 then obj.trailAttach0:Destroy() obj.trailAttach0 = nil end
                    if obj.trailAttach1 then obj.trailAttach1:Destroy() obj.trailAttach1 = nil end
                end

                if chamsEnabled then
                    if not obj.chams or not obj.chams.Parent then
                        local hl = Instance.new("Highlight")
                        hl.Name = "VoidChams"
                        hl.FillTransparency = chamsFillTransparency
                        hl.OutlineTransparency = 1
                        hl.Adornee = char
                        hl.Parent = char
                        obj.chams = hl
                    end
                    obj.chams.FillColor = chamsColor
                    obj.chams.FillTransparency = chamsFillTransparency
                else
                    if obj.chams then obj.chams:Destroy() obj.chams = nil end
                end

                if tracersEnabled and hasDrawing then
                    if not obj.tracer then
                        local line = Drawing.new("Line")
                        line.Visible = false
                        line.Color = tracerColor
                        line.Thickness = tracerThickness
                        line.Transparency = 0.8
                        obj.tracer = line
                    end
                    obj.tracer.Color = tracerColor
                    obj.tracer.Thickness = tracerThickness
                    local targetPart = getTargetPart(char)
                    if targetPart then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local viewportSize = Camera.ViewportSize
                            obj.tracer.From = Vector2.new(viewportSize.X / 2, viewportSize.Y)
                            obj.tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                            obj.tracer.Visible = true
                        else
                            obj.tracer.Visible = false
                        end
                    else
                        obj.tracer.Visible = false
                    end
                else
                    if obj.tracer then obj.tracer:Remove() obj.tracer = nil end
                end

                
                if boxEspEnabled and hasDrawing then
                    local boxCol = boxEspColor
                    local showBox = true
                    if GameDetect.isLostFront() then
                        local isFriend = H.isLostFrontMate(player)
                        if isFriend then
                            showBox = boxTeamTitle.friendlies
                            boxCol = boxTeamTitle.friendCol
                        else
                            showBox = boxTeamTitle.enemies
                            boxCol = boxTeamTitle.enemyCol
                        end
                    end
                    if showBox then
                        if not obj.boxOutline then
                            local outline = Drawing.new("Quad")
                            outline.Visible = false
                            outline.Color = boxCol
                            outline.Thickness = boxThickness
                            outline.Filled = false
                            obj.boxOutline = outline
                        end
                        if not (rainbow.box and not GameDetect.isLostFront()) then
                            obj.boxOutline.Color = boxCol
                        end
                        obj.boxOutline.Thickness = boxThickness

                        local cam = workspace.CurrentCamera or Camera
                        local rootPos = root.Position
                        local facing = true
                        if cam then
                            local to = rootPos - cam.CFrame.Position
                            if to.Magnitude > 0.05 and to.Unit:Dot(cam.CFrame.LookVector) < 0.12 then
                                facing = false
                            end
                        end

                        if not facing then
                            H.hideQuad(obj.boxOutline)
                        else
                            local halfY = 2.5
                            local topV = H.worldToScreen2(rootPos + Vector3.new(0, halfY, 0))
                            local botV = H.worldToScreen2(rootPos + Vector3.new(0, -halfY, 0))
                            if topV and botV then
                                local height = math.abs(topV.Y - botV.Y)
                                local vpY = cam and cam.ViewportSize.Y or 800
                                if height < 3 or height > vpY * 1.15 then
                                    H.hideQuad(obj.boxOutline)
                                else
                                    local width = math.clamp(height * 0.55, 8, 90)
                                    local centerX = (topV.X + botV.X) * 0.5
                                    obj.boxOutline.PointA = Vector2.new(centerX - width * 0.5, topV.Y)
                                    obj.boxOutline.PointB = Vector2.new(centerX + width * 0.5, topV.Y)
                                    obj.boxOutline.PointC = Vector2.new(centerX + width * 0.5, botV.Y)
                                    obj.boxOutline.PointD = Vector2.new(centerX - width * 0.5, botV.Y)
                                    obj.boxOutline.Visible = true
                                end
                            else
                                H.hideQuad(obj.boxOutline)
                            end
                        end
                    else
                        if obj.boxOutline then H.hideQuad(obj.boxOutline) end
                    end
                else
                    if obj.boxOutline then pcall(function() obj.boxOutline:Remove() end) obj.boxOutline = nil end
                end

                
                if skeletonEnabled and hasDrawing then
                    local joints = {
                        {"Head", "UpperTorso"},
                        {"UpperTorso", "LowerTorso"},
                        {"UpperTorso", "LeftUpperArm"},
                        {"LeftUpperArm", "LeftLowerArm"},
                        {"LeftLowerArm", "LeftHand"},
                        {"UpperTorso", "RightUpperArm"},
                        {"RightUpperArm", "RightLowerArm"},
                        {"RightLowerArm", "RightHand"},
                        {"LowerTorso", "LeftUpperLeg"},
                        {"LeftUpperLeg", "LeftLowerLeg"},
                        {"LeftLowerLeg", "LeftFoot"},
                        {"LowerTorso", "RightUpperLeg"},
                        {"RightUpperLeg", "RightLowerLeg"},
                        {"RightLowerLeg", "RightFoot"},
                    }
                    
                    local isR15 = char:FindFirstChild("UpperTorso") ~= nil
                    if not isR15 then
                        joints = {
                            {"Head", "Torso"},
                            {"Torso", "Left Arm"},
                            {"Torso", "Right Arm"},
                            {"Torso", "Left Leg"},
                            {"Torso", "Right Leg"},
                        }
                    end

                    if not obj.skeleton then
                        obj.skeleton = {}
                    end

                    for i, joint in ipairs(joints) do
                        if not obj.skeleton[i] then
                            local line = Drawing.new("Line")
                            line.Visible = false
                            line.Color = skeletonColor
                            line.Thickness = skeletonThickness
                            line.Transparency = 0.9
                            obj.skeleton[i] = line
                        end

                        local part1 = char:FindFirstChild(joint[1])
                        local part2 = char:FindFirstChild(joint[2])
                        if part1 and part2 then
                            local p1, onScreen1 = Camera:WorldToViewportPoint(part1.Position)
                            local p2, onScreen2 = Camera:WorldToViewportPoint(part2.Position)
                            if onScreen1 and onScreen2 then
                                obj.skeleton[i].From = Vector2.new(p1.X, p1.Y)
                                obj.skeleton[i].To = Vector2.new(p2.X, p2.Y)
                                obj.skeleton[i].Color = skeletonColor
                                obj.skeleton[i].Thickness = skeletonThickness
                                obj.skeleton[i].Visible = true
                            else
                                obj.skeleton[i].Visible = false
                            end
                        else
                            obj.skeleton[i].Visible = false
                        end
                    end

                    
                    for i = #joints + 1, #obj.skeleton do
                        if obj.skeleton[i] then
                            obj.skeleton[i]:Remove()
                            obj.skeleton[i] = nil
                        end
                    end
                else
                    if obj.skeleton then
                        for _, line in pairs(obj.skeleton) do
                            line:Remove()
                        end
                        obj.skeleton = nil
                    end
                end

                
                if headDotEnabled and hasDrawing then
                    if not obj.headDot then
                        local dot = Drawing.new("Circle")
                        dot.Visible = false
                        dot.Color = headDotColor
                        dot.Thickness = 0
                        dot.NumSides = 24
                        dot.Radius = headDotRadius
                        dot.Filled = true
                        obj.headDot = dot
                    end
                    local headPart = char:FindFirstChild("Head")
                    if headPart then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(headPart.Position)
                        if onScreen then
                            obj.headDot.Position = Vector2.new(screenPos.X, screenPos.Y)
                            obj.headDot.Radius = headDotRadius
                            if rainbow.headDot then
                                obj.headDot.Color = Color3.fromHSV((tick() * 0.5) % 1, 1, 1)
                            else
                                obj.headDot.Color = headDotColor
                            end
                            obj.headDot.Visible = true
                        else
                            obj.headDot.Visible = false
                        end
                    else
                        obj.headDot.Visible = false
                    end
                else
                    if obj.headDot then pcall(function() obj.headDot:Remove() end) obj.headDot = nil end
                end

                
                if espHealthBarEnabled and hasDrawing then
                    if not obj.healthBarBg then
                        local bg = Drawing.new("Line")
                        bg.Visible = false
                        bg.Color = Color3.fromRGB(40, 40, 40)
                        bg.Thickness = espHealthBarWidth + 2
                        bg.Transparency = 0.7
                        obj.healthBarBg = bg
                    end
                    if not obj.healthBar then
                        local bar = Drawing.new("Line")
                        bar.Visible = false
                        bar.Color = Color3.fromRGB(0, 255, 0)
                        bar.Thickness = espHealthBarWidth
                        bar.Transparency = 0.9
                        obj.healthBar = bar
                    end
                    local rootPos = root.Position
                    local screenPos, onScreen = Camera:WorldToViewportPoint(rootPos)
                    if onScreen then
                        
                        local topWorld = Camera:WorldToViewportPoint(rootPos + Vector3.new(0, 2.5, 0))
                        local botWorld = Camera:WorldToViewportPoint(rootPos + Vector3.new(0, -2.5, 0))
                        local barHeight = math.abs(topWorld.Y - botWorld.Y)
                        local barWidth = barHeight * 0.55

                        
                        local centerX = screenPos.X
                        local leftX = centerX - barWidth / 2 - 5
                        local barTop = screenPos.Y - barHeight / 2
                        local barBot = screenPos.Y + barHeight / 2

                        local healthPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        local barFillTop = barBot - (barBot - barTop) * healthPct

                        obj.healthBarBg.From = Vector2.new(leftX, barTop)
                        obj.healthBarBg.To = Vector2.new(leftX, barBot)
                        obj.healthBarBg.Thickness = espHealthBarWidth + 2
                        obj.healthBarBg.Visible = true

                        obj.healthBar.From = Vector2.new(leftX, barFillTop)
                        obj.healthBar.To = Vector2.new(leftX, barBot)
                        obj.healthBar.Thickness = espHealthBarWidth
                        
                        local r = math.clamp((1 - healthPct) * 2, 0, 1)
                        local g = math.clamp(healthPct * 2, 0, 1)
                        obj.healthBar.Color = Color3.new(r, g, 0)
                        obj.healthBar.Visible = true
                    else
                        obj.healthBarBg.Visible = false
                        obj.healthBar.Visible = false
                    end
                else
                    if obj.healthBar then pcall(function() obj.healthBar:Remove() end) obj.healthBar = nil end
                    if obj.healthBarBg then pcall(function() obj.healthBarBg:Remove() end) obj.healthBarBg = nil end
                end

                
                if boxEsp3DEnabled and hasDrawing then
                    if not obj.box3d then
                        obj.box3d = {}
                        for i = 1, 12 do
                            local line = Drawing.new("Line")
                            line.Visible = false
                            line.Color = boxEsp3DColor
                            line.Thickness = boxEsp3DThickness
                            line.Transparency = 0.85
                            obj.box3d[i] = line
                        end
                    end
                    local cf = root.CFrame
                    
                    local sx, sy, sz = 2, 2.5, 1.5

                    
                    local corners = {
                        cf * Vector3.new(-sx, sy, -sz),
                        cf * Vector3.new(sx, sy, -sz),
                        cf * Vector3.new(sx, sy, sz),
                        cf * Vector3.new(-sx, sy, sz),
                        cf * Vector3.new(-sx, -sy, -sz),
                        cf * Vector3.new(sx, -sy, -sz),
                        cf * Vector3.new(sx, -sy, sz),
                        cf * Vector3.new(-sx, -sy, sz),
                    }

                    
                    local edges = {
                        {1,2},{2,3},{3,4},{4,1}, 
                        {5,6},{6,7},{7,8},{8,5}, 
                        {1,5},{2,6},{3,7},{4,8}, 
                    }

                    local allVisible = true
                    local screenCorners = {}
                    for i, c in ipairs(corners) do
                        local sp = H.worldToScreen2(c)
                        if sp then
                            screenCorners[i] = sp
                        else
                            allVisible = false
                            break
                        end
                    end

                    if allVisible then
                        for i, edge in ipairs(edges) do
                            local line = obj.box3d[i]
                            line.From = screenCorners[edge[1]]
                            line.To = screenCorners[edge[2]]
                            if rainbow.box3d then
                                line.Color = Color3.fromHSV((tick() * 0.5) % 1, 1, 1)
                            else
                                line.Color = boxEsp3DColor
                            end
                            line.Thickness = boxEsp3DThickness
                            line.Visible = true
                        end
                    else
                        for i = 1, 12 do
                            H.hideLine(obj.box3d[i])
                        end
                    end
                else
                    if obj.box3d then
                        for _, line in pairs(obj.box3d) do pcall(function() line:Remove() end) end
                        obj.box3d = nil
                    end
                end

                
                if cornerBoxEnabled and hasDrawing then
                    if not obj.cornerBox then
                        obj.cornerBox = {}
                        for i = 1, 8 do
                            local line = Drawing.new("Line")
                            line.Visible = false
                            line.Color = cornerBoxColor
                            line.Thickness = cornerBoxThickness
                            line.Transparency = 0.9
                            obj.cornerBox[i] = line
                        end
                    end
                    local rootPos = root.Position
                    local _, onScreenCB = Camera:WorldToViewportPoint(rootPos)
                    if onScreenCB then
                        local topP = Camera:WorldToViewportPoint(rootPos + Vector3.new(0, 2.5, 0))
                        local botP = Camera:WorldToViewportPoint(rootPos + Vector3.new(0, -2.5, 0))
                        local height = math.abs(topP.Y - botP.Y)
                        local width = height * 0.55
                        local cx2 = (topP.X + botP.X) / 2
                        local topY2 = topP.Y
                        local botY2 = botP.Y
                        local left = cx2 - width / 2
                        local right = cx2 + width / 2
                        local len = math.max(height, width) * cornerBoxLength

                        local col = rainbow.cornerBox and Color3.fromHSV((tick() * 0.5) % 1, 1, 1) or cornerBoxColor

                        
                        obj.cornerBox[1].From = Vector2.new(left, topY2); obj.cornerBox[1].To = Vector2.new(left + len, topY2)
                        obj.cornerBox[2].From = Vector2.new(left, topY2); obj.cornerBox[2].To = Vector2.new(left, topY2 + len)
                        
                        obj.cornerBox[3].From = Vector2.new(right, topY2); obj.cornerBox[3].To = Vector2.new(right - len, topY2)
                        obj.cornerBox[4].From = Vector2.new(right, topY2); obj.cornerBox[4].To = Vector2.new(right, topY2 + len)
                        
                        obj.cornerBox[5].From = Vector2.new(left, botY2); obj.cornerBox[5].To = Vector2.new(left + len, botY2)
                        obj.cornerBox[6].From = Vector2.new(left, botY2); obj.cornerBox[6].To = Vector2.new(left, botY2 - len)
                        
                        obj.cornerBox[7].From = Vector2.new(right, botY2); obj.cornerBox[7].To = Vector2.new(right - len, botY2)
                        obj.cornerBox[8].From = Vector2.new(right, botY2); obj.cornerBox[8].To = Vector2.new(right, botY2 - len)

                        for i = 1, 8 do
                            obj.cornerBox[i].Color = col
                            obj.cornerBox[i].Thickness = cornerBoxThickness
                            obj.cornerBox[i].Visible = true
                        end
                    else
                        for i = 1, 8 do obj.cornerBox[i].Visible = false end
                    end
                else
                    if obj.cornerBox then
                        for _, line in pairs(obj.cornerBox) do pcall(function() line:Remove() end) end
                        obj.cornerBox = nil
                    end
                end

                
                if beamEspEnabled then
                    local myChar2 = LocalPlayer.Character
                    local myRoot2 = myChar2 and myChar2:FindFirstChild("HumanoidRootPart")
                    if myRoot2 then
                        if not obj.beam or not obj.beam.Parent then
                            
                            local a0 = Instance.new("Attachment")
                            a0.Name = "BeamESPA0"
                            a0.Parent = myRoot2
                            local a1 = Instance.new("Attachment")
                            a1.Name = "BeamESPA1"
                            a1.Parent = root
                            local beam = Instance.new("Beam")
                            beam.Name = "BeamESP"
                            beam.Attachment0 = a0
                            beam.Attachment1 = a1
                            beam.Width0 = 0.15
                            beam.Width1 = 0.15
                            beam.FaceCamera = true
                            beam.LightEmission = 1
                            beam.Transparency = NumberSequence.new(0.3)
                            beam.Parent = myRoot2
                            obj.beam = beam
                            obj.beamAttach0 = a0
                            obj.beamAttach1 = a1
                        end
                        
                        if rainbow.beam then
                            local beamCol = Color3.fromHSV((tick() * 0.5) % 1, 1, 1)
                            obj.beam.Color = ColorSequence.new(beamCol)
                        else
                            obj.beam.Color = ColorSequence.new(beamEspColor)
                        end
                        
                        if obj.beamAttach1 and obj.beamAttach1.Parent ~= root then
                            obj.beamAttach1.Parent = root
                        end
                    end
                else
                    if obj.beam then pcall(function() obj.beam:Destroy() end) obj.beam = nil end
                    if obj.beamAttach0 then pcall(function() obj.beamAttach0:Destroy() end) obj.beamAttach0 = nil end
                    if obj.beamAttach1 then pcall(function() obj.beamAttach1:Destroy() end) obj.beamAttach1 = nil end
                end

                
                local hue = (tick() * 0.5) % 1
                local rbColor = Color3.fromHSV(hue, 1, 1)

                if rainbow.highlight and obj.highlight then
                    obj.highlight.FillColor = rbColor
                    obj.highlight.OutlineColor = rbColor
                end
                if rainbow.chams and obj.chams then
                    obj.chams.FillColor = rbColor
                end
                if rainbow.tracer and obj.tracer then
                    obj.tracer.Color = rbColor
                end
                if rainbow.box and obj.boxOutline and not GameDetect.isLostFront() then
                    obj.boxOutline.Color = rbColor
                end
                if rainbow.skeleton and obj.skeleton then
                    for _, line in pairs(obj.skeleton) do
                        line.Color = rbColor
                    end
                end

            else
                if obj.billboard then pcall(function() obj.billboard:Destroy() end) obj.billboard = nil end
                if obj.highlight then pcall(function() obj.highlight:Destroy() end) obj.highlight = nil end
                if obj.trail then pcall(function() obj.trail:Destroy() end) obj.trail = nil end
                if obj.trailAttach0 then pcall(function() obj.trailAttach0:Destroy() end) obj.trailAttach0 = nil end
                if obj.trailAttach1 then pcall(function() obj.trailAttach1:Destroy() end) obj.trailAttach1 = nil end
                if obj.chams then pcall(function() obj.chams:Destroy() end) obj.chams = nil end
                if obj.tracer then H.hideLine(obj.tracer) pcall(function() obj.tracer:Remove() end) obj.tracer = nil end
                if obj.boxOutline then H.hideQuad(obj.boxOutline) pcall(function() obj.boxOutline:Remove() end) obj.boxOutline = nil end
                if obj.skeleton then
                    for _, line in pairs(obj.skeleton) do H.hideLine(line) pcall(function() line:Remove() end) end
                    obj.skeleton = nil
                end
                if obj.headDot then pcall(function() obj.headDot:Remove() end) obj.headDot = nil end
                if obj.healthBar then pcall(function() obj.healthBar:Remove() end) obj.healthBar = nil end
                if obj.healthBarBg then pcall(function() obj.healthBarBg:Remove() end) obj.healthBarBg = nil end
                if obj.box3d then
                    for _, line in pairs(obj.box3d) do H.hideLine(line) pcall(function() line:Remove() end) end
                    obj.box3d = nil
                end
                if obj.cornerBox then for _, line in pairs(obj.cornerBox) do H.hideLine(line) pcall(function() line:Remove() end) end obj.cornerBox = nil end
                if obj.beam then pcall(function() obj.beam:Destroy() end) obj.beam = nil end
                if obj.beamAttach0 then pcall(function() obj.beamAttach0:Destroy() end) obj.beamAttach0 = nil end
                if obj.beamAttach1 then pcall(function() obj.beamAttach1:Destroy() end) obj.beamAttach1 = nil end
            end
        end
    end

    for player, obj in pairs(espObjects) do
        local charOk = player.Parent and player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local humOk = charOk and player.Character:FindFirstChildOfClass("Humanoid")
        if not charOk or not humOk or humOk.Health <= 0 then
            if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
            if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
            if obj.trail then pcall(function() obj.trail:Destroy() end) end
            if obj.trailAttach0 then pcall(function() obj.trailAttach0:Destroy() end) end
            if obj.trailAttach1 then pcall(function() obj.trailAttach1:Destroy() end) end
            if obj.chams then pcall(function() obj.chams:Destroy() end) end
            if obj.beam then pcall(function() obj.beam:Destroy() end) end
            if obj.beamAttach0 then pcall(function() obj.beamAttach0:Destroy() end) end
            if obj.beamAttach1 then pcall(function() obj.beamAttach1:Destroy() end) end
            H.wipeEspDrawings(obj)
            espObjects[player] = nil
        end
    end
end))

