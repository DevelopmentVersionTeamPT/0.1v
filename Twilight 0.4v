local function getTimeStr()
    local ok, result = pcall(os.date, "%H:%M:%S")
    if ok then return result end
    return tostring(math.floor(tick() % 86400))
end


pcall(function()
    local TCS = game:GetService("TextChatService")
    if TCS and TCS.MessageReceived then
        TCS.MessageReceived:Connect(function(msg)
            pcall(function()
                local source = msg.TextSource
                if source then
                    local player = Players:GetPlayerByUserId(source.UserId)
                    local name = player and player.Name or "Unknown"
                    table.insert(chatLogs, {name = name, text = msg.Text, time = getTimeStr()})
                    if #chatLogs > 200 then table.remove(chatLogs, 1) end
                end
            end)
        end)
    end
end)

cmdCommands["chatlogs"] = function()
    
    if chatLogFrame and chatLogFrame.Parent then
        chatLogFrame:Destroy()
        chatLogFrame = nil
        return
    end

    chatLogFrame = Instance.new("Frame", ScreenGui)
    chatLogFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    chatLogFrame.BorderSizePixel = 0
    chatLogFrame.Position = UDim2.new(0.5, -180, 0.5, -150)
    chatLogFrame.Size = UDim2.new(0, 360, 0, 300)
    chatLogFrame.Active = true
    chatLogFrame.Draggable = true
    local clCorner = Instance.new("UICorner", chatLogFrame)
    clCorner.CornerRadius = UDim.new(0, 8)
    local clStroke = Instance.new("UIStroke", chatLogFrame)
    clStroke.Color = Color3.fromRGB(40, 40, 40)
    clStroke.Thickness = 1

    
    local clTitle = Instance.new("TextLabel", chatLogFrame)
    clTitle.BackgroundTransparency = 1
    clTitle.Position = UDim2.new(0, 12, 0, 8)
    clTitle.Size = UDim2.new(1, -40, 0, 20)
    clTitle.Font = Enum.Font.GothamBold
    clTitle.Text = "Chat Logs"
    clTitle.TextColor3 = Color3.fromRGB(236, 236, 240)
    clTitle.TextSize = 12
    clTitle.TextXAlignment = Enum.TextXAlignment.Left

    
    local clClose = Instance.new("TextButton", chatLogFrame)
    clClose.BackgroundTransparency = 1
    clClose.Position = UDim2.new(1, -28, 0, 6)
    clClose.Size = UDim2.new(0, 20, 0, 20)
    clClose.Font = Enum.Font.GothamBold
    clClose.Text = "X"
    clClose.TextColor3 = Color3.fromRGB(168, 170, 180)
    clClose.TextSize = 16
    clClose.MouseButton1Click:Connect(function()
        if chatLogFrame then chatLogFrame:Destroy() chatLogFrame = nil end
    end)

    
    local clScroll = Instance.new("ScrollingFrame", chatLogFrame)
    clScroll.BackgroundTransparency = 1
    clScroll.Position = UDim2.new(0, 8, 0, 30)
    clScroll.Size = UDim2.new(1, -16, 1, -38)
    clScroll.ScrollBarThickness = 3
    clScroll.ScrollBarImageColor3 = Color3.fromRGB(60, 60, 60)
    clScroll.BorderSizePixel = 0
    clScroll.CanvasSize = UDim2.new(0, 0, 0, 0)

    local clLayout = Instance.new("UIListLayout", clScroll)
    clLayout.Padding = UDim.new(0, 1)
    clLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local lastCount = 0

    local function refreshChatLog()
        if not clScroll or not clScroll.Parent then return end
        
        for i = lastCount + 1, #chatLogs do
            local log = chatLogs[i]
            local entry = Instance.new("TextLabel", clScroll)
            entry.BackgroundTransparency = 1
            entry.Size = UDim2.new(1, 0, 0, 16)
            entry.Font = Enum.Font.GothamBold
            entry.RichText = true
            entry.Text = "<font color=\"#555555\">[" .. log.time .. "]</font> <font color=\"#ffffff\"><b>" .. log.name .. "</b></font>: " .. log.text
            entry.TextColor3 = Color3.fromRGB(180, 180, 180)
            entry.TextSize = 10
            entry.TextXAlignment = Enum.TextXAlignment.Left
            entry.TextWrapped = true
            entry.LayoutOrder = i
        end
        lastCount = #chatLogs
        clScroll.CanvasSize = UDim2.new(0, 0, 0, #chatLogs * 17)
        clScroll.CanvasPosition = Vector2.new(0, math.max(0, #chatLogs * 17 - clScroll.AbsoluteSize.Y))
    end

    
    refreshChatLog()

    
    task.spawn(function()
        while chatLogFrame and chatLogFrame.Parent do
            refreshChatLog()
            task.wait(1)
        end
    end)
end
