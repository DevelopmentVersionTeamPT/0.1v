local function clearAllVisualEsp()
    espEnabled = false
    espHealthEnabled = false
    espHealthBarEnabled = false
    highlightEnabled = false
    chamsEnabled = false
    tracersEnabled = false
    trailEnabled = false
    rainbowTrailEnabled = false
    boxEspEnabled = false
    boxEsp3DEnabled = false
    skeletonEnabled = false
    headDotEnabled = false
    cornerBoxEnabled = false
    distanceEspEnabled = false
    weaponEspEnabled = false
    damageEspEnabled = false
    teamEspEnabled = false
    friendEspEnabled = false
    beamEspEnabled = false
    npcEspEnabled = false
    targetInfoEnabled = false
    fovCircleEnabled = false

    for _, obj in pairs(espObjects) do
        H.wipeEspDrawings(obj)
    end
    espObjects = {}

    for _, obj in pairs(npcEspObjects) do
        H.wipeEspDrawings(obj)
        if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
        if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
        if obj.trail then pcall(function() obj.trail:Destroy() end) end
        if obj.chams then pcall(function() obj.chams:Destroy() end) end
    end
    npcEspObjects = {}

    for _, hl in pairs(teamEspObjects) do
        pcall(function() if hl then hl:Destroy() end end)
    end
    teamEspObjects = {}
    for _, hl in pairs(friendEspObjects) do
        pcall(function() if hl then hl:Destroy() end end)
    end
    friendEspObjects = {}
    for _, hl in pairs(targetEspObjects) do
        pcall(function() if hl then hl:Destroy() end end)
    end
    targetEspObjects = {}

    for _, player in ipairs(Players:GetPlayers()) do
        local char = player.Character
        if char then
            for _, desc in ipairs(char:GetDescendants()) do
                local n = desc.Name
                if n == "VoidTrail" or n == "VoidTrailA0" or n == "VoidTrailA1"
                    or n == "VoidChams" or n == "VoidHighlight" or n == "VoidESP"
                    or n == "TeamESPHighlight" or n == "FriendESPHighlight" or n == "TargetESPHighlight" then
                    pcall(function() desc:Destroy() end)
                end
            end
        end
    end
end

