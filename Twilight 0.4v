local playTwilightLoader = (function()
    local TweenService = game:GetService("TweenService")
    local SCRIPT_VERSION = "2.5"

    local Loader = Instance.new("Frame", ScreenGui)
    Loader.Name = "TwilightLoader"
    Loader.BackgroundColor3 = Color3.fromRGB(8, 8, 9)
    Loader.BorderSizePixel = 0
    Loader.Size = UDim2.new(1, 0, 1, 0)
    Loader.ZIndex = 200
    Loader.Active = true

    local loaderBrand = Instance.new("TextLabel", Loader)
    loaderBrand.BackgroundTransparency = 1
    loaderBrand.AnchorPoint = Vector2.new(0.5, 0.5)
    loaderBrand.Position = UDim2.new(0.5, 0, 0.46, 10)
    loaderBrand.Size = UDim2.new(0, 320, 0, 40)
    loaderBrand.Font = Enum.Font.GothamBold
    loaderBrand.Text = "Twilight"
    loaderBrand.TextColor3 = Color3.fromRGB(242, 242, 242)
    loaderBrand.TextSize = 32
    loaderBrand.TextTransparency = 1
    loaderBrand.ZIndex = 202

    local loaderVersion = Instance.new("TextLabel", Loader)
    loaderVersion.BackgroundTransparency = 1
    loaderVersion.AnchorPoint = Vector2.new(0.5, 0.5)
    loaderVersion.Position = UDim2.new(0.5, 0, 0.46, 34)
    loaderVersion.Size = UDim2.new(0, 200, 0, 16)
    loaderVersion.Font = Enum.Font.GothamBold
    loaderVersion.Text = "v" .. SCRIPT_VERSION
    loaderVersion.TextColor3 = Color3.fromRGB(100, 100, 104)
    loaderVersion.TextSize = 12
    loaderVersion.TextTransparency = 1
    loaderVersion.ZIndex = 202

    local loaderTrack = Instance.new("Frame", Loader)
    loaderTrack.BackgroundColor3 = Color3.fromRGB(28, 28, 30)
    loaderTrack.BorderSizePixel = 0
    loaderTrack.AnchorPoint = Vector2.new(0.5, 0.5)
    loaderTrack.Position = UDim2.new(0.5, 0, 0.46, 56)
    loaderTrack.Size = UDim2.new(0, 120, 0, 1)
    loaderTrack.BackgroundTransparency = 1
    loaderTrack.ZIndex = 202

    local loaderFill = Instance.new("Frame", loaderTrack)
    loaderFill.BackgroundColor3 = Color3.fromRGB(230, 230, 232)
    loaderFill.BorderSizePixel = 0
    loaderFill.Size = UDim2.new(0, 0, 1, 0)
    loaderFill.ZIndex = 203

    local skipBtn = Instance.new("TextButton", Loader)
    skipBtn.BackgroundTransparency = 1
    skipBtn.BorderSizePixel = 0
    skipBtn.AnchorPoint = Vector2.new(0.5, 1)
    skipBtn.Position = UDim2.new(0.5, 0, 1, -28)
    skipBtn.Size = UDim2.new(0, 60, 0, 20)
    skipBtn.Font = Enum.Font.GothamBold
    skipBtn.Text = "Skip"
    skipBtn.TextColor3 = Color3.fromRGB(90, 90, 94)
    skipBtn.TextSize = 12
    skipBtn.TextTransparency = 1
    skipBtn.AutoButtonColor = false
    skipBtn.ZIndex = 205

    local loaderReady = false
    local loaderSkipped = false
    local loaderDone = false

    skipBtn.MouseButton1Click:Connect(function()
        loaderSkipped = true
    end)
    skipBtn.MouseEnter:Connect(function()
        skipBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)
    skipBtn.MouseLeave:Connect(function()
        skipBtn.TextColor3 = Color3.fromRGB(90, 90, 94)
    end)

    local function finishLoader()
        if loaderDone then return end
        loaderDone = true
        local fadeInfo = TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(loaderBrand, fadeInfo, {TextTransparency = 1}):Play()
        TweenService:Create(loaderVersion, fadeInfo, {TextTransparency = 1}):Play()
        TweenService:Create(loaderTrack, fadeInfo, {BackgroundTransparency = 1}):Play()
        TweenService:Create(loaderFill, fadeInfo, {BackgroundTransparency = 1}):Play()
        TweenService:Create(skipBtn, fadeInfo, {TextTransparency = 1}):Play()
        TweenService:Create(Loader, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = 1,
        }):Play()
        task.wait(0.38)
        if Loader and Loader.Parent then Loader:Destroy() end
        if MainFrame and MainFrame.Parent then
            MainFrame.Visible = true
        end
    end

    return function()
        if loaderReady then return end
        loaderReady = true

        TweenService:Create(loaderBrand, TweenInfo.new(0.55, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            TextTransparency = 0,
            Position = UDim2.new(0.5, 0, 0.46, 0),
        }):Play()
        task.wait(0.2)
        TweenService:Create(loaderVersion, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
        task.wait(0.08)
        if loaderSkipped then finishLoader() return end

        TweenService:Create(loaderTrack, TweenInfo.new(0.25), {BackgroundTransparency = 0}):Play()
        TweenService:Create(skipBtn, TweenInfo.new(0.25), {TextTransparency = 0}):Play()

        local marks = {0.3, 0.58, 0.82, 1}
        for _, t in ipairs(marks) do
            if loaderSkipped then break end
            TweenService:Create(loaderFill, TweenInfo.new(0.36, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(t, 0, 1, 0),
            }):Play()
            local t0 = tick()
            while tick() - t0 < 0.36 do
                if loaderSkipped then break end
                task.wait(0.04)
            end
            if loaderSkipped then break end
        end

        if not loaderSkipped then
            task.wait(0.1)
        end
        finishLoader()
    end
end)()


