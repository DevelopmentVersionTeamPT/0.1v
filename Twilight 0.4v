local function showDamageIndicator(character, damage)
    if not character then return end
    local head = character:FindFirstChild("Head")
    if not head then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = "DamageIndicator"
    bb.Size = UDim2.new(0, 100, 0, 40)
    bb.StudsOffset = Vector3.new(math.random(-10, 10) / 10, 4.5, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = head
    bb.Parent = character

    local dmgLabel = Instance.new("TextLabel", bb)
    dmgLabel.BackgroundTransparency = 1
    dmgLabel.Size = UDim2.new(1, 0, 1, 0)
    dmgLabel.Font = Enum.Font.GothamBold
    dmgLabel.Text = "-" .. tostring(math.floor(damage))
    dmgLabel.TextColor3 = damageEspColor
    dmgLabel.TextSize = damageEspSize
    dmgLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    dmgLabel.TextStrokeTransparency = 0.3

    
    task.spawn(function()
        local startTime = tick()
        local duration = 1.5
        local startOffset = bb.StudsOffset

        while tick() - startTime < duration do
            local elapsed = tick() - startTime
            local alpha = elapsed / duration

            
            bb.StudsOffset = startOffset + Vector3.new(0, alpha * 2, 0)

            
            dmgLabel.TextTransparency = alpha
            dmgLabel.TextStrokeTransparency = 0.3 + (alpha * 0.7)

            
            dmgLabel.TextSize = 16 - (alpha * 4)

            task.wait()
        end

        if bb and bb.Parent then
            bb:Destroy()
        end
    end)
end

local function connectDamageESP(player)
    if damageEspConnections[player] then
        pcall(function() damageEspConnections[player]:Disconnect() end)
    end

    local function hookCharacter(character)
        if not character then return end
        local hum = character:WaitForChild("Humanoid", 5)
        if not hum then return end

        local lastHealth = hum.Health

        
        if damageEspConnections[player] then
            pcall(function() damageEspConnections[player]:Disconnect() end)
        end

        damageEspConnections[player] = hum.HealthChanged:Connect(function(newHealth)
            if not damageEspEnabled then return end
            local damage = lastHealth - newHealth
            if damage > 0 then
                showDamageIndicator(character, damage)
            end
            lastHealth = newHealth
        end)
    end

    
    if player.Character then
        task.spawn(hookCharacter, player.Character)
    end

    
    player.CharacterAdded:Connect(function(char)
        task.spawn(hookCharacter, char)
    end)
end


for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        task.spawn(connectDamageESP, player)
    end
end


table.insert(connections, Players.PlayerAdded:Connect(function(player)
    task.spawn(connectDamageESP, player)
end))


table.insert(connections, Players.PlayerRemoving:Connect(function(player)
    if damageEspConnections[player] then
        pcall(function() damageEspConnections[player]:Disconnect() end)
        damageEspConnections[player] = nil
    end
    
    if playerVisualObjects[player] then
        local obj = playerVisualObjects[player]
        if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
        if obj.chams then pcall(function() obj.chams:Destroy() end) end
        if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
        playerVisualObjects[player] = nil
    end
    playerVisuals[player] = nil
end))




table.insert(connections, RunService.RenderStepped:Connect(function()
    if not scriptActive then return end
    for player, settings in pairs(playerVisuals) do
            if player and player.Parent and player.Character then
                local char = player.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                local head = char:FindFirstChild("Head")
                local root = char:FindFirstChild("HumanoidRootPart")

                if not playerVisualObjects[player] then
                    playerVisualObjects[player] = {}
                end
                local obj = playerVisualObjects[player]

                if hum and hum.Health > 0 and root then
                    
                    if settings.esp then
                        if not obj.billboard or not obj.billboard.Parent then
                            local bb = Instance.new("BillboardGui")
                            bb.Name = "PlayerVisualESP"
                            bb.Size = UDim2.new(0, 150, 0, 20)
                            bb.StudsOffset = Vector3.new(0, 3.5, 0)
                            bb.AlwaysOnTop = true
                            bb.Adornee = head or root
                            bb.Parent = char
                            local nl = Instance.new("TextLabel", bb)
                            nl.BackgroundTransparency = 1
                            nl.Size = UDim2.new(1, 0, 1, 0)
                            nl.Font = Enum.Font.GothamBold
                            nl.TextColor3 = Color3.fromRGB(255, 200, 50)
                            nl.TextSize = 12
                            nl.TextStrokeTransparency = 0.5
                            nl.Text = player.DisplayName
                            obj.billboard = bb
                        end
                    else
                        if obj.billboard then pcall(function() obj.billboard:Destroy() end) obj.billboard = nil end
                    end

                    
                    if settings.highlight then
                        if not obj.highlight or not obj.highlight.Parent then
                            local hl = Instance.new("Highlight")
                            hl.Name = "PlayerVisualHL"
                            hl.FillTransparency = 0.7
                            hl.OutlineTransparency = 0
                            hl.FillColor = settings.color or Color3.fromRGB(255, 200, 50)
                            hl.OutlineColor = settings.color or Color3.fromRGB(255, 200, 50)
                            hl.Adornee = char
                            hl.Parent = char
                            obj.highlight = hl
                        end
                    else
                        if obj.highlight then pcall(function() obj.highlight:Destroy() end) obj.highlight = nil end
                    end

                    
                    if settings.chams then
                        if not obj.chams or not obj.chams.Parent then
                            local hl = Instance.new("Highlight")
                            hl.Name = "PlayerVisualChams"
                            hl.FillTransparency = 0
                            hl.OutlineTransparency = 1
                            hl.FillColor = settings.color or Color3.fromRGB(255, 100, 50)
                            hl.Adornee = char
                            hl.Parent = char
                            obj.chams = hl
                        end
                    else
                        if obj.chams then pcall(function() obj.chams:Destroy() end) obj.chams = nil end
                    end

                    
                    if settings.trail then
                        if not obj.trail or not obj.trail.Parent then
                            local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or root
                            local a0 = Instance.new("Attachment"); a0.Name = "PVTrailA0"; a0.Position = Vector3.new(0,1,0); a0.Parent = torso
                            local a1 = Instance.new("Attachment"); a1.Name = "PVTrailA1"; a1.Position = Vector3.new(0,-1,0); a1.Parent = torso
                            local tr = Instance.new("Trail"); tr.Name = "PVTrail"; tr.Attachment0 = a0; tr.Attachment1 = a1
                            tr.Lifetime = 0.5; tr.Color = ColorSequence.new(Color3.fromRGB(255, 200, 50))
                            tr.Transparency = NumberSequence.new(0, 1); tr.WidthScale = NumberSequence.new(1, 0)
                            tr.Parent = torso
                            obj.trail = tr; obj.trailA0 = a0; obj.trailA1 = a1
                        end
                    else
                        if obj.trail then pcall(function() obj.trail:Destroy() end) obj.trail = nil end
                        if obj.trailA0 then pcall(function() obj.trailA0:Destroy() end) obj.trailA0 = nil end
                        if obj.trailA1 then pcall(function() obj.trailA1:Destroy() end) obj.trailA1 = nil end
                    end

                    
                    if settings.tracers and hasDrawing then
                        if not obj.tracer then
                            local line = Drawing.new("Line")
                            line.Color = Color3.fromRGB(255, 200, 50)
                            line.Thickness = 1
                            line.Transparency = 0.8
                            obj.tracer = line
                        end
                        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                        if onScreen then
                            local vp = Camera.ViewportSize
                            obj.tracer.From = Vector2.new(vp.X / 2, vp.Y)
                            obj.tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                            obj.tracer.Visible = true
                        else
                            obj.tracer.Visible = false
                        end
                    else
                        if obj.tracer then pcall(function() obj.tracer:Remove() end) obj.tracer = nil end
                    end

                    
                    if settings.box and hasDrawing then
                        if not obj.box then
                            obj.box = Drawing.new("Quad")
                            obj.box.Color = Color3.fromRGB(255, 200, 50)
                            obj.box.Thickness = 1
                            obj.box.Filled = false
                            obj.box.Visible = false
                        end
                        local size = char:GetExtentsSize()
                        local topV = H.worldToScreen2(root.Position + Vector3.new(0, size.Y/2, 0))
                        local botV = H.worldToScreen2(root.Position - Vector3.new(0, size.Y/2, 0))
                        if topV and botV then
                            local h2 = math.abs(topV.Y - botV.Y)
                            local w2 = h2 * 0.6
                            local cx = topV.X
                            obj.box.PointA = Vector2.new(cx - w2/2, topV.Y)
                            obj.box.PointB = Vector2.new(cx + w2/2, topV.Y)
                            obj.box.PointC = Vector2.new(cx + w2/2, botV.Y)
                            obj.box.PointD = Vector2.new(cx - w2/2, botV.Y)
                            obj.box.Visible = true
                        else
                            H.hideQuad(obj.box)
                        end
                    else
                        if obj.box then pcall(function() obj.box:Remove() end) obj.box = nil end
                    end

                    
                    if settings.headdot and hasDrawing then
                        if not obj.headdot then
                            obj.headdot = Drawing.new("Circle")
                            obj.headdot.Color = Color3.fromRGB(255, 200, 50)
                            obj.headdot.Thickness = 0
                            obj.headdot.NumSides = 24
                            obj.headdot.Radius = 4
                            obj.headdot.Filled = true
                        end
                        local headPart = char:FindFirstChild("Head")
                        if headPart then
                            local sp, onScreen = Camera:WorldToViewportPoint(headPart.Position)
                            if onScreen then
                                obj.headdot.Position = Vector2.new(sp.X, sp.Y)
                                obj.headdot.Visible = true
                            else
                                obj.headdot.Visible = false
                            end
                        else
                            obj.headdot.Visible = false
                        end
                    else
                        if obj.headdot then pcall(function() obj.headdot:Remove() end) obj.headdot = nil end
                    end

                    
                    if settings.skeleton and hasDrawing then
                        local joints
                        if char:FindFirstChild("UpperTorso") then
                            joints = {{"Head","UpperTorso"},{"UpperTorso","LowerTorso"},{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},{"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},{"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},{"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}}
                        else
                            joints = {{"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"}}
                        end
                        if not obj.skeleton then obj.skeleton = {} end
                        for i, jt in ipairs(joints) do
                            if not obj.skeleton[i] then
                                obj.skeleton[i] = Drawing.new("Line")
                                obj.skeleton[i].Color = Color3.fromRGB(255, 200, 50)
                                obj.skeleton[i].Thickness = 1
                                obj.skeleton[i].Transparency = 0.9
                            end
                            local p1 = char:FindFirstChild(jt[1])
                            local p2 = char:FindFirstChild(jt[2])
                            if p1 and p2 then
                                local s1, on1 = Camera:WorldToViewportPoint(p1.Position)
                                local s2, on2 = Camera:WorldToViewportPoint(p2.Position)
                                if on1 and on2 then
                                    obj.skeleton[i].From = Vector2.new(s1.X, s1.Y)
                                    obj.skeleton[i].To = Vector2.new(s2.X, s2.Y)
                                    obj.skeleton[i].Visible = true
                                else
                                    obj.skeleton[i].Visible = false
                                end
                            else
                                obj.skeleton[i].Visible = false
                            end
                        end
                        for i = #joints + 1, #obj.skeleton do
                            if obj.skeleton[i] then obj.skeleton[i]:Remove(); obj.skeleton[i] = nil end
                        end
                    else
                        if obj.skeleton then
                            for _, l in pairs(obj.skeleton) do pcall(function() l:Remove() end) end
                            obj.skeleton = nil
                        end
                    end
                else
                    
                    if obj.billboard then pcall(function() obj.billboard:Destroy() end) obj.billboard = nil end
                    if obj.highlight then pcall(function() obj.highlight:Destroy() end) obj.highlight = nil end
                    if obj.chams then pcall(function() obj.chams:Destroy() end) obj.chams = nil end
                    if obj.trail then pcall(function() obj.trail:Destroy() end) obj.trail = nil end
                    if obj.trailA0 then pcall(function() obj.trailA0:Destroy() end) obj.trailA0 = nil end
                    if obj.trailA1 then pcall(function() obj.trailA1:Destroy() end) obj.trailA1 = nil end
                    if obj.tracer then pcall(function() obj.tracer:Remove() end) obj.tracer = nil end
                    if obj.box then pcall(function() obj.box:Remove() end) obj.box = nil end
                    if obj.headdot then pcall(function() obj.headdot:Remove() end) obj.headdot = nil end
                    if obj.skeleton then for _, l in pairs(obj.skeleton) do pcall(function() l:Remove() end) end; obj.skeleton = nil end
                end
            else
                
                if playerVisualObjects[player] then
                    local obj = playerVisualObjects[player]
                    if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
                    if obj.chams then pcall(function() obj.chams:Destroy() end) end
                    if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
                    if obj.trail then pcall(function() obj.trail:Destroy() end) end
                    if obj.trailA0 then pcall(function() obj.trailA0:Destroy() end) end
                    if obj.trailA1 then pcall(function() obj.trailA1:Destroy() end) end
                    if obj.tracer then pcall(function() obj.tracer:Remove() end) end
                    if obj.box then pcall(function() obj.box:Remove() end) end
                    if obj.headdot then pcall(function() obj.headdot:Remove() end) end
                    if obj.skeleton then for _, l in pairs(obj.skeleton) do pcall(function() l:Remove() end) end end
                    playerVisualObjects[player] = nil
                end
                playerVisuals[player] = nil
            end
        end
end))




table.insert(connections, RunService.RenderStepped:Connect(function()
    if not scriptActive then return end
    if not npcEspEnabled then
        if next(npcEspObjects) then
            for _, obj in pairs(npcEspObjects) do
                if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
                if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
                if obj.trail then pcall(function() obj.trail:Destroy() end) end
                if obj.trailAttach0 then pcall(function() obj.trailAttach0:Destroy() end) end
                if obj.trailAttach1 then pcall(function() obj.trailAttach1:Destroy() end) end
                if obj.chams then pcall(function() obj.chams:Destroy() end) end
                if obj.tracer then pcall(function() obj.tracer:Remove() end) end
                if obj.boxOutline then pcall(function() obj.boxOutline:Remove() end) end
                if obj.skeleton then for _, l in pairs(obj.skeleton) do pcall(function() l:Remove() end) end end
                if obj.headDot then pcall(function() obj.headDot:Remove() end) end
                if obj.healthBar then pcall(function() obj.healthBar:Remove() end) end
                if obj.healthBarBg then pcall(function() obj.healthBarBg:Remove() end) end
                if obj.box3d then for _, line in pairs(obj.box3d) do pcall(function() line:Remove() end) end end
            end
            npcEspObjects = {}
        end
        return
    end

    local npcList = {}
    for _, m in ipairs(workspace:GetDescendants()) do
        if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") and m:FindFirstChild("HumanoidRootPart") and not Players:GetPlayerFromCharacter(m) then
            table.insert(npcList, m)
        end
    end
    for _, char in ipairs(npcList) do
        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")

        if not npcEspObjects[char] then npcEspObjects[char] = {} end
        local obj = npcEspObjects[char]

        if root and hum and hum.Health > 0 then
            
            local showNpcEsp = espEnabled and (espTargetMode == "NPCs" or espTargetMode == "Both")
            if showNpcEsp then
                if not obj.billboard or not obj.billboard.Parent then
                    local bb = Instance.new("BillboardGui")
                    bb.Name = "NPCVoidESP"
                    bb.Size = UDim2.new(0, 150, 0, 58)
                    bb.StudsOffset = Vector3.new(0, 3.5, 0)
                    bb.AlwaysOnTop = true
                    bb.Adornee = head or root
                    bb.Parent = char

                    local weapLabel = Instance.new("TextLabel", bb)
                    weapLabel.Name = "WeapLabel"; weapLabel.BackgroundTransparency = 1
                    weapLabel.Position = UDim2.new(0, 0, 0, 0); weapLabel.Size = UDim2.new(1, 0, 0, 14)
                    weapLabel.Font = Enum.Font.GothamBold; weapLabel.TextColor3 = Color3.fromRGB(236, 236, 240)
                    weapLabel.TextSize = 12; weapLabel.TextStrokeTransparency = 0.4

                    local nameLabel = Instance.new("TextLabel", bb)
                    nameLabel.Name = "NameLabel"; nameLabel.BackgroundTransparency = 1
                    nameLabel.Position = UDim2.new(0, 0, 0, 14); nameLabel.Size = UDim2.new(1, 0, 0, 14)
                    nameLabel.Font = Enum.Font.GothamBold; nameLabel.TextColor3 = Color3.fromRGB(255, 150, 50)
                    nameLabel.TextSize = 12; nameLabel.TextStrokeTransparency = 0.5

                    local healthLabel = Instance.new("TextLabel", bb)
                    healthLabel.Name = "HealthLabel"; healthLabel.BackgroundTransparency = 1
                    healthLabel.Position = UDim2.new(0, 0, 0, 28); healthLabel.Size = UDim2.new(1, 0, 0, 12)
                    healthLabel.Font = Enum.Font.GothamBold; healthLabel.TextColor3 = Color3.fromRGB(180, 255, 180)
                    healthLabel.TextSize = 10; healthLabel.TextStrokeTransparency = 0.5

                    local distLabel = Instance.new("TextLabel", bb)
                    distLabel.Name = "DistLabel"; distLabel.BackgroundTransparency = 1
                    distLabel.Position = UDim2.new(0, 0, 0, 42); distLabel.Size = UDim2.new(1, 0, 0, 12)
                    distLabel.Font = Enum.Font.GothamBold; distLabel.TextColor3 = Color3.fromRGB(236, 236, 240)
                    distLabel.TextSize = 9; distLabel.TextStrokeTransparency = 0.5

                    obj.billboard = bb
                end
                local bb = obj.billboard
                local nameLabel = bb:FindFirstChild("NameLabel")
                if nameLabel then
                    nameLabel.Text = char.Name
                    if rainbow.espNpc then
                        nameLabel.TextColor3 = Color3.fromHSV((tick() * 0.5) % 1, 1, 1)
                    else
                        nameLabel.TextColor3 = espNpcColor
                    end
                end

                local healthLabel = bb:FindFirstChild("HealthLabel")
                if healthLabel then
                    if espHealthEnabled then
                        healthLabel.Visible = true
                        healthLabel.Text = tostring(math.floor(hum.Health))
                        healthLabel.TextColor3 = espHealthColor
                    else
                        healthLabel.Visible = false
                    end
                end

                local distLabel = bb:FindFirstChild("DistLabel")
                if distLabel then
                    if distanceEspEnabled then
                        local myChar = LocalPlayer.Character
                        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                        if myRoot then
                            local dist = math.floor((myRoot.Position - root.Position).Magnitude)
                            distLabel.Text = "(" .. dist .. ") Studs"
                            distLabel.TextColor3 = distanceEspColor
                            distLabel.Visible = true
                        else
                            distLabel.Visible = false
                        end
                    else
                        distLabel.Visible = false
                    end
                end

                local weapLabel = bb:FindFirstChild("WeapLabel")
                if weapLabel then
                    if weaponEspEnabled then
                        local tool = char:FindFirstChildOfClass("Tool")
                        if tool then
                            weapLabel.Text = tool.Name
                            weapLabel.TextColor3 = weaponEspColor
                            weapLabel.Visible = true
                        else
                            weapLabel.Visible = false
                        end
                    else
                        weapLabel.Visible = false
                    end
                end
            else
                if obj.billboard then obj.billboard:Destroy() obj.billboard = nil end
            end

            
            if highlightEnabled then
                if not obj.highlight or not obj.highlight.Parent then
                    local hl = Instance.new("Highlight")
                    hl.Name = "NPCVoidHighlight"
                    hl.FillTransparency = espHighlightFill
                    hl.OutlineTransparency = 0
                    hl.Adornee = char
                    hl.Parent = char
                    obj.highlight = hl
                end
                obj.highlight.FillColor = highlightColor
                obj.highlight.OutlineColor = highlightColor
                obj.highlight.FillTransparency = espHighlightFill
            else
                if obj.highlight then obj.highlight:Destroy() obj.highlight = nil end
            end

            
            if trailEnabled then
                if not obj.trail or not obj.trail.Parent then
                    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or root
                    local a0 = Instance.new("Attachment"); a0.Name = "NPCTrailA0"; a0.Position = Vector3.new(0,1,0); a0.Parent = torso
                    local a1 = Instance.new("Attachment"); a1.Name = "NPCTrailA1"; a1.Position = Vector3.new(0,-1,0); a1.Parent = torso
                    local trail = Instance.new("Trail")
                    trail.Attachment0 = a0; trail.Attachment1 = a1
                    trail.Lifetime = trailLifetime
                    trail.Color = ColorSequence.new(trailColor)
                    trail.Transparency = NumberSequence.new(0, 1)
                    trail.WidthScale = NumberSequence.new(1, 0)
                    trail.Parent = torso
                    obj.trail = trail; obj.trailAttach0 = a0; obj.trailAttach1 = a1
                end
                obj.trail.Color = ColorSequence.new(trailColor)
            else
                if obj.trail then obj.trail:Destroy() obj.trail = nil end
                if obj.trailAttach0 then obj.trailAttach0:Destroy() obj.trailAttach0 = nil end
                if obj.trailAttach1 then obj.trailAttach1:Destroy() obj.trailAttach1 = nil end
            end

            
            if chamsEnabled then
                if not obj.chams or not obj.chams.Parent then
                    local hl = Instance.new("Highlight")
                    hl.Name = "NPCVoidChams"
                    hl.FillTransparency = chamsFillTransparency
                    hl.OutlineTransparency = 1
                    hl.Adornee = char
                    hl.Parent = char
                    obj.chams = hl
                end
                obj.chams.FillColor = chamsColor
                obj.chams.FillTransparency = chamsFillTransparency
            else
                if obj.chams then obj.chams:Destroy() obj.chams = nil end
            end

            
            if tracersEnabled and hasDrawing then
                if not obj.tracer then
                    local line = Drawing.new("Line")
                    line.Color = tracerColor
                    line.Thickness = tracerThickness
                    line.Transparency = 0.8
                    obj.tracer = line
                end
                obj.tracer.Color = tracerColor
                obj.tracer.Thickness = tracerThickness
                local targetPart = (targetMode == "Torso") and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or root) or (head or root)
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local vp = Camera.ViewportSize
                    obj.tracer.From = Vector2.new(vp.X / 2, vp.Y)
                    obj.tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                    obj.tracer.Visible = true
                else
                    obj.tracer.Visible = false
                end
            else
                if obj.tracer then pcall(function() obj.tracer:Remove() end) obj.tracer = nil end
            end

            
            if boxEspEnabled and hasDrawing then
                if not obj.boxOutline then
                    local outline = Drawing.new("Quad")
                    outline.Visible = false
                    outline.Color = boxEspColor
                    outline.Thickness = boxThickness
                    outline.Filled = false
                    obj.boxOutline = outline
                end
                obj.boxOutline.Color = boxEspColor
                obj.boxOutline.Thickness = boxThickness
                local cam = workspace.CurrentCamera or Camera
                local rootPos = root.Position
                local facing = true
                if cam then
                    local to = rootPos - cam.CFrame.Position
                    if to.Magnitude > 0.05 and to.Unit:Dot(cam.CFrame.LookVector) < 0.12 then
                        facing = false
                    end
                end
                if not facing then
                    H.hideQuad(obj.boxOutline)
                else
                    local halfY = 2.5
                    local topV = H.worldToScreen2(rootPos + Vector3.new(0, halfY, 0))
                    local botV = H.worldToScreen2(rootPos + Vector3.new(0, -halfY, 0))
                    if topV and botV then
                        local h2 = math.abs(topV.Y - botV.Y)
                        local vpY = cam and cam.ViewportSize.Y or 800
                        if h2 < 3 or h2 > vpY * 1.15 then
                            H.hideQuad(obj.boxOutline)
                        else
                            local w2 = math.clamp(h2 * 0.55, 8, 90)
                            local cx = (topV.X + botV.X) * 0.5
                            obj.boxOutline.PointA = Vector2.new(cx - w2 * 0.5, topV.Y)
                            obj.boxOutline.PointB = Vector2.new(cx + w2 * 0.5, topV.Y)
                            obj.boxOutline.PointC = Vector2.new(cx + w2 * 0.5, botV.Y)
                            obj.boxOutline.PointD = Vector2.new(cx - w2 * 0.5, botV.Y)
                            obj.boxOutline.Visible = true
                        end
                    else
                        H.hideQuad(obj.boxOutline)
                    end
                end
            else
                if obj.boxOutline then H.hideQuad(obj.boxOutline) pcall(function() obj.boxOutline:Remove() end) obj.boxOutline = nil end
            end

            
            if skeletonEnabled and hasDrawing then
                local joints
                local isR15 = char:FindFirstChild("UpperTorso") ~= nil
                if isR15 then
                    joints = {{"Head","UpperTorso"},{"UpperTorso","LowerTorso"},{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},{"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},{"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},{"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}}
                else
                    joints = {{"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"}}
                end
                if not obj.skeleton then obj.skeleton = {} end
                for i, joint in ipairs(joints) do
                    if not obj.skeleton[i] then
                        local line = Drawing.new("Line")
                        line.Color = skeletonColor
                        line.Thickness = skeletonThickness
                        line.Transparency = 0.9
                        obj.skeleton[i] = line
                    end
                    local part1 = char:FindFirstChild(joint[1])
                    local part2 = char:FindFirstChild(joint[2])
                    if part1 and part2 then
                        local p1, on1 = Camera:WorldToViewportPoint(part1.Position)
                        local p2, on2 = Camera:WorldToViewportPoint(part2.Position)
                        if on1 and on2 then
                            obj.skeleton[i].From = Vector2.new(p1.X, p1.Y)
                            obj.skeleton[i].To = Vector2.new(p2.X, p2.Y)
                            obj.skeleton[i].Color = skeletonColor
                            obj.skeleton[i].Thickness = skeletonThickness
                            obj.skeleton[i].Visible = true
                        else
                            obj.skeleton[i].Visible = false
                        end
                    else
                        obj.skeleton[i].Visible = false
                    end
                end
                for i = #joints + 1, #obj.skeleton do
                    if obj.skeleton[i] then obj.skeleton[i]:Remove() obj.skeleton[i] = nil end
                end
            else
                if obj.skeleton then
                    for _, l in pairs(obj.skeleton) do pcall(function() l:Remove() end) end
                    obj.skeleton = nil
                end
            end

            
            if headDotEnabled and hasDrawing then
                if not obj.headDot then
                    local dot = Drawing.new("Circle")
                    dot.Color = headDotColor
                    dot.Thickness = 0
                    dot.NumSides = 24
                    dot.Radius = headDotRadius
                    dot.Filled = true
                    obj.headDot = dot
                end
                if head then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        obj.headDot.Position = Vector2.new(screenPos.X, screenPos.Y)
                        obj.headDot.Radius = headDotRadius
                        obj.headDot.Color = headDotColor
                        obj.headDot.Visible = true
                    else
                        obj.headDot.Visible = false
                    end
                else
                    obj.headDot.Visible = false
                end
            else
                if obj.headDot then pcall(function() obj.headDot:Remove() end) obj.headDot = nil end
            end

            
            if espHealthBarEnabled and hasDrawing then
                if not obj.healthBarBg then
                    local bg = Drawing.new("Line")
                    bg.Visible = false
                    bg.Color = Color3.fromRGB(40, 40, 40)
                    bg.Thickness = espHealthBarWidth + 2
                    bg.Transparency = 0.7
                    obj.healthBarBg = bg
                end
                if not obj.healthBar then
                    local bar = Drawing.new("Line")
                    bar.Visible = false
                    bar.Color = Color3.fromRGB(0, 255, 0)
                    bar.Thickness = espHealthBarWidth
                    bar.Transparency = 0.9
                    obj.healthBar = bar
                end
                local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    local topWorld = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 2.5, 0))
                    local botWorld = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, -2.5, 0))
                    local barHeight = math.abs(topWorld.Y - botWorld.Y)
                    local barWidth = barHeight * 0.55

                    local centerX = screenPos.X
                    local leftX = centerX - barWidth / 2 - 5
                    local barTop = screenPos.Y - barHeight / 2
                    local barBot = screenPos.Y + barHeight / 2

                    local healthPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    local barFillTop = barBot - (barBot - barTop) * healthPct

                    obj.healthBarBg.From = Vector2.new(leftX, barTop)
                    obj.healthBarBg.To = Vector2.new(leftX, barBot)
                    obj.healthBarBg.Thickness = espHealthBarWidth + 2
                    obj.healthBarBg.Visible = true
                    obj.healthBar.From = Vector2.new(leftX, barFillTop)
                    obj.healthBar.To = Vector2.new(leftX, barBot)
                    obj.healthBar.Thickness = espHealthBarWidth
                    local r = math.clamp((1 - healthPct) * 2, 0, 1)
                    local g = math.clamp(healthPct * 2, 0, 1)
                    obj.healthBar.Color = Color3.new(r, g, 0)
                    obj.healthBar.Visible = true
                else
                    obj.healthBarBg.Visible = false
                    obj.healthBar.Visible = false
                end
            else
                if obj.healthBar then pcall(function() obj.healthBar:Remove() end) obj.healthBar = nil end
                if obj.healthBarBg then pcall(function() obj.healthBarBg:Remove() end) obj.healthBarBg = nil end
            end

            
            if boxEsp3DEnabled and hasDrawing then
                if not obj.box3d then
                    obj.box3d = {}
                    for i = 1, 12 do
                        local line = Drawing.new("Line")
                        line.Visible = false
                        line.Color = boxEsp3DColor
                        line.Thickness = boxEsp3DThickness
                        line.Transparency = 0.85
                        obj.box3d[i] = line
                    end
                end
                local cf = root.CFrame
                
                local sx, sy, sz = 2, 2.5, 1.5
                local corners = {
                    cf * Vector3.new(-sx, sy, -sz), cf * Vector3.new(sx, sy, -sz),
                    cf * Vector3.new(sx, sy, sz), cf * Vector3.new(-sx, sy, sz),
                    cf * Vector3.new(-sx, -sy, -sz), cf * Vector3.new(sx, -sy, -sz),
                    cf * Vector3.new(sx, -sy, sz), cf * Vector3.new(-sx, -sy, sz),
                }
                local edges = {{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
                local allVisible = true
                local screenCorners = {}
                for i, c in ipairs(corners) do
                    local sp = H.worldToScreen2(c)
                    if sp then
                        screenCorners[i] = sp
                    else
                        allVisible = false
                        break
                    end
                end
                if allVisible then
                    for i, edge in ipairs(edges) do
                        local line = obj.box3d[i]
                        line.From = screenCorners[edge[1]]
                        line.To = screenCorners[edge[2]]
                        if rainbow.box3d then
                            line.Color = Color3.fromHSV((tick() * 0.5) % 1, 1, 1)
                        else
                            line.Color = boxEsp3DColor
                        end
                        line.Thickness = boxEsp3DThickness
                        line.Visible = true
                    end
                else
                    for i = 1, 12 do H.hideLine(obj.box3d[i]) end
                end
            else
                if obj.box3d then
                    for _, line in pairs(obj.box3d) do pcall(function() line:Remove() end) end
                    obj.box3d = nil
                end
            end
        else
            
            if obj.billboard then pcall(function() obj.billboard:Destroy() end) obj.billboard = nil end
            if obj.highlight then pcall(function() obj.highlight:Destroy() end) obj.highlight = nil end
            if obj.trail then pcall(function() obj.trail:Destroy() end) obj.trail = nil end
            if obj.trailAttach0 then pcall(function() obj.trailAttach0:Destroy() end) obj.trailAttach0 = nil end
            if obj.trailAttach1 then pcall(function() obj.trailAttach1:Destroy() end) obj.trailAttach1 = nil end
            if obj.chams then pcall(function() obj.chams:Destroy() end) obj.chams = nil end
            if obj.tracer then pcall(function() obj.tracer:Remove() end) obj.tracer = nil end
            if obj.boxOutline then pcall(function() obj.boxOutline:Remove() end) obj.boxOutline = nil end
            if obj.skeleton then for _, l in pairs(obj.skeleton) do pcall(function() l:Remove() end) end obj.skeleton = nil end
            if obj.headDot then pcall(function() obj.headDot:Remove() end) obj.headDot = nil end
            if obj.healthBar then pcall(function() obj.healthBar:Remove() end) obj.healthBar = nil end
            if obj.healthBarBg then pcall(function() obj.healthBarBg:Remove() end) obj.healthBarBg = nil end
            if obj.box3d then for _, line in pairs(obj.box3d) do pcall(function() line:Remove() end) end obj.box3d = nil end
        end
    end

    
    for model, obj in pairs(npcEspObjects) do
        if not model.Parent then
            if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
            if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
            if obj.trail then pcall(function() obj.trail:Destroy() end) end
            if obj.trailAttach0 then pcall(function() obj.trailAttach0:Destroy() end) end
            if obj.trailAttach1 then pcall(function() obj.trailAttach1:Destroy() end) end
            if obj.chams then pcall(function() obj.chams:Destroy() end) end
            if obj.tracer then pcall(function() obj.tracer:Remove() end) end
            if obj.boxOutline then pcall(function() obj.boxOutline:Remove() end) end
            if obj.skeleton then for _, l in pairs(obj.skeleton) do pcall(function() l:Remove() end) end end
            if obj.headDot then pcall(function() obj.headDot:Remove() end) end
            if obj.healthBar then pcall(function() obj.healthBar:Remove() end) end
            if obj.healthBarBg then pcall(function() obj.healthBarBg:Remove() end) end
            if obj.box3d then for _, line in pairs(obj.box3d) do pcall(function() line:Remove() end) end end
            npcEspObjects[model] = nil
        end
    end
end))




local friendCache = {} 
local function isFriend(player)
    if friendCache[player.UserId] ~= nil then
        return friendCache[player.UserId]
    end
    local success, result = pcall(function()
        return LocalPlayer:IsFriendsWith(player.UserId)
    end)
    if success then
        friendCache[player.UserId] = result
        return result
    end
    return false
end

task.spawn(function()
    while true do
        if not scriptActive then break end

        
        if targetEspEnabled then
            
            local hasTargets = false
            for _ in pairs(targetEspPlayers) do hasTargets = true break end
            if not hasTargets then
                targetEspEnabled = false
            end
        end

        if targetEspEnabled then
            for player, _ in pairs(targetEspPlayers) do
                if player and player.Parent and player.Character then
                    local char = player.Character
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local targetColor = Color3.fromRGB(255, 220, 50)
                        local existing = targetEspObjects[player]
                        if not existing or not existing.Parent or existing.Adornee ~= char then
                            if existing and existing.Parent then existing:Destroy() end
                            local hl = Instance.new("Highlight")
                            hl.Name = "TargetESPHighlight"
                            hl.FillTransparency = 0.7
                            hl.OutlineTransparency = 0
                            hl.Adornee = char
                            hl.Parent = char
                            hl.FillColor = targetColor
                            hl.OutlineColor = targetColor
                            targetEspObjects[player] = hl
                        else
                            existing.FillColor = targetColor
                            existing.OutlineColor = targetColor
                        end
                        
                        if friendEspObjects[player] and friendEspObjects[player].Parent then
                            friendEspObjects[player]:Destroy()
                            friendEspObjects[player] = nil
                        end
                        
                        if teamEspObjects[player] and teamEspObjects[player].Parent then
                            teamEspObjects[player]:Destroy()
                            teamEspObjects[player] = nil
                        end
                    else
                        if targetEspObjects[player] and targetEspObjects[player].Parent then
                            targetEspObjects[player]:Destroy()
                        end
                        targetEspObjects[player] = nil
                    end
                else
                    if targetEspObjects[player] and targetEspObjects[player].Parent then
                        targetEspObjects[player]:Destroy()
                    end
                    targetEspObjects[player] = nil
                    
                    if player and not player.Parent then
                        targetEspPlayers[player] = nil
                    end
                end
            end
        else
            for player, hl in pairs(targetEspObjects) do
                if hl and hl.Parent then hl:Destroy() end
            end
            targetEspObjects = {}
        end

        
        if friendEspEnabled then
            for _, player in ipairs(Players:GetPlayers()) do
                
                if targetEspPlayers[player] then
                    if friendEspObjects[player] and friendEspObjects[player].Parent then
                        friendEspObjects[player]:Destroy()
                    end
                    friendEspObjects[player] = nil
                elseif player ~= LocalPlayer and player.Character and isFriend(player) then
                    if friendEspWhitelist[player] ~= false then
                    local char = player.Character
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local friendColor = Color3.fromRGB(50, 255, 50)
                        local existing = friendEspObjects[player]
                        if not existing or not existing.Parent or existing.Adornee ~= char then
                            if existing and existing.Parent then existing:Destroy() end
                            local hl = Instance.new("Highlight")
                            hl.Name = "FriendESPHighlight"
                            hl.FillTransparency = 0.7
                            hl.OutlineTransparency = 0
                            hl.Adornee = char
                            hl.Parent = char
                            hl.FillColor = friendColor
                            hl.OutlineColor = friendColor
                            friendEspObjects[player] = hl
                        else
                            existing.FillColor = friendColor
                            existing.OutlineColor = friendColor
                        end
                        if teamEspEnabled and teamEspObjects[player] and teamEspObjects[player].Parent then
                            teamEspObjects[player]:Destroy()
                            teamEspObjects[player] = nil
                        end
                    else
                        if friendEspObjects[player] and friendEspObjects[player].Parent then
                            friendEspObjects[player]:Destroy()
                        end
                        friendEspObjects[player] = nil
                    end
                    else
                        if friendEspObjects[player] and friendEspObjects[player].Parent then
                            friendEspObjects[player]:Destroy()
                        end
                        friendEspObjects[player] = nil
                    end
                else
                    if friendEspObjects[player] and friendEspObjects[player].Parent then
                        friendEspObjects[player]:Destroy()
                    end
                    friendEspObjects[player] = nil
                end
            end
            for player, hl in pairs(friendEspObjects) do
                if not player.Parent then
                    if hl and hl.Parent then hl:Destroy() end
                    friendEspObjects[player] = nil
                end
            end
        else
            for player, hl in pairs(friendEspObjects) do
                if hl and hl.Parent then hl:Destroy() end
            end
            friendEspObjects = {}
        end

        
        if teamEspEnabled then
            for _, player in ipairs(Players:GetPlayers()) do
                
                if targetEspPlayers[player] then
                    if teamEspObjects[player] and teamEspObjects[player].Parent then
                        teamEspObjects[player]:Destroy()
                    end
                    teamEspObjects[player] = nil
                
                elseif friendEspEnabled and friendEspObjects[player] then
                    if teamEspObjects[player] and teamEspObjects[player].Parent then
                        teamEspObjects[player]:Destroy()
                    end
                    teamEspObjects[player] = nil
                elseif player ~= LocalPlayer and player.Character and player.Team then
                    if teamEspWhitelist[player.Team.Name] ~= false then
                    local char = player.Character
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local teamColor = player.TeamColor.Color
                        local existing = teamEspObjects[player]
                        if not existing or not existing.Parent or existing.Adornee ~= char then
                            if existing and existing.Parent then existing:Destroy() end
                            local hl = Instance.new("Highlight")
                            hl.Name = "TeamESPHighlight"
                            hl.FillTransparency = 0.7
                            hl.OutlineTransparency = 0
                            hl.Adornee = char
                            hl.Parent = char
                            hl.FillColor = teamColor
                            hl.OutlineColor = teamColor
                            teamEspObjects[player] = hl
                        else
                            existing.FillColor = teamColor
                            existing.OutlineColor = teamColor
                        end
                    else
                        if teamEspObjects[player] and teamEspObjects[player].Parent then
                            teamEspObjects[player]:Destroy()
                        end
                        teamEspObjects[player] = nil
                    end
                    else
                        if teamEspObjects[player] and teamEspObjects[player].Parent then
                            teamEspObjects[player]:Destroy()
                        end
                        teamEspObjects[player] = nil
                    end
                else
                    if teamEspObjects[player] and teamEspObjects[player].Parent then
                        teamEspObjects[player]:Destroy()
                    end
                    teamEspObjects[player] = nil
                end
            end
            for player, hl in pairs(teamEspObjects) do
                if not player.Parent then
                    if hl and hl.Parent then hl:Destroy() end
                    teamEspObjects[player] = nil
                end
            end
        else
            for player, hl in pairs(teamEspObjects) do
                if hl and hl.Parent then hl:Destroy() end
            end
            teamEspObjects = {}
        end

        task.wait(0.1)
    end
end)

CloseButton.MouseButton1Click:Connect(function()
    scriptActive = false
    camLockEnabled = false
    espEnabled = false
    espHealthEnabled = false
    highlightEnabled = false
    chamsEnabled = false
    tracersEnabled = false
    boxEspEnabled = false
    skeletonEnabled = false
    headDotEnabled = false
    rainbowTrailEnabled = false
    fullbrightEnabled = false
    noFogEnabled = false
    noclipEnabled = false
    speedEnabled = false
    sprintEnabled = false
    jumpPowerEnabled = false
    infiniteJumpEnabled = false

    
    if lockedTarget and getLockedChar() then
        local root = getLockedChar():FindFirstChild("HumanoidRootPart")
        if root then
            root.Size = Vector3.new(2, 2, 1)
            root.Transparency = 1
            root.CanCollide = false
            root.Material = Enum.Material.SmoothPlastic
        end
    end
    lockedTarget = nil

    
    teamEspEnabled = false
    for _, hl in pairs(teamEspObjects) do
        if hl and hl.Parent then hl:Destroy() end
    end
    teamEspObjects = {}

    
    friendEspEnabled = false
    for _, hl in pairs(friendEspObjects) do
        if hl and hl.Parent then hl:Destroy() end
    end
    friendEspObjects = {}

    
    targetEspEnabled = false
    targetEspPlayers = {}
    for _, hl in pairs(targetEspObjects) do
        if hl and hl.Parent then hl:Destroy() end
    end
    targetEspObjects = {}

    
    if fovCircle then fovCircle:Remove() end

    
    for player, conn in pairs(damageEspConnections) do
        if conn then pcall(function() conn:Disconnect() end) end
    end
    damageEspConnections = {}

    
    for _, obj in pairs(espObjects) do
        if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
        if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
        if obj.trail then pcall(function() obj.trail:Destroy() end) end
        if obj.trailAttach0 then pcall(function() obj.trailAttach0:Destroy() end) end
        if obj.trailAttach1 then pcall(function() obj.trailAttach1:Destroy() end) end
        if obj.chams then pcall(function() obj.chams:Destroy() end) end
        if obj.tracer then pcall(function() obj.tracer:Remove() end) end
        if obj.boxOutline then pcall(function() obj.boxOutline:Remove() end) end
        if obj.skeleton then
            for _, line in pairs(obj.skeleton) do
                pcall(function() line:Remove() end)
            end
        end
        if obj.headDot then pcall(function() obj.headDot:Remove() end) end
        if obj.healthBar then pcall(function() obj.healthBar:Remove() end) end
        if obj.healthBarBg then pcall(function() obj.healthBarBg:Remove() end) end
        if obj.box3d then
            for _, line in pairs(obj.box3d) do pcall(function() line:Remove() end) end
        end
    end
    espObjects = {}

    
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            for _, desc in ipairs(player.Character:GetDescendants()) do
                if desc.Name == "VoidTrail" or desc.Name == "VoidTrailA0" or desc.Name == "VoidTrailA1" or desc.Name == "VoidChams" or desc.Name == "VoidHighlight" or desc.Name == "VoidESP" or desc.Name == "TeamESPHighlight" or desc.Name == "FriendESPHighlight" or desc.Name == "TargetESPHighlight" then
                    desc:Destroy()
                end
            end
        end
    end

    
    local Lighting = game:GetService("Lighting")
    if originalLighting.Ambient then Lighting.Ambient = originalLighting.Ambient end
    if originalLighting.Brightness then Lighting.Brightness = originalLighting.Brightness end
    if originalLighting.GlobalShadows ~= nil then Lighting.GlobalShadows = originalLighting.GlobalShadows end
    if originalLighting.OutdoorAmbient then Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient end
    if originalLighting.FogEnd then Lighting.FogEnd = originalLighting.FogEnd end
    if originalLighting.FogStart then Lighting.FogStart = originalLighting.FogStart end

    
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = originalWalkSpeed
            hum.JumpPower = originalJumpPower
        end
    end

    
    if flyActive then
        flyActive = false
        if flyConnection then flyConnection:Disconnect() flyConnection = nil end
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hrp then
                local bv = hrp:FindFirstChild("XthosFlyVel")
                if bv then bv:Destroy() end
                local bg = hrp:FindFirstChild("XthosFlyGyro")
                if bg then bg:Destroy() end
            end
            if hum then
                hum.PlatformStand = false
                hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
            end
        end
    end

    
    if swimActive then
        swimActive = false
        if swimConnection then swimConnection:Disconnect() swimConnection = nil end
    end

    
    if antiAfkConnection then
        antiAfkConnection:Disconnect()
        antiAfkConnection = nil
        antiAfkActive = false
    end

    
    if infZoomEnabled then
        infZoomEnabled = false
        LocalPlayer.CameraMinZoomDistance = 0.5
        LocalPlayer.CameraMaxZoomDistance = 400
        pcall(function()
            local cam = workspace.CurrentCamera
            if cam then cam.FieldOfView = 70 end
        end)
    end

    
    if tpToolActive then
        tpToolActive = false
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChild("TpTool") or LocalPlayer.Backpack:FindFirstChild("TpTool")
            if tool then tool:Destroy() end
        end
    end

    
    
    for _, conn in ipairs(connections) do
        conn:Disconnect()
    end

    
    for _, obj in pairs(npcEspObjects) do
        if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
        if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
        if obj.trail then pcall(function() obj.trail:Destroy() end) end
        if obj.trailAttach0 then pcall(function() obj.trailAttach0:Destroy() end) end
        if obj.trailAttach1 then pcall(function() obj.trailAttach1:Destroy() end) end
        if obj.chams then pcall(function() obj.chams:Destroy() end) end
        if obj.tracer then pcall(function() obj.tracer:Remove() end) end
        if obj.boxOutline then pcall(function() obj.boxOutline:Remove() end) end
        if obj.skeleton then for _, l in pairs(obj.skeleton) do pcall(function() l:Remove() end) end end
        if obj.headDot then pcall(function() obj.headDot:Remove() end) end
        if obj.healthBar then pcall(function() obj.healthBar:Remove() end) end
        if obj.healthBarBg then pcall(function() obj.healthBarBg:Remove() end) end
        if obj.box3d then for _, l in pairs(obj.box3d) do pcall(function() l:Remove() end) end end
    end
    npcEspObjects = {}

    
    for _, obj in pairs(playerVisualObjects) do
        if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
        if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
        if obj.chams then pcall(function() obj.chams:Destroy() end) end
        if obj.trail then pcall(function() obj.trail:Destroy() end) end
        if obj.trailA0 then pcall(function() obj.trailA0:Destroy() end) end
        if obj.trailA1 then pcall(function() obj.trailA1:Destroy() end) end
        if obj.tracer then pcall(function() obj.tracer:Remove() end) end
        if obj.box then pcall(function() obj.box:Remove() end) end
        if obj.headdot then pcall(function() obj.headdot:Remove() end) end
        if obj.skeleton then for _, l in pairs(obj.skeleton) do pcall(function() l:Remove() end) end end
    end
    playerVisualObjects = {}
    playerVisuals = {}

    ScreenGui:Destroy()
end)





local function cleanAllDrawings()
    
    for _, obj in pairs(espObjects) do
        if obj.tracer then pcall(function() obj.tracer:Remove() end) obj.tracer = nil end
        if obj.boxOutline then pcall(function() obj.boxOutline:Remove() end) obj.boxOutline = nil end
        if obj.skeleton then for _, l in pairs(obj.skeleton) do pcall(function() l:Remove() end) end obj.skeleton = nil end
        if obj.headDot then pcall(function() obj.headDot:Remove() end) obj.headDot = nil end
        if obj.healthBar then pcall(function() obj.healthBar:Remove() end) obj.healthBar = nil end
        if obj.healthBarBg then pcall(function() obj.healthBarBg:Remove() end) obj.healthBarBg = nil end
        if obj.box3d then for _, l in pairs(obj.box3d) do pcall(function() l:Remove() end) end obj.box3d = nil end
        
        if obj.billboard then pcall(function() obj.billboard:Destroy() end) obj.billboard = nil end
        if obj.highlight then pcall(function() obj.highlight:Destroy() end) obj.highlight = nil end
        if obj.trail then pcall(function() obj.trail:Destroy() end) obj.trail = nil end
        if obj.trailAttach0 then pcall(function() obj.trailAttach0:Destroy() end) obj.trailAttach0 = nil end
        if obj.trailAttach1 then pcall(function() obj.trailAttach1:Destroy() end) obj.trailAttach1 = nil end
        if obj.chams then pcall(function() obj.chams:Destroy() end) obj.chams = nil end
    end
    espObjects = {}

    
    for _, obj in pairs(npcEspObjects) do
        if obj.tracer then pcall(function() obj.tracer:Remove() end) end
        if obj.boxOutline then pcall(function() obj.boxOutline:Remove() end) end
        if obj.skeleton then for _, l in pairs(obj.skeleton) do pcall(function() l:Remove() end) end end
        if obj.headDot then pcall(function() obj.headDot:Remove() end) end
        if obj.healthBar then pcall(function() obj.healthBar:Remove() end) end
        if obj.healthBarBg then pcall(function() obj.healthBarBg:Remove() end) end
        if obj.box3d then for _, l in pairs(obj.box3d) do pcall(function() l:Remove() end) end end
        if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
        if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
        if obj.trail then pcall(function() obj.trail:Destroy() end) end
        if obj.trailAttach0 then pcall(function() obj.trailAttach0:Destroy() end) end
        if obj.trailAttach1 then pcall(function() obj.trailAttach1:Destroy() end) end
        if obj.chams then pcall(function() obj.chams:Destroy() end) end
    end
    npcEspObjects = {}

    
    for _, obj in pairs(playerVisualObjects) do
        if obj.tracer then pcall(function() obj.tracer:Remove() end) end
        if obj.box then pcall(function() obj.box:Remove() end) end
        if obj.headdot then pcall(function() obj.headdot:Remove() end) end
        if obj.skeleton then for _, l in pairs(obj.skeleton) do pcall(function() l:Remove() end) end end
        if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
        if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
        if obj.chams then pcall(function() obj.chams:Destroy() end) end
        if obj.trail then pcall(function() obj.trail:Destroy() end) end
        if obj.trailA0 then pcall(function() obj.trailA0:Destroy() end) end
        if obj.trailA1 then pcall(function() obj.trailA1:Destroy() end) end
    end
    playerVisualObjects = {}

    
    for _, hl in pairs(teamEspObjects) do if hl and hl.Parent then hl:Destroy() end end
    teamEspObjects = {}
    for _, hl in pairs(friendEspObjects) do if hl and hl.Parent then hl:Destroy() end end
    friendEspObjects = {}
    for _, hl in pairs(targetEspObjects) do if hl and hl.Parent then hl:Destroy() end end
    targetEspObjects = {}

    
    if fovCircle then fovCircle.Visible = false end

    
    lockedTarget = nil
end


table.insert(connections, LocalPlayer.CharacterAdded:Connect(function()
    
    lockedTarget = nil
    
    _respawnGrace = tick() + 1.0
    task.wait(0.2)
    cleanAllDrawings()
end))


pcall(function()
    local TeleportService = game:GetService("TeleportService")
    table.insert(connections, TeleportService.TeleportInitFailed:Connect(function()
        cleanAllDrawings()
    end))
end)


table.insert(connections, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    Camera = workspace.CurrentCamera
    cleanAllDrawings()
end))




;(function()
    local root = Instance.new("Frame", ScreenGui)
    root.Name = "MobileControls"
    root.BackgroundTransparency = 1
    root.BorderSizePixel = 0
    root.AnchorPoint = Vector2.new(1, 0.5)
    root.Position = UDim2.new(1, -12, 0.52, 0)
    root.Size = UDim2.new(0, 108, 0, 0)
    root.AutomaticSize = Enum.AutomaticSize.Y
    root.ZIndex = 40
    root.Visible = mobileControlsEnabled

    local sheet = Instance.new("Frame", root)
    sheet.Name = "Sheet"
    sheet.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    sheet.BackgroundTransparency = 0.08
    sheet.BorderSizePixel = 0
    sheet.Size = UDim2.new(1, 0, 0, 0)
    sheet.AutomaticSize = Enum.AutomaticSize.Y
    sheet.ZIndex = 40
    Instance.new("UICorner", sheet).CornerRadius = UDim.new(0, 8)
    do
        local s = Instance.new("UIStroke", sheet)
        s.Color = Color3.fromRGB(35, 35, 35)
        s.Thickness = 1
        s.Transparency = 0.15
    end

    local pad = Instance.new("UIPadding", sheet)
    pad.PaddingTop = UDim.new(0, 8)
    pad.PaddingBottom = UDim.new(0, 8)
    pad.PaddingLeft = UDim.new(0, 8)
    pad.PaddingRight = UDim.new(0, 8)

    local list = Instance.new("UIListLayout", sheet)
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Padding = UDim.new(0, 6)
    list.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local buttons = {}
    local extraOpen = false
    local extraRows = {}
    local moreBtn

    local grab = Instance.new("TextButton", sheet)
    grab.BackgroundTransparency = 1
    grab.BorderSizePixel = 0
    grab.Size = UDim2.new(1, 0, 0, 14)
    grab.Text = ""
    grab.AutoButtonColor = false
    grab.ZIndex = 41
    grab.LayoutOrder = 0
    local grabBar = Instance.new("Frame", grab)
    grabBar.AnchorPoint = Vector2.new(0.5, 0.5)
    grabBar.Position = UDim2.new(0.5, 0, 0.5, 0)
    grabBar.Size = UDim2.new(0, 28, 0, 3)
    grabBar.BackgroundColor3 = Color3.fromRGB(55, 55, 58)
    grabBar.BorderSizePixel = 0
    grabBar.ZIndex = 42
    Instance.new("UICorner", grabBar).CornerRadius = UDim.new(1, 0)

    local function setExtras(open)
        extraOpen = open
        if moreBtn then moreBtn.Text = open and "Less" or "More" end
        for _, row in ipairs(extraRows) do
            row.Visible = open
        end
    end

    do
        local dragging = false
        local moved = false
        local dragStart, startPos
        grab.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                moved = false
                dragStart = input.Position
                startPos = root.Position
            end
        end)
        table.insert(connections, UserInputService.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            local d = input.Position - dragStart
            if math.abs(d.X) + math.abs(d.Y) > 4 then moved = true end
            root.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end))
        table.insert(connections, UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                if dragging and not moved then
                    setExtras(not extraOpen)
                end
                dragging = false
            end
        end))
    end

    local COL_OFF = Color3.fromRGB(18, 18, 20)
    local COL_ON = Color3.fromRGB(32, 32, 34)
    local COL_LOCK = Color3.fromRGB(38, 38, 40)
    local TXT_OFF = Color3.fromRGB(150, 150, 150)
    local TXT_ON = Color3.fromRGB(240, 240, 240)

    local function paint(btn, on, locked)
        if not btn then return end
        if locked then
            btn.BackgroundColor3 = COL_LOCK
            btn.TextColor3 = TXT_ON
        elseif on then
            btn.BackgroundColor3 = COL_ON
            btn.TextColor3 = TXT_ON
        else
            btn.BackgroundColor3 = COL_OFF
            btn.TextColor3 = TXT_OFF
        end
    end

    local function styleBtn(b)
        b.BorderSizePixel = 0
        b.Font = Enum.Font.GothamBold
        b.TextSize = 11
        b.AutoButtonColor = false
        b.ZIndex = 41
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
        local stroke = Instance.new("UIStroke", b)
        stroke.Color = Color3.fromRGB(40, 40, 42)
        stroke.Thickness = 1
        stroke.Transparency = 0.35
        return b
    end

    local function makeRow(order)
        local row = Instance.new("Frame", sheet)
        row.BackgroundTransparency = 1
        row.Size = UDim2.new(1, 0, 0, 34)
        row.LayoutOrder = order
        row.ZIndex = 41
        local grid = Instance.new("UIListLayout", row)
        grid.FillDirection = Enum.FillDirection.Horizontal
        grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
        grid.Padding = UDim.new(0, 6)
        grid.SortOrder = Enum.SortOrder.LayoutOrder
        return row
    end

    local function makeBtn(parent, label, w, h)
        local b = Instance.new("TextButton", parent)
        b.Name = label
        b.BackgroundColor3 = COL_OFF
        b.Size = UDim2.new(0, w or 44, 0, h or 34)
        b.Text = label
        b.TextColor3 = TXT_OFF
        styleBtn(b)
        buttons[label] = b
        return b
    end

    local function flip(name)
        local reg = toggleRegistry[name]
        if not reg then return end
        reg.set(not reg.get())
    end

    
    local row1 = makeRow(1)
    local lockBtn = makeBtn(row1, "Lock", 44, 36)
    lockBtn.TextSize = 12
    lockBtn.MouseButton1Click:Connect(function()
        if not camLockEnabled and toggleRegistry["Camera Lock"] then
            toggleRegistry["Camera Lock"].set(true)
        end
        lockOntoTarget()
    end)
    local unlockBtn = makeBtn(row1, "Free", 44, 36)
    unlockBtn.TextSize = 12
    unlockBtn.MouseButton1Click:Connect(function()
        unlockTarget()
    end)

    local row2 = makeRow(2)
    makeBtn(row2, "Cam", 44, 32).MouseButton1Click:Connect(function() flip("Camera Lock") end)
    makeBtn(row2, "Aim", 44, 32).MouseButton1Click:Connect(function() flip("Aim Radius") end)

    local row3 = makeRow(3)
    local modeBtn = makeBtn(row3, fovVisibleOnly and "Open" or "Close", 44, 32)
    modeBtn.MouseButton1Click:Connect(function()
        fovVisibleOnly = not fovVisibleOnly
    end)
    makeBtn(row3, "Menu", 44, 32).MouseButton1Click:Connect(function()
        MainFrame.Visible = not MainFrame.Visible
    end)

    moreBtn = Instance.new("TextButton", sheet)
    moreBtn.Name = "More"
    moreBtn.BackgroundTransparency = 1
    moreBtn.BorderSizePixel = 0
    moreBtn.Size = UDim2.new(1, 0, 0, 18)
    moreBtn.Font = Enum.Font.GothamBold
    moreBtn.Text = "More"
    moreBtn.TextColor3 = Color3.fromRGB(100, 100, 100)
    moreBtn.TextSize = 10
    moreBtn.AutoButtonColor = false
    moreBtn.ZIndex = 41
    moreBtn.LayoutOrder = 4
    buttons.More = moreBtn

    local extras = {
        {{"Fire", "Lock Fire"}, {"360", "360 Assist"}},
        {{"Trig", "Triggerbot"}, {"Clip", "Noclip"}},
        {{"Speed", "Walk Speed"}, {"Jump", "Infinite Jump"}},
        {{"TP", "Click Teleport"}},
    }
    for i, pair in ipairs(extras) do
        local row = makeRow(4 + i)
        row.Visible = false
        table.insert(extraRows, row)
        for _, e in ipairs(pair) do
            local b = makeBtn(row, e[1], 44, 32)
            b.MouseButton1Click:Connect(function() flip(e[2]) end)
        end
    end

    moreBtn.MouseButton1Click:Connect(function()
        setExtras(not extraOpen)
    end)

    local function sync()
        if not root.Visible then return end
        paint(buttons.Cam, camLockEnabled)
        paint(buttons.Aim, fovCircleEnabled)
        paint(buttons.Fire, autoLockKillEnabled)
        paint(buttons["360"], rageBotEnabled)
        paint(buttons.Trig, triggerbotEnabled)
        paint(buttons.Clip, noclipEnabled)
        paint(buttons.Speed, speedEnabled)
        paint(buttons.Jump, infiniteJumpEnabled)
        paint(buttons.TP, clickTPEnabled)
        paint(buttons.Menu, MainFrame.Visible)
        paint(lockBtn, lockedTarget ~= nil, lockedTarget ~= nil)
        paint(unlockBtn, lockedTarget ~= nil)
        modeBtn.Text = fovVisibleOnly and "Open" or "Close"
        paint(modeBtn, fovVisibleOnly)
        moreBtn.TextColor3 = extraOpen and Color3.fromRGB(180, 180, 180) or Color3.fromRGB(100, 100, 100)
    end

    table.insert(connections, RunService.Heartbeat:Connect(sync))

    MobileControls = {
        setVisible = function(v)
            root.Visible = v and true or false
            if v then sync() end
        end,
        root = root,
    }

    if isMobile then
        applyMobileMode(true)
    end
end)()




