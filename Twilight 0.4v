local function isCharVisible(char, myChar)
    local camPos = Camera.CFrame.Position
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local filterList = {myChar, char}
    for _, p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(filterList, p.Character) end end
    rayParams.FilterDescendantsInstances = filterList
    rayParams.IgnoreWater = true

    
    local checkParts = {
        char:FindFirstChild("Head"),
        char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"),
        char:FindFirstChild("HumanoidRootPart"),
    }

    
    local camRight = Camera.CFrame.RightVector
    local camUp = Camera.CFrame.UpVector

    for _, part in ipairs(checkParts) do
        if part then
            local partPos = part.Position
            local dir = (partPos - camPos)
            local distance = dir.Magnitude
            if distance <= 3 then
                return true 
            end

            
            
            local offsets = {
                Vector3.zero,                    
                camRight * 0.8,                  
                camRight * -0.8,                 
                camUp * 0.8,                     
                camUp * -0.6,                    
            }

            for _, offset in ipairs(offsets) do
                local targetPoint = partPos + offset
                local rayDir = (targetPoint - camPos)
                local rayDist = rayDir.Magnitude
                local hit = workspace:Raycast(camPos, rayDir.Unit * (rayDist - 1), rayParams)
                if not hit then
                    return true 
                end
                
                
                if hit then
                    local hitToTarget = (targetPoint - hit.Position).Magnitude
                    if hitToTarget < 3 then
                        return true
                    end
                end
            end
        end
    end
    return false
end



local function getClosestScreenDist(char, mousePos)
    local checkParts = {
        char:FindFirstChild("Head"),
        char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"),
        char:FindFirstChild("HumanoidRootPart"),
    }
    local bestDist = math.huge
    local anyOnScreen = false
    for _, part in ipairs(checkParts) do
        if part then
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                anyOnScreen = true
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if dist < bestDist then
                    bestDist = dist
                end
            end
        end
    end
    return bestDist, anyOnScreen
end

local function getClosestPlayerToCursor()
    local closest = nil
    local closestDist = math.huge
    local mousePos
    if isMobile or mobileControlsEnabled then
        local viewportSize = Camera.ViewportSize
        mousePos = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    else
        
        local viewportSize = Camera.ViewportSize
        if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
            or Camera.CameraType == Enum.CameraType.Scriptable
            or (LocalPlayer.CameraMode == Enum.CameraMode.LockFirstPerson) then
            mousePos = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
        else
            mousePos = UserInputService:GetMouseLocation()
        end
    end
    
    local maxDist = fovCircleEnabled and fovRadius or 9999
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myY = myRoot and myRoot.Position.Y or 0

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                
                local head = char:FindFirstChild("Head")
                local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                if (head and head.Transparency >= 1) and (torso and torso.Transparency >= 1) then
                    
                elseif char:FindFirstChildOfClass("ForceField") then
                    
                elseif H.isTeammate(player) then
                    
                elseif root.Position.Magnitude >= 1 and not (myRoot and root.Position.Y < myY - 50) then
                    local state = hum:GetState()
                    
                    local skipTarget = (state == Enum.HumanoidStateType.Dead)
                    if not skipTarget and (state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.FallingDown) then
                        if root.Position.Y < -50 then skipTarget = true end
                    end
                    if not skipTarget then
                        
                        if rageBotEnabled and fovRadius >= 9999 then
                            local myRoot2 = myChar and myChar:FindFirstChild("HumanoidRootPart")
                            if myRoot2 then
                                local dist3d = (root.Position - myRoot2.Position).Magnitude
                                if dist3d < closestDist and dist3d > 1 then
                                    local passWallCheck = true
                                    if fovVisibleOnly and tick() > _respawnGrace then
                                        passWallCheck = H.isCharVisibleFast(char, myChar)
                                    end
                                    if passWallCheck then
                                        closestDist = dist3d
                                        closest = player
                                    end
                                end
                            end
                        else
                            
                            local dist, anyOnScreen = getClosestScreenDist(char, mousePos)
                            if anyOnScreen and dist < maxDist and dist < closestDist then
                                local passWallCheck = true
                                if fovVisibleOnly and tick() > _respawnGrace then
                                    passWallCheck = H.isCharVisibleFast(char, myChar)
                                end
                                if passWallCheck then
                                    closestDist = dist
                                    closest = player
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    
    if npcCombatEnabled then
        for _, model in ipairs(workspace:GetDescendants()) do
            if model:IsA("Model") and model:FindFirstChildOfClass("Humanoid") and model:FindFirstChild("HumanoidRootPart") and not Players:GetPlayerFromCharacter(model) then
                local root = model:FindFirstChild("HumanoidRootPart")
                local hum = model:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    
                    if root.Position.Magnitude >= 1 and not (myRoot and root.Position.Y < myY - 50) then
                        local state = hum:GetState()
                        local skipNpc = (state == Enum.HumanoidStateType.Dead)
                        if not skipNpc and (state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.FallingDown) then
                            if root.Position.Y < -50 then skipNpc = true end
                        end
                        if not skipNpc then
                            
                            local dist, anyOnScreen = getClosestScreenDist(model, mousePos)
                            if anyOnScreen and dist < maxDist and dist < closestDist then
                                local passWallCheck = true
                                if fovVisibleOnly and tick() > _respawnGrace then
                                    passWallCheck = H.isCharVisibleFast(model, myChar)
                                end
                                if passWallCheck then
                                    closestDist = dist
                                    closest = model
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return closest
end

local function getTargetPart(char)
    if targetMode == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    elseif targetMode == "All" then
        return char:FindFirstChild("Head") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    else
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    end
end

local function usesSmartAim()
    return rageBotEnabled or targetMode == "All"
end

local function getAimParts(char)
    if targetMode == "All" then
        local parts, seen = {}, {}
        for _, name in ipairs({
            "Head", "UpperTorso", "LowerTorso", "Torso",
            "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
            "HumanoidRootPart",
        }) do
            local part = char:FindFirstChild(name)
            if part and part:IsA("BasePart") and not seen[part] then
                seen[part] = true
                table.insert(parts, part)
            end
        end
        return parts
    end

    local primary = getTargetPart(char)
    if not primary then return {} end

    local parts = {primary}
    if rageBotEnabled then
        local head = char:FindFirstChild("Head")
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        for _, extra in ipairs({head, torso}) do
            if extra and extra ~= primary then
                local duplicate = false
                for _, existing in ipairs(parts) do
                    if existing == extra then duplicate = true break end
                end
                if not duplicate then table.insert(parts, extra) end
            end
        end
    end
    return parts
end


local _currentAimPoint = nil

local function buildAimRayParams(myChar, char)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local filterList = {myChar, char}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(filterList, p.Character) end
    end
    rayParams.FilterDescendantsInstances = filterList
    rayParams.IgnoreWater = true
    return rayParams
end

local function getAimPointOpenness(fromPos, targetPoint, rayParams, char)
    local dir = targetPoint - fromPos
    local dist = dir.Magnitude
    if dist <= 3 then return 1 end
    local hit = workspace:Raycast(fromPos, dir.Unit * (dist - 0.3), rayParams)
    if not hit then return 1 end
    if hit.Instance and hit.Instance:IsDescendantOf(char) then
        local hitDist = (hit.Position - fromPos).Magnitude
        return 0.85 + 0.15 * math.clamp(1 - math.abs(hitDist - dist) / math.max(dist, 1), 0, 1)
    end
    if (targetPoint - hit.Position).Magnitude < 2.5 then return 0.55 end
    return 0
end

local function getAimPointOffsets(part)
    local cf = part.CFrame
    local right = cf.RightVector
    local up = cf.UpVector
    local size = part.Size
    local sideOffset = math.max(size.X, size.Z) * 0.38
    local upOffset = size.Y * 0.22
    return {
        Vector3.zero,
        right * sideOffset,
        right * -sideOffset,
        up * upOffset,
        up * -upOffset * 0.6,
        right * sideOffset * 0.7 + up * upOffset * 0.5,
        right * -sideOffset * 0.7 + up * upOffset * 0.5,
    }
end

local function getBestAimPoint(char, myChar)
    local partsToTry = getAimParts(char)
    if #partsToTry == 0 then return nil end
    local primary = getTargetPart(char)

    local camPos = Camera.CFrame.Position
    local camLook = Camera.CFrame.LookVector
    local rayParams = buildAimRayParams(myChar, char)

    local bestPoint, bestScore = nil, -math.huge
    for _, part in ipairs(partsToTry) do
        local partBonus = 0
        if part.Name == "Head" then
            partBonus = 0.04
        elseif part.Name == "UpperTorso" or part.Name == "Torso" or part.Name == "LowerTorso" then
            partBonus = 0.02
        end
        if part == primary then partBonus = partBonus + 0.02 end

        for i, offset in ipairs(getAimPointOffsets(part)) do
            local point = part.Position + offset
            local openness = getAimPointOpenness(camPos, point, rayParams, char)
            if openness > 0 then
                local alignment = camLook:Dot((point - camPos).Unit)
                local score = (openness * 0.65) + (alignment * 0.35) + partBonus
                if i == 1 then score = score + 0.01 end
                if score > bestScore then
                    bestScore = score
                    bestPoint = point
                end
            end
        end
    end

    return bestPoint or (primary and primary.Position)
end


local function getLockedChar()
    if not lockedTarget then return nil end
    if lockedTarget:IsA("Player") then
        return lockedTarget.Character
    else
        return lockedTarget
    end
end

local function clearLockedTarget()
    if hitboxEnabled and getLockedChar() then
        local root = getLockedChar():FindFirstChild("HumanoidRootPart")
        if root then
            root.Size = Vector3.new(2, 2, 1)
            root.Transparency = 1
            root.CanCollide = false
            root.Material = Enum.Material.SmoothPlastic
        end
    end
    lockedTarget = nil
end

local function unlockTarget()
    if not lockedTarget then return false end
    if lockFeedbackEnabled then
        local name = (lockedTarget.DisplayName or lockedTarget.Name)
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Unlocked",
                Text = "You Unlocked From " .. name,
                Duration = 2
            })
        end)
    end
    clearLockedTarget()
    _manualUnlockGrace = tick() + 0.35
    return true
end

local function lockOntoTarget()
    if not camLockEnabled then return false end
    if lockedTarget then
        if lockedTarget:IsA("Player") and H.isTeammate(lockedTarget) then
            lockedTarget = nil
        else
            return true
        end
    end
    local target = getClosestPlayerToCursor()
    if target and not (target:IsA("Player") and H.isTeammate(target)) then
        lockedTarget = target
        if lockFeedbackEnabled then
            local name = (target.DisplayName or target.Name)
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "Locked",
                    Text = "You Locked Onto " .. name,
                    Duration = 2
                })
            end)
        end
        return true
    end
    return false
end

local function toggleLockTarget()
    if not camLockEnabled then return false end
    if lockedTarget then
        return unlockTarget()
    end
    return lockOntoTarget()
end

table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if waitingForSprintKeybind then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            sprintKeybind = input.KeyCode
            if Act._sprintKbBtn and Act._sprintKbBtn.Parent then
                Act._sprintKbBtn.Text = input.KeyCode.Name
                Act._sprintKbBtn.BackgroundColor3 = Color3.fromRGB(42, 42, 46)
            end
            waitingForSprintKeybind = false
        end
        return
    end

    if not processed then
        if Safety.panicOn and Safety.panicKey and input.KeyCode == Safety.panicKey then
            if runPanic then runPanic() end
            return
        end
        if keybindLockEnabled then
            
        elseif CombatBinds.aim and input.KeyCode == CombatBinds.aim then
            if toggleRegistry["Aim Radius"] then toggleRegistry["Aim Radius"].set(not fovCircleEnabled) end
            return
        elseif CombatBinds.alk and input.KeyCode == CombatBinds.alk then
            if toggleRegistry["Lock Fire"] then toggleRegistry["Lock Fire"].set(not autoLockKillEnabled) end
            return
        elseif CombatBinds.rage and input.KeyCode == CombatBinds.rage then
            if toggleRegistry["360 Assist"] then toggleRegistry["360 Assist"].set(not rageBotEnabled) end
            return
        elseif CombatBinds.trigger and input.KeyCode == CombatBinds.trigger then
            if toggleRegistry["Triggerbot"] then toggleRegistry["Triggerbot"].set(not triggerbotEnabled) end
            return
        elseif clickTPKeybind and input.KeyCode == clickTPKeybind then
            if toggleRegistry["Click Teleport"] then toggleRegistry["Click Teleport"].set(not clickTPEnabled) end
            return
        end
    end

    if sprintEnabled and input.KeyCode == sprintKeybind and not processed then
        if sprintMode == "Toggle" then
            isSprinting = not isSprinting
        else
            isSprinting = true
        end
        if LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                if isSprinting then
                    hum.WalkSpeed = sprintSpeed
                else
                    hum.WalkSpeed = speedEnabled and defaultSpeed or originalWalkSpeed
                end
            end
        end
    end

    
    if input.KeyCode == CombatBinds.lock then
        toggleLockTarget()
    end
end))


table.insert(connections, UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if sprintEnabled and input.KeyCode == sprintKeybind and isSprinting and sprintMode == "Hold" then
        isSprinting = false
        if LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = speedEnabled and defaultSpeed or originalWalkSpeed
            end
        end
    end
    
    
end))


local function doInfiniteJump()
    if not infiniteJumpEnabled or not scriptActive then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return end

    local power = 50
    if jumpPowerEnabled then
        power = defaultJumpPower
    elseif hum.UseJumpPower then
        power = math.max(hum.JumpPower, 50)
    else
        local jh = hum.JumpHeight
        if typeof(jh) == "number" and jh > 0 then
            power = math.sqrt(2 * workspace.Gravity * jh)
        end
    end
    power = math.clamp(power, 40, 200)

    pcall(function()
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end)
    pcall(function()
        hum.Jump = true
    end)

    local vel = hrp.AssemblyLinearVelocity
    hrp.AssemblyLinearVelocity = Vector3.new(vel.X, math.max(vel.Y, power), vel.Z)
end

Act._infJumpHeld = false
Act._infJumpPulseUntil = 0
Act._infJumpLast = 0

table.insert(connections, UserInputService.JumpRequest:Connect(function()
    if not infiniteJumpEnabled then return end
    Act._infJumpPulseUntil = tick() + 0.2
    doInfiniteJump()
end))

table.insert(connections, UserInputService.InputBegan:Connect(function(input)
    if not infiniteJumpEnabled then return end
    if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA then
        Act._infJumpHeld = true
        Act._infJumpPulseUntil = tick() + 0.2
        doInfiniteJump()
    end
end))

table.insert(connections, UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA then
        Act._infJumpHeld = false
    end
end))

table.insert(connections, RunService.Heartbeat:Connect(function()
    if not infiniteJumpEnabled or not scriptActive then
        Act._infJumpHeld = false
        return
    end
    local jumping = Act._infJumpHeld
        or tick() < Act._infJumpPulseUntil
        or UserInputService:IsKeyDown(Enum.KeyCode.Space)
        or UserInputService:IsKeyDown(Enum.KeyCode.ButtonA)
    if not jumping then return end
    local now = tick()
    if now - Act._infJumpLast < 0.1 then return end
    Act._infJumpLast = now
    doInfiniteJump()
end))


table.insert(connections, RunService.Stepped:Connect(function()
    if not scriptActive or not noclipEnabled then return end
