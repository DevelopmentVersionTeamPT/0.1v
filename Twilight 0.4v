fovInfo.setBuilder(function(panel)
    
    local modeLbl = Instance.new("TextLabel", panel)
    modeLbl.BackgroundTransparency = 1; modeLbl.Position = UDim2.new(0, 10, 0, 2)
    modeLbl.Size = UDim2.new(0, 40, 0, 18); modeLbl.Font = Enum.Font.GothamBold
    modeLbl.Text = "Mode"; modeLbl.TextColor3 = Color3.fromRGB(160,160,160); modeLbl.TextSize = 10
    modeLbl.TextXAlignment = Enum.TextXAlignment.Left; modeLbl.ZIndex = 6
    local modeOpts = {{"Auto", "Auto"}, {"Manual", "Manual"}}
    for i, opt in ipairs(modeOpts) do
        local b = Instance.new("TextButton", panel)
        b.BackgroundColor3 = (camLockMode == opt[2]) and Color3.fromRGB(50,90,50) or Color3.fromRGB(40,40,43)
        b.BorderSizePixel = 0; b.Position = UDim2.new(0, 50 + (i-1)*65, 0, 2)
        b.Size = UDim2.new(0, 58, 0, 18); b.Font = Enum.Font.GothamBold
        b.Text = opt[1]; b.TextColor3 = Color3.fromRGB(200,200,200); b.TextSize = 9; b.ZIndex = 6
