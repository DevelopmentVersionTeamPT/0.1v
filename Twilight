local function isCharVisible(char, myChar)
    local camPos = Camera.CFrame.Position
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local filterList = {myChar, char}
    for _, p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(filterList, p.Character) end end
    rayParams.FilterDescendantsInstances = filterList
    rayParams.IgnoreWater = true

    
    local checkParts = {
        char:FindFirstChild("Head"),
        char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"),
        char:FindFirstChild("HumanoidRootPart"),
    }

    
    local camRight = Camera.CFrame.RightVector
    local camUp = Camera.CFrame.UpVector

    for _, part in ipairs(checkParts) do
        if part then
            local partPos = part.Position
            local dir = (partPos - camPos)
            local distance = dir.Magnitude
            if distance <= 3 then
                return true 
            end

            
            
            local offsets = {
                Vector3.zero,                    
                camRight * 0.8,                  
                camRight * -0.8,                 
                camUp * 0.8,                     
                camUp * -0.6,                    
            }

            for _, offset in ipairs(offsets) do
                local targetPoint = partPos + offset
                local rayDir = (targetPoint - camPos)
                local rayDist = rayDir.Magnitude
                local hit = workspace:Raycast(camPos, rayDir.Unit * (rayDist - 1), rayParams)
                if not hit then
                    return true 
                end
                
                
                if hit then
                    local hitToTarget = (targetPoint - hit.Position).Magnitude
                    if hitToTarget < 3 then
                        return true
                    end
                end
            end
        end
    end
    return false
end



local function getClosestScreenDist(char, mousePos)
    local checkParts = {
        char:FindFirstChild("Head"),
        char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"),
        char:FindFirstChild("HumanoidRootPart"),
    }
    local bestDist = math.huge
    local anyOnScreen = false
    for _, part in ipairs(checkParts) do
        if part then
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                anyOnScreen = true
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if dist < bestDist then
                    bestDist = dist
                end
            end
        end
    end
    return bestDist, anyOnScreen
end

