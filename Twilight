    if not targetInfoEnabled or not lockedTarget then
        TI.frame.Visible = false
        return
    end
    if not Perf.allow("targetInfo") then return end

    
    if not lockedTarget:IsA("Player") then
        TI.frame.Visible = false
        return
    end

