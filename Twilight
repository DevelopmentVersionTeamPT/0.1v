local freecamActive = false
local freecamConn = nil
local freecamSpeed = 60
local freecamYaw, freecamPitch = 0, 0
local freecamPos = nil
local freecamSaved = nil

local function stopFreecam()
    if not freecamActive then return end
    freecamActive = false
    syncToggle("Freecam", false)
    if freecamConn then
        freecamConn:Disconnect()
        freecamConn = nil
    end
    pcall(function()
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end)
    local cam = workspace.CurrentCamera
    if cam and freecamSaved then
        cam.CameraType = freecamSaved.type or Enum.CameraType.Custom
        if freecamSaved.subject then
            cam.CameraSubject = freecamSaved.subject
        else
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then cam.CameraSubject = hum end
        end
    end
    freecamSaved = nil
    freecamPos = nil
end

local function startFreecam(speed)
    if freecamActive then
        freecamSpeed = speed or freecamSpeed
        return
    end
    if viewingPlayer then
        if Act.stopSpectate then
            Act.stopSpectate()
        else
            viewingPlayer = nil
        end
    end
    freecamSpeed = speed or 60
    syncToggle("Freecam", true)
    local cam = workspace.CurrentCamera
    if not cam then return end
    freecamSaved = {
        type = cam.CameraType,
        subject = cam.CameraSubject,
    }
    freecamPos = cam.CFrame.Position
    local look = cam.CFrame.LookVector
    freecamYaw = math.atan2(-look.X, -look.Z)
    freecamPitch = math.asin(math.clamp(look.Y, -1, 1))
    cam.CameraType = Enum.CameraType.Scriptable
    freecamActive = true

    freecamConn = RunService.RenderStepped:Connect(function(dt)
        if not freecamActive then return end
        local c = workspace.CurrentCamera
        if not c then return end

        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
            local delta = UserInputService:GetMouseDelta()
            freecamYaw = freecamYaw - delta.X * 0.004
            freecamPitch = math.clamp(freecamPitch - delta.Y * 0.004, -1.45, 1.45)
        else
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end

        local rot = CFrame.Angles(0, freecamYaw, 0) * CFrame.Angles(freecamPitch, 0, 0)
        local move = Vector3.zero
        if not UserInputService:GetFocusedTextBox() then
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + rot.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - rot.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - rot.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + rot.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                move = move + Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                move = move - Vector3.new(0, 1, 0)
            end
        end

        local spd = freecamSpeed
        if not UserInputService:GetFocusedTextBox() and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            spd = spd * 2.4
        end
        if move.Magnitude > 0 then
            freecamPos = freecamPos + move.Unit * spd * dt
        end
        c.CFrame = CFrame.new(freecamPos) * rot
    end)
end

