Act.fmtEspHealth = function(hum)
    local hp = math.floor(hum.Health)
    local maxHp = math.max(1, math.floor(hum.MaxHealth))
    local fmt = Act.espHealthFormat
    if fmt == "pct" then
        return tostring(math.floor((hp / maxHp) * 100)) .. "%"
    elseif fmt == "both" then
        return tostring(hp) .. " (" .. tostring(math.floor((hp / maxHp) * 100)) .. "%)"
    end
    return tostring(hp)
