        if _lastSettleAimPoint and (aimPoint - _lastSettleAimPoint).Magnitude > 1.5 then
            _lockAcquireTime = now
        end
        _lastSettleAimPoint = aimPoint
    end

    if now - _lockAcquireTime < getAimSettleDelay() then return end

    local baseInterval = (autoLockKillDelay and autoLockKillDelay > 0) and autoLockKillDelay or 0.03
    if _isArsenalPlace then
        baseInterval = 0.03
    end
    if _lastAutoKillTarget == lockedTarget and (now - _lastAutoKillTime < baseInterval) then return end

    if aimPoint and not _isArsenalPlace and not (isMobile or mobileControlsEnabled) then
        local camLook = Camera.CFrame.LookVector
        local toTarget = (aimPoint - Camera.CFrame.Position).Unit
        local dot = camLook:Dot(toTarget)
        if dot < (usesSmartAim() and 0.90 or 0.94) then return end
    end

    _lastAutoKillTarget = lockedTarget
    _lastAutoKillTime = now
    fireAutoClick()
end))
end)()


table.insert(connections, RunService.Heartbeat:Connect(function()
