-- ===== Tail Physics (FE / old accessory style) =====
-- Never create new joints. Drive the EXISTING AccessoryWeld/Motor6D C0 every
-- frame (classic FE back-hat / accessory scripts). New local Motor6Ds only
-- exist on your client — that's why the old version looked client-only.
Act.tailPhysics = Act.tailPhysics or {}
Act.tailPhysics.enabled = false
Act.tailPhysics.conn = nil
Act.tailPhysics.steppedConn = nil
Act.tailPhysics.charConn = nil
Act.tailPhysics.appearConn = nil
Act.tailPhysics.descConn = nil
Act.tailPhysics.joints = {} -- {joint=, handle=, part0=, baseC0=, baseC1=, mode=, attach=, baseAttachCF=, pitch=, yaw=, pitchV=, yawV=}
Act.tailPhysics.motors = nil -- legacy (new local Motor6D path — client-only)

local function tailPhysicsNotify(text)
end

local function isTailName(name)
    name = string.lower(tostring(name or ""))
    if name == "" then return false end
    if name:find("tail", 1, true) then return true end
    if name:find("fox", 1, true) and (name:find("butt", 1, true) or name:find("rear", 1, true)) then
        return true
    end
    local keys = {
        "fluffytail", "foxytail", "kittytail", "wolftail", "huskytail", "dragontail", "demontail", "cattail",
        "fox tail", "cat tail", "wolf tail", "fluffy tail",
    }
    for i = 1, #keys do
        if name:find(keys[i], 1, true) then return true end
    end
    return false
end

local function isLikelyFurryWaist(name)
    name = string.lower(tostring(name or ""))
    local keys = {"fox", "cat", "kitty", "wolf", "husky", "puppy", "dragon", "fluff", "eevee", "deer", "bunny", "rabbit", "protogen", "furry", "kitsune", "canine", "feline"}
    for i = 1, #keys do
        if name:find(keys[i], 1, true) then return true end
    end
    return false
end

local function getWaistPart(char)
    return char:FindFirstChild("LowerTorso")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("HumanoidRootPart")
end

-- Prefer the real replicated AccessoryWeld — do not invent joints.
local function findExistingTailJoint(handle)
    if not handle then return nil end
    local candidates = {}
    local function consider(inst)
        if not inst then return end
        if inst:IsA("Weld") or inst:IsA("Motor6D") then
            candidates[#candidates + 1] = inst
        end
    end
    for _, d in ipairs(handle:GetChildren()) do
        consider(d)
    end
    local acc = handle.Parent
    if acc then
        for _, d in ipairs(acc:GetChildren()) do
            consider(d)
        end
        for _, d in ipairs(acc:GetDescendants()) do
            if d:IsA("Weld") or d:IsA("Motor6D") then
                consider(d)
            end
        end
    end
    -- Prefer named AccessoryWeld, then any weld/motor touching the handle
    local best, score = nil, -1
    for i = 1, #candidates do
        local j = candidates[i]
        local s = 0
        local n = string.lower(j.Name)
        if n == "accessoryweld" or n:find("accessory", 1, true) then s = s + 10 end
        if j:IsA("Weld") then s = s + 3 end
        if j:IsA("Motor6D") then s = s + 2 end
        if j.Part0 == handle or j.Part1 == handle then s = s + 5 end
        if s > score then
            score = s
            best = j
        end
    end
    return best
end

local function findTailAttachment(handle)
    if not handle then return nil end
    local prefer = {"WaistBackAttachment", "BodyBackAttachment", "WaistCenterAttachment", "WaistFrontAttachment"}
    for i = 1, #prefer do
        local a = handle:FindFirstChild(prefer[i])
        if a and a:IsA("Attachment") then return a end
    end
    return handle:FindFirstChildOfClass("Attachment")
end

local function collectTailHandles(char)
    local handles = {}
    local seen = {}
    local function add(h)
        if h and h:IsA("BasePart") and not seen[h] then
            seen[h] = true
            handles[#handles + 1] = h
        end
    end

    for _, inst in ipairs(char:GetChildren()) do
        if inst:IsA("Accessory") or inst:IsA("Hat") then
            local looksLikeTail = isTailName(inst.Name)
            local handle = inst:FindFirstChild("Handle")
            if not looksLikeTail and handle then
                looksLikeTail = isTailName(handle.Name)
                if not looksLikeTail then
                    for _, d in ipairs(inst:GetDescendants()) do
                        if (d:IsA("MeshPart") or d:IsA("SpecialMesh")) and isTailName(d.Name) then
                            looksLikeTail = true
                            break
                        end
                    end
                end
            end
            if not looksLikeTail then
                pcall(function()
                    if inst.AccessoryType == Enum.AccessoryType.Waist and handle then
                        if isTailName(inst.Name) or isTailName(handle.Name) or isLikelyFurryWaist(inst.Name) then
                            looksLikeTail = true
                        end
                    elseif inst.AccessoryType == Enum.AccessoryType.Back and handle then
                        if isTailName(inst.Name) or isLikelyFurryWaist(inst.Name) then
                            looksLikeTail = true
                        end
                    end
                end)
            end
            if looksLikeTail and handle then
                add(handle)
            end
        elseif inst:IsA("BasePart") and isTailName(inst.Name) then
            add(inst)
        end
    end

    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and isTailName(d.Name) and d.Name ~= "HumanoidRootPart" then
            add(d)
        end
    end
    return handles
end

local function softHandle(handle)
    pcall(function()
        handle.CanCollide = false
        handle.Massless = true
        handle:SetNetworkOwner(LocalPlayer)
    end)
end

local function clearTailJoints(restore)
    for _, entry in ipairs(Act.tailPhysics.joints) do
        if restore then
            if entry.joint and entry.joint.Parent and entry.baseC0 then
                pcall(function()
                    entry.joint.C0 = entry.baseC0
                    if entry.baseC1 then entry.joint.C1 = entry.baseC1 end
                end)
            end
            if entry.attach and entry.attach.Parent and entry.baseAttachCF then
                pcall(function() entry.attach.CFrame = entry.baseAttachCF end)
            end
        end
    end
    Act.tailPhysics.joints = {}
end

local function linkTailHandle(char, handle)
    for _, entry in ipairs(Act.tailPhysics.joints) do
        if entry.handle == handle then
            return entry
        end
    end

    softHandle(handle)
    local joint = findExistingTailJoint(handle)
    local entry = {
        handle = handle,
        joint = nil,
        part0 = nil,
        baseC0 = nil,
        baseC1 = nil,
        attach = nil,
        baseAttachCF = nil,
        mode = "none",
        pitch = 0,
        yaw = 0,
        pitchV = 0,
        yawV = 0,
        sway = CFrame.new(),
    }

    if joint and (joint:IsA("Weld") or joint:IsA("Motor6D")) then
        -- FE path: edit the weld that already exists on the character
        entry.joint = joint
        entry.part0 = joint.Part0
        entry.baseC0 = joint.C0
        entry.baseC1 = joint.C1
        entry.mode = "c0"
        if joint.Part1 == handle then
            entry.part0 = joint.Part0
        elseif joint.Part0 == handle then
            entry.part0 = joint.Part1
        end
    else
        -- RigidConstraint accessories have no C0 — nudge the handle attachment locally
        local attach = findTailAttachment(handle)
        if attach then
            entry.attach = attach
            entry.baseAttachCF = attach.CFrame
            entry.part0 = getWaistPart(char)
            entry.mode = "attach"
        else
            -- Last resort netless: CFrame-follow without creating joints (local-heavy)
            entry.part0 = getWaistPart(char)
            if entry.part0 then
                entry.baseC0 = entry.part0.CFrame:ToObjectSpace(handle.CFrame)
                entry.mode = "netless"
            end
        end
    end

    if entry.mode == "none" then return nil end
    Act.tailPhysics.joints[#Act.tailPhysics.joints + 1] = entry
    return entry
end

local function setupTailPhysics(char)
    if not char then return 0, 0 end
    clearTailJoints(false)
    local count, feCount = 0, 0
    for _, handle in ipairs(collectTailHandles(char)) do
        local entry = linkTailHandle(char, handle)
        if entry then
            count = count + 1
            if entry.mode == "c0" then feCount = feCount + 1 end
        end
    end
    return count, feCount
end

local function stopTailPhysicsLoop()
    if Act.tailPhysics.conn then
        pcall(function() Act.tailPhysics.conn:Disconnect() end)
        Act.tailPhysics.conn = nil
    end
    if Act.tailPhysics.steppedConn then
        pcall(function() Act.tailPhysics.steppedConn:Disconnect() end)
        Act.tailPhysics.steppedConn = nil
    end
    if Act.tailPhysics.charConn then
        pcall(function() Act.tailPhysics.charConn:Disconnect() end)
        Act.tailPhysics.charConn = nil
    end
    if Act.tailPhysics.appearConn then
        pcall(function() Act.tailPhysics.appearConn:Disconnect() end)
        Act.tailPhysics.appearConn = nil
    end
    if Act.tailPhysics.descConn then
        pcall(function() Act.tailPhysics.descConn:Disconnect() end)
        Act.tailPhysics.descConn = nil
    end
end

local function applyTailSway(entry)
    local sway = entry.sway or CFrame.new()
    if entry.mode == "c0" and entry.joint and entry.joint.Parent and entry.baseC0 then
        -- Old FE accessory trick: spam C0 on the real AccessoryWeld
        entry.joint.C0 = entry.baseC0 * sway
    elseif entry.mode == "attach" and entry.attach and entry.attach.Parent and entry.baseAttachCF then
        entry.attach.CFrame = entry.baseAttachCF * sway
    elseif entry.mode == "netless" and entry.handle and entry.part0 and entry.part0.Parent and entry.baseC0 then
        local cf = entry.part0.CFrame * entry.baseC0 * sway
        entry.handle.CFrame = cf
        entry.handle.AssemblyLinearVelocity = entry.part0.AssemblyLinearVelocity
        entry.handle.AssemblyAngularVelocity = entry.part0.AssemblyAngularVelocity
    end
end

local function bindTailCharacter(char)
    if Act.tailPhysics.descConn then
        pcall(function() Act.tailPhysics.descConn:Disconnect() end)
        Act.tailPhysics.descConn = nil
    end
    if Act.tailPhysics.appearConn then
        pcall(function() Act.tailPhysics.appearConn:Disconnect() end)
        Act.tailPhysics.appearConn = nil
    end
    if not char then return end

    local n, feN = setupTailPhysics(char)
    if n > 0 then
        if feN > 0 then
            tailPhysicsNotify("FE linked " .. tostring(feN) .. "/" .. tostring(n) .. " (AccessoryWeld C0)")
        else
            tailPhysicsNotify("Linked " .. tostring(n) .. " (no AccessoryWeld — local fallback)")
        end
    end

    Act.tailPhysics.descConn = char.DescendantAdded:Connect(function(inst)
        if not Act.tailPhysics.enabled then return end
        if inst:IsA("Accessory") or inst:IsA("Hat") or inst:IsA("Weld") or inst:IsA("Motor6D") or isTailName(inst.Name) then
            task.defer(function()
                if Act.tailPhysics.enabled and LocalPlayer.Character == char then
                    setupTailPhysics(char)
                end
            end)
        end
    end)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function()
            Act.tailPhysics.appearConn = hum.ApplyDescriptionFinished:Connect(function()
                if Act.tailPhysics.enabled and LocalPlayer.Character == char then
                    task.defer(function() setupTailPhysics(char) end)
                end
            end)
        end)
    end
end

Act.tailPhysicsOff = function()
    Act.tailPhysics.enabled = false
    stopTailPhysicsLoop()
    clearTailJoints(true)
    tailPhysicsNotify("Off")
end

Act.tailPhysicsOn = function()
    Act.tailPhysics.enabled = true
    stopTailPhysicsLoop()

    local char = LocalPlayer.Character
    bindTailCharacter(char)
    if #Act.tailPhysics.joints == 0 then
        tailPhysicsNotify("No tail found — equip a waist/back tail, then run again")
    end

    Act.tailPhysics.charConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
        if not Act.tailPhysics.enabled then return end
        task.wait(0.35)
        bindTailCharacter(newChar)
    end)

    local lastRescan = 0
    local function stepPhysics(dt)
        if not Act.tailPhysics.enabled or not scriptActive then return end
        dt = math.clamp(dt or 0.016, 0.001, 0.05)
        local c = LocalPlayer.Character
        if not c then return end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not hrp then return end

        local now = tick()
        if now - lastRescan > 2.5 then
            lastRescan = now
            if #Act.tailPhysics.joints == 0 then
                setupTailPhysics(c)
            end
        end

        local localVel = hrp.CFrame:VectorToObjectSpace(hrp.AssemblyLinearVelocity)
        local moveSpeed = Vector3.new(localVel.X, 0, localVel.Z).Magnitude
        local angY = 0
        pcall(function() angY = hrp.AssemblyAngularVelocity.Y end)

        local targetPitch = math.clamp(-localVel.Z * 0.035, -0.85, 0.35)
        local targetYaw = math.clamp(-localVel.X * 0.04 - angY * 0.25, -0.7, 0.7)
        local idleAmp = (moveSpeed < 2) and 0.12 or 0.05
        targetPitch = targetPitch + math.sin(now * 2.4) * idleAmp
        targetYaw = targetYaw + math.sin(now * 1.85 + 0.7) * idleAmp * 0.85
        if hum and hum.Jump then
            targetPitch = targetPitch - 0.25
        end

        local stiffness, damping = 55, 11
        for i = #Act.tailPhysics.joints, 1, -1 do
            local e = Act.tailPhysics.joints[i]
            local alive = e.handle and e.handle.Parent
            if e.mode == "c0" then
                alive = alive and e.joint and e.joint.Parent
            elseif e.mode == "attach" then
                alive = alive and e.attach and e.attach.Parent
            elseif e.mode == "netless" then
                alive = alive and e.part0 and e.part0.Parent
            end
            if not alive then
                table.remove(Act.tailPhysics.joints, i)
            else
                local ax = (targetPitch - e.pitch) * stiffness - e.pitchV * damping
                local ay = (targetYaw - e.yaw) * stiffness - e.yawV * damping
                e.pitchV = e.pitchV + ax * dt
                e.yawV = e.yawV + ay * dt
                e.pitch = e.pitch + e.pitchV * dt
                e.yaw = e.yaw + e.yawV * dt
                e.sway = CFrame.Angles(e.pitch, e.yaw, e.yaw * 0.15)
                pcall(applyTailSway, e)
            end
        end
    end

    -- Heartbeat: spring integrate + C0 write
    Act.tailPhysics.conn = RunService.Heartbeat:Connect(stepPhysics)
    -- Stepped: re-apply C0 after physics (old netless / FE accessory spam)
    Act.tailPhysics.steppedConn = RunService.Stepped:Connect(function()
        if not Act.tailPhysics.enabled or not scriptActive then return end
        for i = 1, #Act.tailPhysics.joints do
            pcall(applyTailSway, Act.tailPhysics.joints[i])
        end
    end)

    table.insert(connections, Act.tailPhysics.conn)
    table.insert(connections, Act.tailPhysics.steppedConn)
end

Act.tailPhysicsToggle = function()
    if Act.tailPhysics.enabled then
        Act.tailPhysicsOff()
    else
        Act.tailPhysicsOn()
    end
end

