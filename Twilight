;(function()
    -- FE invis: real Character stays yours (burial replicates).
    -- Local ghost clone is what you see/control on the surface.
    -- Names are per-UserId so two Twilight users never clobber each other's pads/ghosts.
    Act.invisTeleportY = -100
    local GHOST_TRANS = 0.4
    local uidSuffix = tostring(LocalPlayer.UserId)
    local GHOST_NAME = "TwilightInvisGhost_" .. uidSuffix
    local VOID_NAME = "TwilightInvisVoid_" .. uidSuffix
    local loopConn = nil
    local camConn = nil
    local ghost = nil
    local ghostRoot = nil
    local ghostHum = nil
    local realChar = nil
    local voidPart = nil
    local savedCamSubject = nil
    local savedTrans = {}
    local buriedGroundY = nil
    local animTracks = {}
    local currentAnim = nil

    local function isOwnLocalProp(inst)
        if not inst then return false end
        if inst.Name == GHOST_NAME or inst.Name == VOID_NAME then return true end
        local ok, owner = pcall(function() return inst:GetAttribute("TwilightOwner") end)
        return ok and owner == LocalPlayer.UserId
    end

    local function invisDy()
        local dy = tonumber(Act.invisTeleportY) or -100
        if dy > -20 then dy = -20 end
        if dy < -250 then dy = -250 end
        return dy
    end

    local function setControlsEnabled(on)
        -- Avoid require(PlayerModule) — some executors throw "lacking capability Plugin".
        pcall(function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                if on then
                    hum.PlatformStand = false
                    hum.AutoRotate = true
                else
                    hum.PlatformStand = true
                    hum.AutoRotate = false
                    hum:Move(Vector3.zero, false)
                end
            end
        end)
    end

    local function destroyVoid()
        if voidPart then pcall(function() voidPart:Destroy() end) end
        voidPart = nil
        pcall(function()
            local old = workspace:FindFirstChild(VOID_NAME)
            if old and isOwnLocalProp(old) then old:Destroy() end
        end)
    end

    local function destroyGhost()
        currentAnim = nil
        for _, t in pairs(animTracks) do
            pcall(function() t:Stop(0) end)
        end
        animTracks = {}
        if ghost then pcall(function() ghost:Destroy() end) end
        ghost = nil
        ghostRoot = nil
        ghostHum = nil
        Act.invisGhost = nil
        Act.invisGhostRoot = nil
        Act.invisGhostHum = nil
        pcall(function()
            local leftover = workspace:FindFirstChild(GHOST_NAME)
            if leftover and isOwnLocalProp(leftover) then leftover:Destroy() end
        end)
    end

    local function resolveBuryY(xzPos)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local filter = {}
        if realChar then filter[#filter + 1] = realChar end
        if ghost then filter[#filter + 1] = ghost end
        if voidPart then filter[#filter + 1] = voidPart end
        params.FilterDescendantsInstances = filter
        local hit = workspace:Raycast(Vector3.new(xzPos.X, 800, xzPos.Z), Vector3.new(0, -2500, 0), params)
        local groundY = hit and hit.Position.Y or buriedGroundY or 0
        buriedGroundY = groundY
        return groundY + invisDy()
    end

    local function ensureVoid(surfaceCF)
        local pos = (surfaceCF or CFrame.new()).Position
        local buryY = resolveBuryY(pos)
        local under = CFrame.new(pos.X, buryY - 5, pos.Z)
        if not voidPart or not voidPart.Parent then
            destroyVoid()
            local p = Instance.new("Part")
            p.Name = VOID_NAME
            p.Anchored = true
            p.CanCollide = true
            p.Transparency = 1
            p.Size = Vector3.new(80, 1, 80)
            pcall(function()
                p:SetAttribute("TwilightOwner", LocalPlayer.UserId)
                p:SetAttribute("TwilightLocal", true)
            end)
            p.Parent = workspace
            voidPart = p
        end
        voidPart.CFrame = under
        return voidPart, buryY
    end

    local function setRealLocalHidden(char, hidden)
        if not char then return end
        if hidden then
            for _, d in ipairs(char:GetDescendants()) do
                pcall(function()
                    if d:IsA("BasePart") then
                        if savedTrans[d] == nil then
                            savedTrans[d] = { t = d.Transparency, ltm = d.LocalTransparencyModifier }
                        end
                        d.Transparency = 1
                        d.LocalTransparencyModifier = 1
                        d.CanCollide = false
                    elseif d:IsA("Decal") or d:IsA("Texture") then
                        if savedTrans[d] == nil then savedTrans[d] = { t = d.Transparency } end
                        d.Transparency = 1
                    elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
                        or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") then
                        d.Enabled = false
                    elseif d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
                        d.Enabled = false
                    elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
                        d.Enabled = false
                    end
                end)
            end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                pcall(function()
                    hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                    hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
                    hum.NameDisplayDistance = 0
                    hum.HealthDisplayDistance = 0
                    hum.PlatformStand = true
                    hum.CameraOffset = Vector3.zero
                end)
            end
        else
            for obj, data in pairs(savedTrans) do
                pcall(function()
                    if obj and obj.Parent then
                        if obj:IsA("BasePart") then
                            obj.Transparency = data.t or 0
                            obj.LocalTransparencyModifier = data.ltm or 0
                        elseif obj:IsA("Decal") or obj:IsA("Texture") then
                            obj.Transparency = data.t or 0
                        end
                    end
                end)
            end
            savedTrans = {}
        end
    end

    local function pinRealUnder(surfaceCF)
        local char = realChar
        if not char or not char.Parent then
            char = LocalPlayer.Character
            if not char or Act.isTwilightLocalClone(char) or char.Name == GHOST_NAME then return end
            realChar = char
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root then return end
        local pos = (surfaceCF or root.CFrame).Position
        local _, buryY = ensureVoid(surfaceCF or root.CFrame)
        local rot = (surfaceCF or root.CFrame) - (surfaceCF or root.CFrame).Position
        local cf = CFrame.new(pos.X, buryY, pos.Z) * rot
        for _, p in ipairs(char:GetDescendants()) do
            pcall(function()
                if p:IsA("BasePart") then p.CanCollide = false end
            end)
        end
        pcall(function()
            root.CFrame = cf
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            if hum then
                hum.PlatformStand = true
                hum.AutoRotate = false
            end
        end)
        setRealLocalHidden(char, true)
    end

    local function playGhostAnim(name, fade)
        if not animTracks[name] then return end
        if currentAnim == name then return end
        fade = fade or 0.15
        for n, t in pairs(animTracks) do
            if n ~= name then
                pcall(function() t:Stop(fade) end)
            end
        end
        pcall(function() animTracks[name]:Play(fade) end)
        currentAnim = name
    end

    local function stopGhostAnims(fade)
        fade = fade or 0.1
        for _, t in pairs(animTracks) do
            pcall(function() t:Stop(fade) end)
        end
        currentAnim = nil
    end

    local function setupGhostAnims(hum)
        currentAnim = nil
        animTracks = {}
        if not hum then return end
        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = hum
        end
        local ids = {
            idle = "rbxassetid://507766666",
            walk = "rbxassetid://507777826",
            run = "rbxassetid://507767714",
            jump = "rbxassetid://507765000",
            fall = "rbxassetid://507767968",
        }
        for name, id in pairs(ids) do
            local ok, track = pcall(function()
                local a = Instance.new("Animation")
                a.AnimationId = id
                return animator:LoadAnimation(a)
            end)
            if ok and track then
                pcall(function()
                    track.Looped = (name == "idle" or name == "walk" or name == "run")
                    track.Priority = Enum.AnimationPriority.Movement
                end)
                animTracks[name] = track
            end
        end
    end

    local function createGhost(char, atCF)
        destroyGhost()
        if not char then return false end
        local wasArch = char.Archivable
        char.Archivable = true
        local ok, g = pcall(function() return char:Clone() end)
        char.Archivable = wasArch
        if not ok or not g then return false end

        g.Name = GHOST_NAME
        pcall(function()
            g:SetAttribute("TwilightOwner", LocalPlayer.UserId)
            g:SetAttribute("TwilightLocal", true)
        end)
        local function isInsideTorso(inst)
            local p = inst.Parent
            while p and p ~= g do
                if p.Name == "Torso" or p.Name == "UpperTorso" or p.Name == "LowerTorso" then
                    return true
                end
                p = p.Parent
            end
            return false
        end
        -- Strip anything that often trips executor security / Plugin capability errors
        for _, d in ipairs(g:GetDescendants()) do
            pcall(function()
                local className = d.ClassName
                if className == "Script" or className == "LocalScript" or className == "ModuleScript"
                    or className == "ForceField" or className == "Highlight" or className == "Tool"
                    or className == "WrapLayer" or className == "WrapTarget" or className == "PackageLink"
                    or className == "SurfaceAppearance" or className == "HumanoidDescription" then
                    d:Destroy()
                    return
                end
                if d:IsA("BasePart") then
                    d.Anchored = false
                    d.CanCollide = (d.Name ~= "HumanoidRootPart")
                    d.CanQuery = false
                    if d.Name == "HumanoidRootPart" then
                        d.Transparency = 1
                        d.LocalTransparencyModifier = 1
                        d.CanCollide = false
                    elseif isInsideTorso(d) then
                        -- Keep the part, just fully hide nested torso contents
                        d.Transparency = 1
                        d.LocalTransparencyModifier = 1
                    else
                        d.Transparency = math.clamp(math.max(d.Transparency, GHOST_TRANS), 0, 0.85)
                    end
                elseif d:IsA("Decal") or d:IsA("Texture") then
                    if isInsideTorso(d) then
                        d.Transparency = 1
                    else
                        d.Transparency = math.clamp(math.max(d.Transparency, GHOST_TRANS), 0, 0.85)
                    end
                end
            end)
        end

        local gr = g:FindFirstChild("HumanoidRootPart")
        local gh = g:FindFirstChildOfClass("Humanoid")
        if gh then
            pcall(function()
                gh.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                gh.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
                gh.NameDisplayDistance = 0
                gh.PlatformStand = false
                gh.AutoRotate = true
                gh.WalkSpeed = speedEnabled and defaultSpeed or 16
                gh.JumpPower = jumpPowerEnabled and defaultJumpPower or 50
                gh.UseJumpPower = true
            end)
        end

        local parentOk = pcall(function() g.Parent = workspace end)
        if not parentOk then
            pcall(function() g:Destroy() end)
            return false
        end
        if atCF then pcall(function() g:PivotTo(atCF) end) end
        ghost = g
        ghostRoot = gr or g.PrimaryPart
        ghostHum = gh
        Act.invisGhost = ghost
        Act.invisGhostRoot = ghostRoot
        Act.invisGhostHum = ghostHum
        if ghostRoot then pcall(function() g.PrimaryPart = ghostRoot end) end
        setupGhostAnims(ghostHum)
        playGhostAnim("idle", 0)
        return ghostRoot ~= nil and ghostHum ~= nil
    end

    local function getMoveFlat()
        local cam = workspace.CurrentCamera
        local look = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
        local right = cam and cam.CFrame.RightVector or Vector3.new(1, 0, 0)
        look = Vector3.new(look.X, 0, look.Z)
        right = Vector3.new(right.X, 0, right.Z)
        if look.Magnitude > 0.05 then look = look.Unit else look = Vector3.new(0, 0, -1) end
        if right.Magnitude > 0.05 then right = right.Unit else right = Vector3.new(1, 0, 0) end
        local dir = Vector3.zero
        if not UserInputService:GetFocusedTextBox() then
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + look end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - look end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - right end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + right end
        end
        if dir.Magnitude > 0.05 then return dir.Unit end
        return Vector3.zero
    end

    local function stopLoop()
        if loopConn then pcall(function() loopConn:Disconnect() end) loopConn = nil end
        if camConn then pcall(function() camConn:Disconnect() end) camConn = nil end
    end

    local function ensureLoop()
        if loopConn then return end

        loopConn = RunService.Heartbeat:Connect(function()
            if not Act.invisActive then return end
            local char = LocalPlayer.Character
            if not char or Act.isTwilightLocalClone(char) or char.Name == GHOST_NAME then return end
            realChar = char
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not root or not hum or hum.Health <= 0 then return end
            if not ghost or not ghost.Parent or not ghostRoot or not ghostHum then return end

            pcall(function()
                if LocalPlayer.Character == ghost then
                    LocalPlayer.Character = char
                end
            end)

            local flying = flyActive == true
            if not flying then
                pcall(function()
                    ghostHum.PlatformStand = false
                    ghostHum.AutoRotate = true
                    ghostHum.WalkSpeed = speedEnabled and defaultSpeed or 16
                    ghostHum.JumpPower = jumpPowerEnabled and defaultJumpPower or 50
                    ghostHum.UseJumpPower = true
                end)
                local move = getMoveFlat()
                pcall(function() ghostHum:Move(move, false) end)
                if not UserInputService:GetFocusedTextBox()
                    and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                    pcall(function() ghostHum.Jump = true end)
                end
                local stateOk, state = pcall(function() return ghostHum:GetState() end)
                local vel = ghostRoot.AssemblyLinearVelocity
                local flatSpeed = Vector3.new(vel.X, 0, vel.Z).Magnitude
                if stateOk and state == Enum.HumanoidStateType.Jumping then
                    playGhostAnim("jump", 0.1)
                elseif stateOk and state == Enum.HumanoidStateType.Freefall then
                    playGhostAnim("fall", 0.15)
                elseif flatSpeed > 14 then
                    playGhostAnim("run", 0.15)
                elseif flatSpeed > 1 then
                    playGhostAnim("walk", 0.15)
                else
                    playGhostAnim("idle", 0.2)
                end
            else
                pcall(function()
                    ghostHum:Move(Vector3.zero, false)
                    ghostHum.PlatformStand = true
                    ghostHum.AutoRotate = false
                end)
                stopGhostAnims(0.1)
            end

            pinRealUnder(ghostRoot.CFrame)
        end)

        camConn = RunService.RenderStepped:Connect(function()
            if not Act.invisActive then return end
            if not ghostHum or not ghostHum.Parent then return end
            pcall(function()
                local cam = workspace.CurrentCamera
                if cam and cam.CameraSubject ~= ghostHum then
                    cam.CameraSubject = ghostHum
                end
            end)
            if ghostRoot and ghostRoot.Parent then
                pinRealUnder(ghostRoot.CFrame)
            end
        end)

        table.insert(connections, loopConn)
        table.insert(connections, camConn)
    end

    local function stopInvis()
        if not Act.invisActive then
            syncToggle("Invisible", false)
            return
        end
        Act.invisActive = false
        syncToggle("Invisible", false)
        stopLoop()
        setControlsEnabled(true)

        if Act._invisDied then
            pcall(function() Act._invisDied:Disconnect() end)
            Act._invisDied = nil
        end

        local surfaceCF = ghostRoot and ghostRoot.Parent and ghostRoot.CFrame or nil
        local real = realChar or LocalPlayer.Character
        if real and (real.Name == GHOST_NAME or Act.isTwilightLocalClone(real)) then real = nil end
        local rRoot = real and real:FindFirstChild("HumanoidRootPart")
        local rHum = real and real:FindFirstChildOfClass("Humanoid")

        if real and real.Parent then
            if surfaceCF and rRoot then
                pcall(function()
                    rRoot.CFrame = surfaceCF
                    rRoot.AssemblyLinearVelocity = Vector3.zero
                end)
            end
            setRealLocalHidden(real, false)
            for _, p in ipairs(real:GetDescendants()) do
                pcall(function()
                    if p:IsA("BasePart") then
                        p.Anchored = false
                        p.CanCollide = (p.Name ~= "HumanoidRootPart")
                    end
                end)
            end
            if rRoot then pcall(function() rRoot.CanCollide = false end) end
            if rHum then
                pcall(function()
                    rHum.PlatformStand = false
                    rHum.AutoRotate = true
                    rHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
                    rHum.NameDisplayDistance = 100
                    rHum.CameraOffset = Vector3.zero
                    rHum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end)
            end
            pcall(function()
                local cam = workspace.CurrentCamera
                if cam and rHum then
                    cam.CameraSubject = rHum
                elseif cam and savedCamSubject then
                    cam.CameraSubject = savedCamSubject
                end
            end)
        end
        savedCamSubject = nil

        destroyGhost()
        destroyVoid()
        realChar = nil
        buriedGroundY = nil

        -- Rebind fly to real character after leaving ghost
        if flyActive and Act.flyOn then
            pcall(function() Act.flyOn() end)
        end
    end

    local function startInvis()
        if Act.invisActive then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hrp or not hum or char.Name == GHOST_NAME or Act.isTwilightLocalClone(char) then
            syncToggle("Invisible", false)
            return
        end

        pcall(function() if Act.freecamOff then Act.freecamOff() end end)
        pcall(function() if Act.stopSpectate then Act.stopSpectate() end end)
        pcall(function() if Act.bangOff then Act.bangOff() end end)
        pcall(function() if Act.orbitOff then Act.orbitOff() end end)
        pcall(function() if Act.headSitOff then Act.headSitOff() end end)
        -- Keep fly on; rebind to ghost after spawn (do not call flyOff)

        destroyGhost()
        destroyVoid()
        buriedGroundY = nil
        realChar = char

        local cam = workspace.CurrentCamera
        pcall(function()
            if cam then savedCamSubject = cam.CameraSubject end
        end)

        -- Keep current air/ground position (don't snap down to baseplate)
        local spawnCF = hrp.CFrame
        if not createGhost(char, spawnCF) then
            realChar = nil
            syncToggle("Invisible", false)
            return
        end

        pcall(function() hum:UnequipTools() end)
        setControlsEnabled(false)
        pinRealUnder(spawnCF)
        pcall(function()
            if cam and ghostHum then
                cam.CameraSubject = ghostHum
            end
        end)

        Act.invisActive = true
        syncToggle("Invisible", true)
        ensureLoop()

        if flyActive and Act.flyOn then
            pcall(function() Act.flyOn() end)
        end

        if Act._invisDied then
            pcall(function() Act._invisDied:Disconnect() end)
        end
        Act._invisDied = hum.Died:Connect(function()
            stopInvis()
        end)
        table.insert(connections, Act._invisDied)
    end

    cmdCommands["invis"] = function()
        if Act.invisActive then
            stopInvis()
        else
            startInvis()
        end
    end
    cmdCommands["uninvis"] = function()
        stopInvis()
    end
    cmdCommands["invisible"] = cmdCommands["invis"]
    cmdCommands["uninvisible"] = cmdCommands["uninvis"]
    Act.invisOn = startInvis
    Act.invisOff = stopInvis

    table.insert(connections, LocalPlayer.CharacterAdded:Connect(function()
        if Act.invisActive then
            task.defer(function()
                if Act.invisActive then stopInvis() end
            end)
        end
    end))
end)()


