                end
                if lbl:IsA("TextLabel") and (lbl.Font == Enum.Font.BuilderSansBold or lbl.Font == Enum.Font.BuilderSansMedium) then
                    valLabel = lbl
                end
            end
            if foundName and valLabel then return valLabel end
        end
    end
    return nil
end

