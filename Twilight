        sugBtn:SetAttribute("CmdSug", true)
        sugBtn.BorderSizePixel = 0
        sugBtn.Position = UDim2.new(0, 6, 0, pad + (i - 1) * rowH)
        sugBtn.Size = UDim2.new(1, -12, 0, 20)
