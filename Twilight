local function refreshSearchResults(query)
    for _, child in ipairs(SearchResults:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    if query == "" then return end
    local lower = query:lower()
    local i = 0
    for label, reg in pairs(toggleRegistry) do
        if label:lower():find(lower, 1, true) then
            i = i + 1
            local row = Instance.new("Frame", SearchResults)
            row.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
            row.BorderSizePixel = 0
            row.Size = UDim2.new(0, 260, 0, 32)
