local function getTimeStr()
    local ok, result = pcall(os.date, "%H:%M:%S")
    if ok then return result end
    return tostring(math.floor(tick() % 86400))
end

local function formatAgo(t)
    local d = math.max(0, math.floor(tick() - (t or tick())))
    if d < 60 then return d .. "s ago" end
    if d < 3600 then return math.floor(d / 60) .. "m ago" end
    return math.floor(d / 3600) .. "h ago"
end

local _chatLogDedupeKey = ""
local _chatLogDedupeAt = 0
local function pushChatLog(player, text)
    if not text or text == "" then return end
    local name, display, uid = "Unknown", "Unknown", 0
    if typeof(player) == "Instance" and player:IsA("Player") then
        name = player.Name
        display = player.DisplayName
        uid = player.UserId
    elseif type(player) == "number" then
        uid = player
        local p = Players:GetPlayerByUserId(uid)
        if p then
            name = p.Name
            display = p.DisplayName
        else
            name = "User" .. tostring(uid)
            display = name
        end
    elseif type(player) == "string" then
        name = player
        display = player
    end
    local key = tostring(uid) .. "|" .. text
    local now = tick()
    if key == _chatLogDedupeKey and (now - _chatLogDedupeAt) < 0.35 then
        return
    end
    _chatLogDedupeKey = key
    _chatLogDedupeAt = now
    table.insert(chatLogs, {
        name = name,
        display = display,
        userId = uid,
        text = text,
        time = getTimeStr(),
        at = now,
    })
    if #chatLogs > 400 then table.remove(chatLogs, 1) end
    if Act._chatLogRebuild then
        pcall(Act._chatLogRebuild)
    end
end

