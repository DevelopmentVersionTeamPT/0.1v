        _plusBuilder = builder
        _plusPanelHeight = height or 44
    end

    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = state and "ON" or "OFF"
        btn.BackgroundColor3 = state and Color3.fromRGB(40, 88, 48) or Color3.fromRGB(42, 42, 46)
        if callback then callback(state) end
    end)

    
    toggleRegistry[label] = {
        set = function(newState)
            if newState == state then return end
            state = newState
            btn.Text = state and "ON" or "OFF"
            btn.BackgroundColor3 = state and Color3.fromRGB(40, 88, 48) or Color3.fromRGB(42, 42, 46)
            if callback then callback(state) end
        end,
        setSilent = function(newState)
            state = newState and true or false
            pcall(function()
                btn.Text = state and "ON" or "OFF"
                btn.BackgroundColor3 = state and Color3.fromRGB(40, 88, 48) or Color3.fromRGB(42, 42, 46)
            end)
        end,
        get = function()
            return state
        end
    }

    return btn, toggleInfo
end

