Act.disableSuspend = function()
    if Act.disableActive then return end
    local snap = {}
    lockedTarget = nil
    local list = Act.DISABLE_FEATURES
    for i = 1, #list do
        local name = list[i]
        local reg = toggleRegistry[name]
        if reg and reg.get and reg.get() then
            snap[name] = true
            reg.set(false)
        end
    end
    pcall(function()
        if fovCircle then fovCircle.Visible = false end
    end)
    pcall(function()
        if TI and TI.frame then TI.frame.Visible = false end
    end)
    pcall(function()
        if Act.flyOff then Act.flyOff() end
        if Act.freecamOff then Act.freecamOff() end
        if Act.swimOff then Act.swimOff() end
        if Act.spinOff then Act.spinOff() end
        if Act.freezeOff then Act.freezeOff() end
        if Act.tpToolOff then Act.tpToolOff() end
        if Act.infZoomOff then Act.infZoomOff() end
        if Act.antiAfkOff then Act.antiAfkOff() end
    end)
    Act.disableSnapshot = snap
    Act.disableActive = true
end

Act.disableRestore = function()
    if not Act.disableActive then return end
    local snap = Act.disableSnapshot or {}
    for name, wasOn in pairs(snap) do
        if wasOn then
            local reg = toggleRegistry[name]
            if reg then reg.set(true) end
        end
    end
    Act.disableSnapshot = {}
    Act.disableActive = false
end

Act.runDisable = function(forceState)
    local want = forceState
    if want == nil then
        want = not Act.disableActive
    end
    if want then
        Act.disableSuspend()
    else
        Act.disableRestore()
    end
    if toggleRegistry["Disable"] then
        toggleRegistry["Disable"].setSilent(Act.disableActive)
    end
end

