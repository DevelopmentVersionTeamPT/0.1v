    local function appendEmoteItem(item)
        if not item or not item.id then return false end
        -- Keep id as string — large catalog IDs can lose precision as numbers
        local idKey = tostring(item.id):match("%d+")
        if not idKey or seenIds[idKey] then return false end
        if not verifyIsEmoteId(idKey) then return false end
        seenIds[idKey] = true
        item.id = idKey
        catalogItems[#catalogItems + 1] = item
        if listScroll then
            makeEmoteRow(item, #catalogItems)
        end
        return true
    end

    -- EmoteAnimation only; skip official Roblox presets (creator 1)
    local function isCustomCatalogEmote(entry)
        if not entry then return false end
        local typeId = entry.assetType or entry.assetTypeId or entry.AssetTypeId or entry.assetTypeID or entry.AssetType
        if typeof(typeId) == "EnumItem" then typeId = typeId.Value end
        if typeof(typeId) == "string" then typeId = tonumber(typeId) or typeId end

        local isEmote = false
        if typeof(typeId) == "number" then
            isEmote = (typeId == EMOTE_TYPE_ID)
        elseif typeof(typeId) == "string" then
            local lower = string.lower(typeId)
            isEmote = (lower == "emoteanimation" or lower == "emote" or lower == "61")
        end
        if not isEmote and typeof(entry.taxonomy) == "table" then
            for _, t in ipairs(entry.taxonomy) do
                if typeof(t) == "table" and tostring(t.taxonomyName or ""):lower() == "emotes" then
                    isEmote = true
                    break
                end
            end
        end
        if not isEmote then return false end

        local creatorId = tonumber(entry.creatorTargetId or entry.CreatorTargetId or entry.creatorId or 0)
        local creatorName = string.lower(tostring(entry.creatorName or entry.CreatorName or entry.creator or ""))
        if creatorId == 1 or creatorName == "roblox" then
            return false
        end
        return true
    end

    local function encodeCursor(cursor)
        if not cursor or cursor == "" then return "" end
        local ok, enc = pcall(function()
            return HttpService:UrlEncode(tostring(cursor))
        end)
        if ok and enc then return enc end
        return tostring(cursor):gsub("([^%w%-_%.~])", function(c)
            return string.format("%%%02X", string.byte(c))
        end)
    end

    local function httpGet(url)
        local req = (typeof(request) == "function" and request)
            or (typeof(http_request) == "function" and http_request)
            or (syn and syn.request)
        if req then
            local rok, res = pcall(function()
                return req({
                    Url = url,
                    Method = "GET",
                    Headers = {["Accept"] = "application/json"},
                })
            end)
            if rok and res then
                local body = res.Body or res.body
                local code = res.StatusCode or res.Status or res.statusCode
                if typeof(body) == "string" and #body > 10 and (code == nil or code == 200) then
                    return body
                end
            end
        end
        local ok, raw = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and typeof(raw) == "string" and #raw > 10 and raw:sub(1, 1) == "{" then
            return raw
        end
        return nil
    end

    local function parseCatalogPayload(raw)
        local fetched, gotCursor = {}, nil
        if typeof(raw) ~= "string" then return fetched, gotCursor, false end
        local decOk, data = pcall(function()
            return HttpService:JSONDecode(raw)
        end)
        if not decOk or typeof(data) ~= "table" or typeof(data.data) ~= "table" then
            return fetched, gotCursor, false
        end
        for _, entry in ipairs(data.data) do
            if isCustomCatalogEmote(entry) then
                local id = tonumber(entry.id or entry.assetId or entry.itemId or entry.Id)
                local name = entry.name or entry.itemName or entry.Name
                if id and name then
                    verifiedCache[id] = true
                    fetched[#fetched + 1] = {
                        name = tostring(name),
                        id = id,
                        creator = tostring(entry.creatorName or entry.CreatorName or ""),
                    }
                end
            end
        end
        gotCursor = data.nextPageCursor or data.nextPageToken or data.nextCursor
        if gotCursor == "" then gotCursor = nil end
        return fetched, gotCursor, true
    end

    local function fetchViaAvatarEditor()
        local fetched = {}
        local ok, pages = pcall(function()
            local AES = game:GetService("AvatarEditorService")
            local params = CatalogSearchParams.new()
            pcall(function()
                params.AssetTypes = {Enum.AvatarAssetType.EmoteAnimation}
            end)
            pcall(function()
                params.IncludeOffSale = true
            end)
            pcall(function()
                local sorts = {
                    Enum.CatalogSortType.Relevance,
                    Enum.CatalogSortType.Favorited,
                    Enum.CatalogSortType.Sales,
                    Enum.CatalogSortType.Updated,
                }
                params.SortType = sorts[math.random(1, #sorts)]
            end)
            pcall(function()
                if catalogKeyword and catalogKeyword ~= "" then
                    params.SearchKeyword = catalogKeyword
                end
            end)
            pcall(function()
                params.Limit = 30
            end)
            return AES:SearchCatalog(params)
        end)
        if not ok or not pages then return fetched, false end
        local pageOk, items = pcall(function()
            return pages:GetCurrentPage()
        end)
        if not pageOk or typeof(items) ~= "table" then return fetched, false end
        for _, entry in ipairs(items) do
            -- Normalize AES fields
            local norm = {
                id = entry.Id or entry.id,
                name = entry.Name or entry.name,
                assetType = EMOTE_TYPE_ID,
                creatorTargetId = entry.CreatorTargetId or (entry.Creator and entry.Creator.Id),
                creatorName = entry.CreatorName or (entry.Creator and entry.Creator.Name) or "",
                itemType = entry.ItemType or "Asset",
            }
            if isCustomCatalogEmote(norm) then
                local id = tonumber(norm.id)
                if id and norm.name then
                    verifiedCache[id] = true
                    fetched[#fetched + 1] = {
                        name = tostring(norm.name),
                        id = id,
                        creator = tostring(norm.creatorName or ""),
                    }
                end
            end
        end
        local hasNext = false
        pcall(function() hasNext = not pages.IsFinished end)
        return fetched, #fetched > 0 or hasNext, pages
    end

    local aesPages = nil
    local fetchGeneration = 0
    local fetchCatalogPage
    local refreshBtn
    local catalogSortType = 1
    local catalogKeyword = ""
    local pagesToSkip = 0 -- on refresh, jump ahead so list isn't identical

    local CATALOG_KEYWORDS = {
        "", "dance", "aura", "sit", "funny", "wave", "viral", "meme",
        "rizz", "sigma", "floss", "happy", "sad", "car", "box", "admin",
        "emote", "jump", "spin", "walk", "lay", "cry", "laugh", "flex",
    }

    local function shuffleList(t)
        for i = #t, 2, -1 do
            local j = math.random(1, i)
            t[i], t[j] = t[j], t[i]
        end
        return t
    end

    local function pickFreshCatalogQuery()
        -- Rotate sort so Refresh doesn't always hit the same top page
        local sorts = {0, 1, 2, 3} -- Relevance, Favorited, Sales, Updated
        catalogSortType = sorts[math.random(1, #sorts)]
        catalogKeyword = CATALOG_KEYWORDS[math.random(1, #CATALOG_KEYWORDS)]
        pagesToSkip = math.random(1, 8)
    end

    local function buildCatalogUrls(cursor)
        local cur = ""
        if cursor and cursor ~= "" then
            cur = "&cursor=" .. encodeCursor(cursor)
        end
        local kw = ""
        if catalogKeyword and catalogKeyword ~= "" then
            kw = "&keyword=" .. encodeCursor(catalogKeyword)
        end
        local st = tostring(catalogSortType)
        return {
            "https://catalog.roblox.com/v2/search/items/details?assetTypeIds=61&limit=30&sortType=" .. st .. kw .. cur,
            "https://catalog.roblox.com/v2/search/items/details?AssetTypeIds=61&limit=30&SortType=" .. st .. kw .. cur,
            "https://catalog.roblox.com/v1/search/items/details?Category=14&Subcategory=39&Limit=30&SortType=" .. st
                .. ((catalogKeyword ~= "" and ("&Keyword=" .. encodeCursor(catalogKeyword)) or ""))
                .. ((cursor and cursor ~= "") and ("&Cursor=" .. encodeCursor(cursor)) or ""),
        }
    end

    local function httpFetchPage(cursor)
        local fetched, gotCursor, pageOk = {}, nil, false
        for _, url in ipairs(buildCatalogUrls(cursor)) do
            local raw = httpGet(url)
            local list, c, ok = parseCatalogPayload(raw)
            if ok then
                return list, c, true
            end
        end
        return fetched, gotCursor, pageOk
    end

    local function shouldPrefetchMore()
        if not listScroll or not listLayout or not hasMorePages then return false end
        local window = listScroll.AbsoluteSize.Y
        if window <= 0 then window = listScroll.AbsoluteWindowSize.Y end
        local content = listLayout.AbsoluteContentSize.Y
        local pos = listScroll.CanvasPosition.Y
        if content <= 0 then
            return #catalogItems < (Perf.lowMode and 24 or 45)
        end
        if content < (window + 80) then return true end
        return (content - (pos + window)) <= (Perf.lowMode and 140 or 200)
    end

    -- Pick a batch that avoids the previous refresh's IDs (so Refresh feels new)
    local function showRotatedPoolBatch(batchSize)
        batchSize = batchSize or 18
        local fresh = {}
        local reuse = {}
        for _, it in ipairs(EMOTE_POOL) do
            if lastBatchIds[it.id] then
                reuse[#reuse + 1] = it
            else
                fresh[#fresh + 1] = it
            end
        end
        -- If we've cycled most of the pool, allow reuse
        if #fresh < math.max(6, math.floor(batchSize / 2)) then
            lastBatchIds = {}
            fresh = {}
            for _, it in ipairs(EMOTE_POOL) do
                fresh[#fresh + 1] = it
            end
            reuse = {}
        end
        shuffleList(fresh)
        shuffleList(reuse)
        clearRows()
        seenIds = {}
        catalogItems = {}
        local newBatch = {}
        local n = 0
        local function take(list)
            for _, it in ipairs(list) do
                if n >= batchSize then return end
                verifiedCache[it.id] = true
                if appendEmoteItem({
                    name = it.name,
                    id = it.id,
                    creator = it.creator,
                }) then
                    newBatch[it.id] = true
                    n = n + 1
                end
            end
        end
        take(fresh)
        take(reuse)
        lastBatchIds = newBatch
        return n
    end

    local function setRefreshLabel(text)
        if refreshBtn then
            refreshBtn.Text = text
        end
    end

    fetchCatalogPage = function(reset)
        if reset then
            -- Hard cancel any in-flight page load so Refresh always works
            fetchGeneration = fetchGeneration + 1
            loadingPages = false
        elseif loadingPages or not hasMorePages then
            return
        end

        local gen = fetchGeneration
        loadingPages = true
        if reset then
            setRefreshLabel("Refreshing…")
            pickFreshCatalogQuery()
            nextPageCursor = nil
            hasMorePages = true
            pageEmptyStreak = 0
            aesPages = nil
            if listScroll then
                listScroll.CanvasPosition = Vector2.new(0, 0)
            end

            -- ALWAYS show a different local batch first (guaranteed visible change)
            showRotatedPoolBatch(18)

            -- Skip ahead N pages for live catalog variety
            local skipsLeft = pagesToSkip
            local cursor = nil
            while skipsLeft > 0 and gen == fetchGeneration do
                local list, c, ok = httpFetchPage(cursor)
                if not ok then break end
                if typeof(list) == "table" then
                    for _, it in ipairs(list) do
                        addToEmotePool(it)
                    end
                end
                cursor = c
                if typeof(cursor) ~= "string" or cursor == "" then break end
                skipsLeft = skipsLeft - 1
            end
            nextPageCursor = cursor
            pagesToSkip = 0
        end

        local fetched = {}
        local gotCursor = nil
        local pageOk = false

        -- 1) Catalog HTTP — append NEW emotes (skip ones already in this batch)
        if not aesPages then
            fetched, gotCursor, pageOk = httpFetchPage(nextPageCursor)
            if pageOk and #fetched > 1 then
                shuffleList(fetched)
            end
        end

        if gen ~= fetchGeneration then
            loadingPages = false
            return
        end

        -- 2) AvatarEditorService if HTTP failed (even if we will add fallback later)
        if not pageOk and not aesPages then
            local list, ok, pages = fetchViaAvatarEditor()
            if gen ~= fetchGeneration then
                loadingPages = false
                return
            end
            if ok then
                fetched = list
                pageOk = true
                aesPages = pages
                gotCursor = nil
                local finished = true
                pcall(function() finished = pages.IsFinished end)
                hasMorePages = not finished
            end
        elseif aesPages and not reset then
            local advOk = pcall(function()
                if not aesPages.IsFinished then
                    aesPages:AdvanceToNextPageAsync()
                end
            end)
            if advOk then
                local list = {}
                local pageOk2, items = pcall(function() return aesPages:GetCurrentPage() end)
                if pageOk2 and typeof(items) == "table" then
                    for _, entry in ipairs(items) do
                        local norm = {
                            id = entry.Id or entry.id,
                            name = entry.Name or entry.name,
                            assetType = EMOTE_TYPE_ID,
                            creatorTargetId = entry.CreatorTargetId or (entry.Creator and entry.Creator.Id),
                            creatorName = entry.CreatorName or (entry.Creator and entry.Creator.Name) or "",
                            itemType = "Asset",
                        }
                        if isCustomCatalogEmote(norm) then
                            local id = tonumber(norm.id)
                            if id and norm.name then
                                verifiedCache[id] = true
                                list[#list + 1] = {name = tostring(norm.name), id = id, creator = tostring(norm.creatorName or "")}
                            end
                        end
                    end
                    fetched = list
                    pageOk = true
                    local finished = true
                    pcall(function() finished = aesPages.IsFinished end)
                    hasMorePages = not finished
                end
            else
                hasMorePages = false
            end
        end

        if gen ~= fetchGeneration then
            loadingPages = false
            return
        end

        local added = 0
        if pageOk then
            for _, it in ipairs(fetched) do
                addToEmotePool(it)
                -- Prefer showing emotes that weren't in the previous refresh batch
                if not lastBatchIds[it.id] or reset == false then
                    if appendEmoteItem(it) then
                        added = added + 1
                        lastBatchIds[it.id] = true
                    end
                end
            end
            -- If filter skipped everything, still append something new from fetch
            if added == 0 then
                for _, it in ipairs(fetched) do
                    if appendEmoteItem(it) then
                        added = added + 1
                        lastBatchIds[it.id] = true
                    end
                end
            end
            if not aesPages then
                if typeof(gotCursor) == "string" and gotCursor ~= "" then
                    nextPageCursor = gotCursor
                    hasMorePages = true
                    if added == 0 then
                        pageEmptyStreak = pageEmptyStreak + 1
                        if pageEmptyStreak >= 12 then
                            hasMorePages = false
                            nextPageCursor = nil
                        end
                    else
                        pageEmptyStreak = 0
                    end
                else
                    nextPageCursor = nil
                    hasMorePages = false
                end
            end
        elseif reset then
            -- Keep paging disabled if live catalog is unavailable; pool batch already shown
            hasMorePages = false
        end

        if #catalogItems == 0 then
            showRotatedPoolBatch(18)
            hasMorePages = false
        end

        loadingPages = false
        if reset then
            setRefreshLabel("Refresh Catalog")
        end

        if gen == fetchGeneration and hasMorePages and shouldPrefetchMore() then
            task.defer(function()
                if gen == fetchGeneration then
                    fetchCatalogPage(false)
                end
            end)
        end
    end

    local function maybeLoadMore()
        if loadingPages or not hasMorePages then return end
        if shouldPrefetchMore() then
            task.spawn(function()
