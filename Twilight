            lbl.TextColor3 = Color3.fromRGB(236, 236, 240)
            lbl.TextSize = 12
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.ZIndex = 10

            local state = reg.get()
            local btn = Instance.new("TextButton", row)
            btn.BackgroundColor3 = state and Color3.fromRGB(40, 88, 48) or Color3.fromRGB(42, 42, 46)
            btn.BorderSizePixel = 0
            btn.Position = UDim2.new(1, -55, 0.5, -10)
            btn.Size = UDim2.new(0, 42, 0, 20)
            btn.Font = Enum.Font.BuilderSansBold
            btn.Text = state and "ON" or "OFF"
            btn.TextColor3 = Color3.fromRGB(236, 236, 240)
            btn.TextSize = 10
            btn.ZIndex = 10
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

            btn.MouseButton1Click:Connect(function()
                local newState = not reg.get()
                reg.set(newState)
                btn.Text = newState and "ON" or "OFF"
                btn.BackgroundColor3 = newState and Color3.fromRGB(40, 88, 48) or Color3.fromRGB(42, 42, 46)
            end)
        end
    end
end

