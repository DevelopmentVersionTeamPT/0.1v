local function doInfiniteJump()
    if not infiniteJumpEnabled or not scriptActive then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return end

    local power = 50
    if jumpPowerEnabled then
        power = defaultJumpPower
    elseif hum.UseJumpPower then
        power = math.max(hum.JumpPower, 50)
    else
        local jh = hum.JumpHeight
        if typeof(jh) == "number" and jh > 0 then
            power = math.sqrt(2 * workspace.Gravity * jh)
        end
    end
    power = math.clamp(power, 40, 200)

    pcall(function()
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end)
    pcall(function()
        hum.Jump = true
    end)

    local vel = hrp.AssemblyLinearVelocity
    hrp.AssemblyLinearVelocity = Vector3.new(vel.X, math.max(vel.Y, power), vel.Z)
end

