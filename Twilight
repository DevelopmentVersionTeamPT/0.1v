local bangTarget = nil
local bangSpeed = 22
local bangRunning = false
local bangGen = 0
Act.bangActive = false

local function stopBang()
    bangGen = bangGen + 1
    bangTarget = nil
    bangRunning = false
    Act.bangActive = false
    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if myHum then
        pcall(function()
            myHum.PlatformStand = false
            myHum.AutoRotate = true
        end)
    end
end

local function startBang(target, speed)
    if not target or target == LocalPlayer then return end
    if Act.invisActive then return end
    stopBang()
    if Act.headSitOff then Act.headSitOff() end
    bangTarget = target
    bangSpeed = math.clamp(tonumber(speed) or 22, 1, 100)
    bangRunning = true
    Act.bangActive = true
    bangGen = bangGen + 1
    local gen = bangGen
    Perf.noclipAt = 0

    -- Heartbeat + PreAnimation sync on LOCAL character only.
    -- Never write other players' velocity/CFrame (breaks their Twilight / movement).
    task.spawn(function()
        local zero = Vector3.zero
        while bangRunning and bangGen == gen and bangTarget and scriptActive do
            if Act.invisActive or not bangTarget.Parent then
                break
            end

            local tChar = bangTarget.Character
            local tRoot = tChar and (tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("Torso") or tChar:FindFirstChild("UpperTorso"))
            local myChar = LocalPlayer.Character
            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            local myRoot = myHum and (myHum.RootPart or myChar:FindFirstChild("HumanoidRootPart"))
            if not tRoot or not myRoot or not myHum or myHum.Health <= 0 then
                RunService.Heartbeat:Wait()
                continue
            end

            RunService.Heartbeat:Wait()
            if not bangRunning or bangGen ~= gen or not bangTarget then break end

            tChar = bangTarget.Character
            tRoot = tChar and (tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("Torso") or tChar:FindFirstChild("UpperTorso"))
            myChar = LocalPlayer.Character
            myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            myRoot = myHum and (myHum.RootPart or myChar:FindFirstChild("HumanoidRootPart"))
            if not tRoot or not myRoot or not myHum then
                continue
            end

            pcall(function()
                myHum.PlatformStand = true
                myHum.AutoRotate = false
                myHum:ChangeState(Enum.HumanoidStateType.Physics)
            end)
            for _, p in ipairs(myChar:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                end
            end

            local thrust = 0.9 + math.sin(tick() * bangSpeed) * 0.85
            myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, thrust)
            myRoot.AssemblyLinearVelocity = zero
            myRoot.AssemblyAngularVelocity = zero

            RunService.PreAnimation:Wait()
            if not bangRunning or bangGen ~= gen or not bangTarget then break end

            tRoot = bangTarget.Character and (bangTarget.Character:FindFirstChild("HumanoidRootPart") or bangTarget.Character:FindFirstChild("Torso") or bangTarget.Character:FindFirstChild("UpperTorso"))
            myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if tRoot and myRoot then
                thrust = 0.9 + math.sin(tick() * bangSpeed) * 0.85
                myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, thrust)
                myRoot.AssemblyLinearVelocity = zero
                myRoot.AssemblyAngularVelocity = zero
            end
        end
        if bangGen == gen then
            bangRunning = false
            Act.bangActive = false
            local myChar = LocalPlayer.Character
            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            if myHum then
                pcall(function()
                    myHum.PlatformStand = false
                    myHum.AutoRotate = true
                end)
            end
        end
    end)
end

