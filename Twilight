local jerkActive = false
local jerkPlaying = false
local jerkTrack = nil
local jerkAnim = nil
local jerkTask = nil

local function stopJerkAnim()
    jerkPlaying = false
    if jerkTask then
        pcall(function() task.cancel(jerkTask) end)
        jerkTask = nil
    end
    if jerkTrack then
        pcall(function() jerkTrack:Stop() end)
        jerkTrack = nil
    end
end

local function playJerkAnim()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    stopJerkAnim()
    jerkPlaying = true

    if not jerkAnim then
        jerkAnim = Instance.new("Animation")
        jerkAnim.AnimationId = "rbxassetid://698251653"
    end

    -- This anim only looks right when a short middle section is rewound.
    jerkTask = task.spawn(function()
        while jerkPlaying and scriptActive do
            local c = LocalPlayer.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if not h or h.Health <= 0 then break end

            local track = h:LoadAnimation(jerkAnim)
            jerkTrack = track
            track.Priority = Enum.AnimationPriority.Action4
            track:Play()
            track:AdjustSpeed(0.7)
            track.TimePosition = 0.6
            task.wait(0.1)
            while jerkPlaying and track and track.IsPlaying and track.TimePosition < 0.7 do
                task.wait(0.05)
            end
            if track then
                pcall(function() track:Stop() end)
            end
            if jerkTrack == track then
                jerkTrack = nil
            end
        end
        jerkTask = nil
    end)
end

local function destroyJerkTool()
    stopJerkAnim()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    for _, parent in ipairs({char, bp}) do
        if parent then
            local tool = parent:FindFirstChild("Jerk")
            if tool then tool:Destroy() end
        end
    end
end

local function giveJerkTool()
    destroyJerkTool()
    local char = LocalPlayer.Character
    if not char then return end

    local tool = Instance.new("Tool")
    tool.Name = "Jerk"
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.Parent = LocalPlayer.Backpack

    tool.Equipped:Connect(function()
        playJerkAnim()
    end)
    tool.Unequipped:Connect(function()
        stopJerkAnim()
    end)

    tool.Parent = char
end

