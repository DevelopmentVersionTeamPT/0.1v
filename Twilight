                                    if fovVisibleOnly and tick() > _respawnGrace then
                                        passWallCheck = H.isCharVisibleFast(char, myChar)
                                    end
                                    if passWallCheck then
                                        closestDist = dist3d
                                        closest = player
                                    end
                                end
                            end
                        else
                            
                            local dist, anyOnScreen = getClosestScreenDist(char, mousePos)
                            if anyOnScreen and dist < maxDist and dist < closestDist then
                                local passWallCheck = true
                                if fovVisibleOnly and tick() > _respawnGrace then
                                    passWallCheck = H.isCharVisibleFast(char, myChar)
                                end
                                if passWallCheck then
                                    closestDist = dist
                                    closest = player
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    
    if npcCombatEnabled then
        for _, model in ipairs(workspace:GetDescendants()) do
            if model:IsA("Model") and model:FindFirstChildOfClass("Humanoid") and model:FindFirstChild("HumanoidRootPart") and not Players:GetPlayerFromCharacter(model) and not Act.isTwilightLocalClone(model) then
                local root = model:FindFirstChild("HumanoidRootPart")
                local hum = model:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    
                    if root.Position.Magnitude >= 1 and not (myRoot and root.Position.Y < myY - 50) then
                        local state = hum:GetState()
                        local skipNpc = (state == Enum.HumanoidStateType.Dead)
                        if not skipNpc and (state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.FallingDown) then
                            if root.Position.Y < -50 then skipNpc = true end
                        end
                        if not skipNpc then
                            
                            local dist, anyOnScreen = getClosestScreenDist(model, mousePos)
                            if anyOnScreen and dist < maxDist and dist < closestDist then
                                local passWallCheck = true
                                if fovVisibleOnly and tick() > _respawnGrace then
                                    passWallCheck = H.isCharVisibleFast(model, myChar)
                                end
                                if passWallCheck then
                                    closestDist = dist
                                    closest = model
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return closest
end

local function getTargetPart(char)
    if targetMode == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    elseif targetMode == "All" then
        return char:FindFirstChild("Head") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    else
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    end
end

local function usesSmartAim()
    return rageBotEnabled or targetMode == "All"
end

local function getAimParts(char)
    if targetMode == "All" then
        local parts, seen = {}, {}
        for _, name in ipairs({
            "Head", "UpperTorso", "LowerTorso", "Torso",
            "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
            "HumanoidRootPart",
        }) do
            local part = char:FindFirstChild(name)
            if part and part:IsA("BasePart") and not seen[part] then
                seen[part] = true
                table.insert(parts, part)
            end
        end
        return parts
    end

    local primary = getTargetPart(char)
    if not primary then return {} end

    local parts = {primary}
    if rageBotEnabled then
        local head = char:FindFirstChild("Head")
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        for _, extra in ipairs({head, torso}) do
            if extra and extra ~= primary then
                local duplicate = false
                for _, existing in ipairs(parts) do
                    if existing == extra then duplicate = true break end
                end
                if not duplicate then table.insert(parts, extra) end
            end
        end
    end
    return parts
end


local _currentAimPoint = nil

local function buildAimRayParams(myChar, char)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local filterList = {myChar, char}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(filterList, p.Character) end
    end
    rayParams.FilterDescendantsInstances = filterList
    rayParams.IgnoreWater = true
    return rayParams
end

local function getAimPointOpenness(fromPos, targetPoint, rayParams, char)
    local dir = targetPoint - fromPos
    local dist = dir.Magnitude
    if dist <= 3 then return 1 end
    local hit = workspace:Raycast(fromPos, dir.Unit * (dist - 0.3), rayParams)
    if not hit then return 1 end
    if hit.Instance and hit.Instance:IsDescendantOf(char) then
        local hitDist = (hit.Position - fromPos).Magnitude
        return 0.85 + 0.15 * math.clamp(1 - math.abs(hitDist - dist) / math.max(dist, 1), 0, 1)
    end
    if (targetPoint - hit.Position).Magnitude < 2.5 then return 0.55 end
    return 0
end

local function getAimPointOffsets(part)
    local cf = part.CFrame
    local right = cf.RightVector
    local up = cf.UpVector
    local size = part.Size
    local sideOffset = math.max(size.X, size.Z) * 0.38
    local upOffset = size.Y * 0.22
    return {
        Vector3.zero,
        right * sideOffset,
        right * -sideOffset,
        up * upOffset,
        up * -upOffset * 0.6,
        right * sideOffset * 0.7 + up * upOffset * 0.5,
        right * -sideOffset * 0.7 + up * upOffset * 0.5,
    }
end

local function getBestAimPoint(char, myChar)
    local partsToTry = getAimParts(char)
    if #partsToTry == 0 then return nil end
    local primary = getTargetPart(char)

    local camPos = Camera.CFrame.Position
    local camLook = Camera.CFrame.LookVector
    local rayParams = buildAimRayParams(myChar, char)

    local bestPoint, bestScore = nil, -math.huge
    for _, part in ipairs(partsToTry) do
        local partBonus = 0
        if part.Name == "Head" then
            partBonus = 0.04
        elseif part.Name == "UpperTorso" or part.Name == "Torso" or part.Name == "LowerTorso" then
            partBonus = 0.02
        end
        if part == primary then partBonus = partBonus + 0.02 end

        for i, offset in ipairs(getAimPointOffsets(part)) do
            local point = part.Position + offset
            local openness = getAimPointOpenness(camPos, point, rayParams, char)
            if openness > 0 then
                local alignment = camLook:Dot((point - camPos).Unit)
                local score = (openness * 0.65) + (alignment * 0.35) + partBonus
                if i == 1 then score = score + 0.01 end
                if score > bestScore then
                    bestScore = score
                    bestPoint = point
                end
            end
        end
    end

    return bestPoint or (primary and primary.Position)
end


local function getLockedChar()
    if not lockedTarget then return nil end
    if lockedTarget:IsA("Player") then
        return lockedTarget.Character
    else
        return lockedTarget
    end
end

local function clearLockedTarget()
    if hitboxEnabled and getLockedChar() then
        local root = getLockedChar():FindFirstChild("HumanoidRootPart")
        if root then
            root.Size = Vector3.new(2, 2, 1)
            root.Transparency = 1
            root.CanCollide = false
            root.Material = Enum.Material.SmoothPlastic
        end
    end
    lockedTarget = nil
end

local function unlockTarget()
    if not lockedTarget then return false end
    clearLockedTarget()
    _manualUnlockGrace = tick() + 0.35
    return true
end

local function lockOntoTarget()
    if not camLockEnabled then return false end
    if lockedTarget then
        if lockedTarget:IsA("Player") and H.isTeammate(lockedTarget) then
            lockedTarget = nil
        else
            return true
        end
    end
    local target = getClosestPlayerToCursor()
    if target and not (target:IsA("Player") and H.isTeammate(target)) then
        lockedTarget = target
        return true
    end
    return false
end

local function toggleLockTarget()
    if not camLockEnabled then return false end
    if lockedTarget then
        return unlockTarget()
    end
    return lockOntoTarget()
end

