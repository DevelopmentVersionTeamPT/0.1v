local flyActive = false
local flyConnection = nil
local flyBodyVel = nil
local flyBodyGyro = nil
local FLY_SPEED = 50

cmdCommands["fly"] = "NEEDS_ARG"

local function clearFlyParts(char)
    char = char or LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp then
        local bv = hrp:FindFirstChild("XthosFlyVel")
        if bv then pcall(function() bv:Destroy() end) end
        local bg = hrp:FindFirstChild("XthosFlyGyro")
        if bg then pcall(function() bg:Destroy() end) end
    end
    if hum then
        pcall(function()
            hum.PlatformStand = false
            hum.AutoRotate = true
            hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
    if char == LocalPlayer.Character or not (Act.invisGhost and char == Act.invisGhost) then
        flyBodyVel = nil
        flyBodyGyro = nil
    end
end

local function attachFlyParts(char)
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp then
        hrp = char:WaitForChild("HumanoidRootPart", 5)
    end
    if not hum then
        hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
    end
    if not hrp or not hum or not char.Parent then return false end

    local oldBv = hrp:FindFirstChild("XthosFlyVel")
    if oldBv then oldBv:Destroy() end
    local oldBg = hrp:FindFirstChild("XthosFlyGyro")
    if oldBg then oldBg:Destroy() end

    pcall(function()
        hum.PlatformStand = true
        hum.AutoRotate = false
        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
    end)

    flyBodyVel = Instance.new("BodyVelocity")
    flyBodyVel.Name = "XthosFlyVel"
    flyBodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBodyVel.P = 1250
    flyBodyVel.Velocity = Vector3.zero
    flyBodyVel.Parent = hrp

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.Name = "XthosFlyGyro"
    flyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBodyGyro.P = 3e5
    flyBodyGyro.D = 800
    do
        local cam = workspace.CurrentCamera
        if cam then
            flyBodyGyro.CFrame = CFrame.new(hrp.Position) * (cam.CFrame - cam.CFrame.Position)
        else
            flyBodyGyro.CFrame = hrp.CFrame
        end
    end
    flyBodyGyro.Parent = hrp

    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    return true
end

local function getFlyRoot()
    if Act.invisActive and Act.invisGhost and Act.invisGhost.Parent then
        local gr = Act.invisGhost:FindFirstChild("HumanoidRootPart")
        if gr then return Act.invisGhost, gr, Act.invisGhost:FindFirstChildOfClass("Humanoid") end
    end
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    return char, char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
end

local function ensureFlyLoop()
    if flyConnection then return end
    flyConnection = RunService.Heartbeat:Connect(function()
        if not flyActive then return end

        local c, root, h = getFlyRoot()
        if not c or not root or not h or h.Health <= 0 then return end

        local bvel = root:FindFirstChild("XthosFlyVel")
        local bgyro = root:FindFirstChild("XthosFlyGyro")
        if not bvel or not bgyro then
            if not attachFlyParts(c) then return end
            bvel = root:FindFirstChild("XthosFlyVel")
            bgyro = root:FindFirstChild("XthosFlyGyro")
            if not bvel or not bgyro then return end
        end

        pcall(function()
            h.PlatformStand = true
            h.AutoRotate = false
            root.AssemblyAngularVelocity = Vector3.zero
        end)

        local cam = workspace.CurrentCamera
        if not cam then return end

        local cf = cam.CFrame
        local look = cf.LookVector
        local right = cf.RightVector

        local move = Vector3.zero
        if not UserInputService:GetFocusedTextBox() then
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + look end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - look end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - right end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + right end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.E)
                or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
                or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
                move = move - Vector3.new(0, 1, 0)
            end
        end

        if move.Magnitude > 0.05 then
            bvel.Velocity = move.Unit * FLY_SPEED
        else
            bvel.Velocity = Vector3.zero
        end

        -- Character aims with camera (look down = face down)
        local aimCF = CFrame.new(root.Position) * (cf - cf.Position)
        bgyro.CFrame = aimCF
        bgyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bgyro.P = 3e5
        root.CFrame = aimCF
    end)
end

local function startFly(speed)
    if speed then FLY_SPEED = tonumber(speed) or FLY_SPEED end
    flyActive = true
    syncToggle("Fly", true)
    ensureFlyLoop()
    local real = LocalPlayer.Character
    local char = real
    if Act.invisActive and Act.invisGhost and Act.invisGhost.Parent then
        char = Act.invisGhost
        -- Don't leave movers on the buried real body
        if real and real ~= char then
            clearFlyParts(real)
        end
    end
    if char then
        attachFlyParts(char)
    end
end

cmdCommands["unfly"] = function()
    if not flyActive and not flyConnection then return end
    flyActive = false
    syncToggle("Fly", false)
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    clearFlyParts(LocalPlayer.Character)
    if Act.invisGhost and Act.invisGhost.Parent then
        clearFlyParts(Act.invisGhost)
    end
end
