local spectateFrame = nil
local spectateNameLbl = nil

local function getSpectateList()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p)
        end
    end
    table.sort(list, function(a, b)
        return a.DisplayName:lower() < b.DisplayName:lower()
    end)
    return list
end

local function restoreSpectateCam()
    local cam = workspace.CurrentCamera
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if cam then
        cam.CameraType = Enum.CameraType.Custom
        if hum then cam.CameraSubject = hum end
    end
end

local function updateSpectateLabel()
    if not spectateNameLbl or not spectateNameLbl.Parent then return end
    if viewingPlayer and viewingPlayer.Parent then
        spectateNameLbl.Text = viewingPlayer.DisplayName
    else
        spectateNameLbl.Text = "Nobody"
    end
end

local function hideSpectateUI()
    if spectateFrame then
        pcall(function() spectateFrame:Destroy() end)
        spectateFrame = nil
        spectateNameLbl = nil
    end
end

local function stopSpectate()
    viewingPlayer = nil
    restoreSpectateCam()
    hideSpectateUI()
end

local function startSpectate(player)
    if not player or player == LocalPlayer or not player.Parent then return end
    viewingPlayer = player
    updateSpectateLabel()
end

local function spectateStep(dir)
    local list = getSpectateList()
    if #list == 0 then
        stopSpectate()
        return
    end
    local idx = 1
    if viewingPlayer then
        for i, p in ipairs(list) do
            if p == viewingPlayer then
                idx = i
                break
            end
        end
        idx = idx + (dir or 1)
        if idx > #list then idx = 1 end
        if idx < 1 then idx = #list end
    end
    startSpectate(list[idx])
end

