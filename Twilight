local H = (function()
    local tmTagCache = {}
    local lostFrontMateSet = {}
    local lostFrontMateScanAt = 0
    local aimVisCache = {}
    local OFFSCREEN2 = Vector2.new(-10000, -10000)

    local GUI_SKIP = {
        VoidESP = true, VoidHighlight = true, VoidChams = true,
        TeamESPHighlight = true, FriendESPHighlight = true, TargetESPHighlight = true,
        PlayerVisualChams = true, PlayerVisualHighlight = true,
        NPCVoidHighlight = true, NPCVoidChams = true, NPCVoidESP = true, TwilightUI = true,
    }

    local function isGreenTeamColor(c)
        if typeof(c) ~= "Color3" then return false end
        local h, s, v = Color3.toHSV(c)
        if s >= 0.2 and v >= 0.25 and h >= 0.18 and h <= 0.55 then return true end
        if c.G >= 0.3 and c.G >= c.R and c.G >= c.B and (c.G - math.max(c.R, c.B)) >= 0.05 then return true end
        return false
    end

    local function stripRichText(s)
        if typeof(s) ~= "string" then return "" end
        local clean = s:gsub("<[^>]+>", ""):gsub("%s+", " ")
        return clean:match("^%s*(.-)%s*$") or clean
    end

    local function namesMatch(text, player)
        local t = string.lower(stripRichText(text))
        if t == "" then return false end
        local user = string.lower(player.Name or "")
        local display = string.lower(player.DisplayName or "")
        for _, n in ipairs({user, display}) do
            if n ~= "" then
                if t == n or string.find(t, n, 1, true) then return true end
                if #t >= 3 and string.find(n, t, 1, true) then return true end
            end
        end
        return false
    end

    local function labelIsGreen(lbl)
        if not (lbl:IsA("TextLabel") or lbl:IsA("TextButton") or lbl:IsA("TextBox")) then return false end
        if (lbl.TextTransparency or 0) > 0.9 then return false end
        if isGreenTeamColor(lbl.TextColor3) then return true end
        local stroke = lbl:FindFirstChildOfClass("UIStroke")
        return stroke and (stroke.Transparency or 0) < 0.9 and isGreenTeamColor(stroke.Color)
    end

    local function playerFromAdornee(adornee)
        if not adornee then return nil end
        if adornee:IsA("Player") then return adornee end
        local model = adornee:IsA("Model") and adornee or adornee:FindFirstAncestorOfClass("Model")
        return model and Players:GetPlayerFromCharacter(model) or nil
    end

    local function refreshLostFrontMates()
        local now = tick()
        if now - lostFrontMateScanAt < 0.4 then return end
        lostFrontMateScanAt = now
        for k in pairs(lostFrontMateSet) do lostFrontMateSet[k] = nil end
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not pg then return end
        for _, bb in ipairs(pg:GetDescendants()) do
            if bb:IsA("BillboardGui") and not GUI_SKIP[bb.Name] and bb.Enabled ~= false then
                local plr = playerFromAdornee(bb.Adornee)
                if plr and plr ~= LocalPlayer then
                    local greenHit, nameHit = false, false
                    for _, d in ipairs(bb:GetDescendants()) do
                        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                            if labelIsGreen(d) then
                                greenHit = true
                                if namesMatch(d.Text, plr) then nameHit = true break end
                            end
                        end
                    end
                    if nameHit or greenHit then lostFrontMateSet[plr] = true end
                end
            end
        end
    end

    local api = {}

    function api.isLostFrontMate(player)
        if typeof(player) ~= "Instance" or not player:IsA("Player") then return false end
        if player == LocalPlayer then return true end
        if not GameDetect.isLostFront() then return false end
        refreshLostFrontMates()
        return lostFrontMateSet[player] == true
    end

    function api.isTeammate(player)
        if not teamCheckEnabled then return false end
        if typeof(player) ~= "Instance" or not player:IsA("Player") then return false end
        if player == LocalPlayer then return true end
        if GameDetect.isLostFront() then
            return api.isLostFrontMate(player)
        end
        local cached = tmTagCache[player]
        local now = tick()
        if cached and cached.t > now then return cached.v end
        local result = false
        local myTeam, theirTeam = LocalPlayer.Team, player.Team
        if myTeam and theirTeam then
            result = (myTeam == theirTeam) or (myTeam.Name == theirTeam.Name)
        elseif LocalPlayer.Neutral == false and player.Neutral == false then
            local a, b = LocalPlayer.TeamColor, player.TeamColor
            if a and b then result = (a == b) or (a.Name == b.Name) or (a.Number == b.Number) end
        else
            local myAttr = LocalPlayer:GetAttribute("Team") or LocalPlayer:GetAttribute("team")
            local theirAttr = player:GetAttribute("Team") or player:GetAttribute("team")
            if myAttr ~= nil and theirAttr ~= nil and myAttr == theirAttr then
                result = true
            else
                local myChar, theirChar = LocalPlayer.Character, player.Character
                if myChar and theirChar then
                    local function readTeamVal(char)
                        local v = char:GetAttribute("Team") or char:GetAttribute("team")
                        if v ~= nil then return v end
                        local obj = char:FindFirstChild("Team") or char:FindFirstChild("team")
                        if obj and obj:IsA("ValueBase") then return obj.Value end
                        return nil
                    end
                    local a, b = readTeamVal(myChar), readTeamVal(theirChar)
                    if a ~= nil and b ~= nil and a == b then result = true end
                end
            end
        end
        tmTagCache[player] = {t = now + 0.5, v = result}
        return result
    end

    function api.hideQuad(q)
        if not q then return end
        pcall(function()
            q.Visible = false
            q.PointA = OFFSCREEN2; q.PointB = OFFSCREEN2; q.PointC = OFFSCREEN2; q.PointD = OFFSCREEN2
        end)
    end

    function api.hideLine(l)
        if not l then return end
        pcall(function()
            l.Visible = false
            l.From = OFFSCREEN2; l.To = OFFSCREEN2
        end)
    end

    function api.worldToScreen2(pos)
        local cam = workspace.CurrentCamera or Camera
        if not cam then return nil end
        local v = cam:WorldToViewportPoint(pos)
        if v.Z <= 1 then return nil end
        local vs = cam.ViewportSize
        if v.X < -vs.X or v.X > vs.X * 2 or v.Y < -vs.Y or v.Y > vs.Y * 2 then
            return nil
        end
        return Vector2.new(v.X, v.Y)
    end

    function api.wipeEspDrawings(obj)
        if not obj then return end
        if obj.tracer then api.hideLine(obj.tracer) pcall(function() obj.tracer:Remove() end) obj.tracer = nil end
        if obj.boxOutline then api.hideQuad(obj.boxOutline) pcall(function() obj.boxOutline:Remove() end) obj.boxOutline = nil end
        if obj.box then api.hideQuad(obj.box) pcall(function() obj.box:Remove() end) obj.box = nil end
        if obj.headDot then pcall(function() obj.headDot.Visible = false end) pcall(function() obj.headDot:Remove() end) obj.headDot = nil end
        if obj.headdot then pcall(function() obj.headdot.Visible = false end) pcall(function() obj.headdot:Remove() end) obj.headdot = nil end
        if obj.healthBar then api.hideLine(obj.healthBar) pcall(function() obj.healthBar:Remove() end) obj.healthBar = nil end
        if obj.healthBarBg then api.hideLine(obj.healthBarBg) pcall(function() obj.healthBarBg:Remove() end) obj.healthBarBg = nil end
        if obj.skeleton then
            for _, line in pairs(obj.skeleton) do api.hideLine(line) pcall(function() line:Remove() end) end
            obj.skeleton = nil
        end
        if obj.box3d then
            for _, line in pairs(obj.box3d) do api.hideLine(line) pcall(function() line:Remove() end) end
            obj.box3d = nil
        end
        if obj.cornerBox then
            for _, line in pairs(obj.cornerBox) do api.hideLine(line) pcall(function() line:Remove() end) end
            obj.cornerBox = nil
        end
        if obj.billboard then pcall(function() obj.billboard:Destroy() end) obj.billboard = nil end
        if obj.highlight then pcall(function() obj.highlight:Destroy() end) obj.highlight = nil end
        if obj.trail then pcall(function() obj.trail:Destroy() end) obj.trail = nil end
        if obj.trailAttach0 then pcall(function() obj.trailAttach0:Destroy() end) obj.trailAttach0 = nil end
        if obj.trailAttach1 then pcall(function() obj.trailAttach1:Destroy() end) obj.trailAttach1 = nil end
        if obj.chams then pcall(function() obj.chams:Destroy() end) obj.chams = nil end
        if obj.beam then pcall(function() obj.beam:Destroy() end) obj.beam = nil end
        if obj.beamAttach0 then pcall(function() obj.beamAttach0:Destroy() end) obj.beamAttach0 = nil end
        if obj.beamAttach1 then pcall(function() obj.beamAttach1:Destroy() end) obj.beamAttach1 = nil end
    end

    function api.isCharVisibleFast(char, myChar)
        if not char or not myChar then return false end
        local now = tick()
        local cached = aimVisCache[char]
        if cached and (now - cached.t) < 0.1 then return cached.v end
        local cam = workspace.CurrentCamera or Camera
        if not cam then return false end
        local camPos = cam.CFrame.Position
        local part = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        if not part then aimVisCache[char] = {t = now, v = false} return false end
        local to = part.Position - camPos
        local dist = to.Magnitude
        if dist <= 4 then aimVisCache[char] = {t = now, v = true} return true end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {myChar, char}
        params.IgnoreWater = true
        local hit = workspace:Raycast(camPos, to.Unit * (dist - 1), params)
        local ok = hit == nil
        aimVisCache[char] = {t = now, v = ok}
        return ok
    end

    table.insert(connections, Players.PlayerRemoving:Connect(function(player)
        tmTagCache[player] = nil
        lostFrontMateSet[player] = nil
        aimVisCache[player] = nil
    end))

    return api
end)()

