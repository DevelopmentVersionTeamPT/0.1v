        if _plusOpen then
            
            local panelH = _plusPanel and _plusPanel.Size.Y.Offset or _plusPanelHeight
            local shift = panelH + _plusGap
            if _plusPanel and _plusPanel.Parent then _plusPanel:Destroy() end
            _plusPanel = nil
            for _, child in ipairs(_plusShifted) do
                if child and child.Parent then
                    child.Position = child.Position - UDim2.new(0, 0, 0, shift)
                end
            end
            _plusShifted = {}
            _plusOpen = false
            plusBtn.Text = "+"
        else
            if not _plusBuilder then return end
            local containerY = container.Position.Y.Offset
            local shift = _plusPanelHeight + _plusGap

            
            _plusShifted = {}
            for _, child in ipairs(parent:GetChildren()) do
                if child:IsA("GuiObject") and child ~= container then
                    if child.Position.Y.Offset > containerY then
                        child.Position = child.Position + UDim2.new(0, 0, 0, shift)
                        table.insert(_plusShifted, child)
