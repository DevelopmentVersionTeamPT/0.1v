local Perf = {
    lowMode = true,
    fps = 60,
    _fpsFrames = 0,
    _fpsT0 = tick(),
    _last = {},
    _espWasOn = false,
    _npcWasOn = false,
    npcCache = {},
    npcCacheAt = 0,
    noclipParts = {},
    noclipChar = nil,
    noclipAt = 0,
}

function Perf.interval(name)
    if not Perf.lowMode then
        if name == "npcScan" then return 0.75 end
        if name == "noclipRefresh" then return 1.0 end
        return 0
    end
    if name == "esp" then return 1 / 20 end
    if name == "npcEsp" then return 1 / 15 end
    if name == "npcScan" then return 1.5 end
    if name == "playerVisuals" then return 1 / 15 end
    if name == "targetInfo" then return 1 / 10 end
    if name == "noclipRefresh" then return 1.25 end
    return 1 / 30
end

function Perf.allow(name)
    local iv = Perf.interval(name)
    if iv <= 0 then return true end
    local now = tick()
    local last = Perf._last[name]
    if last and (now - last) < iv then return false end
    Perf._last[name] = now
    return true
end

