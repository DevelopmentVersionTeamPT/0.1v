    end)

    local function finishLoader()
        if loaderDone then return end
        loaderDone = true
        local fadeInfo = TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(loaderBrand, fadeInfo, {TextTransparency = 1}):Play()
        TweenService:Create(loaderVersion, fadeInfo, {TextTransparency = 1}):Play()
        TweenService:Create(loaderTrack, fadeInfo, {BackgroundTransparency = 1}):Play()
        TweenService:Create(loaderFill, fadeInfo, {BackgroundTransparency = 1}):Play()
        TweenService:Create(hairline, fadeInfo, {BackgroundTransparency = 1}):Play()
        TweenService:Create(skipBtn, fadeInfo, {TextTransparency = 1}):Play()
        if centerWash then
            TweenService:Create(centerWash, fadeInfo, {BackgroundTransparency = 1}):Play()
        end
        TweenService:Create(brandScale, fadeInfo, {Scale = 0.985}):Play()
        TweenService:Create(Loader, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = 1,
        }):Play()
        task.wait(0.38)
        if Loader and Loader.Parent then Loader:Destroy() end
        if MainFrame and MainFrame.Parent then
            MainFrame.Visible = true
        end
    end

    return function()
        if loaderReady then return end
        loaderReady = true

        if centerWash then
            TweenService:Create(centerWash, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 0,
            }):Play()
        end

        TweenService:Create(brandScale, TweenInfo.new(0.65, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Scale = 1,
        }):Play()
        TweenService:Create(loaderBrand, TweenInfo.new(0.55, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            TextTransparency = 0,
        }):Play()
        task.wait(0.18)

        TweenService:Create(hairline, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 28, 0, 1),
            BackgroundTransparency = 0.15,
        }):Play()
        TweenService:Create(loaderVersion, TweenInfo.new(0.35), {TextTransparency = 0}):Play()
        task.wait(0.1)
        if loaderSkipped then finishLoader() return end

        TweenService:Create(loaderTrack, TweenInfo.new(0.28), {BackgroundTransparency = 0}):Play()
        TweenService:Create(skipBtn, TweenInfo.new(0.28), {TextTransparency = 0}):Play()

        local marks = {0.22, 0.48, 0.76, 1}
        for _, t in ipairs(marks) do
            if loaderSkipped then break end
            TweenService:Create(loaderFill, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(t, 0, 1, 0),
            }):Play()
            local t0 = tick()
            while tick() - t0 < 0.4 do
                if loaderSkipped then break end
                task.wait(0.04)
            end
            if loaderSkipped then break end
        end

        if not loaderSkipped then
            task.wait(0.12)
        end
        finishLoader()
    end
end)()


