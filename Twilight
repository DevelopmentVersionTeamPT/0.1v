local function showDamageIndicator(character, damage)
    if not character then return end
    local head = character:FindFirstChild("Head")
    if not head then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = "DamageIndicator"
    bb.Size = UDim2.new(0, 100, 0, 40)
    bb.StudsOffset = Vector3.new(math.random(-10, 10) / 10, 4.5, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = head
    bb.Parent = character

    local dmgLabel = Instance.new("TextLabel", bb)
    dmgLabel.BackgroundTransparency = 1
    dmgLabel.Size = UDim2.new(1, 0, 1, 0)
    dmgLabel.Font = Enum.Font.BuilderSansBold
    dmgLabel.Text = "-" .. tostring(math.floor(damage))
    dmgLabel.TextColor3 = damageEspColor
    dmgLabel.TextSize = damageEspSize
    dmgLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    dmgLabel.TextStrokeTransparency = 0.3

    
    task.spawn(function()
        local startTime = tick()
        local duration = 1.5
        local startOffset = bb.StudsOffset

        while tick() - startTime < duration do
            local elapsed = tick() - startTime
            local alpha = elapsed / duration

            
            bb.StudsOffset = startOffset + Vector3.new(0, alpha * 2, 0)

            
            dmgLabel.TextTransparency = alpha
            dmgLabel.TextStrokeTransparency = 0.3 + (alpha * 0.7)

            
            dmgLabel.TextSize = 16 - (alpha * 4)

            task.wait()
        end

        if bb and bb.Parent then
            bb:Destroy()
        end
    end)
end

local function connectDamageESP(player)
    if damageEspConnections[player] then
        pcall(function() damageEspConnections[player]:Disconnect() end)
    end

    local function hookCharacter(character)
        if not character then return end
        local hum = character:WaitForChild("Humanoid", 5)
        if not hum then return end

        local lastHealth = hum.Health

        
        if damageEspConnections[player] then
            pcall(function() damageEspConnections[player]:Disconnect() end)
        end

        damageEspConnections[player] = hum.HealthChanged:Connect(function(newHealth)
            if not damageEspEnabled then return end
            local damage = lastHealth - newHealth
            if damage > 0 then
                showDamageIndicator(character, damage)
            end
            lastHealth = newHealth
        end)
    end

    
    if player.Character then
        task.spawn(hookCharacter, player.Character)
    end

    
    player.CharacterAdded:Connect(function(char)
        task.spawn(hookCharacter, char)
    end)
end


for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        task.spawn(connectDamageESP, player)
    end
end


