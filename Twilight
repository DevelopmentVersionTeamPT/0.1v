        local selected = (i == cmdMatchIndex)
        sugBtn.BackgroundColor3 = selected and Color3.fromRGB(42, 42, 48) or Color3.fromRGB(18, 18, 18)
        sugBtn.BackgroundTransparency = selected and 0 or 1
        sugBtn.TextColor3 = selected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
        Instance.new("UICorner", sugBtn).CornerRadius = UDim.new(0, 3)
